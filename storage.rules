rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    // Writes: cap size; allow images plus common document types under projects/ (files & docs tab).
    function allowedProjectWrite() {
      return signedIn()
        && request.resource.size < 32 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
          || request.resource.contentType == 'application/msword'
        );
    }
    function allowedImageWrite() {
      return signedIn()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Project files (clips, hero, room covers under projects/{id}/..., documents, etc.)
    match /projects/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedProjectWrite();
      // Deletes must not require image/* (metadata on delete can fail strict checks; library cleanup needs this).
      allow delete: if signedIn();
    }

    // Legacy / alternate paths used by admin hero, What's New, client documents (index.html uploads to boards/...)
    match /boards/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    match /images/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    match /clips/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    match /rooms/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    match /selections/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    match /specbook/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }
  }
}
