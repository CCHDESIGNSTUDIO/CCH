rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    // Writes: cap size; allow images plus common document types under projects/ (files & docs tab).
    function allowedProjectWrite() {
      return signedIn()
        && request.resource.size < 32 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'text/html'
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
          || request.resource.contentType == 'application/msword'
        );
    }
    function allowedImageWrite() {
      return signedIn()
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType == null
          || request.resource.contentType == ''
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }
    /** Design board canvas uploads (images/designboards/... and projects/.../designboards/...). */
    function allowedDesignBoardImageWrite() {
      return signedIn()
        && request.resource.size < 32 * 1024 * 1024
        && (
          request.resource.contentType == null
          || request.resource.contentType == ''
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }
    /** boards/ path: images plus PDF/HTML shared to client portal (legacy uploads used boards/.../clientDocuments/). */
    function allowedBoardsMediaWrite() {
      return signedIn()
        && request.resource.size < 32 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'text/html'
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    // Project files (clips, hero, room covers under projects/{id}/..., documents, etc.)
    match /projects/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedProjectWrite();
      // Deletes must not require image/* (metadata on delete can fail strict checks; library cleanup needs this).
      allow delete: if signedIn();
    }

    /** Legacy line-item path (older builds used docs/{projectId}/...). */
    match /docs/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    /** Legacy proposal line uploads (uploadProposalImage). */
    match /proposals/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    /** Document attachments on proposals, invoices, POs (addDocEditAttachment, addProposalAttachment) */
    match /attachments/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedProjectWrite();
      allow delete: if signedIn();
    }

    // Legacy / alternate paths used by admin hero, What's New, client documents (index.html uploads to boards/...)
    match /boards/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedBoardsMediaWrite();
      allow delete: if signedIn();
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    match /images/designboards/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedDesignBoardImageWrite();
      allow delete: if signedIn();
    }

    match /images/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    match /clips/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    match /rooms/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    match /selections/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    match /specbook/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    /** Custom Order Builder & Studio: reference images (pleats, welts, etc.) under library/{category}/... */
    match /library/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }

    /** Houzz catalog images uploaded via May 1-2, 2026 migration. Reads stay public (product display),
     *  writes require signed-in (no more bulk-upload work expected). */
    match /houzz-products/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowedImageWrite();
      allow delete: if signedIn();
    }
  }
}
