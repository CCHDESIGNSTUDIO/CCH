    // ----- OVERVIEW TAB (DARK LUXURY — WEST AVALON STYLE) -----
    async function renderOverviewTab(T, proj) {
      const statusClass = proj.status === 'In Progress' ? 'active' : proj.status === 'Completed' ? 'completed' : 'hold';

      // Load all docs
      let invoices = [], proposals = [], pos = [], clips = [], activities = [];
      try {
        const s1 = await db.collection('boards').doc(proj.id).collection('invoices').orderBy('createdAt','desc').get();
        s1.forEach(d => invoices.push({id:d.id,...d.data()}));
      } catch(e) { try { const s1b = await db.collection('boards').doc(proj.id).collection('invoices').get(); s1b.forEach(d => invoices.push({id:d.id,...d.data()})); } catch(e2){} }
      try {
        const s2 = await db.collection('boards').doc(proj.id).collection('proposals').get();
        s2.forEach(d => proposals.push({id:d.id,...d.data()}));
      } catch(e){}
      try {
        const s3 = await db.collection('boards').doc(proj.id).collection('purchaseOrders').get();
        s3.forEach(d => pos.push({id:d.id,...d.data()}));
      } catch(e){}
      try {
        const s4 = await db.collection('boards').doc(proj.id).collection('clips').get();
        s4.forEach(d => clips.push({id:d.id,...d.data()}));
      } catch(e){}

      // Load clip-derived invoices
      const seenInvNums = new Set(invoices.map(i => i.invoiceNum || i.number || ''));
      try {
        const invMap = {};
        clips.forEach(c => {
          const invNum = c.invoiceNum || c.houzzInvoice || '';
          if (invNum && !seenInvNums.has(invNum)) {
            if (!invMap[invNum]) invMap[invNum] = { id: 'clip-inv-' + invNum, invoiceNum: invNum, number: invNum, status: 'Invoiced', total: 0, items: [], payments: [], _fromClips: true };
            invMap[invNum].total += (c.totalSelling || c.clientPrice || 0);
            invMap[invNum].items.push(c);
          }
        });
        Object.values(invMap).forEach(inv => invoices.push(inv));
      } catch(e) {}

      invoices.forEach(inv => { if (inv.status === 'Estimated') inv.status = 'Invoiced'; });
      proposals.forEach(pr => { if (pr.status === 'Estimated') pr.status = 'Approved'; });

      // Load recent activity
      try {
        const actSnap = await db.collection('activity').where('projectId','==',proj.id).orderBy('createdAt','desc').limit(10).get();
        actSnap.forEach(d => activities.push({id:d.id,...d.data()}));
      } catch(e) {
        try {
          const actSnap2 = await db.collection('activity').limit(50).get();
          actSnap2.forEach(d => { const data = d.data(); if (data.projectId === proj.id) activities.push({id:d.id,...data}); });
          activities.sort((a,b) => (b.createdAt||'').localeCompare(a.createdAt||''));
          activities = activities.slice(0, 10);
        } catch(e2){}
      }

      // Financials
      const totalProposed = proposals.reduce((s,p) => s + (parseFloat(p.total)||0), 0);
      const totalInvoiced = invoices.reduce((s,i) => s + (parseFloat(i.total)||0), 0);
      const totalPOCost = pos.reduce((s,p) => s + (parseFloat(p.total)||0), 0);
      let totalPaid = 0;
      invoices.forEach(inv => {
        totalPaid += (inv.payments || []).reduce((s,p) => s + (parseFloat(p.amount)||0), 0);
        if (inv.status === 'Paid' && totalPaid === 0) totalPaid += parseFloat(inv.total) || 0;
      });
      const balance = totalInvoiced - totalPaid;
      const margin = totalInvoiced > 0 ? Math.round((1 - totalPOCost / totalInvoiced) * 100) : 0;

      // Group clips by room
      const byRoom = {};
      clips.forEach(c => {
        const room = c.room || c.category || 'General';
        if (!byRoom[room]) byRoom[room] = [];
        byRoom[room].push(c);
      });
      const rooms = Object.keys(byRoom).sort();

      // Pending POs
      const pendingPOs = pos.filter(p => !['Installed','Received','Cancelled'].includes(p.status));
      const overduePOs = pendingPOs.filter(p => {
        const eta = p.eta ? new Date(p.eta) : null;
        return eta && eta < new Date();
      });

      // Build connected doc chains
      const allDocs = [
        ...proposals.map(p => ({ type: 'proposal', icon: '📋', label: p.proposalNum || p.name || p.id.slice(0,8), id: p.id, collection: 'proposals', total: p.total, status: p.status, linked: { invoice: p.linkedInvoiceId, po: p.linkedPOId } })),
