      const unpaidInvoices = allInvoices.filter(i => i.status !== 'Paid' && (parseFloat(i.total || i.amount) || 0) > 0);
      const pendingPOs = allPOs.filter(po => !po.status || po.status === 'draft' || po.status === 'pending' || po.status === 'sent');
      const awaitingApproval = allProposals.filter(pr => pr.status === 'sent' || pr.status === 'pending' || pr.status === 'awaiting');
      const totalProposalValue = allProposals.reduce((s, pr) => s + (parseFloat(pr.total || pr.amount) || 0), 0);

      // ── Additional calculations for dashboard ──
      const now = new Date();
      const todayStr = now.getFullYear() + '-' + String(now.getMonth()+1).padStart(2,'0') + '-' + String(now.getDate()).padStart(2,'0');
      const weekStart = new Date(now); weekStart.setDate(weekStart.getDate() - weekStart.getDay());
      const weekStr = weekStart.toISOString().slice(0,10);

