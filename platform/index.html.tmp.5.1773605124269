    function corrTypeChanged() {
      var t = document.getElementById('corrType').value;
      var sg = document.getElementById('corrStatusGroup');
      if (sg) sg.style.display = (t === 'change_order' || t === 'approval') ? '' : 'none';
      var vg = document.getElementById('corrVendorGroup');
      var cg = document.getElementById('corrContactGroup');
      if (t === 'client_email' || t === 'text_message') {
        if (vg) vg.querySelector('.form-label').textContent = 'Client Name';
        if (cg) cg.querySelector('.form-label').textContent = 'Client Contact';
