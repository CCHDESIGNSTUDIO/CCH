        function renderTimeWeeklyView(container, filtered, admin) {
      // Determine which week to show
      const today = new Date();
      const weekStart = getWeekStart(timeFilter.dateFrom ? new Date(timeFilter.dateFrom) : today);
      const weekEnd = new Date(weekStart);
      weekEnd.setDate(weekEnd.getDate() + 6);

      const weekStartStr = dateStr(weekStart);
      const weekEndStr = dateStr(weekEnd);
      const weekLabel = weekStart.toLocaleDateString('en-US', {month:'short',day:'numeric'}) + ' – ' + weekEnd.toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'});

      // Filter to this week
      const weekEntries = filtered.filter(t => t.date >= weekStartStr && t.date <= weekEndStr);

      // Days of week
      const days = [];
      for (let i = 0; i < 7; i++) {
        const d = new Date(weekStart);
        d.setDate(d.getDate() + i);
        days.push({ date: dateStr(d), label: d.toLocaleDateString('en-US', {weekday:'short'}), dayNum: d.getDate() });
      }

      // Group by project
      const projects = [...new Set(weekEntries.map(t => t.project).filter(Boolean))].sort();
      const rows = projects.map(proj => {
        const projEntries = weekEntries.filter(t => t.project === proj);
        const dayCols = days.map(d => {
          const dayEntries = projEntries.filter(t => t.date === d.date);
          return { hours: dayEntries.reduce((s, t) => s + (parseFloat(t.hours) || 0), 0), total: dayEntries.reduce((s, t) => s + (parseFloat(t.total) || 0), 0), entries: dayEntries };
        });
        const weekHours = dayCols.reduce((s, c) => s + c.hours, 0);
        const weekTotal = dayCols.reduce((s, c) => s + c.total, 0);
        return { project: proj, days: dayCols, weekHours, weekTotal };
      });

      const dailyTotals = days.map((d, i) => rows.reduce((s, r) => s + r.days[i].hours, 0));
      const grandTotalHrs = rows.reduce((s, r) => s + r.weekHours, 0);
      const grandTotalDollars = rows.reduce((s, r) => s + r.weekTotal, 0);

      // Prev/next week nav
      const prevWeek = new Date(weekStart); prevWeek.setDate(prevWeek.getDate() - 7);
      const nextWeek = new Date(weekStart); nextWeek.setDate(nextWeek.getDate() + 7);

      container.innerHTML = `
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
          <button class="btn btn-secondary btn-sm" onclick="timeFilter.dateFrom='${dateStr(prevWeek)}';timeFilter.dateTo='${dateStr(new Date(prevWeek.getTime()+6*86400000))}';renderTimeView()">← Prev Week</button>
          <div style="font-weight:600;font-size:16px;">${weekLabel}</div>
          <button class="btn btn-secondary btn-sm" onclick="timeFilter.dateFrom='${dateStr(nextWeek)}';timeFilter.dateTo='${dateStr(new Date(nextWeek.getTime()+6*86400000))}';renderTimeView()">Next Week →</button>
        </div>
        <div class="card"><div class="table-wrap">
          <table class="data-table">
            <thead><tr>
              <th style="min-width:140px;">Project</th>
              ${days.map(d => `<th class="amount" style="min-width:60px;">${d.label}<br><span style="font-weight:400;font-size:11px;">${d.dayNum}</span></th>`).join('')}
              <th class="amount" style="min-width:70px;background:var(--gold-light);"><strong>Week</strong></th>
              ${admin ? '<th class="amount" style="min-width:80px;">$</th>' : ''}
            </tr></thead>
            <tbody>
              ${rows.map(r => `
                <tr>
                  <td><strong>${esc(r.project)}</strong></td>
                  ${r.days.map(d => `<td class="amount" style="cursor:${d.hours?'pointer':'default'};${d.hours?'color:var(--black);font-weight:500;':'color:var(--gray-300);'}" ${d.entries.length?`title="${d.entries.map(e=>esc(e.description||e.service)).join(', ')}"`:''}>
                    ${d.hours ? formatHours(d.hours) : '—'}
                  </td>`).join('')}
                  <td class="amount" style="background:var(--gold-light);font-weight:700;">${formatHours(r.weekHours)}</td>
                  ${admin ? `<td class="amount"><strong>${formatMoney(r.weekTotal)}</strong></td>` : ''}
                </tr>
              `).join('')}
              ${rows.length === 0 ? `<tr><td colspan="${admin ? 10 : 9}" style="text-align:center;padding:24px;color:var(--gray-400);">No entries this week</td></tr>` : ''}
            </tbody>
            <tfoot>
              <tr style="font-weight:700;background:var(--gray-50);">
                <td>TOTAL</td>
                ${dailyTotals.map(h => `<td class="amount">${h ? formatHours(h) : '—'}</td>`).join('')}
                <td class="amount" style="background:var(--gold-light);font-size:16px;color:var(--gold-dark);">${formatHours(grandTotalHrs)}</td>
                ${admin ? `<td class="amount" style="font-size:14px;color:var(--green);">${formatMoney(grandTotalDollars)}</td>` : ''}
              </tr>
            </tfoot>
          </table>
        </div></div>
      `;
