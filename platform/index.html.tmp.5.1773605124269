    window._tlListAssignToBucket = function() {
      var allIndices = [];
      window._tlListSelected.forEach(function(listIdx) {
        var row = document.querySelector('.tl-list-item[data-list-idx="' + listIdx + '"]');
        if (row) {
          try {
            var indices = JSON.parse(row.dataset.indices);
            indices.forEach(function(i) { if (allIndices.indexOf(i) < 0) allIndices.push(i); });
          } catch(e) {}
        }
      });

      if (allIndices.length === 0) return;

      // Sync to memory selection system and use existing bucket assignment
      window._tlSelectedMems = new Set();
      allIndices.forEach(function(capIdx) {
        window._tlSelectedMems.add(capIdx);
      });

      if (typeof window._tlAssignSelectedToBucket === 'function') {
        var tempSelected = new Set();
        window._tlListSelected.forEach(function(li) { tempSelected.add(li); });
        window._tlSelectedMems = tempSelected;
        window._tlAssignSelectedToBucket();
      } else {
        var caps = window._pendingCaptures || [];
        var totalMins = 0;
        var appNames = [];
        allIndices.forEach(function(idx) {
          var c = caps[idx];
          if (c) {
            totalMins += c.minutes;
            if (appNames.indexOf(c.app) < 0) appNames.push(c.app);
          }
        });

        if (!window._projectBuckets) window._projectBuckets = [];
        window._projectBuckets.push({
          project: 'Unassigned',
          description: '',
          items: allIndices,
          minutes: totalMins,
          comment: ''
        });

        showToast('Created bucket with ' + allIndices.length + ' captures (' + Math.round(totalMins / 60 * 10) / 10 + 'h)', 'success');
      }

      window._tlListSelected.clear();
      renderTimeView();
    }

    // ── List view drag-and-drop ──
    function _tlInitListDragDrop() {
      var items = document.querySelectorAll('.tl-list-item');
      items.forEach(function(item) {
        item.addEventListener('dragstart', function(e) {
          var indices = JSON.parse(item.dataset.indices);
          var app = item.dataset.app || '';
          // Send as {indices, app} object to match what _tlDropOnBucketArea expects
          e.dataTransfer.setData('text/plain', JSON.stringify({ indices: indices, app: app }));
          e.dataTransfer.effectAllowed = 'move';
          window._dragListIndices = indices;
          item.style.opacity = '0.5';
        });
        item.addEventListener('dragend', function(e) {
          item.style.opacity = '';
        });
      });
