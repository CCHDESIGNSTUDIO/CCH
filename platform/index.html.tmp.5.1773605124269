    async function showImageManager(projectId, projectName) {
      const modal = document.getElementById('modalContainer');
      modal.innerHTML = `
        <div class="modal-overlay" onclick="if(event.target===this)closeModal()">
          <div class="modal" style="width:900px;max-height:85vh;display:flex;flex-direction:column;">
            <div class="modal-header">
              <div class="modal-title">🖼️ Image Manager — ${esc(projectName || projectId)}</div>
              <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body" style="overflow-y:auto;padding:20px;" id="imgMgrBody">
              <div style="text-align:center;padding:40px;color:var(--gray-400);">Scanning images...</div>
            </div>
          </div>
        </div>`;
      modal.style.display = 'block';

      // Load all clips
      let clips = [];
      try {
        const snap = await db.collection('boards').doc(projectId).collection('clips').get();
        snap.forEach(d => clips.push({ id: d.id, ...d.data() }));
      } catch(e) { console.error('Image manager load error:', e); }

      if (clips.length === 0) {
        document.getElementById('imgMgrBody').innerHTML = '<div class="empty-state"><div class="empty-icon">📷</div><div class="empty-text">No clips found in this project.</div></div>';
        return;
      }

      // Categorize images
      const fbPattern = /firebasestorage\.googleapis\.com/;
      const results = clips.map(c => {
        const url = c.imageUrl || (c.images && c.images[0]) || '';
        const isFirebase = fbPattern.test(url);
        return { clip: c, url, isFirebase, status: url ? 'checking' : 'missing' };
      });

      // Render initial grid
      _imgMgrRender(results, projectId);

      // Check each image in parallel (batches of 8)
      const batchSize = 8;
      for (let i = 0; i < results.length; i += batchSize) {
        const batch = results.slice(i, i + batchSize);
        await Promise.all(batch.map(async (r) => {
          if (!r.url) { r.status = 'missing'; return; }
          if (r.isFirebase) { r.status = 'ok'; return; }
          try {
            const ok = await _imgTestLoad(r.url, 5000);
            r.status = ok ? 'external-ok' : 'broken';
          } catch(e) { r.status = 'broken'; }
        }));
        _imgMgrRender(results, projectId);
      }
    }

    function _imgTestLoad(url, timeout) {
      return new Promise((resolve) => {
        const img = new Image();
        const timer = setTimeout(() => { img.src = ''; resolve(false); }, timeout || 5000);
        img.onload = () => { clearTimeout(timer); resolve(true); };
        img.onerror = () => { clearTimeout(timer); resolve(false); };
        img.referrerPolicy = 'no-referrer';
        img.src = url;
      });
    }

    function _imgMgrRender(results, projectId) {
