      try {
        var ref = await db.collection('boards').doc(projectId).collection('proposals').add({
          name: _proNum,
          proposalNum: _proNum,
          items: items,
          total: total,
          status: 'Draft',
          createdAt: new Date().toISOString(),
          createdBy: _cUser,
          createdByEmail: (currentUser && currentUser.email) || '',
          activityLog: [{ action: 'created', details: items.length + ' items from product library', userName: _cUser, userEmail: (currentUser && currentUser.email) || '', timestamp: new Date().toISOString() }]
        });
        try { await db.collection('boards').doc(projectId).update({ proposalCount: firebase.firestore.FieldValue.increment(1) }); } catch(e){}
        closeModal();
        navigate('#/project/' + projectId + '/proposal/' + ref.id);
