    // Insert section above/below
    async function ibAddSectionAt(projectId, relativeSectionId, position) {
      var name = prompt('Section name:');
      if (!name) return;
      var snap = await db.collection('boards').doc(projectId).collection('ideabooks').get();
      var sections = [];
      snap.forEach(function(d) { sections.push({ id: d.id, order: d.data().order || 0 }); });
      sections.sort(function(a, b) { return a.order - b.order; });
      var relIdx = sections.findIndex(function(s) { return s.id === relativeSectionId; });
      var newOrder = 0;
      if (position === 'above') {
        newOrder = relIdx > 0 ? (sections[relIdx - 1].order + sections[relIdx].order) / 2 : sections[relIdx].order - 1;
      } else {
        newOrder = relIdx < sections.length - 1 ? (sections[relIdx].order + sections[relIdx + 1].order) / 2 : sections[relIdx].order + 1;
      }
      var docRef = await db.collection('boards').doc(projectId).collection('ideabooks').add({
        name: name.trim(), description: '', images: [], order: newOrder, createdAt: new Date().toISOString()
      });
      ibActiveSection = docRef.id;
      renderProjectDetail();
    }

