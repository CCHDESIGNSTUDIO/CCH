    // ── List view selection state ──
    window._tlListSelected = new Set();

    window._tlListItemClick = function(event, listIdx, indices) {
      var row = event.currentTarget;
      var cb = row.querySelector('.tl-list-check');
      if (window._tlListSelected.has(listIdx)) {
        window._tlListSelected.delete(listIdx);
        row.classList.remove('tl-list-selected');
        row.style.background = '';
        row.style.outline = '';
        if (cb) cb.checked = false;
      } else {
        window._tlListSelected.add(listIdx);
        row.classList.add('tl-list-selected');
        row.style.background = 'rgba(196,160,82,0.12)';
        row.style.outline = '1px solid rgba(196,160,82,0.3)';
        if (cb) cb.checked = true;
      }
      _tlListUpdateSelectionUI();
    }

    window._tlListUpdateSelection = function() {
      window._tlListSelected.clear();
      document.querySelectorAll('.tl-list-check:checked').forEach(function(cb) {
        window._tlListSelected.add(parseInt(cb.dataset.listIdx));
      });
      document.querySelectorAll('.tl-list-item').forEach(function(row) {
        var idx = parseInt(row.dataset.listIdx);
        if (window._tlListSelected.has(idx)) {
          row.classList.add('tl-list-selected');
          row.style.background = 'rgba(196,160,82,0.12)';
          row.style.outline = '1px solid rgba(196,160,82,0.3)';
        } else {
          row.classList.remove('tl-list-selected');
          row.style.background = '';
          row.style.outline = '';
        }
      });
      _tlListUpdateSelectionUI();
    }

    function _tlListUpdateSelectionUI() {
      var count = window._tlListSelected.size;
      var countEl = document.getElementById('tlListSelCount');
      var btn = document.getElementById('tlListFooterBtn');
      var hint = document.getElementById('tlListFooterHint');
      if (countEl) {
        countEl.innerHTML = count > 0 ? '<span style="background:var(--gold);color:white;padding:2px 8px;border-radius:0;font-size:10px;font-weight:700;">' + count + ' selected</span>' : '';
