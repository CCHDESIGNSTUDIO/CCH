    // ── Bucket persistence (localStorage) ──
    function _tlSaveBuckets() {
      // Save to both localStorage (instant) and Firestore (persistent)
      try {
        var serializable = {};
        Object.keys(window._dayBuckets).forEach(function(day) {
          serializable[day] = (window._dayBuckets[day] || []).map(function(b) {
            return { project: b.project, items: b.items, comment: b.comment || '', logged: !!b.logged, loggedId: b.loggedId || '', description: b.description || '' };
          });
        });
        localStorage.setItem('cch_tl_buckets', JSON.stringify(serializable));
      } catch(e) { console.warn('[TL] Failed to save buckets to localStorage:', e); }

      // Persist to Firestore — save each day's buckets as a document
      try {
        if (typeof db !== 'undefined' && currentUser && currentUser.email) {
          Object.keys(window._dayBuckets).forEach(function(day) {
            var dayBuckets = (window._dayBuckets[day] || []).map(function(b) {
              return { project: b.project || '', items: b.items || [], comment: b.comment || '', logged: !!b.logged, loggedId: b.loggedId || '', description: b.description || '' };
            });
            var docId = currentUser.email.replace(/[^a-zA-Z0-9]/g, '_') + '_' + day;
            db.collection('timeBuckets').doc(docId).set({
              email: currentUser.email,
              date: day,
              buckets: dayBuckets,
              updatedAt: firebase.firestore.FieldValue.serverTimestamp()
            }, { merge: true }).catch(function(e) { console.warn('[TL] Firestore bucket save error:', e); });
          });
        }
      } catch(e) { console.warn('[TL] Firestore bucket save error:', e); }
    }
    function _tlLoadBuckets() {
      // First load from localStorage for instant display
      try {
        var saved = localStorage.getItem('cch_tl_buckets');
        if (saved) {
          var parsed = JSON.parse(saved);
          Object.keys(parsed).forEach(function(day) {
            window._dayBuckets[day] = parsed[day];
          });
        }
      } catch(e) { console.warn('[TL] Failed to load buckets from localStorage:', e); }
    }
    // Load from Firestore — overwrites localStorage data with persistent data
    function _tlLoadBucketsFromFirestore() {
      try {
        if (typeof db !== 'undefined' && currentUser && currentUser.email) {
          db.collection('timeBuckets')
            .where('email', '==', currentUser.email)
            .orderBy('date', 'desc')
            .limit(90) // Keep 90 days of bucket history (like Timely)
            .get().then(function(snap) {
              snap.forEach(function(doc) {
                var data = doc.data();
                if (data.date && data.buckets) {
                  window._dayBuckets[data.date] = data.buckets;
                }
              });
              // Re-save to localStorage for next instant load
              try {
                var serializable = {};
                Object.keys(window._dayBuckets).forEach(function(day) {
                  serializable[day] = window._dayBuckets[day];
                });
                localStorage.setItem('cch_tl_buckets', JSON.stringify(serializable));
              } catch(e) {}
              console.log('[TL] Loaded buckets from Firestore:', Object.keys(window._dayBuckets).length, 'days');
              // Re-render if on timeline view
              if (typeof renderTimeView === 'function' && document.getElementById('tlBucketsList')) {
                var bl = document.getElementById('tlBucketsList');
                if (bl) bl.innerHTML = _tlRenderBucketsPanel();
                _tlRefreshGrid();
              }
            }).catch(function(e) { console.warn('[TL] Firestore bucket load error:', e); });
        }
      } catch(e) { console.warn('[TL] Firestore bucket load error:', e); }
