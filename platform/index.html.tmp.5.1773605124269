              <th style="padding:10px;text-align:left;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;cursor:pointer;user-select:none;" onclick="${vsClick('description')}">Description${vsa('description')}</th>
              <th style="padding:10px;text-align:left;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;cursor:pointer;user-select:none;" onclick="${vsClick('contact')}">Contact${vsa('contact')}</th>
              <th style="padding:10px;text-align:left;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;cursor:pointer;user-select:none;" onclick="${vsClick('email')}">Email${vsa('email')}</th>
              <th style="padding:10px;text-align:left;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;cursor:pointer;user-select:none;" onclick="${vsClick('phone')}">Phone${vsa('phone')}</th>
              <th style="padding:10px;text-align:left;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;cursor:pointer;user-select:none;" onclick="${vsClick('tags')}">Tags${vsa('tags')}</th>
              <th style="padding:10px;text-align:left;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;width:50px;">Edit</th>
            </tr></thead>
            <tbody>
              ${filtered.map(function(v) { return '<tr style="border-bottom:1px solid var(--gray-100);cursor:pointer;" onclick="navigate(\'#/vendors/' + encodeURIComponent(v.name) + '\')">' +
                '<td style="padding:10px;font-weight:600;font-size:14px;white-space:nowrap;">' + esc(v.name) + '</td>' +
