    async function addNewProposalItem(projectId, proposalId) {
      const doc = await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).get();
      const items = doc.data().items || [];
      const qty = parseFloat(document.getElementById('piQty').value) || 1;
      const cost = parseFloat(document.getElementById('piCost').value) || 0;
      const markupPct = parseFloat(document.getElementById('piMarkup').value) || 0;
      const shipping = parseFloat(document.getElementById('piShipping').value) || 0;
      const clientPrice = (cost * qty * (1 + markupPct / 100)) + shipping;
      items.push({
        title: document.getElementById('piTitle').value.trim(),
        category: document.getElementById('piCat').value.trim(),
        vendor: document.getElementById('piVendor').value.trim(),
        qty: qty,
        cost: cost,
        markupPct: markupPct,
        shipping: shipping,
        amount: clientPrice,
        imageUrl: document.getElementById('piImage').value.trim(),
        description: document.getElementById('piDesc').value.trim(),
        shipTo: (document.getElementById('piShipTo') || {}).value ? document.getElementById('piShipTo').value.trim() : ''
      });
      const total = items.reduce((s, i) => s + (parseFloat(i.amount) || 0), 0);
      await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).update({ items, total });
      logDocActivity(projectId, 'proposals', proposalId, 'item_added', 'Added: ' + (document.getElementById('piTitle').value.trim() || 'New item'));
      closeModal();
      renderProposalDetail(projectId, proposalId);
