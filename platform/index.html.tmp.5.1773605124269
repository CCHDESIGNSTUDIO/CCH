              invMap[invNum] = { id: 'clip-inv-' + invNum, invoiceNum: invNum, number: invNum,
                status: 'Invoiced', date: c.savedAt || '', createdAt: c.savedAt || '',
                total: 0, items: [], _fromClips: true, payments: [] };
