    async function renderFFETab(T, proj) {
      T.innerHTML = '<div style="text-align:center;padding:60px;color:var(--gray-400);">Loading FFE data...</div>';

      // Load all data in parallel
      let clips = [], pos = [], roomMeta = {}, projData = {};
      try {
        const [clipSnap, poSnap, rmSnap, projDoc] = await Promise.all([
          db.collection('boards').doc(proj.id).collection('clips').get(),
          db.collection('boards').doc(proj.id).collection('purchaseOrders').get(),
          db.collection('boards').doc(proj.id).collection('roomMeta').get(),
          db.collection('boards').doc(proj.id).get()
        ]);
        clipSnap.forEach(d => clips.push({ id: d.id, ...d.data() }));
        poSnap.forEach(d => pos.push({ id: d.id, ...d.data() }));
        rmSnap.forEach(d => { const data = d.data(); if (data.name) roomMeta[data.name] = data; });
        projData = projDoc.data() || {};
      } catch(e) { console.error('FFE load error:', e); }

      ffeRoomBudgets = projData.roomBudgets || {};
      const categoryBudgets = projData.categoryBudgets || {};

      // Enrich clips with PO data
      const poMap = {};
      pos.forEach(po => { if (po.number || po.num) poMap[po.number || po.num] = po; });
      clips.forEach(c => {
        if (c.poNum && poMap[c.poNum]) {
          const po = poMap[c.poNum];
          if (!c.orderStatus) c.orderStatus = po.status || '';
          if (!c.orderDate) c.orderDate = po.orderDate || po.issueDate || po.date || '';
        }
        // Default selection status
        if (!c.selectionStatus && !c.approvalStatus) c.selectionStatus = 'Proposed';
        else if (!c.selectionStatus) c.selectionStatus = c.approvalStatus;
      });

      // Apply filters and sort
      let filtered = ffeApplyFilters(clips);
      filtered = ffeApplySort(filtered);

      // Collect unique values for filters
      const allRooms = [...new Set(clips.map(c => c.room || 'Unassigned'))].sort();
      const allCategories = [...new Set(clips.map(c => c.category).filter(Boolean))].sort();
      const allVendors = [...new Set(clips.map(c => c.vendor).filter(Boolean))].sort();
      const selectionStatuses = ['Proposed', 'Approved', 'Ordered', 'Received', 'Installed', 'Returned'];
      const orderStatuses = ['', 'Ordered', 'Shipped', 'At Receiver', 'At Workroom', 'Received', 'Installed', 'Cancelled'];

      // Summary stats
      const totalCost = clips.reduce((s, c) => s + (parseFloat(c.cost) || 0) * (parseFloat(c.qty) || 1), 0);
      const totalSell = clips.reduce((s, c) => s + (parseFloat(c.totalSelling) || (parseFloat(c.clientPrice) || 0) * (parseFloat(c.qty) || 1)), 0);
      const totalProfit = totalSell - totalCost;
      const profitMargin = totalSell > 0 ? (totalProfit / totalSell * 100) : 0;

      // Status counts
      const statusCounts = {};
      selectionStatuses.forEach(s => statusCounts[s] = 0);
      clips.forEach(c => {
        const st = c.selectionStatus || c.approvalStatus || 'Proposed';
        if (statusCounts[st] !== undefined) statusCounts[st]++;
        else statusCounts[st] = 1;
      });

      // View sub-tabs
      const viewTabs = [
        { id: 'design', label: '🎨 Design View', desc: 'Selections & Curation' },
        { id: 'procurement', label: '📦 Procurement', desc: 'Operations & Tracking' },
        { id: 'client', label: '👤 Client View', desc: 'Client Presentation' },
        { id: 'reports', label: '📊 Reports', desc: 'Budget & Analysis' }
      ];

      // Active filter count
      const activeFilterCount = Object.values(ffeFilters).filter(v => v).length;

      // Build header + view tabs
      let html = `
        <div style="margin-bottom:20px;">
          <!-- Summary Bar -->
          <div style="display:flex;gap:0;margin-bottom:16px;border-radius:0;overflow:hidden;border:1px solid rgba(200,185,154,0.15);">
            <div style="flex:1;padding:14px 18px;background:linear-gradient(135deg,rgba(0,184,212,0.08),rgba(0,184,212,0.03));border-right:1px solid rgba(200,185,154,0.1);">
              <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--gray-400);margin-bottom:4px;">Selections</div>
              <div style="font-size:22px;font-weight:700;color:var(--cyan);font-family:var(--font-mono);">${clips.length}</div>
              <div style="font-size:10px;color:var(--gray-500);margin-top:2px;">${allRooms.length} rooms</div>
            </div>
            <div style="flex:1;padding:14px 18px;background:linear-gradient(135deg,rgba(200,185,154,0.08),rgba(200,185,154,0.03));border-right:1px solid rgba(200,185,154,0.1);">
              <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--gray-400);margin-bottom:4px;">Total Cost</div>
              <div style="font-size:22px;font-weight:700;color:var(--gold);font-family:var(--font-mono);">${formatMoney(totalCost)}</div>
              <div style="font-size:10px;color:var(--gray-500);margin-top:2px;">designer cost</div>
            </div>
            <div style="flex:1;padding:14px 18px;background:linear-gradient(135deg,rgba(95,165,107,0.08),rgba(95,165,107,0.03));border-right:1px solid rgba(200,185,154,0.1);">
              <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--gray-400);margin-bottom:4px;">Client Total</div>
              <div style="font-size:22px;font-weight:700;color:#5FA56B;font-family:var(--font-mono);">${formatMoney(totalSell)}</div>
              <div style="font-size:10px;color:var(--gray-500);margin-top:2px;">sell price</div>
            </div>
            <div style="flex:1;padding:14px 18px;background:linear-gradient(135deg,rgba(96,165,250,0.08),rgba(96,165,250,0.03));">
              <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--gray-400);margin-bottom:4px;">Product Profit</div>
              <div style="font-size:22px;font-weight:700;color:${totalProfit >= 0 ? '#60A5FA' : 'var(--red)'};font-family:var(--font-mono);">${formatMoney(totalProfit)}</div>
              <div style="font-size:10px;color:var(--gray-500);margin-top:2px;">${profitMargin.toFixed(1)}% margin</div>
            </div>
          </div>

          <!-- Status Pipeline -->
          <div style="display:flex;gap:2px;margin-bottom:16px;border-radius:0;overflow:hidden;">
            ${selectionStatuses.map(st => {
              const count = statusCounts[st] || 0;
              const pct = clips.length > 0 ? (count / clips.length * 100) : 0;
              const colors = { Proposed: '#6B7280', Approved: '#C8B99A', Ordered: '#00B8D4', Received: '#60A5FA', Installed: '#5FA56B', Returned: '#E16A5B' };
              const bgColor = colors[st] || '#6B7280';
              return '<div style="flex:' + Math.max(pct, 8) + ';padding:8px 6px;background:' + bgColor + '22;text-align:center;cursor:pointer;" onclick="ffeSetFilter(\'status\',\'' + (ffeFilters.status === st ? '' : st) + '\')" title="' + st + ': ' + count + ' items">' +
                '<div style="font-size:15px;font-weight:700;color:' + bgColor + ';">' + count + '</div>' +
                '<div style="font-size:9px;text-transform:uppercase;letter-spacing:0.5px;color:' + bgColor + ';opacity:0.8;">' + st + '</div>' +
              '</div>';
            }).join('')}
          </div>

          <!-- View Tabs -->
          <div style="display:flex;gap:0;margin-bottom:16px;border-radius:0;overflow:hidden;border:1px solid rgba(200,185,154,0.15);">
            ${viewTabs.map(vt => `
              <button onclick="ffeSetView('${vt.id}')" style="flex:1;padding:12px 16px;border:none;cursor:pointer;text-align:center;background:${ffeActiveView === vt.id ? 'linear-gradient(135deg,rgba(0,184,212,0.15),rgba(0,184,212,0.05))' : 'transparent'};border-right:1px solid rgba(200,185,154,0.1);transition:all 0.2s;">
                <div style="font-size:13px;font-weight:600;color:${ffeActiveView === vt.id ? 'var(--cyan)' : 'var(--gray-400)'};">${vt.label}</div>
                <div style="font-size:10px;color:var(--gray-500);margin-top:2px;">${vt.desc}</div>
              </button>
            `).join('')}
          </div>

          <!-- Filters -->
          <div style="display:flex;gap:8px;align-items:center;margin-bottom:16px;flex-wrap:wrap;">
            <select class="form-input" style="font-size:11px;padding:6px 10px;min-width:130px;" onchange="ffeSetFilter('room',this.value)">
              <option value="">All Rooms</option>
              ${allRooms.map(r => '<option value="' + escAttr(r) + '"' + (ffeFilters.room === r ? ' selected' : '') + '>' + esc(r) + '</option>').join('')}
            </select>
            <select class="form-input" style="font-size:11px;padding:6px 10px;min-width:130px;" onchange="ffeSetFilter('category',this.value)">
              <option value="">All Categories</option>
              ${allCategories.map(c => '<option value="' + escAttr(c) + '"' + (ffeFilters.category === c ? ' selected' : '') + '>' + esc(c) + '</option>').join('')}
            </select>
            <select class="form-input" style="font-size:11px;padding:6px 10px;min-width:130px;" onchange="ffeSetFilter('vendor',this.value)">
              <option value="">All Vendors</option>
              ${allVendors.map(v => '<option value="' + escAttr(v) + '"' + (ffeFilters.vendor === v ? ' selected' : '') + '>' + esc(v) + '</option>').join('')}
            </select>
            <select class="form-input" style="font-size:11px;padding:6px 10px;min-width:130px;" onchange="ffeSetFilter('status',this.value)">
              <option value="">All Statuses</option>
              ${selectionStatuses.map(s => '<option value="' + escAttr(s) + '"' + (ffeFilters.status === s ? ' selected' : '') + '>' + esc(s) + '</option>').join('')}
            </select>
            ${ffeActiveView === 'procurement' ? `
              <select class="form-input" style="font-size:11px;padding:6px 10px;min-width:130px;" onchange="ffeSetFilter('orderStatus',this.value)">
                <option value="">All Order Status</option>
                ${orderStatuses.filter(Boolean).map(s => '<option value="' + escAttr(s) + '"' + (ffeFilters.orderStatus === s ? ' selected' : '') + '>' + esc(s) + '</option>').join('')}
              </select>
            ` : ''}
            ${activeFilterCount > 0 ? '<button class="btn btn-secondary btn-sm" onclick="ffeClearFilters()" style="font-size:11px;padding:4px 10px;">✕ Clear (' + activeFilterCount + ')</button>' : ''}
            <div style="flex:1;"></div>
            <span style="font-size:12px;color:var(--gray-400);">${filtered.length}${filtered.length !== clips.length ? ' of ' + clips.length : ''} items</span>
          </div>
        </div>
      `;

      // Render active view
      if (ffeActiveView === 'design') {
        html += renderFFEDesignView(filtered, clips, proj, allRooms, roomMeta);
      } else if (ffeActiveView === 'procurement') {
        html += renderFFEProcurementView(filtered, clips, proj, pos);
      } else if (ffeActiveView === 'client') {
        html += renderFFEClientView(filtered, clips, proj, allRooms, roomMeta);
      } else if (ffeActiveView === 'reports') {
        html += renderFFEReportsView(clips, proj, allRooms, allCategories, allVendors, pos, ffeRoomBudgets, categoryBudgets);
      }

      T.innerHTML = html;
    }

    // ===== DESIGN VIEW — Card/Grid Selections Tracker =====
    function renderFFEDesignView(filtered, allClips, proj, allRooms, roomMeta) {
      const selectionStatuses = ['Proposed', 'Approved', 'Ordered', 'Received', 'Installed', 'Returned'];
      // Group by room
      const grouped = {};
      filtered.forEach(c => { const rm = c.room || 'Unassigned'; if (!grouped[rm]) grouped[rm] = []; grouped[rm].push(c); });
      const roomNames = Object.keys(grouped).sort();

      if (filtered.length === 0) {
        return '<div class="empty-state"><div class="empty-icon">🛋️</div><div class="empty-text">No selections match current filters.<br>Use CCH Clipper to add products, or import an FFE report.</div></div>';
      }

      let html = '';
      roomNames.forEach(rm => {
        const items = grouped[rm];
        const roomCost = items.reduce((s, c) => s + (parseFloat(c.cost) || 0) * (parseFloat(c.qty) || 1), 0);
        const roomSell = items.reduce((s, c) => s + (parseFloat(c.totalSelling) || (parseFloat(c.clientPrice) || 0) * (parseFloat(c.qty) || 1)), 0);
        const budget = ffeRoomBudgets[rm] || 0;
        const overBudget = budget > 0 && roomSell > budget;
        const coverImg = (roomMeta[rm] && roomMeta[rm].coverImage) || '';

        html += `
          <div style="margin-bottom:28px;">
            <div style="display:flex;align-items:center;gap:16px;margin-bottom:14px;padding-bottom:10px;border-bottom:2px solid ${overBudget ? 'var(--red)' : 'var(--gold)'};">
              ${coverImg ? '<img src="' + escAttr(coverImg) + '" style="width:48px;height:48px;border-radius:0;object-fit:cover;" referrerpolicy="no-referrer" onerror="this.style.display=\'none\'">' : ''}
              <div style="flex:1;">
                <div style="font-size:16px;font-weight:600;font-family:var(--font-display);letter-spacing:0.5px;">${esc(rm)}</div>
                <div style="font-size:11px;color:var(--gray-400);">${items.length} items · Cost: ${formatMoney(roomCost)} · Sell: ${formatMoney(roomSell)}${budget > 0 ? ' · Budget: ' + formatMoney(budget) : ''}</div>
              </div>
              ${overBudget ? '<span style="font-size:11px;padding:4px 10px;background:var(--red-light);color:var(--red);border-radius:0;font-weight:600;">⚠ Over Budget by ' + formatMoney(roomSell - budget) + '</span>' : ''}
              ${budget > 0 && !overBudget ? '<span style="font-size:11px;padding:4px 10px;background:var(--green-light);color:var(--green);border-radius:0;font-weight:600;">✓ ' + formatMoney(budget - roomSell) + ' remaining</span>' : ''}
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;">
              ${items.map(clip => {
                const imgSrc = clip.imageUrl || (clip.images && clip.images[0]) || '';
                const cost = parseFloat(clip.cost) || 0;
                const sell = parseFloat(clip.clientPrice) || 0;
                const qty = parseFloat(clip.qty) || 1;
                const markup = cost > 0 ? Math.round((sell - cost) / cost * 100) : 0;
                const status = clip.selectionStatus || clip.approvalStatus || 'Proposed';
                const statusColors = { Proposed: '#6B7280', Approved: '#C8B99A', Ordered: '#00B8D4', Received: '#60A5FA', Installed: '#5FA56B', Returned: '#E16A5B' };
                const stColor = statusColors[status] || '#6B7280';

                return `
                  <div class="card" style="padding:0;overflow:hidden;cursor:pointer;border:1px solid rgba(255,255,255,0.06);transition:border-color 0.2s,transform 0.2s;" onmouseenter="this.style.borderColor='var(--cyan)';this.style.transform='translateY(-2px)'" onmouseleave="this.style.borderColor='rgba(255,255,255,0.06)';this.style.transform='none'" onclick="showClipDetail('${escAttr(proj.id)}','${escAttr(clip.id)}')">
                    <div style="height:180px;background:var(--gray-50);position:relative;overflow:hidden;">
                      ${imgSrc ? '<img src="' + escAttr(imgSrc) + '" style="width:100%;height:100%;object-fit:cover;" referrerpolicy="no-referrer" onerror="this.outerHTML=\'<div style=display:flex;align-items:center;justify-content:center;height:100%;color:var(--gray-300);font-size:48px;>🛋️</div>\'">' : '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--gray-300);font-size:48px;">🛋️</div>'}
                      <div style="position:absolute;top:8px;right:8px;" onclick="event.stopPropagation()">
                        <select style="font-size:10px;padding:3px 6px;border-radius:0;border:none;background:${stColor}33;color:${stColor};font-weight:600;cursor:pointer;appearance:none;-webkit-appearance:none;text-align:center;min-width:80px;" onchange="ffeUpdateSelectionStatus('${escAttr(proj.id)}','${escAttr(clip.id)}',this.value)">
                          ${selectionStatuses.map(s => '<option value="' + s + '"' + (status === s ? ' selected' : '') + '>' + s + '</option>').join('')}
                        </select>
                      </div>
                      ${clip.poNum ? '<div style="position:absolute;bottom:8px;left:8px;font-size:10px;padding:2px 8px;background:rgba(0,184,212,0.9);color:#fff;border-radius:0;font-weight:600;">PO: ' + esc(clip.poNum) + '</div>' : ''}
                    </div>
                    <div style="padding:12px;">
                      <div style="font-size:13px;font-weight:600;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="${escAttr(clip.title || 'Untitled')}">${esc(clip.title || 'Untitled')}</div>
                      <div style="font-size:11px;color:var(--gray-400);margin-bottom:8px;">${esc(clip.vendor || '')}${clip.category ? ' · ' + esc(clip.category) : ''}</div>
                      <div style="display:flex;justify-content:space-between;align-items:center;">
                        <div>
                          <span style="font-size:14px;font-weight:700;color:var(--green);font-family:var(--font-mono);">${sell > 0 ? formatMoney(sell) : '-'}</span>
                          ${qty > 1 ? '<span style="font-size:10px;color:var(--gray-400);margin-left:4px;">×' + qty + '</span>' : ''}
                        </div>
                        <div style="font-size:11px;color:${markup > 0 ? 'var(--green)' : 'var(--gray-400)'};">${markup > 0 ? markup + '% markup' : ''}</div>
                      </div>
                      ${cost > 0 ? '<div style="font-size:10px;color:var(--gray-500);margin-top:2px;">Cost: ' + formatMoney(cost) + (qty > 1 ? ' × ' + qty + ' = ' + formatMoney(cost * qty) : '') + '</div>' : ''}
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      });

      return html;
    }

    // ===== PROCUREMENT VIEW — Operations Table =====
    function renderFFEProcurementView(filtered, allClips, proj, pos) {
      if (filtered.length === 0) {
        return '<div class="empty-state"><div class="empty-icon">📦</div><div class="empty-text">No items match current filters.</div></div>';
