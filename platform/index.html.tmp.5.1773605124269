    // ==================== ACTIVITY FEED ====================
    // Firestore collection: activity/{docId}
    // Fields: type, action, description, projectId, projectName, docId, user, timestamp, meta

    let activityCache = [];
    let activityFilter = { type: '', project: '', dateFrom: '', dateTo: '' };
    let activityLimit = 50;

    async function logActivity(type, action, description, projectId, projectName, meta) {
      try {
        await db.collection('activity').add({
          type: type,           // invoice, proposal, po, clip, time, email, note, milestone, project
          action: action,       // created, updated, deleted, published, approved, sent, completed
          description: description,
          projectId: projectId || '',
          projectName: projectName || '',
          user: currentUser ? currentUser.email : 'system',
          timestamp: new Date().toISOString(),
          meta: meta || {}
        });
      } catch(e) { console.warn('Activity log failed:', e.message); }
    }

    async function renderActivityFeed() {
      setBreadcrumb([{ label: 'Activity Feed' }]);
      setTopbarActions('<button class="btn btn-primary btn-sm" onclick="showNewNoteModal()">+ Add Note</button>');

      var C = document.getElementById('contentArea');
      C.innerHTML = '<div style="text-align:center;padding:60px;color:var(--gray-400);">Loading activity...</div>';

      try {
        var snap = await db.collection('activity').orderBy('timestamp', 'desc').limit(activityLimit).get();
        activityCache = [];
        snap.forEach(function(d) { activityCache.push({ id: d.id, ...d.data() }); });
      } catch(e) {
        // If index not ready, fallback to unordered
        try {
          var snap2 = await db.collection('activity').limit(activityLimit).get();
          activityCache = [];
          snap2.forEach(function(d) { activityCache.push({ id: d.id, ...d.data() }); });
          activityCache.sort(function(a, b) { return (b.timestamp || '').localeCompare(a.timestamp || ''); });
        } catch(e2) { activityCache = []; }
      }

      renderActivityView();
    }

    function getFilteredActivity() {
      return activityCache.filter(function(a) {
        if (activityFilter.type && a.type !== activityFilter.type) return false;
        if (activityFilter.project && a.projectId !== activityFilter.project) return false;
        if (activityFilter.dateFrom && (a.timestamp || '') < activityFilter.dateFrom) return false;
        if (activityFilter.dateTo && (a.timestamp || '') > activityFilter.dateTo + 'T23:59:59') return false;
        return true;
      });
    }

    function renderActivityView() {
      var C = document.getElementById('contentArea');
      var filtered = getFilteredActivity();

      // Get unique projects and types for filters
      var allProjects = [];
      var projMap = {};
      activityCache.forEach(function(a) {
        if (a.projectId && !projMap[a.projectId]) {
          projMap[a.projectId] = true;
          allProjects.push({ id: a.projectId, name: a.projectName || a.projectId });
        }
      });
      allProjects.sort(function(a, b) { return (a.name || '').localeCompare(b.name || ''); });

      var typeButtons = ['all', 'invoice', 'proposal', 'po', 'clip', 'time', 'email', 'note', 'milestone', 'project'];
      var typeLabels = { all:'All', invoice:'Invoices', proposal:'Proposals', po:'POs', clip:'Clips', time:'Time', email:'Email', note:'Notes', milestone:'Milestones', project:'Projects' };

      // Group by day
      var byDay = {};
      filtered.forEach(function(a) {
        var day = (a.timestamp || '').slice(0, 10);
        if (!day) day = 'Unknown';
        if (!byDay[day]) byDay[day] = [];
        byDay[day].push(a);
      });
      var dayKeys = Object.keys(byDay).sort().reverse();

      var todayStr = new Date().toISOString().slice(0, 10);
      var yesterdayStr = new Date(Date.now() - 86400000).toISOString().slice(0, 10);

      function dayLabel(d) {
        if (d === todayStr) return 'Today';
        if (d === yesterdayStr) return 'Yesterday';
        if (d === 'Unknown') return 'Unknown Date';
        try { return new Date(d + 'T12:00:00').toLocaleDateString('en-US', { weekday:'long', month:'long', day:'numeric' }); }
        catch(e) { return d; }
      }

      C.innerHTML =
        '<div class="page-header">' +
          '<div class="page-title">Activity Feed</div>' +
          '<div class="page-subtitle">' + filtered.length + ' event' + (filtered.length !== 1 ? 's' : '') + (activityFilter.type || activityFilter.project ? ' (filtered)' : '') + '</div>' +
        '</div>' +

        // Stats row
        '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px;">' +
          '<div class="card card-body" style="text-align:center;">' +
            '<div style="font-size:24px;font-weight:700;color:var(--gold);">' + activityCache.length + '</div>' +
            '<div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;">Total Events</div>' +
          '</div>' +
          '<div class="card card-body" style="text-align:center;">' +
            '<div style="font-size:24px;font-weight:700;color:var(--green);">' + activityCache.filter(function(a){ return (a.timestamp||'').slice(0,10) === todayStr; }).length + '</div>' +
            '<div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;">Today</div>' +
          '</div>' +
          '<div class="card card-body" style="text-align:center;">' +
            '<div style="font-size:24px;font-weight:700;">' + Object.keys(projMap).length + '</div>' +
            '<div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;">Active Projects</div>' +
          '</div>' +
          '<div class="card card-body" style="text-align:center;">' +
            '<div style="font-size:24px;font-weight:700;">' + activityCache.filter(function(a){ return a.type === 'note'; }).length + '</div>' +
            '<div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;">Notes</div>' +
          '</div>' +
        '</div>' +

        // Type filter pills
        '<div class="af-filters">' +
          typeButtons.map(function(t) {
            var isActive = (t === 'all' && !activityFilter.type) || activityFilter.type === t;
            return '<button class="af-filter-btn' + (isActive ? ' active' : '') + '" onclick="activityFilter.type=\'' + (t === 'all' ? '' : t) + '\';renderActivityView()">' + typeLabels[t] + '</button>';
          }).join('') +
        '</div>' +

        // Project + date filters
        '<div style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;">' +
          '<select class="form-input" style="width:200px;" onchange="activityFilter.project=this.value;renderActivityView()">' +
            '<option value="">All Projects</option>' +
            allProjects.map(function(p) {
              return '<option value="' + escAttr(p.id) + '"' + (activityFilter.project === p.id ? ' selected' : '') + '>' + esc(p.name) + '</option>';
            }).join('') +
          '</select>' +
          '<input type="date" class="form-input" style="width:150px;" value="' + (activityFilter.dateFrom || '') + '" onchange="activityFilter.dateFrom=this.value;renderActivityView()" placeholder="From">' +
          '<input type="date" class="form-input" style="width:150px;" value="' + (activityFilter.dateTo || '') + '" onchange="activityFilter.dateTo=this.value;renderActivityView()" placeholder="To">' +
          (activityFilter.type || activityFilter.project || activityFilter.dateFrom || activityFilter.dateTo ?
            '<button class="btn btn-sm" onclick="activityFilter={type:\'\',project:\'\',dateFrom:\'\',dateTo:\'\'};renderActivityView()">Clear Filters</button>' : '') +
        '</div>' +

        // Timeline
        '<div class="af-timeline" id="activityTimeline">' +
          (filtered.length === 0 ?
            '<div class="empty-state" style="padding:40px;text-align:center;"><div class="empty-icon">📋</div><div class="empty-text">No activity yet</div><div style="font-size:13px;color:var(--gray-400);margin-top:8px;">Activity will appear here as you work on projects</div></div>' :
            dayKeys.map(function(day) {
              return '<div class="af-day-header">' + dayLabel(day) + '</div>' +
                byDay[day].map(function(a) { return renderActivityItem(a); }).join('');
            }).join('')) +
        '</div>' +

        (filtered.length >= activityLimit ?
          '<div style="text-align:center;padding:20px;"><button class="btn btn-secondary" onclick="activityLimit+=50;renderActivityFeed()">Load More</button></div>' : '');
    }

    function renderActivityItem(a) {
