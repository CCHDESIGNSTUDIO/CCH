    // ---- MONTHLY VIEW ----
    function renderTimeMonthlyView(container, filtered, admin) {
      const today = new Date();
      let viewMonth = today.getMonth();
      let viewYear = today.getFullYear();
      if (timeFilter.dateFrom) {
        const d = new Date(timeFilter.dateFrom);
        viewMonth = d.getMonth();
        viewYear = d.getFullYear();
      }

      const monthStart = new Date(viewYear, viewMonth, 1);
      const monthEnd = new Date(viewYear, viewMonth + 1, 0);
      const monthStartStr = dateStr(monthStart);
      const monthEndStr = dateStr(monthEnd);
      const monthLabel = monthStart.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

      const monthEntries = filtered.filter(t => t.date >= monthStartStr && t.date <= monthEndStr);

      // Group into weeks
      const weeks = [];
      let ws = getWeekStart(monthStart);
      while (ws <= monthEnd) {
        const we = new Date(ws);
        we.setDate(we.getDate() + 6);
        const wsStr = dateStr(ws);
        const weStr = dateStr(we);
        const weekEnts = monthEntries.filter(t => t.date >= wsStr && t.date <= weStr);
        const hrs = weekEnts.reduce((s, t) => s + (parseFloat(t.hours) || 0), 0);
        const total = weekEnts.reduce((s, t) => s + (parseFloat(t.total) || 0), 0);
        weeks.push({
          label: ws.toLocaleDateString('en-US', {month:'short',day:'numeric'}) + ' – ' + we.toLocaleDateString('en-US', {month:'short',day:'numeric'}),
          startStr: wsStr,
          endStr: weStr,
          entries: weekEnts,
          hours: hrs,
          total: total
        });
        ws = new Date(ws);
        ws.setDate(ws.getDate() + 7);
      }

      // Group by project for month
      const projects = [...new Set(monthEntries.map(t => t.project).filter(Boolean))].sort();
      const projSummary = projects.map(proj => {
        const pEnts = monthEntries.filter(t => t.project === proj);
        return {
          project: proj,
          hours: pEnts.reduce((s, t) => s + (parseFloat(t.hours) || 0), 0),
          total: pEnts.reduce((s, t) => s + (parseFloat(t.total) || 0), 0),
          entries: pEnts.length,
          billable: pEnts.filter(t => t.billable).reduce((s, t) => s + (parseFloat(t.total) || 0), 0)
        };
      });

      const grandHrs = monthEntries.reduce((s, t) => s + (parseFloat(t.hours) || 0), 0);
      const grandTotal = monthEntries.reduce((s, t) => s + (parseFloat(t.total) || 0), 0);

      const prevMonth = new Date(viewYear, viewMonth - 1, 1);
      const nextMonth = new Date(viewYear, viewMonth + 1, 1);

      container.innerHTML = `
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
          <button class="btn btn-secondary btn-sm" onclick="timeFilter.dateFrom='${dateStr(prevMonth)}';timeFilter.dateTo='';renderTimeView()">← ${prevMonth.toLocaleDateString('en-US',{month:'short'})}</button>
          <div style="font-weight:600;font-size:16px;">${monthLabel}</div>
          <button class="btn btn-secondary btn-sm" onclick="timeFilter.dateFrom='${dateStr(nextMonth)}';timeFilter.dateTo='';renderTimeView()">${nextMonth.toLocaleDateString('en-US',{month:'short'})} →</button>
        </div>

        <div style="display:grid;grid-template-columns:${admin ? 'repeat(3,1fr)' : 'repeat(2,1fr)'};gap:16px;margin-bottom:24px;">
          <div class="card card-body" style="text-align:center;">
            <div style="font-size:28px;font-weight:700;color:var(--gold);">${grandHrs.toFixed(1)}</div>
            <div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;">Hours This Month</div>
          </div>
          <div class="card card-body" style="text-align:center;">
            <div style="font-size:28px;font-weight:700;">${monthEntries.length}</div>
            <div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;">Entries</div>
          </div>
          ${admin ? `<div class="card card-body" style="text-align:center;">
            <div style="font-size:28px;font-weight:700;color:var(--green);">${formatMoney(grandTotal)}</div>
            <div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;">Total Value</div>
          </div>` : ''}
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
          <div>
            <div class="section-title">Weekly Breakdown</div>
            <div class="card"><div class="table-wrap">
              <table class="data-table">
                <thead><tr><th>Week</th><th class="amount">Hours</th>${admin?'<th class="amount">Value</th>':''}<th class="amount">Entries</th></tr></thead>
                <tbody>
                  ${weeks.map(w => `
                    <tr style="cursor:pointer;" onclick="timeFilter.dateFrom='${w.startStr}';timeFilter.dateTo='${w.endStr}';timeViewMode='weekly';renderTimeView()">
                      <td style="font-size:12px;">${w.label}</td>
                      <td class="amount" style="font-weight:600;">${formatHours(w.hours)}</td>
                      ${admin?`<td class="amount">${formatMoney(w.total)}</td>`:''}
                      <td class="amount">${w.entries.length}</td>
                    </tr>
