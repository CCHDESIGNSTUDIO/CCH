    // Inline image upload from product detail — supports multiple images
    window._pdUploadImage = async function(file, productId) {
      if (!file) return;
      try {
        var ext = (file.name.split('.').pop() || 'jpeg').toLowerCase();
        // Use images/ path (deployed and working) instead of products/ path
        var storagePath = 'images/products/' + productId + '/' + Date.now() + '.' + ext;
        var ref = firebase.storage().ref(storagePath);
        await ref.put(file, { contentType: file.type || 'image/' + ext });
        var downloadUrl = await ref.getDownloadURL();
        // Add to images array AND set as primary imageUrl
        var prod = libraryProducts.find(function(x) { return x.id === productId; });
        var existingImages = (prod && prod.images) ? prod.images.slice() : [];
        if (prod && prod.imageUrl && existingImages.indexOf(prod.imageUrl) < 0) {
          existingImages.unshift(prod.imageUrl); // preserve existing primary
        }
        if (existingImages.indexOf(downloadUrl) < 0) existingImages.push(downloadUrl);
        await db.collection('products').doc(productId).update({
          imageUrl: downloadUrl,
          images: existingImages,
          updatedAt: new Date().toISOString()
        });
        // Update local cache
        if (prod) { prod.imageUrl = downloadUrl; prod.images = existingImages; }
        // Refresh the detail modal to show updated images
        showProductDetail(productId);
      } catch(e) { alert('Image upload failed: ' + e.message); }
    };

