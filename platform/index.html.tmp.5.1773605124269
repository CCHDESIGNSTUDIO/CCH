    async function bulkMarkQBSynced(collection) {
      if (!confirm('This will mark ALL ' + collection + ' that have a matching QB record as synced (green). Proceed?')) return;
      await loadFinancialData();
      var items = collection === 'purchaseOrders' ? _cachedPOs : _cachedInvoices;
      var updated = 0;
      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        if (item.number && !item.qbDocId) {
          await db.collection('boards').doc(item.projectId).collection(collection).doc(item.id).update({ qbDocId: item.number });
          updated++;
        }
      }
      alert('Updated ' + updated + ' records. POs/Invoices with matching numbers now show as synced.');
      _cacheTime = 0; invalidateSearchCache();
      navigate(window.location.hash);
    }

    // ==================== QB PUSH (Cloud Function) ====================
    async function pushDocToQB(docType, projectId, docId) {
      const typeLabel = docType === 'invoice' ? 'Invoice' : 'Purchase Order';
      let sendEmail = false;

      if (docType === 'invoice') {
        const choice = confirm('Push this Invoice to QuickBooks and email the client a payment request?\n\nOK = Push + Email\nCancel = Don\'t push');
        if (!choice) return;
        sendEmail = true;
      } else {
        if (!confirm('Push this PO to QuickBooks?')) return;
      }

      // Show progress
      const btn = event.target.closest('button');
      const origText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '⏳ Pushing to QB...';
      btn.style.opacity = '0.7';

      try {
        // Check if firebase.functions is available
        if (typeof firebase === 'undefined' || !firebase.functions) {
          throw new Error('Firebase Functions SDK not loaded. Add the functions SDK script tag.');
        }

        const fnName = docType === 'invoice' ? 'pushInvoiceToQB' : 'pushPOToQB';
        const pushFn = firebase.functions().httpsCallable(fnName);
        const result = await pushFn({ projectId, docId, sendEmail: sendEmail });

        if (result.data.success) {
          // Update button to show success
          btn.innerHTML = '✅ QB Synced';
          btn.style.background = '#2E7D32';
          btn.style.cursor = 'default';

          const msg = result.data.message === 'Already synced to QB' ?
            'Already synced to QB (Doc ID: ' + result.data.qbDocId + ')' :
            'Pushed to QuickBooks!\n\nQB Doc ID: ' + result.data.qbDocId +
            (result.data.emailSent ? '\n✉️ Payment request emailed to client.' : '');
          alert(msg);

          // Refresh to show green badge
          _cacheTime = 0;
          const hash = window.location.hash;
          navigate(hash);
        }
      } catch(err) {
        btn.innerHTML = origText;
        btn.disabled = false;
        btn.style.opacity = '1';

        let errMsg = err.message || 'Unknown error';
        if (errMsg.includes('not-found') || errMsg.includes('not found')) {
          errMsg = 'Cloud Function not deployed yet.\n\nDeploy with: firebase deploy --only functions\n\nSee QB setup guide for details.';
        } else if (errMsg.includes('unauthenticated')) {
          errMsg = 'You need to be signed in to push to QB.';
        } else if (errMsg.includes('failed-precondition')) {
          errMsg = 'QuickBooks not connected yet.\n\nAdd your refresh token to Firestore:\nadmin/qb → refreshToken field';
        }
        alert('QB Push Error:\n' + errMsg);
      }
    }

