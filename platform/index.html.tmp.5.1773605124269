    window._tlListSelectAll = function() {
      var items = document.querySelectorAll('.tl-list-item');
      var allSelected = window._tlListSelected.size > 0 && window._tlListSelected.size >= items.length;
      if (allSelected) {
        window._tlListSelected.clear();
        items.forEach(function(row) {
          row.classList.remove('tl-list-selected');
          row.style.background = ''; row.style.outline = '';
          var cb = row.querySelector('.tl-list-check');
          if (cb) cb.checked = false;
        });
      } else {
        items.forEach(function(row) {
          var idx = parseInt(row.dataset.listIdx);
          if (!isNaN(idx) && parseFloat(row.style.opacity) !== 0.3) {
            window._tlListSelected.add(idx);
