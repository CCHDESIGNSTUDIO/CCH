    // ==================== DOCUMENT ACTIVITY TIMELINE ====================
    async function logDocActivity(projectId, collection, docId, action, details) {
      try {
        const userName = (currentUser && currentUser.displayName) || (currentUser && currentUser.email) || 'Unknown';
        const userEmail = (currentUser && currentUser.email) || '';
        const entry = {
          action: action,
          details: details || '',
          userName: userName,
          userEmail: userEmail,
          timestamp: new Date().toISOString()
        };
        await db.collection('boards').doc(projectId).collection(collection).doc(docId).update({
          activityLog: firebase.firestore.FieldValue.arrayUnion(entry),
          lastEditedBy: userName,
          lastEditedByEmail: userEmail,
          lastEditedAt: new Date().toISOString()
        });
      } catch(e) { console.warn('Activity log failed:', e); }
    }

    function getActivityIcon(action) {
      var icons = {
        'created': '🆕', 'edited': '✏️', 'item_added': '➕', 'item_removed': '🗑️',
        'item_edited': '✏️', 'status_changed': '🔄', 'published': '📤', 'unpublished': '📥',
        'sent': '📧', 'viewed': '👁️', 'payment_recorded': '💰', 'paid': '✅',
        'qb_synced': '📗', 'qb_payment': '💳', 'attachment_added': '📎',
        'attachment_removed': '📎', 'image_uploaded': '📷', 'converted': '🔀',
        'po_generated': '📦', 'deleted': '🗑️', 'saved': '💾',
        'created_from_proposal': '📋', 'reminder_sent': '🔔'
      };
      return icons[action] || '📝';
    }

    function getActivityLabel(action) {
      var labels = {
        'created': 'Created', 'edited': 'Edited', 'item_added': 'Item Added',
        'item_removed': 'Item Removed', 'item_edited': 'Item Edited',
        'status_changed': 'Status Changed', 'published': 'Published to Client',
        'unpublished': 'Unpublished', 'sent': 'Sent to Client', 'viewed': 'Viewed by Client',
        'payment_recorded': 'Payment Recorded', 'paid': 'Marked as Paid',
        'qb_synced': 'QB Synced', 'qb_payment': 'QB Payment Confirmed',
        'attachment_added': 'Attachment Added', 'attachment_removed': 'Attachment Removed',
        'image_uploaded': 'Image Uploaded', 'converted': 'Converted',
        'po_generated': 'POs Generated', 'deleted': 'Deleted', 'saved': 'Saved',
        'created_from_proposal': 'Created from Proposal', 'reminder_sent': 'Reminder Sent'
      };
      return labels[action] || action;
    }

    function renderDocTimeline(activityLog, createdAt, createdBy) {
      var entries = (activityLog || []).slice().sort(function(a, b) {
        return new Date(b.timestamp) - new Date(a.timestamp);
      });
      // Always show creation as first event if not in log
      var hasCreate = entries.some(function(e) { return e.action === 'created'; });
      if (!hasCreate && createdAt) {
        entries.push({
          action: 'created', details: '', timestamp: createdAt,
          userName: createdBy || 'System', userEmail: ''
        });
      }

      if (entries.length === 0) {
        return '<div style="font-size:12px;color:var(--gray-400);font-style:italic;padding:12px;">No activity recorded yet</div>';
      }

      var html = '';
      entries.forEach(function(entry, idx) {
        var icon = getActivityIcon(entry.action);
        var label = getActivityLabel(entry.action);
        var ts = entry.timestamp ? new Date(entry.timestamp) : null;
        var dateStr = ts ? ts.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
        var timeStr = ts ? ts.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }) : '';
        var user = entry.userName || entry.userEmail || '';
        // Shorten email to first name
        if (user.indexOf('@') >= 0) user = user.split('@')[0];
        var isLast = idx === entries.length - 1;

        html += '<div style="display:flex;gap:12px;position:relative;">' +
          '<div style="display:flex;flex-direction:column;align-items:center;min-width:24px;">' +
            '<div style="width:28px;height:28px;border-radius:50%;background:var(--gray-50);display:flex;align-items:center;justify-content:center;font-size:13px;border:2px solid ' + (idx === 0 ? 'var(--cyan)' : 'var(--gray-200)') + ';z-index:1;">' + icon + '</div>' +
            (isLast ? '' : '<div style="width:2px;flex:1;background:var(--gray-200);margin:2px 0;"></div>') +
          '</div>' +
          '<div style="flex:1;padding-bottom:' + (isLast ? '0' : '16') + 'px;">' +
            '<div style="font-size:12px;font-weight:600;color:' + (idx === 0 ? 'var(--cyan)' : 'var(--gray-600)') + ';">' + label + '</div>' +
            (entry.details ? '<div style="font-size:11px;color:var(--gray-500);margin-top:2px;">' + esc(entry.details) + '</div>' : '') +
            '<div style="font-size:10px;color:var(--gray-400);margin-top:3px;">' +
              (user ? '<span style="font-weight:500;">' + esc(user) + '</span> · ' : '') +
              dateStr + (timeStr ? ', ' + timeStr : '') +
            '</div>' +
          '</div>' +
        '</div>';
      });
      return html;
    }

