        <div class="card" style="padding:0;overflow:hidden;">
          <div class="table-wrap" style="overflow-x:auto;">
            <table class="data-table" style="width:100%;font-size:12px;min-width:1100px;">
              <thead>
                <tr style="background:var(--gray-50);">
                  <th style="width:36px;padding:8px 4px;"></th>
                  ${sortHdr('title', 'Item')}
                  ${sortHdr('vendor', 'Vendor')}
                  ${sortHdr('room', 'Room')}
                  ${sortHdr('category', 'Category')}
                  ${sortHdr('cost', 'Cost')}
                  ${sortHdr('clientPrice', 'Sell')}
                  <th style="font-size:11px;padding:8px 6px;">PO #</th>
                  <th style="font-size:11px;padding:8px 6px;min-width:100px;">Selection</th>
                  <th style="font-size:11px;padding:8px 6px;min-width:100px;">Order Status</th>
                  <th style="font-size:11px;padding:8px 6px;min-width:100px;">Install</th>
                  <th style="font-size:11px;padding:8px 6px;">Lead Time</th>
                </tr>
              </thead>
              <tbody>
      `;

      filtered.forEach(clip => {
        const imgSrc = clip.imageUrl || (clip.images && clip.images[0]) || '';
        const cost = parseFloat(clip.cost) || 0;
        const sell = parseFloat(clip.clientPrice) || 0;
        const qty = parseFloat(clip.qty) || 1;
        const status = clip.selectionStatus || clip.approvalStatus || 'Proposed';
        const orderStatus = clip.orderStatus || '';
        const installStatus = clip.installStatus || '';
        const leadTime = clip.leadTime || '';
        const statusColors = { Proposed: '#6B7280', Approved: '#C8B99A', Ordered: '#00B8D4', Received: '#60A5FA', Installed: '#5FA56B', Returned: '#E16A5B' };
        const stColor = statusColors[status] || '#6B7280';

        html += `
          <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
            <td style="padding:6px 4px;">${imgSrc ? '<img src="' + escAttr(imgSrc) + '" style="width:32px;height:32px;border-radius:4px;object-fit:cover;" referrerpolicy="no-referrer" onerror="this.outerHTML=\'<div style=width:32px;height:32px;background:var(--gray-100);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:14px>📦</div>\'">' : '<div style="width:32px;height:32px;background:var(--gray-100);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:14px;">📦</div>'}</td>
            <td style="padding:6px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer;" onclick="showClipDetail('${escAttr(proj.id)}','${escAttr(clip.id)}')" title="${escAttr(clip.title || '')}"><strong>${esc(clip.title || 'Untitled')}</strong>${clip.sku ? '<br><span style="font-size:10px;color:var(--gray-500);">SKU: ' + esc(clip.sku) + '</span>' : ''}</td>
            <td style="padding:6px;font-size:11px;color:var(--gray-400);">${esc(clip.vendor || '-')}</td>
            <td style="padding:6px;font-size:11px;">${esc(clip.room || '-')}</td>
            <td style="padding:6px;font-size:11px;color:var(--gray-400);">${esc(clip.category || '-')}</td>
            <td style="padding:6px;font-family:var(--font-mono);font-size:11px;">${cost > 0 ? formatMoney(cost) : '-'}${qty > 1 ? '<br><span style="font-size:10px;color:var(--gray-500);">×' + qty + '</span>' : ''}</td>
            <td style="padding:6px;font-family:var(--font-mono);font-size:11px;color:var(--green);font-weight:600;">${sell > 0 ? formatMoney(sell) : '-'}</td>
            <td style="padding:6px;font-size:11px;">${clip.poNum ? '<span style="color:var(--cyan);font-weight:600;">' + esc(clip.poNum) + '</span>' : '<span style="color:var(--gray-500);">—</span>'}</td>
            <td style="padding:6px;" onclick="event.stopPropagation()">
              <select style="font-size:10px;padding:3px 6px;border-radius:0;border:1px solid ${stColor}44;background:${stColor}15;color:${stColor};font-weight:600;cursor:pointer;width:90px;" onchange="ffeUpdateSelectionStatus('${escAttr(proj.id)}','${escAttr(clip.id)}',this.value)">
                ${selectionStatuses.map(s => '<option value="' + s + '"' + (status === s ? ' selected' : '') + '>' + s + '</option>').join('')}
              </select>
            </td>
            <td style="padding:6px;" onclick="event.stopPropagation()">
              <select class="form-input" style="font-size:10px;padding:3px 6px;width:100px;" onchange="ffeUpdateOrderStatus('${escAttr(proj.id)}','${escAttr(clip.id)}',this.value)">
                <option value="">—</option>
                ${orderStatuses.map(s => '<option value="' + s + '"' + (orderStatus === s ? ' selected' : '') + '>' + s + '</option>').join('')}
              </select>
            </td>
            <td style="padding:6px;" onclick="event.stopPropagation()">
              <select class="form-input" style="font-size:10px;padding:3px 6px;width:100px;" onchange="ffeUpdateInstallStatus('${escAttr(proj.id)}','${escAttr(clip.id)}',this.value)">
                <option value="">—</option>
                ${installStatuses.map(s => '<option value="' + s + '"' + (installStatus === s ? ' selected' : '') + '>' + s + '</option>').join('')}
              </select>
            </td>
            <td style="padding:6px;font-size:11px;color:var(--gray-400);">${esc(leadTime || '—')}</td>
          </tr>
        `;
      });

      html += `
              </tbody>
            </table>
          </div>
        </div>
      `;

      return html;
    }

    // ===== CLIENT VIEW — Clean, Simple Presentation =====
    function renderFFEClientView(filtered, allClips, proj, allRooms, roomMeta) {
      // Group by room - client sees clean, no-cost view
      const grouped = {};
      filtered.forEach(c => { const rm = c.room || 'Unassigned'; if (!grouped[rm]) grouped[rm] = []; grouped[rm].push(c); });
      const roomNames = Object.keys(grouped).sort();

      if (filtered.length === 0) {
        return '<div class="empty-state"><div class="empty-icon">👤</div><div class="empty-text">No selections to display.</div></div>';
      }

      let html = `
        <div style="padding:4px 0;margin-bottom:16px;">
