    async function cycleProposalStatus(projectId, proposalId, current) {
      const order = ['Draft', 'Sent', 'Approved', 'Declined'];
      const next = order[(order.indexOf(current) + 1) % order.length];
      await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).update({ status: next });
      logDocActivity(projectId, 'proposals', proposalId, 'status_changed', current + ' → ' + next);
      invalidateSearchCache();
      renderProposalDetail(projectId, proposalId);
    }

    async function togglePublished(projectId, docId, newValue, collection) {
      const col = collection || 'proposals';
      await db.collection('boards').doc(projectId).collection(col).doc(docId).update({ published: newValue });
      logDocActivity(projectId, col, docId, newValue ? 'published' : 'unpublished', '');
      invalidateSearchCache();
      if (col === 'proposals') renderProposalDetail(projectId, docId);
      else navigate(window.location.hash);
    }

    async function togglePublishedInvoice(projectId, docId, newValue) {
      await togglePublished(projectId, docId, newValue, 'invoices');
    }

