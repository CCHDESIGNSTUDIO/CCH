    // Import Niice from global page — asks which project to attach to
    async function deleteIdeabookFromList(projectId, ideabookId, name) {
      if (!confirm('Delete board "' + name + '"? This cannot be undone.')) return;
      try {
        await db.collection('boards').doc(projectId).collection('ideabooks').doc(ideabookId).delete();
        renderIdeabooksList();
      } catch(e) { alert('Error: ' + e.message); }
    }

    async function renameIdeabookFromList(projectId, ideabookId, currentName) {
      var newName = prompt('Rename board:', currentName);
      if (!newName || newName.trim() === currentName) return;
      try {
        await db.collection('boards').doc(projectId).collection('ideabooks').doc(ideabookId).update({ name: newName.trim() });
        renderIdeabooksList();
      } catch(e) { alert('Error: ' + e.message); }
    }

    async function copyIdeabookToProject(fromProjectId, ideabookId, boardName) {
      var projList = projects || [];
      if (projList.length === 0) { alert('No projects loaded.'); return; }
      var opts = projList.map(function(p) { return p.name + ' (' + p.id + ')'; });
      var choice = prompt('Copy "' + boardName + '" to which project?\\n\\n' + opts.map(function(o, i) { return (i+1) + '. ' + o; }).join('\\n') + '\\n\\nEnter project number:');
      if (!choice) return;
      var idx = parseInt(choice) - 1;
      if (idx < 0 || idx >= projList.length) { alert('Invalid selection.'); return; }
      var targetProjectId = projList[idx].id;

      try {
        var doc = await db.collection('boards').doc(fromProjectId).collection('ideabooks').doc(ideabookId).get();
        if (!doc.exists) { alert('Board not found.'); return; }
        var data = doc.data();
        data.name = (data.name || boardName) + ' (copy)';
        data.createdAt = new Date().toISOString();
        await db.collection('boards').doc(targetProjectId).collection('ideabooks').add(data);
        alert('Copied to ' + projList[idx].name);
        renderIdeabooksList();
      } catch(e) { alert('Error: ' + e.message); }
    }

    async function moveIdeabookToProject(fromProjectId, ideabookId, boardName) {
      var projList = projects || [];
      if (projList.length === 0) { alert('No projects loaded.'); return; }
      var others = projList.filter(function(p) { return p.id !== fromProjectId; });
      if (others.length === 0) { alert('No other projects to move to.'); return; }
      var opts = others.map(function(p) { return p.name + ' (' + p.id + ')'; });
      var choice = prompt('Move "' + boardName + '" to which project?\\n\\n' + opts.map(function(o, i) { return (i+1) + '. ' + o; }).join('\\n') + '\\n\\nEnter project number:');
      if (!choice) return;
      var idx = parseInt(choice) - 1;
      if (idx < 0 || idx >= others.length) { alert('Invalid selection.'); return; }
      var targetProjectId = others[idx].id;

      if (!confirm('Move "' + boardName + '" from current project to ' + others[idx].name + '?')) return;

      try {
        var doc = await db.collection('boards').doc(fromProjectId).collection('ideabooks').doc(ideabookId).get();
        if (!doc.exists) { alert('Board not found.'); return; }
        var data = doc.data();
        data.movedFrom = fromProjectId;
        data.movedAt = new Date().toISOString();
        await db.collection('boards').doc(targetProjectId).collection('ideabooks').add(data);
        await db.collection('boards').doc(fromProjectId).collection('ideabooks').doc(ideabookId).delete();
        alert('Moved to ' + others[idx].name);
        renderIdeabooksList();
      } catch(e) { alert('Error: ' + e.message); }
    }

