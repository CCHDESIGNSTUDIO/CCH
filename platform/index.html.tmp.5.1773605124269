    async function generateReportNow() {
      if (!confirm('Generate a weekly report for the last 7 days?')) return;
      try {
        var btn = document.querySelector('.topbar-actions .btn-primary');
        if (btn) { btn.textContent = '⏳ Generating...'; btn.disabled = true; }

        // Try cloud function first
        try {
          var genFn = firebase.functions().httpsCallable('generateWeeklyReport');
          var result = await genFn({ weeksBack: 0 });
          if (result.data.success) {
            renderReportsPage();
            return;
          }
        } catch(fnErr) {
          console.warn('Cloud function not deployed, generating locally:', fnErr.message);
        }

        // Fallback: build report locally
        var now = new Date();
        var weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
        var startStr = weekAgo.toISOString().slice(0, 10);
        var endStr = now.toISOString().slice(0, 10);

        // Pull time entries
        var totalHours = 0, totalBillable = 0, timeByProject = {};
        try {
          var tSnap = await db.collection('timeEntries').get();
          tSnap.forEach(function(d) {
            var t = d.data();
            if (t.date >= startStr && t.date <= endStr) {
              var hrs = parseFloat(t.hours) || 0;
              var tot = parseFloat(t.total) || 0;
              totalHours += hrs;
              if (t.billable) totalBillable += tot;
              var pn = t.project || 'Unassigned';
              if (!timeByProject[pn]) timeByProject[pn] = { hours: 0, billable: 0, entries: 0 };
              timeByProject[pn].hours += hrs;
              timeByProject[pn].billable += tot;
              timeByProject[pn].entries++;
            }
          });
        } catch(e) {}

        // Pull activity count
        var activityCount = 0;
        try {
          var aSnap = await db.collection('activity').where('createdAt', '>=', weekAgo.toISOString()).get();
          activityCount = aSnap.size;
        } catch(e) {
          try { var aSnap2 = await db.collection('activity').get(); activityCount = aSnap2.size; } catch(e2) {}
        }

        // Simple health
        var health = 85;
