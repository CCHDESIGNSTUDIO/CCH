      const installStatuses = ['Pending', 'Scheduled', 'In Progress', 'Installed', 'Punch List'];

      const sortHdr = function(field, label) {
        return '<th style="cursor:pointer;user-select:none;white-space:nowrap;font-size:11px;padding:8px 6px;" onclick="ffeSort(\'' + field + '\')">' + label + ffeSortArrow(field) + '</th>';
