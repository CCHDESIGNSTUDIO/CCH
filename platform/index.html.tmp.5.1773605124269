    function addCorrAttachmentField() {
      var c = document.getElementById('corrAttachments');
      var d = document.createElement('div');
      d.style.cssText = 'display:flex;gap:8px;margin-bottom:6px;';
      d.innerHTML = '<input class="form-input corr-attach-url" placeholder="Paste link..." style="flex:1;font-size:12px;"><button class="btn btn-sm" style="color:var(--red);padding:4px 8px;" onclick="this.parentElement.remove()">×</button>';
