    async function removePOAttachment(projectId, poId, idx) {
      if (!confirm('Remove this attachment?')) return;
      var docRef = db.collection('boards').doc(projectId).collection('purchaseOrders').doc(poId);
      var snap = await docRef.get();
      var attachments = (snap.exists && snap.data().attachments) ? snap.data().attachments.slice() : [];
