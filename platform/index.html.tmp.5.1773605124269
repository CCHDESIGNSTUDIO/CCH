        s.forEach(d => {
          const data = { id: d.id, ...d.data() };
          const num = data.invoiceNum || data.number || '';
          if (num && seenNums.has(num)) return;
          if (num) seenNums.add(num);
          invoices.push(data);
        });
      } catch(e){}
      // Fallback: catch docs missing createdAt
      try {
        const s2 = await db.collection('boards').doc(proj.id).collection('invoices').get();
        s2.forEach(d => {
          if (!invoices.find(i => i.id === d.id)) {
            const data = { id: d.id, ...d.data() };
            const num = data.invoiceNum || data.number || '';
            if (num && seenNums.has(num)) return;
            if (num) seenNums.add(num);
            invoices.push(data);
          }
        });
      } catch(e){}

      // Build invoices from clips
