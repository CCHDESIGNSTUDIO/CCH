  <script>
    // ==================== CONFIG ====================
    const firebaseConfig = {
      apiKey: "AIzaSyAd24U5ArVGrA24IxNcYD2NYiTVycyF4og",
      authDomain: "cch-design-boards.firebaseapp.com",
      projectId: "cch-design-boards",
