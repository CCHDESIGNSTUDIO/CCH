    // ==================== PROJECT DETAIL ====================
    async function renderProjectDetail() {
      if (!currentProjectId) { navigate('#/projects'); return; }
      const C = document.getElementById('contentArea');
      C.innerHTML = '<div style="text-align:center;padding:40px;color:var(--gray-400)">Loading project...</div>';

      // Load project
      let proj;
      const doc = await db.collection('boards').doc(currentProjectId).get();
      if (doc.exists) {
        proj = { id: doc.id, ...doc.data() };
      } else {
        // Might be a legacy board-only project — create project doc
        proj = { id: currentProjectId, name: currentProjectId.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '), status: 'In Progress' };
      }

      setBreadcrumb([
        { label: 'Projects', hash: '#/projects' },
        { label: proj.name || proj.id }
      ]);
      setTopbarActions(`
        <button class="btn btn-secondary btn-sm" onclick="showNewTimeEntryModal({project:'${escAttr(proj.name || proj.id)}'})" title="Log time for this project" style="margin-right:4px;">⏱ Add Time</button>
        <button class="btn btn-secondary btn-sm" onclick="navigate('#/clientview/${proj.id}')" title="Preview client dashboard" style="margin-right:4px;">👁️ Preview</button>
        <button class="btn btn-secondary btn-sm" onclick="copyClientLink('${proj.id}')" title="Copy client dashboard link" style="margin-right:4px;">🔗 Share with Client</button>
        <button class="btn btn-secondary btn-sm" onclick="showEditProjectModal('${proj.id}')">Edit</button>
      `);

      const _isAdminUser = currentUser && ADMIN_EMAILS.includes((currentUser.email || '').toLowerCase());
      const tabs = ['overview', 'ideabooks', 'boards', 'designboards', 'ffe', 'proposals', 'invoices', 'pos', ...(_isAdminUser ? ['financials'] : []), 'comms', 'notes'];
      const tabLabels = { overview: 'Overview', ideabooks: '💡 Ideabooks', boards: '🏠 Room Boards', designboards: '🎨 Design Boards', ffe: '🛋️ FFE Tracker', proposals: '📋 Proposals', invoices: '💰 Invoices', pos: '📦 Purchase Orders', financials: '📊 Financials', comms: '💬 Communications', notes: '📝 Notes' };

      // Load profit data for summary bar
      let _projInvoices = [], _projPOs = [], _projTime = [];
      try {
        const invS = await db.collection('boards').doc(proj.id).collection('invoices').get();
        invS.forEach(d => _projInvoices.push({ id: d.id, ...d.data() }));
      } catch(e) {}
      try {
        const poS = await db.collection('boards').doc(proj.id).collection('purchaseOrders').get();
        poS.forEach(d => _projPOs.push({ id: d.id, ...d.data() }));
      } catch(e) {}
      // Also include clip-based POs (from CCH Clipper) that aren't in the purchaseOrders collection
      try {
        const _clipSnap = await db.collection('boards').doc(proj.id).collection('clips').get();
        const _clipPoMap = {};
        _clipSnap.forEach(d => {
          const c = d.data();
          if (c.poNum) {
            if (!_clipPoMap[c.poNum]) {
              _clipPoMap[c.poNum] = { id: 'clip-po-' + c.poNum, number: c.poNum, vendor: c.vendor || '',
                status: c.poStatus || 'Ordered', total: 0, items: [], _fromClips: true };
            }
            _clipPoMap[c.poNum].total += (c.totalCost || c.cost || 0);
            _clipPoMap[c.poNum].items.push({ title: c.title || '', cost: c.totalCost || c.cost || 0, qty: c.qty || 1 });
          }
        });
        Object.values(_clipPoMap).forEach(po => {
          if (!_projPOs.find(existing => (existing.number || existing.num) === po.number)) {
            _projPOs.push(po);
          }
        });
      } catch(e) {}
      try {
        const teS = await db.collection('timeEntries').where('project', '==', (proj.name || proj.id)).limit(500).get();
        teS.forEach(d => _projTime.push({ id: d.id, ...d.data() }));
        // Also check by projectId
        if (_projTime.length === 0) {
          const teS2 = await db.collection('timeEntries').where('projectId', '==', proj.id).limit(500).get();
          teS2.forEach(d => _projTime.push({ id: d.id, ...d.data() }));
        }
      } catch(e) {}

      const _billingModel = proj.billingModel || (proj.contractFee || proj.flatFee || proj.budget ? 'flat_fee' : 'hourly');
      const _contractFee = parseFloat(proj.contractFee || proj.flatFee || proj.budget) || 0;
      const _loggedHours = _projTime.reduce((s, t) => s + (parseFloat(t.hours) || 0), 0);
      const _billableTime = _projTime.filter(t => t.billable !== false);
      const _loggedValue = _billableTime.reduce((s, t) => {
        const rate = parseFloat(t.rate || t.hourlyRate || t.billableRate) || 100;
        return s + ((parseFloat(t.hours) || 0) * rate);
      }, 0);

      // === THREE COST BUCKETS ===
      // 1. Direct Project Costs (POs, freight, misc)
      const _directCosts = _projPOs.reduce((s, po) => {
        let t = parseFloat(po.total || po.amount) || 0;
        if (!t && po.items) t = po.items.reduce((s2, i) => s2 + (parseFloat(i.total || i.amount) || 0), 0);
        return s + t;
      }, 0);

      // 2. Contractor Labor Cost (non-owner team) — uses TEAM_CONFIG
      const _contractorCosts = _projTime.reduce((s, t) => {
        const memberStr = t.member || t.user || '';
        if (_isOwnerMember(memberStr)) return s;
        const costRate = parseFloat(t.internalCostRate) || _getContractorRate(memberStr);
        return s + ((parseFloat(t.hours) || 0) * costRate);
      }, 0);
      const _contractorHours = _projTime.reduce((s, t) => {
        const memberStr = t.member || t.user || '';
        return _isOwnerMember(memberStr) ? s : s + (parseFloat(t.hours) || 0);
      }, 0);

      // 3. Owner Labor Value — tracked, not deducted in cash profit — uses TEAM_CONFIG
      const _ownerTime = _projTime.filter(t => _isOwnerMember(t.member || t.user || ''));
      const _ownerHours = _ownerTime.reduce((s, t) => s + (parseFloat(t.hours) || 0), 0);
      const _ownerLaborValue = _ownerTime.reduce((s, t) => {
        const rate = parseFloat(t.rate || t.hourlyRate || t.billableRate) || TEAM_CONFIG.owner.rate;
        return s + ((parseFloat(t.hours) || 0) * rate);
      }, 0);

      // === REVENUE ===
      const _invoicedValue = _projInvoices.reduce((s, i) => s + (parseFloat(i.total || i.amount) || 0), 0);
      const _collectedValue = _projInvoices.filter(i => i.status === 'Paid').reduce((s, i) => s + (parseFloat(i.total || i.amount) || 0), 0);
      const _revenue = _contractFee > 0 ? _contractFee : _invoicedValue;

      // === DUAL PROFIT ===
      const _cashProfit = _revenue - _directCosts - _contractorCosts;
      const _loadedProfit = _cashProfit - _ownerLaborValue;
      const _cashMargin = _revenue > 0 ? (_cashProfit / _revenue * 100) : 0;

      // === EFFICIENCY ===
      const _efficiency = _billingModel === 'flat_fee'
        ? (_contractFee > 0 ? (_cashProfit / _contractFee * 100) : 0)
        : (_loggedValue > 0 ? (_invoicedValue / _loggedValue * 100) : 0);
      const _feeBurnPct = _contractFee > 0 ? Math.round((_directCosts + _contractorCosts) / _contractFee * 100) : 0;

      // === BUILD FINANCIAL HEALTH BAR ===
      const _hasData = _loggedHours > 0 || _invoicedValue > 0 || _directCosts > 0;
      const _profitBarHtml = (_isAdminUser && _hasData) ? `
        <div style="background:linear-gradient(135deg, rgba(30,30,30,0.95), rgba(26,26,46,0.6));border:1px solid rgba(255,255,255,0.06);border-radius:0;padding:16px 20px;margin-bottom:14px;">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
            <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:var(--gray-400);">Financial Health</span>
            <span style="font-size:9px;padding:2px 8px;border-radius:0;font-weight:700;background:${_billingModel === 'flat_fee' ? 'rgba(196,160,82,0.15);color:var(--gold);' : 'rgba(0,184,212,0.15);color:var(--cyan);'}">${_billingModel === 'flat_fee' ? 'Flat Fee' : 'Hourly'} Project</span>
            ${_contractFee > 0 && _feeBurnPct > 80 ? '<span style="font-size:9px;padding:2px 8px;border-radius:0;font-weight:700;background:rgba(225,106,91,0.15);color:#E16A5B;">⚠ ' + _feeBurnPct + '% Fee Burned</span>' : ''}
          </div>

          <!-- Revenue Row -->
          <div style="display:flex;flex-wrap:wrap;gap:20px;align-items:flex-start;margin-bottom:12px;">
            ${_contractFee > 0 ? '<div><div style="font-size:9px;color:var(--gray-500);text-transform:uppercase;letter-spacing:1px;">Contract Fee</div><div style="font-size:18px;font-weight:700;color:var(--gold);font-family:var(--font-mono);">' + formatMoney(_contractFee) + '</div></div>' : ''}
            <div><div style="font-size:9px;color:var(--gray-500);text-transform:uppercase;letter-spacing:1px;">Logged Value</div><div style="font-size:18px;font-weight:700;color:#ddd;font-family:var(--font-mono);">${formatMoney(_loggedValue)}</div></div>
            <div><div style="font-size:9px;color:var(--gray-500);text-transform:uppercase;letter-spacing:1px;">Invoiced</div><div style="font-size:18px;font-weight:700;color:#5FA56B;font-family:var(--font-mono);">${formatMoney(_invoicedValue)}</div></div>
          </div>

          <!-- Cost Chips Row -->
          <div style="margin-bottom:12px;">
            <div style="font-size:9px;color:var(--gray-500);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;">Costs</div>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
              ${_directCosts > 0 ? '<span style="display:inline-flex;align-items:center;gap:4px;padding:5px 12px;border-radius:0;font-size:12px;font-weight:600;font-family:var(--font-mono);background:rgba(26,188,156,0.1);color:#1abc9c;border:1px solid rgba(26,188,156,0.2);">PO ' + formatMoney(_directCosts) + ' <span style="font-size:10px;opacity:0.7;">(' + _projPOs.length + ')</span></span>' : ''}
              ${_contractorCosts > 0 ? '<span style="display:inline-flex;align-items:center;gap:4px;padding:5px 12px;border-radius:0;font-size:12px;font-weight:600;font-family:var(--font-mono);background:rgba(225,106,91,0.1);color:#E16A5B;border:1px solid rgba(225,106,91,0.2);">Contractors ' + formatMoney(_contractorCosts) + '</span>' : ''}
              ${_ownerLaborValue > 0 ? '<span style="display:inline-flex;align-items:center;gap:4px;padding:5px 12px;border-radius:0;font-size:12px;font-weight:600;font-family:var(--font-mono);background:rgba(200,185,154,0.1);color:var(--gold);border:1px solid rgba(200,185,154,0.2);">Cynthia ' + formatMoney(_ownerLaborValue) + '</span>' : ''}
              ${_directCosts === 0 && _contractorCosts === 0 && _ownerLaborValue === 0 ? '<span style="font-size:12px;color:var(--gray-500);">No costs recorded yet</span>' : ''}
            </div>
          </div>

          <!-- Profit Row -->
          <div style="display:flex;flex-wrap:wrap;gap:20px;align-items:flex-start;padding-top:12px;border-top:1px solid rgba(255,255,255,0.06);">
            <div>
              <div style="font-size:9px;color:var(--gray-500);text-transform:uppercase;letter-spacing:1px;">Cash Profit</div>
              <div style="font-size:20px;font-weight:700;color:${_cashProfit >= 0 ? '#5FA56B' : '#E16A5B'};font-family:var(--font-mono);">${formatMoney(_cashProfit)}</div>
              <div style="font-size:9px;color:var(--gray-500);margin-top:1px;">revenue − POs − contractors${_revenue > 0 ? ' · <span style="color:' + (_cashProfit >= 0 ? '#5FA56B' : '#E16A5B') + ';font-weight:600;">' + (_cashProfit / _revenue * 100).toFixed(1) + '% margin</span>' : ''}</div>
            </div>
            <div>
              <div style="font-size:9px;color:var(--gray-500);text-transform:uppercase;letter-spacing:1px;">Loaded Profit</div>
              <div style="font-size:20px;font-weight:700;color:${_loadedProfit >= 0 ? '#C8B99A' : '#E16A5B'};font-family:var(--font-mono);">${formatMoney(_loadedProfit)}</div>
              <div style="font-size:9px;color:var(--gray-500);margin-top:1px;">cash profit − owner labor</div>
            </div>
            <div>
              <div style="font-size:9px;color:var(--gray-500);text-transform:uppercase;letter-spacing:1px;">Efficiency</div>
              <div style="font-size:20px;font-weight:700;color:${_efficiency >= 85 ? '#5FA56B' : _efficiency >= 70 ? '#C8B99A' : '#E16A5B'};font-family:var(--font-mono);">${_efficiency.toFixed(0)}%</div>
            </div>
            ${_contractFee > 0 ? '<div><div style="font-size:9px;color:var(--gray-500);text-transform:uppercase;letter-spacing:1px;">Fee Burn</div><div style="font-size:20px;font-weight:700;color:' + (_feeBurnPct > 90 ? '#E16A5B' : _feeBurnPct > 70 ? '#C8B99A' : 'var(--cyan)') + ';font-family:var(--font-mono);">' + _feeBurnPct + '%</div></div>' : ''}
          </div>
          ${_contractFee > 0 ? '<div style="margin-top:10px;height:4px;background:var(--gray-700);border-radius:2px;overflow:hidden;"><div style="height:100%;width:' + Math.min(100, _feeBurnPct) + '%;border-radius:2px;background:linear-gradient(90deg, ' + (_feeBurnPct > 90 ? '#E16A5B' : _feeBurnPct > 70 ? '#C8B99A, #E16A5B' : 'var(--cyan), var(--gold)') + ');"></div></div>' : ''}
        </div>` : '';

      C.innerHTML = `
        <div class="page-header" style="margin-bottom: 12px;">
          <div class="page-title">${esc(proj.name || 'Project')}</div>
          <div class="page-subtitle">${esc(proj.clientName ? 'For ' + proj.clientName : '')}</div>
        </div>
        ${_profitBarHtml}
        <div class="project-tabs">
          ${tabs.map((t, idx) => `<button class="project-tab ${t === currentProjectTab ? 'active' : ''}" onclick="switchProjectTab('${t}')">${tabLabels[t]}</button>${idx > 0 && idx < tabs.length - 1 ? '<span class="tab-arrow">›</span>' : ''}`).join('')}
        </div>
        <div id="projectTabContent"></div>
      `;

      renderProjectTab(proj);
    }

    function switchProjectTab(tab) {
      currentProjectTab = tab;
      window.location.hash = `#/project/${currentProjectId}/${tab}`;
      document.querySelectorAll('.project-tab').forEach(t => t.classList.remove('active'));
      const _adminCheck = currentUser && ADMIN_EMAILS.includes((currentUser.email || '').toLowerCase());
      const _tabList = ['overview','ideabooks','boards','designboards','proposals','invoices','pos', ...(_adminCheck ? ['financials'] : []),'comms','notes'];
      const activeTab = document.querySelector(`.project-tab:nth-child(${_tabList.indexOf(tab) + 1})`);
      if (activeTab) activeTab.classList.add('active');
      renderProjectDetail(); // Re-render with new tab
    }

    async function renderProjectTab(proj) {
      const T = document.getElementById('projectTabContent');
      if (!T) return;

      if (currentProjectTab === 'overview') await renderOverviewTab(T, proj);
      else if (currentProjectTab === 'ideabooks') await renderIdeabooksTab(T, proj);
      else if (currentProjectTab === 'boards') await renderBoardsTab(T, proj);
      else if (currentProjectTab === 'designboards') await renderDesignBoardsTab(T, proj);
      else if (currentProjectTab === 'proposals') await renderProposalsTab(T, proj);
      else if (currentProjectTab === 'invoices') await renderInvoicesTab(T, proj);
      else if (currentProjectTab === 'pos') await renderPOsTab(T, proj);
      else if (currentProjectTab === 'ffe') await renderFFETab(T, proj);
      else if (currentProjectTab === 'financials') await renderFinancialsTab(T, proj);
      else if (currentProjectTab === 'comms') await renderCommsTab(T, proj);
      else if (currentProjectTab === 'notes') await renderNotesTab(T, proj);
    }

    // ----- DESIGN BOARDS TAB -----
    async function renderDesignBoardsTab(T, proj) {
      let boards = [];
      try {
        const snap = await db.collection('boards').doc(proj.id).collection('designBoards').get();
        snap.forEach(d => boards.push({ id: d.id, ...d.data() }));
      } catch(e) { console.error('Design boards load error:', e); }
      boards.sort((a,b) => (b.updatedAt || b.createdAt || '').localeCompare(a.updatedAt || a.createdAt || ''));

      T.innerHTML = `
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
          <div style="font-size:16px;font-weight:600;">${boards.length} Design Board${boards.length !== 1 ? 's' : ''}</div>
          <div style="display:flex;gap:8px;">
            <button class="btn btn-secondary" onclick="showImageManager('${proj.id}','${escAttr(proj.name)}')">🖼️ Image Manager</button>
            <button class="btn btn-primary" onclick="createDesignBoard('${proj.id}')">+ New Design Board</button>
          </div>
        </div>
        ${boards.length === 0 ?
          '<div class="empty-state"><div class="empty-icon">🎨</div><div class="empty-text">No design boards yet.</div></div>' :
          '<div class="ideabook-grid">' + boards.map(b => {
            const firstElWithImg = b.elements && b.elements.find(e => getProductImg(e));
            const coverImg = getProductImg(b) || (firstElWithImg ? getProductImg(firstElWithImg) : '');
            const count = (b.elements || []).length || b.elementCount || 0;
            const dateStr = b.updatedAt ? new Date(b.updatedAt).toLocaleDateString() : (b.createdAt ? new Date(b.createdAt).toLocaleDateString() : '');
            return '<div class="ideabook-card">' +
              '<div class="ideabook-cover imgs-1">' +
                (coverImg ? '<img src="' + escAttr(coverImg) + '" referrerpolicy="no-referrer" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'">' : '') +
                '<div class="ib-placeholder" style="' + (coverImg ? 'display:none;' : 'display:flex;') + '">🎨</div>' +
              '</div>' +
              '<div class="ideabook-card-body">' +
                '<div>' +
                  '<div class="ideabook-card-name">' + esc(b.name || 'Untitled Board') + '</div>' +
                  '<div class="ideabook-card-count">' + (b.type || 'Design Board') + ' · ' + count + ' element' + (count !== 1 ? 's' : '') + (dateStr ? ' · ' + dateStr : '') + '</div>' +
                  '<div style="display:flex;gap:8px;margin-top:8px;">' +
                    '<button class="btn btn-sm btn-secondary" onclick="event.stopPropagation();editDesignBoard(\'' + proj.id + '\',\'' + b.id + '\')">✏️ Edit</button>' +
                    '<button class="btn btn-sm btn-secondary" onclick="event.stopPropagation();navigate(\'#/clientview/' + proj.id + '\')">❤️ Client View</button>' +
                  '</div>' +
                '</div>' +
                '<div style="display:flex;gap:4px;">' +
                  '<button class="ideabook-card-menu" onclick="event.stopPropagation();renameDesignBoard(\'' + proj.id + '\',\'' + b.id + '\',\'' + escAttr(b.name || '') + '\')" title="Rename">✏️</button>' +
                  '<button class="ideabook-card-menu" onclick="event.stopPropagation();deleteDesignBoard(\'' + proj.id + '\',\'' + b.id + '\')" title="Delete" style="color:var(--red);">🗑️</button>' +
                '</div>' +
              '</div>' +
            '</div>';
          }).join('') + '</div>'}
      `;
    }

    async function createDesignBoard(projectId) {
      const name = prompt('Design board name:');
      if (!name) return;
      try {
        await db.collection('boards').doc(projectId).collection('designBoards').add({
          name: name, type: 'Design Board', elements: [], createdAt: new Date().toISOString(), updatedAt: new Date().toISOString()
        });
        renderProjectDetail();
      } catch(e) { alert('Error: ' + e.message); }
    }

    async function renameDesignBoard(projectId, boardId, currentName) {
      const name = prompt('New name:', currentName);
      if (!name || name === currentName) return;
      try {
        await db.collection('boards').doc(projectId).collection('designBoards').doc(boardId).update({ name: name, updatedAt: new Date().toISOString() });
        renderProjectDetail();
      } catch(e) { alert('Error: ' + e.message); }
    }

    async function deleteDesignBoard(projectId, boardId) {
      if (!confirm('Delete this design board?')) return;
      try {
        await db.collection('boards').doc(projectId).collection('designBoards').doc(boardId).delete();
        renderProjectDetail();
      } catch(e) { alert('Error: ' + e.message); }
    }

    function editDesignBoard(projectId, boardId) {
      navigate('#/project/' + projectId + '/designboard/' + boardId);
    }

    async function openDesignBoard(projectId, boardId) {
      setBreadcrumb([{ label: 'Projects', onclick: "navigate('#/projects')" }, { label: projectId, onclick: "navigate('#/project/" + projectId + "')" }, { label: 'Design Board' }]);
      setTopbarActions('');
      const T = document.getElementById('contentArea');
      T.innerHTML = '<div style="text-align:center;padding:80px;color:var(--gray-400)">Loading design board...</div>';

      try {
        const doc = await db.collection('boards').doc(projectId).collection('designBoards').doc(boardId).get();
        if (!doc.exists) { T.innerHTML = '<div class="empty-state"><div class="empty-icon">❌</div><div class="empty-text">Design board not found.</div></div>'; return; }
        const board = doc.data();
        const boardName = board.name || 'Design Board';
        const canvasW = board.canvasWidth || 1400;
        const canvasH = board.canvasHeight || 1000;

        // Load all sources in parallel
        const [clipsSnap, ibSnap, libSnap] = await Promise.all([
          db.collection('boards').doc(projectId).collection('clips').get(),
          db.collection('boards').doc(projectId).collection('ideabooks').get(),
          db.collection('productLibrary').limit(200).get().catch(() => ({ docs: [] }))
        ]);

        const clips = []; clipsSnap.forEach(d => clips.push({id:d.id,...d.data()}));
        const ideabooks = []; ibSnap.forEach(d => ideabooks.push({id:d.id,...d.data()}));
        const ibImages = [];
        ideabooks.forEach(ib => {
          (ib.images || []).forEach(img => {
            if (typeof img === 'string') ibImages.push({ imageUrl: img, section: ib.name });
            else ibImages.push({ ...img, imageUrl: img.imageUrl || img.url || img.src || '', section: ib.name });
          });
        });
        const libItems = []; libSnap.docs.forEach(d => libItems.push({id:d.id,...d.data()}));

        // State
        window._dbProjectId = projectId;
        window._dbBoardId = boardId;
        window._dbElements = board.elements || [];
        window._dbSelected = null;
        window._dbDragItem = null;
        window._dbHistory = [JSON.stringify(board.elements || [])];
        window._dbShowPricing = true;
        window._dbSourceTab = 'room';

        function renderSidebarItems(filter) {
          var f = (filter || '').toLowerCase();
          var tab = window._dbSourceTab;
          var items = [];
          if (tab === 'room') {
            items = clips.filter(function(c) { return getProductImg(c); }).map(function(c) {
              return { title: c.title || c.name || 'Untitled', vendor: c.vendor || c.manufacturer || '', price: c.clientPrice || c.totalSelling || '', img: getProductImg(c), data: c };
            });
          } else if (tab === 'ideabook') {
            items = ibImages.filter(function(img) { return img.imageUrl; }).map(function(img) {
              return { title: img.caption || img.title || 'Untitled', vendor: img.vendor || '', price: img.price || img.clientPrice || '', img: img.imageUrl, data: img, section: img.section };
            });
          } else if (tab === 'library') {
            items = libItems.map(function(p) {
              return { title: p.title || p.name || 'Untitled', vendor: p.vendor || p.manufacturer || '', price: p.clientPrice || p.retailPrice || '', img: getProductImg(p), data: p };
            });
          }
          if (f) items = items.filter(function(it) { return (it.title + ' ' + it.vendor + ' ' + (it.section||'')).toLowerCase().indexOf(f) >= 0; });
          var el = document.getElementById('dbItemsList');
          if (!el) return;
          el.innerHTML = items.length === 0 ? '<div style="padding:20px;text-align:center;color:var(--gray-400);font-size:12px;">No items found</div>' :
            items.map(function(it, idx) {
              var imgHtml = it.img ? '<img src="' + escAttr(it.img) + '" referrerpolicy="no-referrer" style="width:36px;height:36px;object-fit:cover;flex-shrink:0;background:var(--gray-100);" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'">' +
                '<div style="display:none;width:36px;height:36px;background:var(--gray-200);align-items:center;justify-content:center;flex-shrink:0;font-size:14px;">🎨</div>' :
                '<div style="width:36px;height:36px;background:var(--gray-200);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:14px;">🎨</div>';
              return '<div class="db-source-item" draggable="true" ondragstart="window._dbDragItem=' + idx + ';event.dataTransfer.setData(\'text/plain\',\'item\')" style="display:flex;gap:8px;align-items:center;padding:6px 8px;cursor:grab;border-bottom:1px solid var(--gray-100);transition:background 0.15s;" onmouseover="this.style.background=\'var(--gray-50)\'" onmouseout="this.style.background=\'\'" ondblclick="dbAddToCanvas(' + idx + ')">' +
                imgHtml +
                '<div style="flex:1;min-width:0;"><div style="font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(it.title) + '</div>' +
                '<div style="font-size:10px;color:var(--gray-400);">' + esc(it.vendor) + '</div>' +
                (it.price ? '<div style="font-size:11px;font-weight:700;color:var(--gold);">$' + (parseFloat(it.price)||0).toLocaleString() + '</div>' : '') +
                '</div></div>';
            }).join('');
        }

        function dbGetSourceItems() {
          if (window._dbSourceTab === 'room') return clips.map(function(c) { return { title: c.title||c.name||'', vendor: c.vendor||'', price: c.clientPrice||c.totalSelling||'', img: getProductImg(c), data: c }; });
          if (window._dbSourceTab === 'ideabook') return ibImages.map(function(img) { return { title: img.caption||img.title||'', vendor: img.vendor||'', price: img.price||img.clientPrice||'', img: img.imageUrl, data: img }; });
          return libItems.map(function(p) { return { title: p.title||p.name||'', vendor: p.vendor||'', price: p.clientPrice||p.retailPrice||'', img: getProductImg(p), data: p }; });
        }

        window.dbSwitchSource = function(tab) {
          window._dbSourceTab = tab;
          document.querySelectorAll('.db-source-tab').forEach(function(t) { t.classList.remove('active'); });
          var active = document.querySelector('.db-source-tab[data-tab="' + tab + '"]');
          if (active) active.classList.add('active');
          document.getElementById('dbFilterInput').value = '';
          renderSidebarItems('');
        };

        window.dbAddToCanvas = function(idx) {
          var items = dbGetSourceItems();
          var it = items[idx];
          if (!it) return;
          var el = { id: Date.now() + '_' + Math.random().toString(36).substr(2,4), type: 'image', x: 100 + Math.random()*200, y: 100 + Math.random()*200, w: 200, h: 200, title: it.title, vendor: it.vendor, price: it.price, img: it.img, rotation: 0 };
          window._dbElements.push(el);
          dbRenderCanvas();
          dbSave();
        };

        window.dbAddText = function() {
          var el = { id: Date.now() + '_t', type: 'text', x: 200, y: 200, w: 200, h: 40, text: 'New Text', fontSize: 24, fontWeight: 'bold', color: '#333' };
          window._dbElements.push(el);
          dbRenderCanvas();
          dbSave();
        };

        window.dbAddHeading = function() {
          var el = { id: Date.now() + '_h', type: 'text', x: 100, y: 100, w: 400, h: 60, text: 'Heading', fontSize: 36, fontWeight: 'bold', color: '#333' };
          window._dbElements.push(el);
          dbRenderCanvas();
          dbSave();
        };

        window.dbAddLine = function(dir) {
          var el = { id: Date.now() + '_l', type: 'line', x: 200, y: 300, w: dir === 'h' ? 300 : 2, h: dir === 'h' ? 2 : 200, color: '#333' };
          window._dbElements.push(el);
          dbRenderCanvas();
          dbSave();
        };

        window.dbAddImageURL = function() {
          var url = prompt('Image URL:');
          if (!url) return;
