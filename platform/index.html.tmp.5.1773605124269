    // ---- A/R AGING ----
    function buildARAgingReport(wb, invoices) {
      var now = Date.now();
      var rows = [];
      invoices.forEach(function(i) {
        var total = parseFloat(i.total) || 0;
        var paid = (i.payments || []).reduce(function(s,p) { return s + (parseFloat(p.amount)||0); }, 0) || parseFloat(i.amountPaid||i.paidAmount||i.totalPaid||0) || (i.status === 'Paid' ? total : 0);
        var balance = total - paid;
        if (balance <= 0) return;
        var invDate = new Date(i.date || i.createdAt || '');
        var daysOld = isNaN(invDate.getTime()) ? 999 : Math.floor((now - invDate.getTime()) / 86400000);
        var bucket = daysOld <= 30 ? 'Current' : daysOld <= 60 ? '31-60' : daysOld <= 90 ? '61-90' : '90+';
        rows.push({
          'Invoice #': i.invoiceNum || i.number || i.id.slice(0,8),
          'Project': i.projectName || i.project || '',
          'Client': i.clientName || i.client || '',
          'Date': i.date || i.createdAt || '',
          'Days Old': daysOld < 999 ? daysOld : 'Unknown',
          'Bucket': bucket,
          'Total': total,
          'Paid': paid,
          'Balance': Math.round(balance * 100) / 100,
          'Status': i.status || ''
        });
      });
      rows.sort(function(a,b) { return (b.Balance||0) - (a.Balance||0); });

      // Summary by bucket
      var buckets = { 'Current': 0, '31-60': 0, '61-90': 0, '90+': 0 };
      rows.forEach(function(r) { if (buckets.hasOwnProperty(r.Bucket)) buckets[r.Bucket] += r.Balance; });

      var summaryRows = [
        { 'Aging Bucket': 'Current (0-30 days)', 'Total Outstanding': Math.round(buckets['Current'] * 100) / 100 },
        { 'Aging Bucket': '31-60 days', 'Total Outstanding': Math.round(buckets['31-60'] * 100) / 100 },
        { 'Aging Bucket': '61-90 days', 'Total Outstanding': Math.round(buckets['61-90'] * 100) / 100 },
        { 'Aging Bucket': '90+ days', 'Total Outstanding': Math.round(buckets['90+'] * 100) / 100 },
        { 'Aging Bucket': 'TOTAL', 'Total Outstanding': Math.round(rows.reduce(function(s,r) { return s + r.Balance; }, 0) * 100) / 100 }
      ];

      var ws1 = XLSX.utils.json_to_sheet(summaryRows);
      ws1['!cols'] = [{wch:24},{wch:18}];
      XLSX.utils.book_append_sheet(wb, ws1, 'Aging Summary');

      var ws2 = XLSX.utils.json_to_sheet(rows);
      ws2['!cols'] = [{wch:14},{wch:25},{wch:20},{wch:12},{wch:10},{wch:10},{wch:12},{wch:12},{wch:12},{wch:12}];
      XLSX.utils.book_append_sheet(wb, ws2, 'Aging Detail');
    }

    // ---- TIME BY PROJECT ----
    function buildTimeByProjectReport(wb, timeEntries) {
      var projects = {};
      timeEntries.forEach(function(t) {
        var pn = t.project || 'Unassigned';
        if (!projects[pn]) projects[pn] = { hours: 0, billableHours: 0, nonBillableHours: 0, value: 0, entries: 0, members: {}, activities: {} };
        var hrs = parseFloat(t.hours) || 0;
        projects[pn].hours += hrs;
        projects[pn].entries++;
        if (t.billable) { projects[pn].billableHours += hrs; projects[pn].value += parseFloat(t.total) || 0; }
        else { projects[pn].nonBillableHours += hrs; }
        // By member
        var mem = t.member || t.memberName || 'Unknown';
        if (!projects[pn].members[mem]) projects[pn].members[mem] = 0;
        projects[pn].members[mem] += hrs;
        // By activity
        var act = t.activityType || t.task || 'General';
        if (act.length > 30) act = act.substring(0, 30);
        if (!projects[pn].activities[act]) projects[pn].activities[act] = 0;
        projects[pn].activities[act] += hrs;
      });

      var rows = [];
      Object.keys(projects).sort().forEach(function(pn) {
        var p = projects[pn];
        var memberStr = Object.keys(p.members).map(function(m) { return m + ' (' + p.members[m].toFixed(1) + 'h)'; }).join(', ');
        rows.push({
          'Project': pn,
          'Total Hours': Math.round(p.hours * 10) / 10,
          'Billable': Math.round(p.billableHours * 10) / 10,
          'Non-Billable': Math.round(p.nonBillableHours * 10) / 10,
          'Value': Math.round(p.value * 100) / 100,
          'Entries': p.entries,
          'Members': memberStr
        });
      });
      rows.sort(function(a,b) { return b['Total Hours'] - a['Total Hours']; });

      var ws = XLSX.utils.json_to_sheet(rows);
      ws['!cols'] = [{wch:28},{wch:12},{wch:10},{wch:12},{wch:12},{wch:8},{wch:40}];
      XLSX.utils.book_append_sheet(wb, ws, 'Time by Project');

      // Detail sheet
      var detail = timeEntries.map(function(t) {
        return {
          'Date': t.date || '',
          'Project': t.project || '',
          'Member': t.member || t.memberName || '',
          'Activity': t.activityType || '',
          'Task': (t.task || '').substring(0, 80),
          'Hours': parseFloat(t.hours) || 0,
          'Rate': parseFloat(t.rate) || 0,
          'Total': parseFloat(t.total) || 0,
          'Billable': t.billable ? 'Yes' : 'No',
          'Source': t.source || ''
        };
      });
      detail.sort(function(a,b) { return (b.Date||'').localeCompare(a.Date||''); });
      var ws2 = XLSX.utils.json_to_sheet(detail);
      ws2['!cols'] = [{wch:12},{wch:25},{wch:14},{wch:18},{wch:40},{wch:8},{wch:8},{wch:10},{wch:8},{wch:14}];
      XLSX.utils.book_append_sheet(wb, ws2, 'Time Detail');
    }

    // ---- PRODUCT SUMMARY ----
    function buildProductSummaryReport(wb, clips) {
