      var name = prompt('Name for this link (or leave blank):', '');
      if (name === null) return;
      if (!name.trim()) {
        // Auto-detect name from URL
        try { name = decodeURIComponent(url.split('/').pop().split('?')[0]) || 'Linked File'; } catch(e) { name = 'Linked File'; }
      }
      var isOneDrive = url.indexOf('onedrive') >= 0 || url.indexOf('sharepoint') >= 0 || url.indexOf('1drv.ms') >= 0;
      if (!_docEdit.docData.attachments) _docEdit.docData.attachments = [];
      _docEdit.docData.attachments.push({
        name: name.trim(), url: url, type: isOneDrive ? 'onedrive-link' : 'external-link',
        size: 0, uploadedAt: new Date().toISOString(), source: isOneDrive ? 'OneDrive/SharePoint' : 'External'
      });
      try {
        await db.collection('boards').doc(_docEdit.projectId).collection(_docEdit.collection).doc(_docEdit.docId).update({ attachments: _docEdit.docData.attachments });
        showToast('Link attached');
      } catch(e) { alert('Error saving link: ' + e.message); }
