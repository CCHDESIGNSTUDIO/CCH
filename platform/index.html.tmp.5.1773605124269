    function clientViewTab(el, panelId) {
      document.querySelectorAll('.cv-tab').forEach(t => t.classList.remove('active'));
      if (el && el.classList) el.classList.add('active');
      ['cv-home','cv-products','cv-ideabooks','cv-proposals','cv-invoices','cv-updates','cv-comms'].forEach(id => {
        const p = document.getElementById(id);
        if (p) {
          if (id === panelId) { p.style.display = 'block'; p.classList.add('cv-panel-fade'); }
          else { p.style.display = 'none'; }
        }
      });
      document.querySelectorAll('.cv-nav-item').forEach(n => {
        n.classList.toggle('active', n.getAttribute('onclick') && n.getAttribute('onclick').includes("'" + panelId + "'"));
      });
    }

    function cvNav(el, panelId) {
      document.querySelectorAll('.cv-nav-item').forEach(n => n.classList.remove('active'));
      if (el && el.classList) el.classList.add('active');
      ['cv-home','cv-products','cv-ideabooks','cv-proposals','cv-invoices','cv-updates','cv-comms'].forEach(id => {
        const p = document.getElementById(id);
        if (p) {
          if (id === panelId) { p.style.display = 'block'; p.classList.add('cv-panel-fade'); }
          else { p.style.display = 'none'; }
        }
      });
      document.querySelectorAll('.cv-tab').forEach(t => {
        t.classList.toggle('active', t.getAttribute('onclick') && t.getAttribute('onclick').includes("'" + panelId + "'"));
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function cvShowProduct(card) {
      const d = card.dataset;
      const existing = document.querySelector('.cv-modal-bg');
      if (existing) existing.remove();
      const price = d.price ? formatMoney(parseFloat(d.price)) : '';
      const details = [
        d.category ? ['Category', d.category] : null,
        d.room ? ['Room', d.room] : null,
        d.finish ? ['Finish', d.finish] : null,
        d.dims ? ['Dimensions', d.dims] : null,
        d.sku ? ['SKU', d.sku] : null,
        d.vendor ? ['Vendor', d.vendor] : null,
      ].filter(Boolean);
      const modal = document.createElement('div');
      modal.className = 'cv-modal-bg';
      modal.onclick = function(e) { if (e.target === modal) modal.remove(); };
      modal.innerHTML = '<div class="cv-modal" style="position:relative;">' +
        '<button class="cv-modal-close" onclick="this.closest(\'.cv-modal-bg\').remove()">✕</button>' +
        (d.img ? '<img class="cv-modal-img" src="' + esc(d.img) + '" onerror="this.style.display=\'none\'">' : '<div style="height:200px;background:#111;display:flex;align-items:center;justify-content:center;font-size:64px;border-radius:0;">🪑</div>') +
        '<div class="cv-modal-body">' +
          '<div class="cv-modal-title">' + esc(d.title) + '</div>' +
          '<div class="cv-modal-vendor">' + esc(d.vendor) + (d.sku ? ' · ' + esc(d.sku) : '') + '</div>' +
          (price ? '<div class="cv-modal-price cv-card-price">' + price + '</div>' : '') +
          (details.length > 0 ? '<div class="cv-modal-details">' + details.map(function(x) {
            return '<div class="cv-modal-detail"><div class="cv-modal-detail-label">' + x[0] + '</div><div>' + esc(x[1]) + '</div></div>';
          }).join('') + '</div>' : '') +
        '</div></div>';
      document.body.appendChild(modal);
    }

    function copyClientLink(projectId) {
      const url = window.location.origin + '/#/clientview/' + projectId;
      navigator.clipboard.writeText(url).then(() => {
        const btn = event.target.closest('button');
        const orig = btn.innerHTML;
        btn.innerHTML = '✓ Copied!';
        setTimeout(() => { btn.innerHTML = orig; }, 2000);
      }).catch(() => {
        prompt('Copy this client link:', url);
      });
    }

    async function clientApproveProposal(projectId, proposalId) {
      if (!confirm('Approve this entire proposal? This confirms you agree to all items and pricing shown.')) return;
      const doc = await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).get();
      const data = doc.data();
      const items = (data.items || []).map(it => ({ ...it, approved: true }));
      await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).update({
        status: 'Approved', items: items,
        approvedAt: new Date().toISOString(), approvedBy: 'client'
      });
      renderClientView(projectId);
    }

    async function clientApproveLine(projectId, propId, lineIdx) {
      const doc = await db.collection('boards').doc(projectId).collection('proposals').doc(propId).get();
      const items = doc.data().items || [];
      if (items[lineIdx]) { items[lineIdx].approved = true; items[lineIdx].declined = false; }
      await db.collection('boards').doc(projectId).collection('proposals').doc(propId).update({ items: items });
      renderClientView(projectId);
    }

    async function clientDeclineLine(projectId, propId, lineIdx) {
      const doc = await db.collection('boards').doc(projectId).collection('proposals').doc(propId).get();
      const items = doc.data().items || [];
      if (items[lineIdx]) { items[lineIdx].declined = true; items[lineIdx].approved = false; }
      await db.collection('boards').doc(projectId).collection('proposals').doc(propId).update({ items: items });
      renderClientView(projectId);
    }

    async function postClientUpdate(projectId) {
      const title = prompt('Update title (e.g. "Week 3 Progress"):');
      if (!title) return;
      const body = prompt('Update message for client:');
      if (!body) return;
      await db.collection('boards').doc(projectId).collection('notes').add({
        title: title.trim(), text: body.trim(),
        createdAt: new Date().toISOString(), author: currentUser.email,
        type: 'client-update', published: true
      });
      renderClientView(projectId);
    }

    // ==================== CLIENT MESSAGING ====================
    async function postClientMessage(projectId) {
      var input = document.getElementById('cv-chat-input');
      if (!input) return;
      var text = input.value.trim();
      if (!text) return;

      var from = (currentUser && currentUser.email) ? 'CCH Design' : 'Client';
      await db.collection('boards').doc(projectId).collection('messages').add({
        text: text,
        from: from,
        author: currentUser ? currentUser.email : 'client',
        timestamp: new Date().toISOString(),
        createdAt: new Date().toISOString()
      });
      input.value = '';

      // Log activity if owner
      if (currentUser && currentUser.email) {
        var projDoc = await db.collection('boards').doc(projectId).get();
        var projName = projDoc.exists ? (projDoc.data().name || projectId) : projectId;
        await logActivity('note', 'message', 'Client message sent: ' + text.substring(0, 80), projectId, projName, {});
      }

      // Reload messages
      await loadClientMessages(projectId);
    }

    async function loadClientMessages(projectId) {
      var list = document.getElementById('cv-comms-feed');
      if (!list) return;
      // After posting, reload and navigate back to comms
      await renderClientView(projectId);
      setTimeout(function() { cvNav(null, 'cv-comms'); }, 150);
    }

    // ==================== SMS FROM APP ====================
    async function sendTextFromApp(projectId) {
      if (!projectId) projectId = currentProjectId;
      var projDoc = await db.collection('boards').doc(projectId).get();
      var proj = projDoc.exists ? projDoc.data() : {};
      var defaultPhone = proj.clientPhone || '';

      var phone = prompt('Client phone number (with +1):', defaultPhone);
      if (!phone) return;
      var message = prompt('Message:');
      if (!message) return;

      try {
        var sendFn = firebase.functions().httpsCallable('sendClientText');
        var result = await sendFn({ projectId: projectId, toPhone: phone, message: message });
        if (result.data.success) {
          alert('✅ Text sent and saved in Activity Feed!');
          // Save phone to project if not already stored
          if (!proj.clientPhone) {
            await db.collection('boards').doc(projectId).update({ clientPhone: phone });
          }
        }
      } catch(err) {
        alert('SMS failed: ' + err.message + '\n\nMake sure Twilio is configured:\nfirebase functions:config:set twilio.sid="..." twilio.token="..." twilio.number="+1..."');
      }
    }

    let _cvPricingHidden = false;
    function cvTogglePricing() {
      _cvPricingHidden = !_cvPricingHidden;
      const btn = document.getElementById('cvPricingToggle');
