    // ===== REPORTS VIEW — Budget & Analysis Dashboards =====
    function renderFFEReportsView(clips, proj, allRooms, allCategories, allVendors, pos, roomBudgets, categoryBudgets) {
      let html = '';

      // ---- Report 1: Budget by Room ----
      const roomData = {};
      clips.forEach(c => {
        const rm = c.room || 'Unassigned';
        if (!roomData[rm]) roomData[rm] = { cost: 0, sell: 0, items: 0, approved: 0 };
        const cost = (parseFloat(c.cost) || 0) * (parseFloat(c.qty) || 1);
        const sell = parseFloat(c.totalSelling) || (parseFloat(c.clientPrice) || 0) * (parseFloat(c.qty) || 1);
        roomData[rm].cost += cost;
        roomData[rm].sell += sell;
        roomData[rm].items++;
        const st = c.selectionStatus || c.approvalStatus || 'Proposed';
        if (['Approved', 'Ordered', 'Received', 'Installed'].includes(st)) roomData[rm].approved++;
      });

      html += `
        <div style="margin-bottom:32px;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
            <div style="font-size:16px;font-weight:600;font-family:var(--font-display);letter-spacing:0.5px;">Budget by Room</div>
            <button class="btn btn-secondary btn-sm" onclick="ffeShowSetBudgetModal('${escAttr(proj.id)}')" style="font-size:11px;">💰 Set Room Budgets</button>
          </div>
          <div class="card" style="padding:0;overflow:hidden;">
            <table class="data-table" style="width:100%;font-size:12px;">
              <thead>
                <tr style="background:var(--gray-50);">
                  <th style="padding:10px 12px;text-align:left;">Room</th>
                  <th style="padding:10px 8px;text-align:center;">Items</th>
                  <th style="padding:10px 8px;text-align:right;">Budget</th>
                  <th style="padding:10px 8px;text-align:right;">Cost</th>
                  <th style="padding:10px 8px;text-align:right;">Sell Price</th>
                  <th style="padding:10px 8px;text-align:right;">Remaining</th>
                  <th style="padding:10px 8px;text-align:right;">Profit</th>
                  <th style="padding:10px 12px;min-width:160px;">Budget Usage</th>
                </tr>
              </thead>
              <tbody>
