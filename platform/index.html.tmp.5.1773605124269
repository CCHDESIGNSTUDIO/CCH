          // Preview line with time
          (timeLabel || previewTitles ? '<div onclick="event.stopPropagation();var d=document.getElementById(\'' + detailId + '\');d.style.display=d.style.display===\'none\'?\'block\':\'none\';" style="cursor:pointer;font-size:11px;color:var(--gold);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:3px;line-height:1.4;">' + (timeLabel ? '<span style="color:#fff;font-weight:600;">' + timeLabel + '</span> · ' : '') + esc(previewTitles) + '</div>' : '') +

