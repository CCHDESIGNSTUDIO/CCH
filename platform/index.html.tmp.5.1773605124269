            reader.onerror = reject;
            reader.readAsDataURL(f);
          });
          images.push({
            imageUrl: dataUrl,
            caption: f.name.replace(/\.[^.]+$/, ''),
            vendor: '',
            showPrice: true,
            showSource: true,
            stars: 0,
            comments: [],
            addedAt: new Date().toISOString(),
            source: 'upload'
          });
          added++;
        } catch(e) { console.warn('Failed to read file:', f.name, e); }
      }

      if (added > 0) {
        await db.collection('boards').doc(projectId).collection('ideabooks').doc(sectionId).update({ images: images });
        renderProjectDetail();
      }
    }

