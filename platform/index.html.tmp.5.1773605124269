    }

    async function saveProposalItem(projectId, proposalId, idx) {
      const doc = await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).get();
      const items = doc.data().items || [];
      const qty = parseFloat(document.getElementById('piQty').value) || 1;
      const cost = parseFloat(document.getElementById('piCost').value) || 0;
      const markupPct = parseFloat(document.getElementById('piMarkup').value) || 0;
      const shipping = parseFloat(document.getElementById('piShipping').value) || 0;
      const clientPrice = (cost * qty * (1 + markupPct / 100)) + shipping;
      items[idx] = {
        ...items[idx],
        title: document.getElementById('piTitle').value.trim(),
        category: document.getElementById('piCat').value.trim(),
        vendor: document.getElementById('piVendor').value.trim(),
        qty: qty,
        cost: cost,
        markupPct: markupPct,
        shipping: shipping,
        amount: clientPrice,
        imageUrl: document.getElementById('piImage').value.trim(),
        description: document.getElementById('piDesc').value.trim(),
        shipTo: (document.getElementById('piShipTo') || {}).value ? document.getElementById('piShipTo').value.trim() : (items[idx].shipTo || '')
      };
      const total = items.reduce((s, i) => s + (parseFloat(i.amount) || 0), 0);
      await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).update({ items, total });
      logDocActivity(projectId, 'proposals', proposalId, 'item_edited', 'Updated: ' + (document.getElementById('piTitle').value.trim() || 'Item ' + (idx+1)));
      closeModal();
      renderProposalDetail(projectId, proposalId);
    }

    async function removeProposalItem(projectId, proposalId, idx) {
      if (!confirm('Remove this item from the proposal?')) return;
      const doc = await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).get();
      const items = doc.data().items || [];
      var removedName = (items[idx] && items[idx].title) || 'Item ' + (idx+1);
      items.splice(idx, 1);
      const total = items.reduce((s, i) => s + (i.amount || 0), 0);
      await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).update({ items, total });
      logDocActivity(projectId, 'proposals', proposalId, 'item_removed', 'Removed: ' + removedName);
      renderProposalDetail(projectId, proposalId);
    }

    async function moveProposalItem(projectId, proposalId, idx, dir) {
      const newIdx = idx + dir;
      const doc = await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).get();
      const items = doc.data().items || [];
      if (newIdx < 0 || newIdx >= items.length) return;
      [items[idx], items[newIdx]] = [items[newIdx], items[idx]];
      await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).update({ items });
      renderProposalDetail(projectId, proposalId);
    }

