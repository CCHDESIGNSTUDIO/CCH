                  _sub += c * q * (1 + m / 100);
                  _ship += parseFloat(i.shipping) || 0;
                });
                _ship += parseFloat(prop.docShipping) || 0;
                const _taxRate = parseFloat(prop.taxRate) || 0;
                const _tax = _sub * (_taxRate / 100);
                const _grand = _sub + _ship + _tax;
                return `
