    // ── Timeline: New bucket prompt ──
    // Project picker: shows dropdown of existing projects + custom option
    function _tlPickProject(defaultVal, callback) {
      // Merge project sources
      var projects = [];
      var seen = {};
      // From time entries (active projects)
      (timeEntries || []).forEach(function(t) {
        if (t.project && t.project !== 'Unassigned' && !seen[t.project]) {
          seen[t.project] = true;
          projects.push(t.project);
        }
      });
      // From capture project list (boards + categories)
      (window._captureProjectList || []).forEach(function(p) {
        if (p && !seen[p]) { seen[p] = true; projects.push(p); }
      });
      projects.sort();

      // Build modal
      var modal = document.createElement('div');
      modal.id = 'tlProjectPicker';
      modal.style.cssText = 'position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;';
      var optionsHtml = projects.map(function(p) {
        return '<option value="' + escAttr(p) + '"' + (p === defaultVal ? ' selected' : '') + '>' + esc(p) + '</option>';
      }).join('');
      modal.innerHTML = '<div style="background:#1C1C1E;border:1px solid rgba(196,160,82,0.3);border-radius:0;padding:20px;width:300px;box-shadow:0 16px 48px rgba(0,0,0,0.4);">' +
        '<div style="font-size:13px;font-weight:700;color:#e8e8e8;margin-bottom:12px;">Select Project</div>' +
        '<select id="tlProjectPickerSelect" style="width:100%;padding:10px;background:#2C2C2E;color:#e8e8e8;border:1px solid rgba(255,255,255,0.15);border-radius:0;font-size:13px;margin-bottom:8px;outline:none;">' +
          '<option value="">— Choose project —</option>' +
          optionsHtml +
          '<option value="__custom__">+ Custom name...</option>' +
        '</select>' +
        '<input id="tlProjectPickerCustom" placeholder="Custom project name" style="display:none;width:100%;padding:10px;background:#2C2C2E;color:#e8e8e8;border:1px solid rgba(255,255,255,0.15);border-radius:0;font-size:13px;margin-bottom:12px;outline:none;box-sizing:border-box;" />' +
        '<div style="display:flex;gap:8px;">' +
          '<button id="tlProjectPickerOk" style="flex:1;padding:10px;background:var(--gold);color:white;border:none;border-radius:0;cursor:pointer;font-size:13px;font-weight:700;">Select</button>' +
          '<button id="tlProjectPickerCancel" style="padding:10px 16px;background:rgba(255,255,255,0.06);color:var(--gold);border:1px solid rgba(255,255,255,0.1);border-radius:0;cursor:pointer;font-size:13px;">Cancel</button>' +
        '</div>' +
      '</div>';
      document.body.appendChild(modal);

      var select = document.getElementById('tlProjectPickerSelect');
      var custom = document.getElementById('tlProjectPickerCustom');
      select.onchange = function() {
        custom.style.display = select.value === '__custom__' ? 'block' : 'none';
        if (select.value === '__custom__') custom.focus();
      };
      // Pre-select default if it exists
      if (defaultVal && seen[defaultVal]) {
        select.value = defaultVal;
      }
      document.getElementById('tlProjectPickerOk').onclick = function() {
        var val = select.value === '__custom__' ? custom.value.trim() : select.value;
        modal.remove();
        if (val) callback(val);
      };
      document.getElementById('tlProjectPickerCancel').onclick = function() {
        modal.remove();
      };
      modal.onclick = function(e) { if (e.target === modal) modal.remove(); };
      // Focus select
      setTimeout(function() { select.focus(); }, 50);
    }

