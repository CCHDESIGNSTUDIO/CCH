    async function saveNewUpdate(projectId) {
      var period = document.getElementById('upPeriod').value.trim();
      var greeting = document.getElementById('upGreeting').value.trim();
      if (!period) return;

      // Pre-populate sections from project data
      var rooms = [];
      try {
        var clipSnap = await db.collection('boards').doc(projectId).collection('clips').get();
        var roomSet = {};
        clipSnap.forEach(function(d) {
          var c = d.data();
          var room = c.room || c.category || 'General';
          if (!roomSet[room]) roomSet[room] = { name: room, items: 0, pct: 0 };
          roomSet[room].items++;
        });
        rooms = Object.values(roomSet);
      } catch(e) {}

      var data = {
        period: period,
        greeting: greeting,
        status: 'draft',
        rooms: rooms.map(function(r) {
          return { name: r.name, progress: 0, delivery: '', items: [] };
        }),
        approvals: [],
        palette: [],
        completed: [],
        upcoming: [],
        createdAt: new Date().toISOString()
      };

      var ref = await db.collection('boards').doc(projectId).collection('updates').add(data);
      closeModal();

      // Jump straight to editor
      editUpdate(projectId, ref.id);
    }

