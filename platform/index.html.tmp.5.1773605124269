              '</div>' +
            '</div>';
        }
      }

      // Update clip count
      try {
        await db.collection('boards').doc(projectId).update({ clipCount: firebase.firestore.FieldValue.increment(created) });
      } catch(e) {}

      // Show results
      if (progress) {
        progress.innerHTML = `
          <div style="text-align:center;padding:24px;">
            <div style="font-size:40px;margin-bottom:12px;">✅</div>
