      if (under15.length === 0) { alert('No entries at or under 15 minutes to consolidate.'); return; }

      // Group by project + date
      const groups = {};
      under15.forEach(t => {
        const key = (t.project || 'Unassigned') + '||' + (t.date || '');
        if (!groups[key]) groups[key] = { project: t.project || 'Unassigned', date: t.date || '', entries: [], rate: 0 };
        groups[key].entries.push(t);
        groups[key].rate = groups[key].rate || (parseFloat(t.rate) || 0);
      });

      const groupList = Object.entries(groups).sort(([,a],[,b]) => (b.entries.length - a.entries.length));
      const roundUp15 = (hrs) => Math.ceil(hrs / 0.25) * 0.25; // round up to next 15min
      const fmtHrs = (h) => { const m = Math.round(h * 60); return m >= 60 ? Math.floor(m/60)+'h '+(m%60)+'m' : m+'m'; };
      const fmtMoney = (n) => '$' + parseFloat(n).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0});

      const totalRaw = under15.reduce((s,t) => s + (parseFloat(t.hours)||0), 0);
      const totalRounded = groupList.reduce((s,[,g]) => s + roundUp15(g.entries.reduce((gs,t) => gs + (parseFloat(t.hours)||0), 0)), 0);

      document.getElementById('modalContainer').innerHTML = `
        <div class="modal-overlay" onclick="if(event.target===this)closeModal()">
          <div class="modal" style="width:780px;max-height:88vh;display:flex;flex-direction:column;">
            <div class="modal-header" style="flex-shrink:0;">
              <div>
                <div class="modal-title">⚡ Consolidate Small Entries</div>
                <div style="font-size:12px;color:var(--gray-400);margin-top:2px;">${under15.length} entries under 15min · ${groupList.length} project/date groups · Check the groups you want to merge</div>
              </div>
              <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>

            <div style="padding:12px 24px;background:var(--gray-50);border-bottom:1px solid var(--gray-200);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">
              <div style="display:flex;gap:16px;align-items:center;">
                <label style="font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;">
                  <input type="checkbox" id="consolidateSelectAll" onchange="toggleAllConsolidateGroups(this.checked)" checked>
                  Select All Groups
                </label>
                <span id="consolidateSelCount" style="font-size:12px;color:var(--gray-500);">${groupList.length} of ${groupList.length} selected</span>
              </div>
              <div style="font-size:12px;color:var(--gray-500);">Raw: ${fmtHrs(totalRaw)} → Rounded: <strong style="color:var(--black);">${fmtHrs(totalRounded)}</strong> · Est. <strong style="color:var(--green);">${fmtMoney(totalRounded * (groupList[0]?.[1]?.rate || 150))}</strong></div>
            </div>

            <div style="overflow-y:auto;flex:1;padding:16px 24px;">
              ${groupList.map(([key, g], idx) => {
                const rawHrs = g.entries.reduce((s,t) => s + (parseFloat(t.hours)||0), 0);
                const roundedHrs = roundUp15(rawHrs);
                const billable = roundedHrs * g.rate;
                const services = [...new Set(g.entries.map(t => t.service).filter(Boolean))];
                const descriptions = [...new Set(g.entries.map(t => t.description).filter(Boolean))];
                const suggestedDesc = descriptions.length > 0 ? descriptions[0] : (services.length > 0 ? services[0] : '');
                return `
                <div class="consolidate-group" id="cg-${idx}" style="border:2px solid var(--gray-200);border-radius:0;padding:16px;margin-bottom:12px;transition:all 0.15s;">
                  <div style="display:flex;align-items:flex-start;gap:12px;">
                    <input type="checkbox" class="cg-checkbox" data-idx="${idx}" checked
                      onchange="updateConsolidateGroupStyle(${idx},this.checked);updateConsolidateSelCount()"
                      style="margin-top:3px;width:16px;height:16px;flex-shrink:0;cursor:pointer;">
                    <div style="flex:1;min-width:0;">
                      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:8px;">
                        <div>
                          <div style="font-weight:700;font-size:14px;">${esc(g.project)}</div>
                          <div style="font-size:12px;color:var(--gray-400);margin-top:2px;">${g.date} · ${g.entries.length} entr${g.entries.length===1?'y':'ies'} · raw: ${fmtHrs(rawHrs)} → <strong style="color:var(--gold);">${fmtHrs(roundedHrs)}</strong></div>
                        </div>
                        <div style="text-align:right;flex-shrink:0;">
                          <div style="font-size:18px;font-weight:700;color:var(--gold);">${fmtHrs(roundedHrs)}</div>
                          ${g.rate > 0 ? `<div style="font-size:12px;color:var(--gray-500);">~${fmtMoney(billable)}</div>` : ''}
                        </div>
                      </div>
                      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                        <input type="text" class="form-input cg-desc-input" data-idx="${idx}"
                          value="${escAttr(suggestedDesc)}"
                          placeholder="Billing description (optional)"
                          style="flex:1;min-width:200px;font-size:13px;padding:7px 10px;">
                        <button class="btn btn-sm cg-details-btn" data-idx="${idx}" onclick="toggleConsolidateDetails(${idx})" style="font-size:12px;white-space:nowrap;">▼ Details</button>
                      </div>
                      <div id="cg-details-${idx}" style="display:none;margin-top:10px;background:var(--gray-50);border-radius:0;padding:10px;font-size:12px;">
                        ${g.entries.map(t => `
                          <div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--gray-100);">
