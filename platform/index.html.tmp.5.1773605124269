      const todayEntries = myTimeEntries.filter(t => t.date === todayStr);
      const todayHours = todayEntries.reduce((s,t) => s + (parseFloat(t.hours) || 0), 0);
      const todayBillable = todayEntries.filter(t => t.billable !== false).reduce((s,t) => s + (parseFloat(t.hours) || 0), 0);
      const todayNonBillable = todayHours - todayBillable;
      const todayProjects = [...new Set(todayEntries.map(t => t.project || t.projectName).filter(Boolean))];
      const userRate = (isOwner && window._dashboardView !== 'contractor') ? 150 : (avgRate || 75);
      const todayBillableValue = todayBillable * userRate;

