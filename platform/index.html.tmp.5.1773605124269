        ...pos.map(p => ({ type: 'po', icon: '📦', label: p.number || p.num || p.id.slice(0,8), id: p.id, collection: 'purchaseOrders', total: p.total, status: p.status, linked: { proposal: p.linkedProposalId, invoice: p.linkedInvoiceId } }))
