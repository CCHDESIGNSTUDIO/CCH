    // Color extraction from image
    function ibLbExtractColors(imgUrl) {
      var img = new Image();
      img.crossOrigin = 'anonymous';
      img.referrerPolicy = 'no-referrer';
      img.onload = function() {
        try {
          var canvas = document.createElement('canvas');
          var size = 50;
          canvas.width = size; canvas.height = size;
          var ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, size, size);
          var data = ctx.getImageData(0, 0, size, size).data;
          // Simple k-means-ish: sample pixels, cluster into 5 colors
          var samples = [];
          for (var i = 0; i < data.length; i += 16) {
            samples.push([data[i], data[i+1], data[i+2]]);
          }
          // Pick 5 diverse colors
          var colors = [samples[0]];
          for (var c = 1; c < 5 && samples.length > 0; c++) {
            var bestDist = -1, bestIdx = 0;
            for (var j = 0; j < samples.length; j++) {
              var minDist = Infinity;
              for (var k = 0; k < colors.length; k++) {
                var d = Math.abs(samples[j][0]-colors[k][0]) + Math.abs(samples[j][1]-colors[k][1]) + Math.abs(samples[j][2]-colors[k][2]);
                if (d < minDist) minDist = d;
              }
              if (minDist > bestDist) { bestDist = minDist; bestIdx = j; }
            }
            if (bestDist > 30) colors.push(samples[bestIdx]);
          }
          var container = document.getElementById('ibLbColors');
          var section = document.getElementById('ibLbColorSection');
          if (container && section && colors.length > 1) {
            section.style.display = 'block';
            container.innerHTML = colors.map(function(c) {
              return '<div class="ib-lb-color-dot" style="background:rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')" title="rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')"></div>';
            }).join('');
          }
        } catch(e) { /* CORS or other error — skip colors */ }
      };
      img.src = imgUrl;
    }

