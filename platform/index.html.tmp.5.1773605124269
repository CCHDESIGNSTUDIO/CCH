    // ── Theme Manager ──
    function setTheme(theme) {
      if (theme === 'classic') {
        document.documentElement.setAttribute('data-theme', 'classic');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
      localStorage.setItem('cch-theme', theme);
      updateThemeToggle(theme);
    }
    function updateThemeToggle(theme) {
      const btnS = document.getElementById('themeBtnStudio');
      const btnC = document.getElementById('themeBtnClassic');
      if (!btnS || !btnC) return;
      if (theme === 'classic') {
        btnS.style.border = '1px solid rgba(139,115,85,0.15)';
        btnS.style.background = 'transparent';
        btnS.style.color = 'rgba(0,0,0,0.3)';
        btnC.style.border = '1px solid var(--gold)';
        btnC.style.background = 'var(--gold-light)';
        btnC.style.color = 'var(--gold)';
      } else {
        btnS.style.border = '1px solid var(--gold)';
        btnS.style.background = 'var(--gold-light)';
        btnS.style.color = 'var(--gold)';
        btnC.style.border = '1px solid rgba(255,255,255,0.08)';
        btnC.style.background = 'transparent';
        btnC.style.color = 'rgba(255,255,255,0.3)';
