    function docEditFieldChange(el) {
      const idx = parseInt(el.dataset.idx);
      const field = el.dataset.field;
      if (field === 'room') { _docEdit.items[idx].room = el.value; _docEdit.items[idx].category = el.value; }
      else _docEdit.items[idx][field] = el.value;
      docEditAutoSave();
    }

    function docEditNumChange(el) {
      const idx = parseInt(el.dataset.idx);
      const field = el.dataset.field;
      _docEdit.items[idx][field] = parseFloat(el.value) || 0;
      // Recalc row totals
      const row = document.getElementById('docEditRow' + idx);
      if (row) {
        const item = _docEdit.items[idx];
        const qty = parseFloat(item.qty) || 1;
        const cost = parseFloat(item.cost) || 0;
        const mkup = parseFloat(item.markupPct) || 0;
        const ship = parseFloat(item.shipping) || 0;
        const total = (cost * qty * (1 + mkup / 100)) + ship;
        const mkupDollar = cost * qty * (mkup / 100);
        item.amount = total;
        const calcs = row.querySelectorAll('input.calc');
        if (calcs[0]) calcs[0].value = mkupDollar.toFixed(2);
        if (calcs[1]) calcs[1].value = total.toFixed(2);
      }
      docEditRecalcTotals();
      docEditAutoSave();
    }

    function docEditRecalcTotals() {
      const items = _docEdit.items;
      let subtotal = 0, totalShipping = 0;
      items.forEach(item => {
        const qty = parseFloat(item.qty) || 1;
        const cost = parseFloat(item.cost) || 0;
        const mkup = parseFloat(item.markupPct) || 0;
        const ship = parseFloat(item.shipping) || 0;
        subtotal += cost * qty * (1 + mkup / 100);
        totalShipping += ship;
      });
      const taxRate = parseFloat(_docEdit.docData.taxRate) || 0;
      const tax = subtotal * (taxRate / 100);
      const grandTotal = subtotal + totalShipping + tax;

      // Payments
      const payments = _docEdit.docData.payments || [];
      const totalPaid = payments.reduce((s,p) => s + (parseFloat(p.amount) || 0), 0);
      const balance = grandTotal - totalPaid;

      // Calculate expense breakdown for POs
      var _expBreakdown = {};
      if (_docEdit.type === 'po') {
        items.forEach(function(item) {
          var et = item.expenseType || 'product';
          var qty = parseFloat(item.qty) || 1;
          var cost = parseFloat(item.cost) || 0;
          var ship = parseFloat(item.shipping) || 0;
          var lt = (cost * qty) + ship;
          if (!_expBreakdown[et]) _expBreakdown[et] = 0;
          _expBreakdown[et] += lt;
        });
      }
      var _expLabels = { product: 'Products', sales_tax: 'Pre-Paid Sales Tax', shipping: 'Shipping/Freight', handling: 'Handling Fees', other_expense: 'Other Expenses' };
      var _expColors = { product: 'var(--cyan)', sales_tax: '#E16A5B', shipping: 'var(--gold)', handling: '#9B59B6', other_expense: 'var(--gray-400)' };

      const el = document.getElementById('docEditTotals');
      if (el) {
        var _expRows = '';
        if (_docEdit.type === 'po' && Object.keys(_expBreakdown).length > 1) {
          _expRows = '<tr><td colspan="2" style="padding-top:8px;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--gray-400);border-top:1px solid var(--gray-200);">Expense Breakdown</td></tr>';
          Object.keys(_expBreakdown).forEach(function(et) {
            if (_expBreakdown[et] > 0) {
              _expRows += '<tr><td style="color:' + (_expColors[et] || '#fff') + ';font-size:12px;">' + (_expLabels[et] || et) + '</td><td style="color:' + (_expColors[et] || '#fff') + ';">' + formatMoney(_expBreakdown[et]) + '</td></tr>';
            }
          });
        } else if (_docEdit.type === 'po' && _expBreakdown['sales_tax']) {
          _expRows = '<tr><td style="color:#E16A5B;font-size:12px;">Pre-Paid Sales Tax</td><td style="color:#E16A5B;">' + formatMoney(_expBreakdown['sales_tax']) + '</td></tr>';
        }
        el.innerHTML = '<table>' +
          '<tr><td>Subtotal</td><td>' + formatMoney(subtotal) + '</td></tr>' +
          (totalShipping > 0 ? '<tr><td>Shipping Cost</td><td>' + formatMoney(totalShipping) + '</td></tr>' : '') +
          '<tr><td>Sales Tax' + (taxRate > 0 ? ' (' + taxRate + '%)' : '') + '</td><td>' + formatMoney(tax) + '</td></tr>' +
          '<tr class="total-line"><td>Total</td><td>' + formatMoney(grandTotal) + '</td></tr>' +
          (totalPaid > 0 ? '<tr><td style="color:var(--green);">Payments</td><td style="color:var(--green);">-' + formatMoney(totalPaid) + '</td></tr>' : '') +
          (totalPaid > 0 ? '<tr class="total-line"><td><strong>Balance Due</strong></td><td><strong style="color:' + (balance <= 0 ? 'var(--green)' : 'var(--gold)') + ';">' + formatMoney(balance) + '</strong></td></tr>' : '') +
          _expRows +
        '</table>';
      }
      // Update header total — show balance if payments exist
      const htEl = document.getElementById('docEditHeaderTotal');
      if (htEl) {
        if (totalPaid > 0) {
          htEl.innerHTML = '<span style="font-size:28px;font-weight:700;color:' + (balance <= 0 ? 'var(--green)' : 'var(--gold)') + ';">' + formatMoney(balance) + '</span>' +
            '<div style="font-size:11px;color:var(--gray-400);margin-top:2px;">of ' + formatMoney(grandTotal) + ' total</div>';
        } else {
          htEl.textContent = formatMoney(grandTotal);
        }
      }
      // Update balance display
      const balEl = document.getElementById('docEditBalanceDisplay');
      if (balEl) balEl.textContent = formatMoney(balance);
    }

    let _docEditSaveTimer = null;
    function docEditAutoSave() {
      clearTimeout(_docEditSaveTimer);
      _docEditSaveTimer = setTimeout(docEditSave, 1500);
    }

    var _docEditSaveCount = 0;
    async function docEditSave() {
      const d = _docEdit;
      if (!d.projectId || !d.docId || !d.collection) return;
      // Recalc all amounts
      let grandTotal = 0;
      d.items.forEach(item => {
        const qty = parseFloat(item.qty) || 1;
        const cost = parseFloat(item.cost) || 0;
        const mkup = parseFloat(item.markupPct) || 0;
        const ship = parseFloat(item.shipping) || 0;
        item.amount = (cost * qty * (1 + mkup / 100)) + ship;
        grandTotal += item.amount;
      });
      var _editUser = (currentUser && currentUser.displayName) || (currentUser && currentUser.email) || 'Unknown';
      try {
        var _updatePayload = {
          items: d.items, total: grandTotal, updatedAt: new Date().toISOString(),
          lastEditedBy: _editUser,
          lastEditedByEmail: (currentUser && currentUser.email) || '',
          lastEditedAt: new Date().toISOString()
        };
        await db.collection('boards').doc(d.projectId).collection(d.collection).doc(d.docId).update(_updatePayload);
        // Log activity only every 10th save to avoid noise from auto-save
        _docEditSaveCount++;
        if (_docEditSaveCount === 1 || _docEditSaveCount % 10 === 0) {
          logDocActivity(d.projectId, d.collection, d.docId, 'edited', d.items.length + ' items, total ' + formatMoney(grandTotal));
        }
        // Flash save indicator
        const ind = document.getElementById('docEditSaveInd');
        if (ind) { ind.textContent = '✓ Saved'; ind.style.color = 'var(--green)'; setTimeout(() => { if (ind) ind.textContent = ''; }, 2000); }
      } catch(e) { console.error('Save failed:', e); }
      invalidateSearchCache();
    }

