              <div class="clip-card-body">
                <div class="clip-card-title">${esc(p.title || 'Untitled')}</div>
                ${p.vendor ? `<div class="clip-card-vendor">${esc(p.vendor)}</div>` : ''}
                ${p.category ? `<div style="font-size:11px;color:var(--gray-400);margin-top:2px;">${esc(p.category)}</div>` : ''}
              </div>
            </div>
          `).join('')}
        </div>`;
      }

      T.innerHTML = `
        <h1 class="page-title">Product Library</h1>
        <p style="color:var(--gray-400);margin-bottom:20px;">${hasMore ? 'Showing ' + DISPLAY_LIMIT + ' of ' + filtered.length : filtered.length} product${filtered.length !== 1 ? 's' : ''}${hasMore ? ' — use search to find more' : ''}</p>

        <div style="display:flex;gap:12px;margin-bottom:24px;flex-wrap:wrap;align-items:center;">
