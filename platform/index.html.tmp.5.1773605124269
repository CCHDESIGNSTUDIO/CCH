            style="flex:1;min-width:200px;">
          <select class="form-input" style="width:180px;" onchange="libraryFilter.vendor=this.value;renderLibraryView()">
            <option value="">All Vendors</option>
            ${vendors.map(v => `<option value="${escAttr(v)}" ${libraryFilter.vendor === v ? 'selected' : ''}>${esc(v)}</option>`).join('')}
          </select>
          <select class="form-input" style="width:180px;" onchange="libraryFilter.category=this.value;renderLibraryView()">
            <option value="">All Categories</option>
