            '<div style="font-size:13px;font-weight:700;color:' + (isMeeting ? '#CE93D8' : '#E8E8E8') + ';overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;">' +
              (meetingLabel ? meetingLabel + ' ' : '') + appNameHtml +
            '</div>' +
