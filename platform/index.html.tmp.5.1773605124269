    function filterProjects(text) {
      projectsFilterText = text.toLowerCase().trim();
      renderProjectsView();
    }

    function sortProjectsBy(field) {
      if (projectsSortField === field) {
        projectsSortDir = projectsSortDir === 'asc' ? 'desc' : 'asc';
      } else {
        projectsSortField = field;
        projectsSortDir = field === 'name' ? 'asc' : 'desc';
      }
      renderProjectsView();
    }

    function renderProjectsView() {
      const C = document.getElementById('projectsContainer');
      if (!C) return;

      // Filter
      let filtered = projects.filter(p => {
        if (!projectsFilterText) return true;
        const name = (p.name || p.id).toLowerCase();
        const client = (p.clientName || '').toLowerCase();
        const status = (p.status || '').toLowerCase();
        return name.includes(projectsFilterText) || client.includes(projectsFilterText) || status.includes(projectsFilterText);
      });

      // Sort
      const sf = projectsSortField;
      const dir = projectsSortDir === 'asc' ? 1 : -1;
      filtered.sort((a, b) => {
        let va, vb;
        if (sf === 'name') { va = (a.name || a.id).toLowerCase(); vb = (b.name || b.id).toLowerCase(); return va < vb ? -dir : va > vb ? dir : 0; }
        if (sf === 'items') { return ((a.clipCount || 0) - (b.clipCount || 0)) * dir; }
        if (sf === 'invoices') { return ((a.invoiceCount || 0) - (b.invoiceCount || 0)) * dir; }
        if (sf === 'proposals') { return ((a.proposalCount || 0) - (b.proposalCount || 0)) * dir; }
        if (sf === 'status') { va = (a.status || '').toLowerCase(); vb = (b.status || '').toLowerCase(); return va < vb ? -dir : va > vb ? dir : 0; }
        if (sf === 'updated') { va = a.updatedAt || a.createdAt || ''; vb = b.updatedAt || b.createdAt || ''; return va < vb ? -dir : va > vb ? dir : 0; }
        return 0;
      });

      const arrow = (field) => projectsSortField === field ? (projectsSortDir === 'asc' ? ' ▲' : ' ▼') : '';

      if (filtered.length === 0) {
        C.innerHTML = '<div class="empty-state"><div class="empty-icon">📁</div><div class="empty-text">' +
          (projectsFilterText ? 'No projects match "' + esc(projectsFilterText) + '"' : 'No projects yet.') +
          '</div></div>';
        return;
      }

      if (projectsViewMode === 'list') {
        C.innerHTML = `
          <table class="project-list-table">
            <thead><tr>
              <th onclick="sortProjectsBy('name')">Project${arrow('name') ? '<span class="sort-arrow">' + arrow('name') + '</span>' : ''}</th>
              <th onclick="sortProjectsBy('status')">Status${arrow('status') ? '<span class="sort-arrow">' + arrow('status') + '</span>' : ''}</th>
              <th onclick="sortProjectsBy('items')" style="text-align:center">Items${arrow('items') ? '<span class="sort-arrow">' + arrow('items') + '</span>' : ''}</th>
              <th onclick="sortProjectsBy('invoices')" style="text-align:center">Invoices${arrow('invoices') ? '<span class="sort-arrow">' + arrow('invoices') + '</span>' : ''}</th>
              <th onclick="sortProjectsBy('proposals')" style="text-align:center">Proposals${arrow('proposals') ? '<span class="sort-arrow">' + arrow('proposals') + '</span>' : ''}</th>
              <th onclick="sortProjectsBy('updated')">Last Updated${arrow('updated') ? '<span class="sort-arrow">' + arrow('updated') + '</span>' : ''}</th>
            </tr></thead>
            <tbody>
              ${filtered.map(p => {
                const name = p.name || p.id.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
                const status = p.status || 'In Progress';
                const statusClass = status === 'In Progress' ? 'active' : status === 'Completed' ? 'completed' : 'hold';
                const updated = p.updatedAt ? new Date(p.updatedAt).toLocaleDateString() : (p.createdAt ? new Date(p.createdAt).toLocaleDateString() : '-');
                return '<tr onclick="navigate(\'#/project/' + p.id + '\')">' +
                  '<td><span class="proj-name">' + esc(name) + '</span>' + (p.clientName ? '<br><span class="proj-client">' + esc(p.clientName) + '</span>' : '') + '</td>' +
                  '<td><span class="project-status status-' + statusClass + '">' + esc(status) + '</span></td>' +
                  '<td class="proj-count">' + (p.clipCount || 0) + '</td>' +
                  '<td class="proj-count">' + (p.invoiceCount || 0) + '</td>' +
                  '<td class="proj-count">' + (p.proposalCount || 0) + '</td>' +
                  '<td style="font-size:12px;color:var(--gray-400)">' + updated + '</td>' +
                  '</tr>';
              }).join('')}
            </tbody>
          </table>
        `;
      } else {
        C.innerHTML = '<div class="projects-grid">' + filtered.map(p => projectCardHTML(p)).join('') + '</div>';
      }
    }

    function projectCardHTML(p) {
      const name = p.name || p.id.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      const status = p.status || 'In Progress';
