    // Load invoices for product
    async function loadInvoicesForProduct(product) {
      var el = document.getElementById('productInvoiceList');
      if (!el) return;
      try {
        var snap = await db.collection('invoices').limit(200).get();
        var matched = [];
        var searchTitle = (product.title || '').toLowerCase();
        var searchVendor = (product.vendor || '').toLowerCase();
        snap.forEach(function(d) {
          var inv = d.data();
          var items = inv.items || inv.lineItems || [];
          var hasMatch = false;
          if (Array.isArray(items)) {
            hasMatch = items.some(function(item) {
              return ((item.title || item.description || '').toLowerCase().includes(searchTitle) ||
                      (item.product || '').toLowerCase().includes(searchTitle));
            });
          }
          if (!hasMatch) {
            var desc = (inv.description || inv.notes || '').toLowerCase();
            hasMatch = searchTitle.length > 4 && desc.includes(searchTitle);
          }
          if (hasMatch) matched.push({ id: d.id, ...inv });
        });
        if (matched.length === 0) {
          el.innerHTML = '<div style="font-style:italic;">No invoices found.</div>';
        } else {
          el.innerHTML = matched.map(function(inv) {
            return '<div style="padding:6px 10px;background:var(--gray-50);border-radius:0;margin-bottom:4px;cursor:pointer;" onclick="closeModal();navigate(\'#/invoices\')">' +
              '<div style="font-size:12px;font-weight:600;">' + esc(inv.number || inv.invoiceNumber || 'Invoice') + '</div>' +
              '<div style="font-size:11px;color:var(--gray-400);">' + esc(inv.client || inv.projectName || '') + (inv.total ? ' · $' + parseFloat(inv.total).toLocaleString('en-US',{minimumFractionDigits:2}) : '') + '</div>' +
            '</div>';
          }).join('');
        }
      } catch(e) { if (el) el.innerHTML = '<div style="font-style:italic;">Unable to load invoices.</div>'; }
    }

    async function loadPOsForProduct(product) {
      const el = document.getElementById('productPOList');
      if (!el) return;
      try {
        // Search all POs across all projects for this product by title/vendor/sku match
        const projSnap = await db.collection('boards').get();
        const matched = [];
        const searchTitle = (product.title || '').toLowerCase();
        const searchVendor = (product.vendor || '').toLowerCase();
        const searchSku = (product.sku || '').toLowerCase();
        for (const projDoc of projSnap.docs) {
          const projName = projDoc.data().name || projDoc.id.split('-').map(w=>w.charAt(0).toUpperCase()+w.slice(1)).join(' ');
          try {
            const poSnap = await db.collection('boards').doc(projDoc.id).collection('purchaseOrders').get();
            poSnap.forEach(d => {
              const po = d.data();
              // Match by libraryProductId or by title/vendor/sku in description/items
              const desc = ((po.description||'')).toLowerCase();
              const vendor = (po.vendor||'').toLowerCase();
              const hasMatch = (product.id && po.libraryProductId === product.id) ||
                (searchSku && desc.includes(searchSku)) ||
                (searchTitle && searchTitle.length > 4 && desc.includes(searchTitle)) ||
                (searchVendor && vendor === searchVendor && desc.includes(searchTitle.substring(0,6)));
              if (hasMatch) matched.push({ id: d.id, projectId: projDoc.id, projectName: projName, ...po });
            });
          } catch(e) {}
        }
        if (!el) return;
        if (matched.length === 0) {
          el.innerHTML = '<div style="font-size:12px;color:var(--gray-400);font-style:italic;">No POs found for this product.</div>';
        } else {
          const statusColors = { 'Draft':'var(--gray-400)', 'Sent':'var(--gold)', 'Ordered':'#0097A7', 'Received':'var(--green)', 'On Hold':'#6A1B9A', 'Cancelled':'var(--gray-300)' };
          el.innerHTML = matched.map(po => `
            <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:var(--gray-50);border-radius:0;margin-bottom:6px;cursor:pointer;" onclick="closeModal();navigate('#/project/${po.projectId}/pos')">
              <div>
                <div style="font-size:13px;font-weight:600;">${esc(po.number||'PO')}</div>
                <div style="font-size:11px;color:var(--gray-400);">${esc(po.projectName)} · ${esc(po.vendor||'')}</div>
              </div>
              <div style="text-align:right;">
                <span style="font-size:11px;padding:2px 8px;border-radius:0;background:var(--gray-100);color:${statusColors[po.status]||'var(--gray-400)'};font-weight:600;">${esc(po.status||'Draft')}</span>
                ${po.total ? `<div style="font-size:12px;font-weight:700;margin-top:2px;">$${parseFloat(po.total).toLocaleString('en-US',{minimumFractionDigits:2})}</div>` : ''}
              </div>
            </div>`).join('');
        }
      } catch(e) {
        if (el) el.innerHTML = '<div style="font-size:12px;color:var(--gray-400);">Unable to load POs.</div>';
      }
    }

