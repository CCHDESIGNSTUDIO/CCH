    // Data cache for financial pages
    let _cachedProposals = null, _cachedInvoices = null, _cachedPOs = null, _cachedProjNames = null, _cachedProjList = null;
    let _cacheTime = 0;
    const CACHE_TTL = 60000; // 1 minute

    async function loadFinancialData(forceRefresh) {
      if (!forceRefresh && _cachedProjNames && Date.now() - _cacheTime < CACHE_TTL) return;
      const projSnap = await db.collection('boards').get();
      _cachedProjNames = {}; _cachedProjList = [];
      projSnap.forEach(d => { _cachedProjNames[d.id] = d.data().name || d.id; _cachedProjList.push({ id: d.id, name: d.data().name || d.id }); });

      // Load all in parallel
      const promises = Object.keys(_cachedProjNames).map(async pid => {
        const result = { proposals: [], invoices: [], pos: [] };
        try {
          const ps = await db.collection('boards').doc(pid).collection('proposals').get();
          ps.forEach(d => result.proposals.push({ id: d.id, projectId: pid, projectName: _cachedProjNames[pid], ...d.data() }));
        } catch(e) {}
        try {
          const is = await db.collection('boards').doc(pid).collection('invoices').get();
          is.forEach(d => result.invoices.push({ id: d.id, projectId: pid, projectName: _cachedProjNames[pid], ...d.data() }));
        } catch(e) {}
        try {
          const ps2 = await db.collection('boards').doc(pid).collection('purchaseOrders').get();
          ps2.forEach(d => result.pos.push({ id: d.id, projectId: pid, projectName: _cachedProjNames[pid], ...d.data() }));
        } catch(e) {}
        return result;
      });

      const results = await Promise.all(promises);
      _cachedProposals = []; _cachedInvoices = []; _cachedPOs = [];
      results.forEach(r => {
        _cachedProposals.push(...r.proposals);
        _cachedInvoices.push(...r.invoices);
        _cachedPOs.push(...r.pos);
      });

      // Also build POs from clips that have poNum (Houzz import stored PO data as clips)
      const clipPromises = Object.keys(_cachedProjNames).map(async pid => {
        try {
          const clipSnap = await db.collection('boards').doc(pid).collection('clips').get();
          const poMap = {};
          clipSnap.forEach(d => {
            const c = d.data();
            if (c.poNum) {
              if (!poMap[c.poNum]) {
                poMap[c.poNum] = { id: 'clip-po-' + c.poNum, projectId: pid, projectName: _cachedProjNames[pid],
                  number: c.poNum, num: c.poNum, vendor: c.vendor || '', status: c.status || 'Ordered',
                  date: c.poDate || '', orderDate: c.poDate || '', createdAt: c.savedAt || '',
                  total: 0, items: [], source: 'clip-derived' };
              }
              poMap[c.poNum].total += (c.totalCost || c.cost || 0);
              poMap[c.poNum].items.push(c);
              if (c.vendor && !poMap[c.poNum].vendor) poMap[c.poNum].vendor = c.vendor;
            }
          });
          return Object.values(poMap);
        } catch(e) { return []; }
      });
      const clipPOs = await Promise.all(clipPromises);
      clipPOs.forEach(arr => {
        arr.forEach(po => {
          // Only add if not already in purchaseOrders collection
          if (!_cachedPOs.find(existing => existing.num === po.num && existing.projectId === po.projectId)) {
            _cachedPOs.push(po);
          }
        });
      });

      // Normalize statuses globally
      _cachedInvoices.forEach(inv => { if (inv.status === 'Estimated') inv.status = 'Invoiced'; });
      _cachedProposals.forEach(pr => { if (pr.status === 'Estimated') pr.status = 'Approved'; });

      _cacheTime = Date.now();
    }

