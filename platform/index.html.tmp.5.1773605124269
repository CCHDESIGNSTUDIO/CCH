    async function renderVendors() {
      setBreadcrumb([{ label: 'Vendors' }]);
      setTopbarActions('<button class="btn btn-primary" onclick="showNewVendorModal()">+ New Vendor</button>');

      const T = document.getElementById('contentArea');
      T.innerHTML = '<div style="text-align:center;padding:60px;color:var(--gray-400);">Loading vendors...</div>';

      const vendorMap = {};

      // 1. Load from vendors collection (full contact info)
      try {
        const vSnap = await db.collection('vendors').limit(3000).get();
        vSnap.forEach(function(d) {
          var v = d.data();
          var name = (v.name || v.company || v.vendor || '').trim();
          if (!name) return;
          vendorMap[name] = {
            id: d.id, name: name,
            description: v.description || v.type || v.specialty || '',
            type: v.type || v.vendorType || '',
            contact: v.contact || v.contactName || v.rep || '',
            email: v.email || v.contactEmail || '',
            phone: v.phone || v.contactPhone || v.tel || '',
            tags: v.tags || v.categories || '',
            website: v.website || v.url || '',
            productCount: 0, totalCost: 0, totalSell: 0,
            source: 'vendors'
          };
        });
        console.log('[Vendors] Loaded', Object.keys(vendorMap).length, 'from vendors collection');
      } catch(e) {
        console.log('[Vendors] No vendors collection or error:', e.message);
      }

      // 2. Merge product-derived vendor data
      try {
        const pSnap = await db.collection('products').limit(3000).get();
        pSnap.forEach(function(d) {
          var p = d.data();
          var name = (p.vendor || p.manufacturer || '').trim();
          if (!name) return;
          if (!vendorMap[name]) {
            vendorMap[name] = {
              name: name, description: '', type: '', contact: '', email: '', phone: '', tags: '',
              website: p.vendorUrl || '', productCount: 0, totalCost: 0, totalSell: 0, source: 'products'
            };
          }
          vendorMap[name].productCount++;
          vendorMap[name].totalCost += parseFloat(p.cost || p.costPrice) || 0;
          vendorMap[name].totalSell += parseFloat(p.clientPrice || p.sellPrice || p.totalSelling) || 0;
          if (!vendorMap[name].tags && p.category) vendorMap[name].tags = p.category;
        });
      } catch(e) { console.error('Product load error:', e); }

      vendorsCache = Object.values(vendorMap);
      vendorsTotalCount = vendorsCache.length;
      renderVendorsList();
    }

    function renderVendorsList() {
      const T = document.getElementById('contentArea');
      let filtered = vendorsCache;
      if (vendorSearch) {
        const s = vendorSearch.toLowerCase();
        filtered = filtered.filter(function(v) {
          return (v.name || '').toLowerCase().includes(s) ||
                 (v.description || '').toLowerCase().includes(s) ||
                 (v.contact || '').toLowerCase().includes(s) ||
                 (v.email || '').toLowerCase().includes(s) ||
                 (v.tags || '').toLowerCase().includes(s) ||
                 (v.phone || '').includes(s);
        });
      }
      // Sort
      filtered.sort(function(a, b) {
        var dir = vendorSortDir === 'asc' ? 1 : -1;
        if (vendorSortField === 'productCount' || vendorSortField === 'totalCost' || vendorSortField === 'totalSell') {
          return ((a[vendorSortField] || 0) - (b[vendorSortField] || 0)) * dir;
        }
        var aVal = String(a[vendorSortField] || '').toLowerCase();
        var bVal = String(b[vendorSortField] || '').toLowerCase();
        return (aVal < bVal ? -1 : aVal > bVal ? 1 : 0) * dir;
      });
      var vsa = function(field) {
        if (vendorSortField !== field) return ' ▾';
        return vendorSortDir === 'asc' ? ' ▲' : ' ▼';
      };
      var vsClick = function(field) {
        return 'vendorSortField=\'' + field + '\';vendorSortDir=vendorSortDir===\'asc\'?\'desc\':\'asc\';renderVendorsList()';
      };
      var showingText = vendorSearch ? 'Showing ' + filtered.length + ' of ' + vendorsTotalCount + ' vendors' : filtered.length + ' vendor' + (filtered.length !== 1 ? 's' : '');
      T.innerHTML = `
        <h1 class="page-title">Vendors</h1>
