                  </tbody>
                </table>
              </div>
            </div>
          `).join('')}

          ${prop.notes ? `<div style="margin-top:20px;padding:16px;background:var(--gray-50);border-radius:0;font-size:13px;"><strong>Notes / Terms:</strong><br>${esc(prop.notes)}</div>` : ''}

