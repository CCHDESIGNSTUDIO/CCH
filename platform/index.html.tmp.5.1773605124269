              <th style="padding:10px;text-align:left;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;cursor:pointer;user-select:none;" onclick="librarySortField='title';librarySortDir=librarySortDir==='asc'?'desc':'asc';renderLibraryView()">Product${sortArrow('title')}</th>
              <th style="padding:10px;text-align:left;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;cursor:pointer;user-select:none;" onclick="librarySortField='vendor';librarySortDir=librarySortDir==='asc'?'desc':'asc';renderLibraryView()">Vendor${sortArrow('vendor')}</th>
              <th style="padding:10px;text-align:left;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;cursor:pointer;user-select:none;" onclick="librarySortField='category';librarySortDir=librarySortDir==='asc'?'desc':'asc';renderLibraryView()">Category${sortArrow('category')}</th>
              <th style="padding:10px;text-align:right;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;cursor:pointer;user-select:none;" onclick="librarySortField='cost';librarySortDir=librarySortDir==='asc'?'desc':'asc';renderLibraryView()">Cost${sortArrow('cost')}</th>
              <th style="padding:10px;text-align:right;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;cursor:pointer;user-select:none;" onclick="librarySortField='sell';librarySortDir=librarySortDir==='asc'?'desc':'asc';renderLibraryView()">Sell Price${sortArrow('sell')}</th>
              <th style="padding:10px;text-align:left;font-size:10px;text-transform:uppercase;color:var(--gray-400);font-weight:600;cursor:pointer;user-select:none;" onclick="librarySortField='sku';librarySortDir=librarySortDir==='asc'?'desc':'asc';renderLibraryView()">SKU${sortArrow('sku')}</th>
            </tr></thead>
            <tbody>${displayItems.map(p => {
