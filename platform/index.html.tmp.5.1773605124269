    function getFilteredTimeEntries() {
      // Build project→client lookup from cache
      var _projClientMap = {};
      if (window.cache && cache.projects) {
        cache.projects.forEach(function(p) { if (p.clientName) _projClientMap[p.name || p.id] = p.clientName; });
      }
      return timeEntries.filter(t => {
        if (timeFilter.project && t.project !== timeFilter.project) return false;
        if (timeFilter.client) {
          var entryClient = _projClientMap[t.project] || '';
          if (entryClient !== timeFilter.client) return false;
        }
        if (timeFilter.member) {
          // Flexible member match: compare first names to handle Holliday→Holloway transition
          var filterFirst = timeFilter.member.split(' ')[0].toLowerCase();
          var entryMember = (t.member || '').toLowerCase();
          var entryFirst = entryMember.split(' ')[0];
          // Also check team/email field for old entries
          var entryEmail = (t.team || '').toLowerCase();
          if (entryFirst !== filterFirst && !entryMember.includes(filterFirst) && !entryEmail.includes(filterFirst)) return false;
        }
        if (timeFilter.dateFrom && t.date < timeFilter.dateFrom) return false;
        if (timeFilter.dateTo && t.date > timeFilter.dateTo) return false;
        if (timeFilter.billable === 'yes' && !t.billable) return false;
        if (timeFilter.billable === 'no' && t.billable) return false;
        if (timeFilter.invoiced === 'yes' && !t.invoiceId) return false;
        if (timeFilter.invoiced === 'no' && t.invoiceId) return false;
        return true;
      });
    }

