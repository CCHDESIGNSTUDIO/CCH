    function toggleAllConsolidateGroups(checked) {
      document.querySelectorAll('.cg-checkbox').forEach(cb => {
        cb.checked = checked;
        updateConsolidateGroupStyle(parseInt(cb.dataset.idx), checked);
      });
      updateConsolidateSelCount();
    }

    function updateConsolidateGroupStyle(idx, checked) {
      const el = document.getElementById('cg-' + idx);
      if (!el) return;
      el.style.borderColor = checked ? 'var(--gold)' : 'var(--gray-200)';
      el.style.opacity = checked ? '1' : '0.45';
    }

    function updateConsolidateSelCount() {
      const total = document.querySelectorAll('.cg-checkbox').length;
      const sel = document.querySelectorAll('.cg-checkbox:checked').length;
      const el = document.getElementById('consolidateSelCount');
      if (el) el.textContent = sel + ' of ' + total + ' selected';
      const selAll = document.getElementById('consolidateSelectAll');
      if (selAll) { selAll.checked = sel === total; selAll.indeterminate = sel > 0 && sel < total; }
      const btn = document.getElementById('consolidateMergeBtn');
      if (btn) btn.textContent = sel > 0 ? '⚡ Merge ' + sel + ' Group' + (sel!==1?'s':'') : 'No Groups Selected';
    }

    function toggleConsolidateDetails(idx) {
      const el = document.getElementById('cg-details-' + idx);
      const btn = document.querySelector('.cg-details-btn[data-idx="' + idx + '"]');
      if (!el) return;
      const open = el.style.display !== 'none';
      el.style.display = open ? 'none' : 'block';
      if (btn) btn.textContent = open ? '▼ Details' : '▲ Hide';
    }

    async function confirmConsolidateMerge() {
      const groups = window._consolidateGroups;
      if (!groups) return;
      const btn = document.getElementById('consolidateMergeBtn');
      if (btn) { btn.disabled = true; btn.textContent = 'Merging...'; }

      const selectedIdxs = [...document.querySelectorAll('.cg-checkbox:checked')].map(cb => parseInt(cb.dataset.idx));
      if (selectedIdxs.length === 0) { alert('No groups selected.'); if (btn) { btn.disabled = false; btn.textContent = '⚡ Merge Selected Groups'; } return; }

      const THRESHOLD = 0.25;
      const roundUp15 = (hrs) => Math.ceil(hrs / 0.25) * 0.25;
      let merged = 0, skipped = 0;

      for (const idx of selectedIdxs) {
        const g = groups[idx];
        if (!g) continue;
        const desc = (document.querySelector('.cg-desc-input[data-idx="' + idx + '"]')?.value || '').trim();
        const rawHrs = g.entries.reduce((s,t) => s + (parseFloat(t.hours)||0), 0);
        const roundedHrs = roundUp15(rawHrs);
        const rate = g.rate || 0;
        const total = roundedHrs * rate;
        const service = [...new Set(g.entries.map(t => t.service).filter(Boolean))][0] || '';

        // Build the merged entry data
        const mergedEntry = {
          project: g.project,
          date: g.date,
          hours: roundedHrs,
          rate: rate,
          total: total,
          billable: true,
          description: desc || service || 'Consolidated entries',
          service: service,
          member: g.entries[0]?.member || '',
          consolidatedFrom: g.entries.map(t => t.id).filter(Boolean),
          createdAt: firebase.firestore.FieldValue.serverTimestamp(),
        };

        try {
          // Write merged entry
          await db.collection('timeEntries').add(mergedEntry);
          // Delete originals
          const batch = db.batch();
          g.entries.forEach(t => { if (t.id) batch.delete(db.collection('timeEntries').doc(t.id)); });
          await batch.commit();
          merged++;
        } catch(e) {
          console.error('Merge error for group', g.project, g.date, e);
          skipped++;
        }
      }

      closeModal();
      // Reload time entries — build locally then assign atomically to avoid race condition
      try {
        const snap = await db.collection('timeEntries').orderBy('date','desc').limit(500).get();
        const freshEntries = [];
        snap.forEach(d => freshEntries.push({id:d.id,...d.data()}));
        timeEntries = freshEntries;
      } catch(e){ console.error('Error reloading time entries after merge:', e); }
      renderTimeTracker();
      alert('✅ Merged ' + merged + ' group' + (merged!==1?'s':'') + ' into single entries.' + (skipped>0?' '+skipped+' group(s) skipped due to errors.':''));
    }

    async function deleteSubMinuteEntries(minMinutes) {
      var threshold = minMinutes / 60; // 15min = 0.25 hours
      var toDelete = timeEntries.filter(function(t) {
        return (parseFloat(t.hours) || 0) < threshold && !t.invoiceId;
      });
      if (toDelete.length === 0) { alert('No entries under ' + minMinutes + ' minutes found.'); return; }
      if (!confirm('Delete ' + toDelete.length + ' entries under ' + minMinutes + ' minutes?\n\nThis will remove all non-invoiced entries shorter than ' + minMinutes + 'min. This cannot be undone.')) return;

      var deleted = 0;
      // Batch in groups of 400
      for (var i = 0; i < toDelete.length; i += 400) {
        var chunk = toDelete.slice(i, i + 400);
        try {
          var batch = db.batch();
          chunk.forEach(function(t) { if (t.id) batch.delete(db.collection('timeEntries').doc(t.id)); });
          await batch.commit();
          deleted += chunk.length;
        } catch(e) {
          for (var j = 0; j < chunk.length; j++) {
            try { if (chunk[j].id) await db.collection('timeEntries').doc(chunk[j].id).delete(); deleted++; } catch(e2) {}
          }
        }
      }
      alert('Deleted ' + deleted + ' entries under ' + minMinutes + ' minutes.');
      renderTimeTracker();
    }

    // --- Create Invoice from Selected Time Entries ---
    async function showCreateInvoiceFromTime() {
      // Get checked entries or all uninvoiced billable
      let selectedIds = [...document.querySelectorAll('.time-cb:checked')].map(cb => cb.dataset.id);
      let entries;
      if (selectedIds.length > 0) {
        entries = timeEntries.filter(t => selectedIds.includes(t.id) && !t.invoiceId);
      } else {
        // Use filter to get uninvoiced billable
        entries = timeEntries.filter(t => t.billable && !t.invoiceId);
        if (timeFilter.project) entries = entries.filter(t => t.project === timeFilter.project);
      }

      if (entries.length === 0) { alert('No uninvoiced billable entries selected.'); return; }

      // Group by project
      const byProject = {};
      entries.forEach(t => {
        if (!byProject[t.project]) byProject[t.project] = [];
        byProject[t.project].push(t);
      });

      const projectNames = Object.keys(byProject);
      if (projectNames.length > 1 && !confirm(`Entries span ${projectNames.length} projects (${projectNames.join(', ')}). Create separate invoices for each?`)) return;

      for (const projName of projectNames) {
        const projEntries = byProject[projName];
        await createTimeInvoice(projName, projEntries);
      }

      renderTimeTracker();
    }

    async function createTimeInvoice(projName, entries) {
      // Group by service type for line items
      const byService = {};
      entries.forEach(t => {
        const key = t.service || 'Services';
        if (!byService[key]) byService[key] = { hours: 0, total: 0, descriptions: [], rate: t.rate || 0 };
        byService[key].hours += parseFloat(t.hours) || 0;
        byService[key].total += parseFloat(t.total) || 0;
        if (t.description) byService[key].descriptions.push(t.description);
      });

      const lineItems = Object.entries(byService).map(([service, data]) => ({
        description: service + ' (' + data.hours.toFixed(1) + ' hrs)' + (data.descriptions.length ? ' — ' + data.descriptions.slice(0, 3).join('; ') : ''),
        qty: data.hours,
        rate: data.rate,
        amount: data.total
      }));

      const total = lineItems.reduce((s, li) => s + li.amount, 0);
      const dateRange = entries.map(t => t.date).filter(Boolean).sort();
      const invNumber = await getNextDocNumber('INV');

      // Find or create the board/project
      const projectId = projName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');

      try {
        const invData = {
          number: invNumber,
          date: new Date().toISOString().slice(0, 10),
          status: 'Draft',
          items: lineItems,
          total: total,
          notes: `Time entries from ${dateRange[0] || ''} to ${dateRange[dateRange.length - 1] || ''}`,
          source: 'time-tracker',
          timeEntryIds: entries.map(t => t.id),
          trackedValue: total,
          createdAt: new Date().toISOString()
        };

        const invRef = await db.collection('boards').doc(projectId).collection('invoices').add(invData);

        // Mark time entries as invoiced
        const batch = db.batch();
        entries.forEach(t => {
          batch.update(db.collection('timeEntries').doc(t.id), {
            invoiceId: invRef.id,
            invoiceNumber: invNumber,
            invoicedAmount: t.total
          });
        });
        await batch.commit();

        alert(`Invoice ${invNumber} created for ${projName}: ${formatMoney(total)} (${entries.length} entries)`);
      } catch(e) { alert('Error creating invoice: ' + e.message); }
    }

    // ==================== AI RECONSTRUCTED TIME ====================
    async function reconstructDailyTime() {
      // Ask for date range or default to today
      var dateStr = prompt('Reconstruct time for which date? (YYYY-MM-DD or leave blank for today)', new Date().toISOString().slice(0,10));
      if (dateStr === null) return;
      if (!dateStr) dateStr = new Date().toISOString().slice(0,10);

      var startOfDay = dateStr + 'T00:00:00';
      var endOfDay = dateStr + 'T23:59:59';

      // Show loading
      var modal = document.createElement('div');
      modal.className = 'modal active';
      modal.id = 'aiTimeModal';
      modal.innerHTML = '<div class="modal-content" style="max-width:700px;max-height:85vh;overflow-y:auto;"><div style="text-align:center;padding:40px;"><div style="font-size:32px;margin-bottom:12px;">🤖</div><div style="color:var(--gray-500);">Scanning activity feed for ' + dateStr + '...</div></div></div>';
      document.body.appendChild(modal);

      try {
        // Pull ALL activity for this date
        var actDocs = [];
        try {
          var actSnap = await db.collection('activity')
            .where('createdAt', '>=', startOfDay)
            .where('createdAt', '<=', endOfDay)
            .get();
          actSnap.forEach(function(d) { actDocs.push({ id: d.id, ...d.data() }); });
        } catch(e) {
          // Fallback: pull recent and filter manually
          var actSnap2 = await db.collection('activity').orderBy('createdAt', 'desc').limit(200).get();
          actSnap2.forEach(function(d) {
            var data = d.data();
            if (data.createdAt && data.createdAt >= startOfDay && data.createdAt <= endOfDay) {
              actDocs.push({ id: d.id, ...data });
            }
          });
        }

        // Group by projectId
        var byProject = {};
        actDocs.forEach(function(a) {
          var pid = a.projectId || 'unknown';
          if (!byProject[pid]) byProject[pid] = { projectId: pid, projectName: a.projectName || pid, activities: [] };
          byProject[pid].activities.push(a);
        });

        // Load project names for any missing names
        var projIds = Object.keys(byProject);
        for (var i = 0; i < projIds.length; i++) {
          var pid = projIds[i];
          if (pid !== 'unknown' && byProject[pid].projectName === pid) {
            try {
              var pDoc = await db.collection('boards').doc(pid).get();
              if (pDoc.exists && pDoc.data().name) byProject[pid].projectName = pDoc.data().name;
            } catch(e) {}
          }
        }

        // Estimate time per project based on activity density
        // Logic: each activity represents ~15-25 min of work depending on type
        var suggestions = [];
        Object.values(byProject).forEach(function(group) {
          var totalMin = 0;
          var taskDescs = [];

          group.activities.forEach(function(a) {
            var type = a.type || a.action || '';
            var desc = a.description || a.text || '';

            // Weight by activity type
            var weight = 20; // default 20 min per activity
            if (type === 'invoice' || type === 'proposal') weight = 15;
            else if (type === 'po') weight = 10;
            else if (type === 'note' || type === 'milestone') weight = 10;
            else if (type === 'sms' || type === 'message') weight = 5;
            else if (type === 'clipper' || type === 'clip') weight = 8;
            else if (type === 'email') weight = 12;
            else if (desc.toLowerCase().includes('call') || desc.toLowerCase().includes('teams')) weight = 30;
            else if (desc.toLowerCase().includes('render') || desc.toLowerCase().includes('design')) weight = 35;
            else if (desc.toLowerCase().includes('board') || desc.toLowerCase().includes('mood')) weight = 25;

            totalMin += weight;

            // Build task description from actual activity descriptions
            var shortDesc = desc.length > 60 ? desc.substring(0, 60) + '...' : desc;
            if (shortDesc && taskDescs.length < 5) taskDescs.push(shortDesc);
          });

          // Cap at 8 hours per project per day
          totalMin = Math.min(totalMin, 480);

          if (totalMin >= 5) {
            suggestions.push({
              projectId: group.projectId,
              projectName: group.projectName,
              activityCount: group.activities.length,
              minutes: totalMin,
              tasks: taskDescs,
              types: [...new Set(group.activities.map(function(a) { return a.type || 'other'; }))]
            });
          }
        });

