      // ---- Report 3: Procurement Status ----
      const procStatuses = ['Proposed', 'Approved', 'Ordered', 'Shipped', 'At Receiver', 'At Workroom', 'Received', 'Installed'];
      const procCounts = {};
      procStatuses.forEach(s => procCounts[s] = 0);
      clips.forEach(c => {
        const st = c.orderStatus || c.selectionStatus || c.approvalStatus || 'Proposed';
        if (procCounts[st] !== undefined) procCounts[st]++;
        else {
          // Map selection statuses to procurement pipeline
          const selSt = c.selectionStatus || c.approvalStatus || 'Proposed';
          if (procCounts[selSt] !== undefined) procCounts[selSt]++;
        }
      });

      const procColors = { Proposed: '#6B7280', Approved: '#C8B99A', Ordered: '#00B8D4', Shipped: '#60A5FA', 'At Receiver': '#818CF8', 'At Workroom': '#A78BFA', Received: '#34D399', Installed: '#5FA56B' };
      const totalItems = clips.length || 1;

      html += `
        <div style="margin-bottom:32px;">
          <div style="font-size:16px;font-weight:600;font-family:var(--font-display);letter-spacing:0.5px;margin-bottom:14px;">Procurement Pipeline</div>
