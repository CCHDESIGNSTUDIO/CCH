      var active = document.activeElement;
      if (active && active.id && active.id.startsWith('tlBucketComment')) {
        // Don't re-render — just schedule for after blur
        if (!window._tlBucketRenderPending) {
          window._tlBucketRenderPending = true;
          active.addEventListener('blur', function handler() {
            active.removeEventListener('blur', handler);
            window._tlBucketRenderPending = false;
            var bl2 = document.getElementById('tlBucketsList');
            if (bl2) bl2.innerHTML = _tlRenderBucketsPanel();
            _tlInitDragDrop();
          }, { once: true });
        }
        return;
      }
      bl.innerHTML = _tlRenderBucketsPanel();
    }

    // ── Timeline: Memories panel (right) — grouped by app ──
    function _tlRenderMemoriesPanel(day, allProjects) {
      var all = window._pendingCaptures || [];
      var dayCaps = all.map(function(c,idx){ return {cap:c, idx:idx}; }).filter(function(item){ return item.cap.date === day && !item.cap._dismissed; });
      if (dayCaps.length === 0) {
        return '<div style="text-align:center;color:var(--gold);padding:32px 12px;font-size:13px;line-height:1.6;">' +
          '<div style="font-size:24px;margin-bottom:8px;">📭</div>' +
          'No captures for this day.<br>Import Desktop Log or wait for scan.' +
        '</div>';
      }

      // Smart grouping: consolidate by domain for websites, by app for desktop apps
      function getGroupKey(cap) {
        var rawApp = cap.app || 'Unknown';
        var normApp = (typeof _normalizeAppName === 'function') ? _normalizeAppName(rawApp) : rawApp;
        var app = normApp.toLowerCase().trim();
        var titles = (cap.titles || '').toLowerCase();

        // Group all browser tabs by the domain they visited
        var isBrowserApp = (typeof _isBrowser === 'function') ? _isBrowser(normApp) : false;
        if (isBrowserApp) {
          // Try to extract domain from titles
          var domainMatch = (cap.titles || '').match(/(?:https?:\/\/)?([a-z0-9][-a-z0-9]*(?:\.[a-z0-9][-a-z0-9]*)+)/i);
          if (domainMatch) {
            var dom = domainMatch[1].toLowerCase().replace(/^www\./, '');
            return 'web:' + dom;
          }
          return app; // fallback to browser name
        }

        // Group website-like app names (e.g., "cchdesign.nlce.co", "pro.houzz.com") by root domain
        if (app.match(/^[a-z0-9][-a-z0-9]*\.[a-z]/)) {
          var rootDomain = app.replace(/^www\./, '');
          // Strip subdomain for grouping (keep last 2 parts)
          var parts = rootDomain.split('.');
          if (parts.length > 2) rootDomain = parts.slice(-2).join('.');
          return 'web:' + rootDomain;
        }

        // Group all claude windows together
        if (app === 'claude' || app.indexOf('claude') === 0) return 'claude';

        // Use normalized app name for grouping (merges POWERPNT+PowerPoint, ms-teams+Teams, etc.)
        return app;
      }

      function getGroupLabel(key, caps) {
        if (key.indexOf('web:') === 0) {
          var domain = key.substring(4);
          // Friendly labels for known domains
          var domainLabels = {
            'cch-platform.web.app': 'CCH Studio',
            'cchdesign.com': 'CCH Design',
            'houzz.com': 'Houzz',
            'pro.houzz.com': 'Houzz Pro',
            'claude.ai': 'Claude AI',
            'github.com': 'GitHub',
            'google.com': 'Google',
            'figma.com': 'Figma',
            'canva.com': 'Canva',
            'x.com': 'X (Twitter)',
            'twitter.com': 'X (Twitter)'
          };
          return domainLabels[domain] || domain;
        }
        // Use the most common app name from captures in this group (normalized)
        var nameCount = {};
        caps.forEach(function(c) {
          var n = (typeof _normalizeAppName === 'function') ? _normalizeAppName(c.app || 'Unknown') : (c.app || 'Unknown');
          nameCount[n] = (nameCount[n] || 0) + 1;
        });
        var best = key, bestC = 0;
        Object.keys(nameCount).forEach(function(n) {
          if (nameCount[n] > bestC) { best = n; bestC = nameCount[n]; }
        });
        return best;
      }

      var groups = {};
      dayCaps.forEach(function(item) {
        var key = getGroupKey(item.cap);
        if (!groups[key]) groups[key] = { key: key, app: '', totalMins: 0, titles: [], indices: [], caps: [] };
        groups[key].totalMins += item.cap.minutes;
        if (item.cap.titles) groups[key].titles.push(item.cap.titles.substring(0,50));
        groups[key].indices.push(item.idx);
        groups[key].caps.push(item.cap);
      });
      // Set display labels
      Object.values(groups).forEach(function(g) { g.app = getGroupLabel(g.key, g.caps); });
      var sorted = Object.values(groups).sort(function(a,b){ return b.totalMins - a.totalMins; });

      // Check which are in buckets
      var bucketed = new Set();
      (window._projectBuckets || []).forEach(function(b){ (b.items||[]).forEach(function(i){ bucketed.add(i); }); });

      // Use same 30-color FNV-1a palette as center timeline for consistency
      function appColor(app) {
        var COLS = ['#1976D2','#E53935','#F57C00','#388E3C','#7B1FA2','#00838F','#5D4037','#455A64','#C62828','#2E7D32','#F06292','#81C784','#4DD0E1','#FF8A65','#BA68C8','#0097A7','#8D6E63','#D81B60','#00BFA5','#6D4C41','#1E88E5','#43A047','#FB8C00','#8E24AA','#00897B','#EF5350','#5C6BC0','#FFB300','#26A69A','#EC407A'];
        var h = 2166136261;
        for (var i = 0; i < app.length; i++) { h ^= app.charCodeAt(i); h = (h * 16777619) & 0xFFFFFFFF; }
        return COLS[Math.abs(h) % COLS.length];
      }

      var html = '';
      sorted.forEach(function(g, gi) {
        var isInBucket = g.indices.some(function(i){ return bucketed.has(i); });
        var color = appColor(g.app);
        var dur = g.totalMins >= 60 ? Math.floor(g.totalMins/60)+'h'+(g.totalMins%60>0?' '+g.totalMins%60+'m':'') : g.totalMins+'m';
        var previewTitles = g.titles.slice(0,2).join(' · ');

        // Collect full details for all captures in this group
        var groupCaps = g.indices.map(function(idx) { return all[idx]; }).filter(Boolean);
        var totalSessions = groupCaps.reduce(function(s,c) { return s + (c.count || 1); }, 0);
        var categories = {};
        var allTitles = [];
        var projectNames = {};
        var timeRangeStart = '', timeRangeEnd = '';
        groupCaps.forEach(function(c) {
          if (c.category) categories[c.category] = (categories[c.category]||0) + c.minutes;
          if (c.titles) {
            c.titles.split(/[|·,]/).forEach(function(t) {
              var trimmed = t.trim();
              if (trimmed && allTitles.indexOf(trimmed) < 0) allTitles.push(trimmed);
