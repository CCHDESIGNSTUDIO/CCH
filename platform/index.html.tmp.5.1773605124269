              if (window._captureProjectList.indexOf(c) < 0) window._captureProjectList.push(c);
            });
          } catch(e) {}
        }
        // Scan today + yesterday
        var today = new Date().toISOString().slice(0,10);
        var yesterday = new Date(Date.now() - 86400000).toISOString().slice(0,10);
        // Scan last 7 days + the currently viewed day (covers full week of data)
        var scanDates = [today];
        for (var sd = 1; sd <= 6; sd++) {
          var pastDay = new Date(Date.now() - sd * 86400000).toISOString().slice(0,10);
          if (scanDates.indexOf(pastDay) < 0) scanDates.push(pastDay);
        }
        // Add the viewed timeline day if it's not already included
        if (_tlDay && scanDates.indexOf(_tlDay) < 0) {
          scanDates.push(_tlDay);
        }
        var allSuggestions = [];

        // ── App name normalization: unify variants to prevent duplication ──
        function _normalizeAppName(app) {
          var low = (app || '').toLowerCase().trim();
          // Browser variants → canonical names
          if (low === 'google chrome' || low === 'googlechrome' || low === 'chrome.exe') return 'Chrome';
          if (low === 'chrome') return 'Chrome';
          if (low === 'microsoft edge' || low === 'msedge' || low === 'edge.exe') return 'Edge';
          if (low === 'edge') return 'Edge';
          if (low === 'firefox' || low === 'firefox.exe' || low === 'mozilla firefox') return 'Firefox';
          // Office variants
          if (low === 'powerpnt' || low === 'powerpnt.exe' || low === 'microsoft powerpoint') return 'PowerPoint';
          if (low === 'powerpoint') return 'PowerPoint';
          if (low === 'winword' || low === 'winword.exe' || low === 'microsoft word') return 'Word';
          if (low === 'excel' || low === 'excel.exe' || low === 'microsoft excel') return 'Excel';
          if (low === 'onenote' || low === 'onenote.exe' || low === 'microsoft onenote') return 'OneNote';
          if (low === 'outlook' || low === 'outlook.exe' || low === 'microsoft outlook') return 'Outlook';
          if (low === 'olk' || low === 'olk.exe') return 'Outlook';
          // Teams/Communication
          if (low === 'ms-teams' || low === 'microsoft teams' || low === 'teams.exe' || low === 'teams') return 'Microsoft Teams';
          // Utilities
          if (low === 'snippingtool' || low === 'snipping tool' || low === 'sniptool') return 'Snipping Tool';
          if (low === 'windowsterminal' || low === 'windows terminal' || low === 'cmd' || low === 'cmd.exe') return 'Terminal';
          if (low === 'explorer' || low === 'explorer.exe') return 'File Explorer';
          if (low === 'windows explorer') return 'File Explorer';
          // Design
          if (low === 'sketchup' || low === 'sketchup 2025' || low === 'sketchup 2024') return 'SketchUp';
          if (low === 'adobe acrobat' || low === 'acrobat' || low === 'adobe acrobat (64-bit)') return 'Adobe Acrobat';
          if (low === 'enscape' || low === 'enscape3d') return 'Enscape';
          if (low === 'layout' || low === 'layout 2025' || low === 'layout 2024') return 'LayOut';
          return app; // keep original casing
        }

        // Browser check using normalized name
        function _isBrowser(normalizedApp) {
          var low = normalizedApp.toLowerCase();
          return ['chrome', 'firefox', 'safari', 'edge', 'brave', 'arc', 'opera', 'vivaldi'].indexOf(low) >= 0;
        }

        // Extract meaningful label from window title for non-browser apps
        function _enrichAppLabel(normalizedApp, title) {
          if (!title || title.length < 3) return normalizedApp;
          var appLow = normalizedApp.toLowerCase();

          // Teams: show call/meeting participant or topic
          if (appLow === 'microsoft teams') {
            var callMatch = title.match(/call with (.+)/i);
            if (callMatch) return 'Call with ' + callMatch[1].substring(0, 40);
            var meetMatch = title.match(/(.+?)\s*[-–|]\s*Microsoft Teams/i);
            if (meetMatch && meetMatch[1].length > 2 && meetMatch[1].length < 50) return meetMatch[1].trim();
            if (title.match(/meeting|call|conference/i)) return 'Teams Meeting';
            return normalizedApp;
          }

          // PowerPoint: show filename
          if (appLow === 'powerpoint') {
            var ppMatch = title.match(/(.+?)\s*[-–]\s*PowerPoint/i);
            if (ppMatch && ppMatch[1].length > 2 && ppMatch[1].length < 80) return ppMatch[1].trim();
            if (title.length < 80 && !title.match(/^PowerPoint$/i)) return title;
            return normalizedApp;
          }

          // Word: show filename
          if (appLow === 'word') {
            var wdMatch = title.match(/(.+?)\s*[-–]\s*(Microsoft )?Word/i);
            if (wdMatch && wdMatch[1].length > 2 && wdMatch[1].length < 80) return wdMatch[1].trim();
            return normalizedApp;
          }

          // Excel: show filename
          if (appLow === 'excel') {
            var xlMatch = title.match(/(.+?)\s*[-–]\s*(Microsoft )?Excel/i);
            if (xlMatch && xlMatch[1].length > 2 && xlMatch[1].length < 80) return xlMatch[1].trim();
            return normalizedApp;
          }

          // Outlook: show email subject
          if (appLow === 'outlook') {
            var olMatch = title.match(/^(?:Re:\s*|Fw:\s*)?(.+?)(?:\s*[-–]\s*(Outlook|Mail))?$/i);
            if (olMatch && olMatch[1].length > 2 && olMatch[1].length < 80) return olMatch[1].trim();
            return normalizedApp;
          }

          // SketchUp: show filename
          if (appLow === 'sketchup') {
            var skMatch = title.match(/(.+?)\s*[-–]\s*SketchUp/i);
            if (skMatch && skMatch[1].length > 2 && skMatch[1].length < 80) return skMatch[1].trim();
            return normalizedApp;
          }

