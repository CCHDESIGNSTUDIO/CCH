    async function docEditSavePayment() {
      const amount = parseFloat(document.getElementById('payAmount').value);
      const date = document.getElementById('payDate').value;
      const method = document.getElementById('payMethod').value;
      const note = document.getElementById('payNote').value.trim();
      if (!amount || amount <= 0) { alert('Enter a payment amount'); return; }

      const payment = {
        id: 'pay_' + Date.now(),
        amount, date: date || new Date().toISOString().split('T')[0],
        method, note, reference: note,
        recordedAt: new Date().toISOString()
      };

      if (!_docEdit.docData.payments) _docEdit.docData.payments = [];
      _docEdit.docData.payments.push(payment);

      // Save to Firestore
      try {
        await db.collection('boards').doc(_docEdit.projectId).collection(_docEdit.collection).doc(_docEdit.docId).update({
          payments: _docEdit.docData.payments
        });

        // Auto-update status based on payments
        const total = _docEdit.items.reduce((s,i) => s + (parseFloat(i.amount) || 0), 0);
        const totalPaid = _docEdit.docData.payments.reduce((s,p) => s + (parseFloat(p.amount) || 0), 0);
        const balance = total - totalPaid;
        let newStatus = _docEdit.docData.status;
        if (totalPaid >= total && total > 0) newStatus = 'Paid';
        else if (totalPaid > 0) newStatus = 'Partial';
        if (newStatus !== _docEdit.docData.status) {
          _docEdit.docData.status = newStatus;
        }
        await db.collection('boards').doc(_docEdit.projectId).collection(_docEdit.collection).doc(_docEdit.docId).update({ 
          status: newStatus, balance: balance 
        });

        // Update status badge in header
        const statusEl = document.querySelector('.badge[class*="badge-"]');
        // Refresh status display
        const ind = document.getElementById('docEditSaveInd');
        if (ind) { ind.textContent = '✓ Payment of ' + formatMoney(amount) + ' recorded'; ind.style.color = 'var(--green)'; setTimeout(() => { if (ind) ind.textContent = ''; }, 3000); }
      } catch(e) { console.error('Payment save failed:', e); alert('Failed to save payment'); }

      document.getElementById('paymentModal').remove();
      docEditRenderPayments();
      docEditRecalcTotals();
    }

    async function docEditDeletePayment(idx) {
      if (!confirm('Delete this payment?')) return;
      _docEdit.docData.payments.splice(idx, 1);
      try {
        await db.collection('boards').doc(_docEdit.projectId).collection(_docEdit.collection).doc(_docEdit.docId).update({
          payments: _docEdit.docData.payments
        });
        // Recalc status
        const total = _docEdit.items.reduce((s,i) => s + (parseFloat(i.amount) || 0), 0);
        const totalPaid = (_docEdit.docData.payments || []).reduce((s,p) => s + (parseFloat(p.amount) || 0), 0);
        let newStatus = _docEdit.docData.status;
        if (totalPaid <= 0 && _docEdit.docData.status === 'Paid') newStatus = 'Sent';
        else if (totalPaid > 0 && totalPaid < total) newStatus = 'Partial';
        else if (totalPaid >= total && total > 0) newStatus = 'Paid';
        if (newStatus !== _docEdit.docData.status) {
          _docEdit.docData.status = newStatus;
          await db.collection('boards').doc(_docEdit.projectId).collection(_docEdit.collection).doc(_docEdit.docId).update({ status: newStatus });
        }
      } catch(e) { console.error('Payment delete failed:', e); }
      docEditRenderPayments();
      docEditRecalcTotals();
    }

    // Quick payment from global list (without opening edit view)
    async function quickRecordPayment(projectId, collection, docId) {
      const amountStr = prompt('Payment amount:');
      if (!amountStr) return;
      const amount = parseFloat(amountStr);
      if (!amount || amount <= 0) { alert('Invalid amount'); return; }
      const method = prompt('Payment method (Check, Credit Card, ACH/Wire, Zelle, Deposit):', 'Check') || 'Check';
      const note = prompt('Reference / Note (optional):', '') || '';

      const payment = {
        id: 'pay_' + Date.now(),
        amount, date: new Date().toISOString().split('T')[0],
        method, note, reference: note,
        recordedAt: new Date().toISOString()
      };

      try {
        const ref = db.collection('boards').doc(projectId).collection(collection).doc(docId);
        const doc = await ref.get();
        if (!doc.exists) { alert('Document not found'); return; }
        const data = doc.data();
        const payments = data.payments || [];
        payments.push(payment);

        // Auto-update status
        const total = parseFloat(data.total) || 0;
        const totalPaid = payments.reduce((s,p) => s + (parseFloat(p.amount) || 0), 0);
        let status = data.status;
        if (totalPaid >= total && total > 0) status = 'Paid';
        else if (totalPaid > 0) status = 'Partial';

        await ref.update({ payments, status, balance: total - totalPaid });
        alert('Payment of ' + formatMoney(amount) + ' recorded!');
        _cacheTime = 0; // Force refresh
        if (collection === 'invoices') { renderAllInvoices(); renderProjectDetail(); }
        else if (collection === 'proposals') { renderAllProposals(); renderProjectDetail(); }
        else renderProjectDetail();
      } catch(e) { console.error('Quick payment failed:', e); alert('Failed to record payment'); }
    }

