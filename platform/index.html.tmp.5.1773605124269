      const snap = await db.collection('boards').get();
      projects = [];
      snap.forEach(d => projects.push({ id: d.id, ...d.data() }));

      // Fix invoice counts for projects showing 0 but having clips
      const zeroCounts = projects.filter(p => (p.invoiceCount || 0) === 0 && (p.clipCount || 0) > 0);
      await Promise.all(zeroCounts.map(async p => {
        try {
          const invSnap = await db.collection('boards').doc(p.id).collection('invoices').get();
          let count = invSnap.size;
          if (count === 0) {
            const clipSnap = await db.collection('boards').doc(p.id).collection('clips').limit(200).get();
            const nums = new Set();
            clipSnap.forEach(d => {
              var c = d.data();
              if (c.invoiceNum) nums.add(c.invoiceNum);
              if (c.houzzInvoice) nums.add(c.houzzInvoice);
            });
            count = nums.size;
          }
          if (count > 0) {
            p.invoiceCount = count;
            try { await db.collection('boards').doc(p.id).update({ invoiceCount: count }); } catch(e){}
          }
        } catch(e) {}
      }));

      C.innerHTML = `
        <div class="page-header">
