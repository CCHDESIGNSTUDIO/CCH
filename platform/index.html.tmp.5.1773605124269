    // ==================== INVOICE DETAIL ====================
    async function renderInvoiceDetail(projectId, invoiceId) {
      const T = document.getElementById('contentArea');
      T.innerHTML = '<div style="text-align:center;padding:60px;color:var(--gray-400);">Loading invoice...</div>';

      let docData = null, items = [];

      // Try loading from invoices collection first
      try {
        const doc = await db.collection('boards').doc(projectId).collection('invoices').doc(invoiceId).get();
        if (doc.exists) { docData = { id: doc.id, ...doc.data() }; items = docData.items || []; }
      } catch(e) {}

      // If it's a clip-based invoice (id starts with clip-inv-)
      if (!docData && invoiceId.startsWith('clip-inv-')) {
        const invNum = invoiceId.replace('clip-inv-', '');
        // First check if a real invoice doc already exists with this number
        try {
          const existing = await db.collection('boards').doc(projectId).collection('invoices')
            .where('invoiceNum', '==', invNum).limit(1).get();
          if (!existing.empty) {
            const eDoc = existing.docs[0];
            docData = { id: eDoc.id, ...eDoc.data() };
            items = docData.items || [];
            invoiceId = eDoc.id;
            window.location.hash = '#/project/' + projectId + '/invoice/' + invoiceId;
          }
        } catch(e) {}

        if (!docData) {
          try {
          const clipSnap = await db.collection('boards').doc(projectId).collection('clips').get();
          items = [];
          let total = 0, vendor = '', status = 'Invoiced';
          clipSnap.forEach(d => {
            const c = d.data();
            if (c.invoiceNum === invNum || c.houzzInvoice === invNum) {
              const unitCost = parseFloat(c.cost) || (c.totalCost && c.qty ? parseFloat(c.totalCost) / parseFloat(c.qty) : 0) || 0;
              const sell = parseFloat(c.totalSelling) || parseFloat(c.clientPrice) || 0;
              const qty = parseFloat(c.qty) || 1;
              const mkup = unitCost > 0 ? Math.round(((sell/qty - unitCost) / unitCost) * 100) : 0;
              items.push({ title: c.title || '', vendor: c.vendor || '', category: c.category || '', room: c.room || '',
                qty: qty, cost: unitCost, markupPct: mkup, shipping: 0,
                amount: sell, imageUrl: c.imageUrl || '', description: c.description || '' });
              total += sell;
              if (c.vendor && !vendor) vendor = c.vendor;
              if (c.invoiceStatus) status = c.invoiceStatus;
            }
          });
          // Create a real invoice doc from clips so it's editable
          const newDoc = await db.collection('boards').doc(projectId).collection('invoices').add({
            invoiceNum: invNum, number: invNum, vendor, status, total, items,
            createdAt: new Date().toISOString(), updatedAt: new Date().toISOString(),
            _fromClips: true
          });
          docData = { id: newDoc.id, invoiceNum: invNum, number: invNum, vendor, status, total, items };
          invoiceId = newDoc.id;
          window.location.hash = '#/project/' + projectId + '/invoice/' + invoiceId;
        } catch(e) { console.error('Error building invoice from clips:', e); }
        }
      }

      // If loaded from saved doc but most costs are 0, re-sync from clips
      if (docData && docData._fromClips && items.length > 0) {
        const zeroCostCount = items.filter(i => !parseFloat(i.cost) || parseFloat(i.cost) === 0).length;
        if (zeroCostCount >= items.length * 0.5) {
          try {
            const invNum = docData.invoiceNum || docData.number || '';
            const clipSnap = await db.collection('boards').doc(projectId).collection('clips').get();
            const clipMap = {};
            clipSnap.forEach(d => {
              const c = d.data();
              if (c.invoiceNum === invNum || c.houzzInvoice === invNum) {
                clipMap[c.title || ''] = c;
              }
            });
            let needsUpdate = false;
            items.forEach(item => {
              const clip = clipMap[item.title];
              if (clip) {
                const unitCost = parseFloat(clip.cost) || (clip.totalCost && clip.qty ? parseFloat(clip.totalCost) / parseFloat(clip.qty) : 0) || 0;
                if (unitCost > 0 && !parseFloat(item.cost)) {
                  item.cost = unitCost;
                  const qty = parseFloat(item.qty) || 1;
                  const sell = parseFloat(item.amount) || 0;
                  item.markupPct = unitCost > 0 ? Math.round(((sell/qty - unitCost) / unitCost) * 100) : 0;
                  needsUpdate = true;
                }
              }
            });
            if (needsUpdate) {
              await db.collection('boards').doc(projectId).collection('invoices').doc(invoiceId).update({ items });
              docData.items = items;
            }
          } catch(e) { console.warn('Cost re-sync failed:', e); }
        }
      }

      if (!docData) { T.innerHTML = '<div class="empty-state"><div class="empty-text">Invoice not found.</div></div>'; return; }

      // Get project info
      const projDoc = await db.collection('boards').doc(projectId).get();
      const projData = projDoc.exists ? { id: projectId, ...projDoc.data() } : { id: projectId };

      renderDocEditPage('invoice', projectId, invoiceId, docData, items, projData);
    }

