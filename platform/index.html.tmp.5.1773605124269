      const thisWeekEntries = myTimeEntries.filter(t => t.date >= weekStr);
      const weekHrs = thisWeekEntries.reduce((s,t) => s + (parseFloat(t.hours) || 0), 0);
      const weekBillable = thisWeekEntries.filter(t => t.billable !== false).reduce((s,t) => s + (parseFloat(t.hours) || 0), 0);
