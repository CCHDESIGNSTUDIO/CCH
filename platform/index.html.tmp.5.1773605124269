    .asset-tag { display: inline-block; padding: 4px 12px; border-radius:0; font-size: 11px; font-weight: 600; cursor: pointer; border: 1px solid var(--gray-200); background: white; color: var(--gray-600); margin: 3px; transition: all 0.15s; }
