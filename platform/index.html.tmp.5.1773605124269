                </tbody>
                <tfoot><tr style="font-weight:700;"><td>TOTAL</td><td class="amount">${formatHours(grandHrs)}</td>${admin?`<td class="amount">${formatMoney(grandTotal)}</td>`:''}<td class="amount">${monthEntries.length}</td></tr></tfoot>
