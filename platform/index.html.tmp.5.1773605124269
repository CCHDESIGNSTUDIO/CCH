            <div style="font-size:13px;color:var(--gray-400);">
              ${Object.keys(grouped).length} room${Object.keys(grouped).length !== 1 ? 's' : ''} · ${items.length} items
            </div>
            <div style="text-align:right;min-width:260px;">
              ${(() => {
                let _sub = 0, _ship = 0;
