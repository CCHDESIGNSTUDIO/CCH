                    <th>Vendor</th>
                    <th class="amount">Qty</th>
                    <th class="amount">Cost</th>
                    <th class="amount">Markup %</th>
                    <th class="amount">Shipping</th>
                    <th class="amount">Total</th>
                    <th style="width:60px;"></th>
                  </tr></thead>
                  <tbody>
                    ${grouped[cat].map(item => {
                      const qty = parseFloat(item.qty) || 1;
                      const cost = parseFloat(item.cost) || 0;
                      const markupPct = parseFloat(item.markupPct) || 0;
                      const shipping = parseFloat(item.shipping) || 0;
                      const clientPrice = parseFloat(item.amount) || 0;
                      return `
                      <tr>
                        <td>${item.imageUrl ? `<img src="${escAttr(item.imageUrl)}" style="width:50px;height:50px;object-fit:cover;border-radius:4px;" onerror="this.outerHTML='📦'">` : '📦'}</td>
                        <td><strong>${esc(item.title || 'Untitled')}</strong><br><span style="font-size:11px;color:var(--gray-400);">${esc(item.description || '').substring(0,60)}</span>${item.shipTo ? '<br><span style="font-size:10px;color:var(--teal);">Ship to: ' + esc(item.shipTo) + '</span>' : ''}</td>
