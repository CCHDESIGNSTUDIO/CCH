    function ffeApplyFilters(clips) {
      return clips.filter(c => {
        if (ffeFilters.room && (c.room || 'Unassigned') !== ffeFilters.room) return false;
        if (ffeFilters.category && (c.category || '') !== ffeFilters.category) return false;
        if (ffeFilters.vendor && (c.vendor || '') !== ffeFilters.vendor) return false;
        if (ffeFilters.status && (c.selectionStatus || c.approvalStatus || 'Proposed') !== ffeFilters.status) return false;
        if (ffeFilters.orderStatus && (c.orderStatus || '') !== ffeFilters.orderStatus) return false;
        return true;
      });
    }

    function ffeApplySort(clips) {
      return clips.sort((a, b) => {
        let va = a[ffeSortField] || '', vb = b[ffeSortField] || '';
        if (['cost', 'clientPrice', 'qty', 'totalSelling', 'markupPct'].includes(ffeSortField)) {
          va = parseFloat(va) || 0; vb = parseFloat(vb) || 0;
        } else { va = String(va).toLowerCase(); vb = String(vb).toLowerCase(); }
        if (va < vb) return ffeSortDir === 'asc' ? -1 : 1;
        if (va > vb) return ffeSortDir === 'asc' ? 1 : -1;
        return 0;
      });
    }

