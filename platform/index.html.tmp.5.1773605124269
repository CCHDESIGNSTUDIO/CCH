        vendorData[v].sell += parseFloat(c.totalSelling) || (parseFloat(c.clientPrice) || 0) * (parseFloat(c.qty) || 1);
        vendorData[v].items++;
        const st = c.orderStatus || c.selectionStatus || '';
        if (['Ordered', 'Shipped', 'At Receiver', 'At Workroom'].includes(st)) vendorData[v].ordered++;
        if (['Received', 'Installed'].includes(st)) vendorData[v].received++;
      });

      html += `
        <div style="margin-bottom:32px;">
          <div style="font-size:16px;font-weight:600;font-family:var(--font-display);letter-spacing:0.5px;margin-bottom:14px;">Vendor Summary</div>
