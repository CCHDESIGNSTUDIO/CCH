      await db.collection('boards').doc(projectId).collection('ideabooks').doc(sectionId).update({ images });
      renderProjectDetail();
    }

    // ---- DRAG & DROP ----
    var _ibDrag = null; // { projectId, sectionId, index }

    function ibDragStart(event, projectId, sectionId, index) {
      _ibDrag = { projectId: projectId, sectionId: sectionId, index: index };
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/plain', sectionId + ':' + index);
      event.target.style.opacity = '0.4';
      setTimeout(function() { if (event.target) event.target.style.opacity = '1'; }, 200);
    }

    async function ibDropOnItem(event, projectId, toSectionId, toIndex) {
      event.preventDefault();
      if (!_ibDrag) return;
      var from = _ibDrag;
      _ibDrag = null;

      if (from.sectionId === toSectionId) {
        // Reorder within same section
        if (from.index === toIndex) return;
        var doc = await db.collection('boards').doc(projectId).collection('ideabooks').doc(toSectionId).get();
        var images = doc.data().images || [];
        var item = images.splice(from.index, 1)[0];
        images.splice(toIndex, 0, item);
        await db.collection('boards').doc(projectId).collection('ideabooks').doc(toSectionId).update({ images: images });
      } else {
        // Move between sections
        await ibMoveToSection(projectId, from.sectionId, from.index, toSectionId);
        return; // ibMoveToSection already re-renders
      }
      renderProjectDetail();
    }

    async function ibDropImage(event, projectId, toSectionId) {
      event.preventDefault();

      // ── External drop: local files from desktop ──
      var dt = event.dataTransfer;
      if (dt && dt.files && dt.files.length > 0) {
        var imgFiles = Array.from(dt.files).filter(function(f) { return f.type.startsWith('image/'); });
        if (imgFiles.length > 0) {
          await ibProcessImageFiles(imgFiles, projectId, toSectionId);
          return;
        }
      }

      // ── External drop: image URL dragged from a website ──
      if (dt) {
        var externalUrl = ibExtractDroppedUrl(dt);
        if (externalUrl) {
          await ibAddExternalUrl(externalUrl, projectId, toSectionId);
          return;
        }
      }

      // ── Internal reorder: image dragged from another section slot ──
      if (!_ibDrag) return;
      var from = _ibDrag;
      _ibDrag = null;

      if (from.sectionId === toSectionId) return; // dropped on same grid, ignore

      // Move to end of target section
      await ibMoveToSection(projectId, from.sectionId, from.index, toSectionId);
    }

    async function ibDropOnTab(event, projectId, toSectionId) {
      event.preventDefault();
      if (!_ibDrag) return;
      var from = _ibDrag;
      _ibDrag = null;

      if (from.sectionId === toSectionId) return;

      await ibMoveToSection(projectId, from.sectionId, from.index, toSectionId);
    }

    async function ibMoveToSection(projectId, fromSectionId, index, toSectionId) {
      if (!toSectionId || toSectionId === fromSectionId) return;
      try {
        var fromDoc = await db.collection('boards').doc(projectId).collection('ideabooks').doc(fromSectionId).get();
        var fromImages = fromDoc.data().images || [];
        if (index < 0 || index >= fromImages.length) return;
        var item = fromImages[index];
        fromImages.splice(index, 1);
        await db.collection('boards').doc(projectId).collection('ideabooks').doc(fromSectionId).update({ images: fromImages });
        var toDoc = await db.collection('boards').doc(projectId).collection('ideabooks').doc(toSectionId).get();
        var toImages = toDoc.data().images || [];
        toImages.push(item);
        await db.collection('boards').doc(projectId).collection('ideabooks').doc(toSectionId).update({ images: toImages });
        renderProjectDetail();
      } catch(e) { alert('Error moving: ' + e.message); }
    }

