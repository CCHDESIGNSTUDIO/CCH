    // Sticky section tabs on scroll
    (function() {
      var lastTabs = null;
      var placeholder = null;
      var contentEl = null;
      function checkSticky() {
        var tabs = document.querySelector('.ib-section-tabs');
        if (!tabs) { if (lastTabs) { lastTabs.classList.remove('stuck'); if (placeholder) placeholder.style.display = 'none'; } lastTabs = null; return; }
        if (!contentEl) contentEl = document.querySelector('.content');
        if (!contentEl) return;
        // Create placeholder to prevent content jump
        if (!placeholder || !placeholder.parentNode) {
          placeholder = document.createElement('div');
          placeholder.className = 'ib-tabs-placeholder';
          placeholder.style.display = 'none';
          tabs.parentNode.insertBefore(placeholder, tabs);
        }
        var tabsRect = (tabs.classList.contains('stuck') ? placeholder : tabs).getBoundingClientRect();
        var headerH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 52;
        if (tabsRect.top <= headerH) {
          if (!tabs.classList.contains('stuck')) {
            placeholder.style.height = tabs.offsetHeight + 'px';
            placeholder.style.display = 'block';
            tabs.classList.add('stuck');
          }
        } else {
          tabs.classList.remove('stuck');
          placeholder.style.display = 'none';
        }
        lastTabs = tabs;
      }
      // Listen on window scroll (content may use body scroll or own scroll)
      window.addEventListener('scroll', checkSticky, { passive: true });
      // Also listen on content area scroll
      var observer = new MutationObserver(function() {
        var c = document.querySelector('.content');
        if (c && c !== contentEl) { contentEl = c; c.addEventListener('scroll', checkSticky, { passive: true }); }
      });
      observer.observe(document.body, { childList: true, subtree: true });
      document.addEventListener('scroll', checkSticky, true);
    })();

    // File upload handler for ideabook images
    async function ibUploadFiles(event, projectId, sectionId) {
      var files = event.target.files;
      if (!files || files.length === 0) return;
      await ibProcessImageFiles(Array.from(files), projectId, sectionId);
    }

    // Drag-and-drop file handler — handles both local files AND website image URLs
    async function ibDropFiles(event, projectId, sectionId) {
      var dt = event.dataTransfer;
      if (!dt) return;

      // ── 1. Local files dragged from desktop ──
      if (dt.files && dt.files.length > 0) {
        var imageFiles = Array.from(dt.files).filter(function(f) { return f.type.startsWith('image/'); });
        if (imageFiles.length > 0) {
          await ibProcessImageFiles(imageFiles, projectId, sectionId);
          return;
        }
      }

      // ── 2. Image URL dragged from a website ──
      var imageUrl = ibExtractDroppedUrl(dt);
      if (imageUrl) {
        await ibAddExternalUrl(imageUrl, projectId, sectionId);
        return;
      }
    }

    // Extract an image URL from a drag DataTransfer (from browser tabs or desktop links)
    function ibExtractDroppedUrl(dt) {
      // Priority 1: text/uri-list (standard for image/link drags)
      var uriList = dt.getData('text/uri-list');
      if (uriList) {
        var urls = uriList.split(/\r?\n/).map(function(u) { return u.trim(); }).filter(function(u) { return u && !u.startsWith('#'); });
        // Prefer direct image URLs
        var imgUrl = urls.find(function(u) { return /\.(jpg|jpeg|png|webp|gif|avif|svg)(\?.*)?$/i.test(u); });
        if (imgUrl) return imgUrl;
        if (urls[0]) return urls[0]; // fall back to first URL even if not image extension
      }

      // Priority 2: text/html — parse <img src> out of it
      var html = dt.getData('text/html');
      if (html) {
        var m = html.match(/<img[^>]+src=["']([^"']+)["']/i);
        if (m && m[1]) return m[1];
      }

      // Priority 3: plain text that looks like a URL
      var text = dt.getData('text/plain');
      if (text && /^https?:\/\//i.test(text.trim())) return text.trim();

      return null;
    }

    // Add an external URL (dragged from web or pasted) to an ideabook section
    async function ibAddExternalUrl(url, projectId, sectionId) {
