        const s = await db.collection('boards').doc(projectId).collection('clips').get();
        s.forEach(d => clips.push({id:d.id,...d.data()}));
      } catch(e){}

      if (clips.length === 0) { alert('No room board items to generate from. Publish items from the CCH Clipper first.'); return; }

      // Build proposal items from clips
      const items = clips.map(c => ({
        title: c.title || 'Untitled',
        description: c.description || '',
        category: c.category || 'General',
        amount: parseFloat((c.clientPrice || '0').replace(/[$,]/g, '')) || 0,
        vendor: c.vendor || '',
        imageUrl: c.imageUrl || (c.images && c.images[0]) || null
      }));

      const total = items.reduce((sum, i) => sum + i.amount, 0);

      var _proNum = await getNextDocNumber('PRO');
      var _cUser = (currentUser && currentUser.displayName) || (currentUser && currentUser.email) || 'Unknown';
      const ref = await db.collection('boards').doc(projectId).collection('proposals').add({
        name: _proNum,
        proposalNum: _proNum,
        items, total,
        status: 'Draft',
        createdAt: new Date().toISOString(),
        createdBy: _cUser,
        createdByEmail: (currentUser && currentUser.email) || '',
        activityLog: [{ action: 'created', details: items.length + ' items from room boards', userName: _cUser, userEmail: (currentUser && currentUser.email) || '', timestamp: new Date().toISOString() }]
      });

      try { await db.collection('boards').doc(projectId).update({ proposalCount: firebase.firestore.FieldValue.increment(1) }); } catch(e){}

      // Open the proposal tab
      switchProjectTab('proposals');
    }

