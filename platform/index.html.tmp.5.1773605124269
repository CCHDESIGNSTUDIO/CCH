          'Total Sell': Math.round(totalSell * 100) / 100,
          'Profit': Math.round((totalSell - totalCost) * 100) / 100,
          'Status': c.approvalStatus || c.status || '',
          'Invoice #': c.invoiceNum || ''
        };
      });
