      html += `
              </tbody>
            </table>
          </div>
        </div>
      `;

      // ---- Profit Tracking Connection ----
      const totalCost = clips.reduce((s, c) => s + (parseFloat(c.cost) || 0) * (parseFloat(c.qty) || 1), 0);
      const totalSell = clips.reduce((s, c) => s + (parseFloat(c.totalSelling) || (parseFloat(c.clientPrice) || 0) * (parseFloat(c.qty) || 1)), 0);
      const totalProfitAll = totalSell - totalCost;
      const profitMargin = totalSell > 0 ? (totalProfitAll / totalSell * 100) : 0;

      html += `
        <div style="margin-bottom:32px;">
          <div style="font-size:16px;font-weight:600;font-family:var(--font-display);letter-spacing:0.5px;margin-bottom:14px;">Product Profitability</div>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;">
            <div style="padding:20px;background:linear-gradient(135deg,rgba(200,185,154,0.08),rgba(200,185,154,0.03));border:1px solid rgba(200,185,154,0.15);border-radius:0;text-align:center;">
              <div style="font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--gray-400);margin-bottom:8px;">Product Cost</div>
              <div style="font-size:24px;font-weight:700;color:var(--gold);font-family:var(--font-mono);">${formatMoney(totalCost)}</div>
            </div>
            <div style="padding:20px;background:linear-gradient(135deg,rgba(95,165,107,0.08),rgba(95,165,107,0.03));border:1px solid rgba(95,165,107,0.15);border-radius:0;text-align:center;">
