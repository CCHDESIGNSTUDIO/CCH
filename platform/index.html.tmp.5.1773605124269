    // Cache a single external image to Firebase Storage via canvas
    async function imgMgrCacheSingle(projectId, clipId, url, btn) {
      if (btn) { btn.textContent = '...'; btn.disabled = true; }
      try {
        // Try to load and convert via canvas (works if CORS allows)
        const blob = await _imgFetchAsBlob(url);
        if (blob) {
          const path = 'projects/' + projectId + '/clips/' + clipId + '/' + Date.now() + '-cached.jpg';
          const downloadUrl = await uploadImageToStorage(blob, path);
          await db.collection('boards').doc(projectId).collection('clips').doc(clipId).update({
            imageUrl: downloadUrl, _originalUrl: url, updatedAt: new Date().toISOString()
          });
          if (btn) { btn.textContent = '✅'; btn.style.color = 'var(--green)'; }
          showToast('Cached to Firebase!', 2000);
        } else {
          // CORS blocked - use canvas fallback
          const dataUrl = await _imgCanvasCapture(url);
          if (dataUrl) {
            const path = 'projects/' + projectId + '/clips/' + clipId + '/' + Date.now() + '-cached.jpg';
            const downloadUrl = await uploadBase64ToStorage(dataUrl, path);
            await db.collection('boards').doc(projectId).collection('clips').doc(clipId).update({
              imageUrl: downloadUrl, _originalUrl: url, updatedAt: new Date().toISOString()
            });
            if (btn) { btn.textContent = '✅'; btn.style.color = 'var(--green)'; }
            showToast('Cached to Firebase!', 2000);
          } else {
            if (btn) { btn.textContent = 'CORS blocked'; btn.style.color = 'var(--red)'; btn.disabled = false; }
            showToast('Cannot cache — CORS blocked. Upload manually.', 3000);
          }
        }
      } catch(err) {
        console.error('Cache failed:', err);
        if (btn) { btn.textContent = 'Failed'; btn.style.color = 'var(--red)'; btn.disabled = false; }
      }
    }

    // Try fetch as blob (works for CORS-enabled servers)
    async function _imgFetchAsBlob(url) {
      try {
        const res = await fetch(url, { mode: 'cors', referrerPolicy: 'no-referrer' });
        if (res.ok) return await res.blob();
        return null;
      } catch(e) { return null; }
    }

    // Try canvas capture (works for some images)
    function _imgCanvasCapture(url) {
      return new Promise((resolve) => {
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.referrerPolicy = 'no-referrer';
        const timer = setTimeout(() => resolve(null), 8000);
        img.onload = () => {
          clearTimeout(timer);
          try {
            const canvas = document.createElement('canvas');
            canvas.width = img.naturalWidth;
            canvas.height = img.naturalHeight;
            canvas.getContext('2d').drawImage(img, 0, 0);
            resolve(canvas.toDataURL('image/jpeg', 0.9));
          } catch(e) { resolve(null); }
        };
        img.onerror = () => { clearTimeout(timer); resolve(null); };
        img.src = url;
      });
    }

    // Cache all external-ok images to Firebase
    async function imgMgrCacheAll(projectId) {
      if (!confirm('This will attempt to cache all working external images to Firebase Storage. Images blocked by CORS will need manual upload. Continue?')) return;
      const cards = document.querySelectorAll('[onclick*="imgMgrCacheSingle"]');
      for (const card of cards) {
        card.click();
        await new Promise(r => setTimeout(r, 1500)); // stagger to avoid rate limits
      }
    }

    // Bulk upload: match uploaded files to clips by fuzzy title match
    async function imgMgrBulkUpload(files, projectId, filter) {
      if (!files || !files.length) return;
      // Load clips
      let clips = [];
      try {
        const snap = await db.collection('boards').doc(projectId).collection('clips').get();
        snap.forEach(d => clips.push({ id: d.id, ...d.data() }));
      } catch(e) { return; }

      // For each uploaded file, try to match to a clip by filename similarity
      const fileArr = Array.from(files);
      let matched = 0, unmatched = [];

      for (const file of fileArr) {
        const fname = file.name.replace(/\.[^.]+$/, '').toLowerCase().replace(/[_-]/g, ' ');
        // Find best match by title
        let bestClip = null, bestScore = 0;
        for (const c of clips) {
          const title = (c.title || '').toLowerCase();
          if (!title) continue;
          // Simple word overlap scoring
          const fWords = fname.split(/\s+/);
          const tWords = title.split(/\s+/);
          let score = 0;
          fWords.forEach(fw => { if (tWords.some(tw => tw.includes(fw) || fw.includes(tw))) score++; });
          if (score > bestScore) { bestScore = score; bestClip = c; }
        }

        if (bestClip && bestScore >= 1) {
          try {
            const path = 'projects/' + projectId + '/clips/' + bestClip.id + '/' + Date.now() + '-' + file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
            const downloadUrl = await uploadImageToStorage(file, path);
            await db.collection('boards').doc(projectId).collection('clips').doc(bestClip.id).update({
              imageUrl: downloadUrl, updatedAt: new Date().toISOString()
            });
            matched++;
          } catch(e) { unmatched.push(file.name); }
        } else {
          unmatched.push(file.name);
        }
      }

      const msg = matched + ' image' + (matched !== 1 ? 's' : '') + ' matched and uploaded.' +
        (unmatched.length > 0 ? '\n\nCould not match: ' + unmatched.join(', ') : '');
      alert(msg);

      // Refresh
      const projName = document.querySelector('.modal-title')?.textContent?.replace('🖼️ Image Manager — ', '') || '';
      showImageManager(projectId, projName);
    }

    // ==================== FFE REPORT IMPORT ====================
    // Reads Houzz FFE Export XLSX with embedded thumbnail images
    // Extracts images, uploads to Firebase Storage, creates/updates clips
    async function importFFEReport(projectId, projectName) {
      var input = document.createElement('input');
      input.type = 'file';
      input.accept = '.xlsx,.xls';
      input.onchange = async function(e) {
        var file = e.target.files[0];
        if (!file) return;

        document.getElementById('modalContainer').innerHTML = `
          <div class="modal-overlay">
            <div class="modal" style="width:600px;max-height:85vh;overflow:auto;">
              <div class="modal-header">
                <div class="modal-title">📊 Import FFE Report — ${esc(projectName)}</div>
                <button class="modal-close" onclick="closeModal()">&times;</button>
              </div>
              <div class="modal-body" id="ffeImportProgress">
                <div style="text-align:center;padding:20px;color:var(--gray-400);">
                  <div style="font-size:24px;margin-bottom:8px;">📂</div>
                  Reading ${esc(file.name)}...
                </div>
              </div>
            </div>
          </div>
        `;

        try {
          // Read the XLSX with SheetJS
          var data = await file.arrayBuffer();
          var wb = XLSX.read(data, { type: 'array' });
          var ws = wb.Sheets[wb.SheetNames[0]];
          var rows = XLSX.utils.sheet_to_json(ws, { defval: '' });

          // Also extract embedded images using JSZip
          var zip = await JSZip.loadAsync(data);
          var mediaFiles = {};
          var mediaKeys = Object.keys(zip.files).filter(function(k) { return k.startsWith('xl/media/'); });
          for (var mk of mediaKeys) {
            var fname = mk.split('/').pop();
            mediaFiles[fname] = zip.files[mk];
          }
          console.log('[FFE] Media files found:', mediaKeys.length, Object.keys(mediaFiles));

          // Helper: get elements by local name (ignores XML namespace prefixes)
          function xmlByLocal(parent, localName) {
            var all = parent.getElementsByTagName('*');
            var results = [];
            for (var i = 0; i < all.length; i++) {
              if (all[i].localName === localName) results.push(all[i]);
            }
            return results;
          }

          // Find ALL drawing files (drawing1.xml, drawing2.xml, etc.)
          var drawingFiles = Object.keys(zip.files).filter(function(k) {
            return /^xl\/drawings\/drawing\d+\.xml$/.test(k);
          });
          console.log('[FFE] Drawing files found:', drawingFiles);

          // Parse ALL drawing relationships
          var ridToFile = {};
          for (var df of drawingFiles) {
            try {
              var relsPath = df.replace('xl/drawings/', 'xl/drawings/_rels/') + '.rels';
              if (!zip.files[relsPath]) continue;
              var relsXml = await zip.files[relsPath].async('text');
              var relsDoc = new DOMParser().parseFromString(relsXml, 'text/xml');
              var rels = xmlByLocal(relsDoc, 'Relationship');
              rels.forEach(function(rel) {
                var rid = rel.getAttribute('Id');
                var target = rel.getAttribute('Target') || '';
                if (target.includes('media/')) ridToFile[rid] = target.split('/').pop();
              });
            } catch(e) { console.warn('[FFE] Error parsing rels for', df, e); }
          }
          console.log('[FFE] Relationship IDs mapped:', Object.keys(ridToFile).length, ridToFile);

          // Parse ALL drawing XMLs to map row → image
          var rowToRid = {};
          for (var df of drawingFiles) {
            try {
              var drawXml = await zip.files[df].async('text');
              var drawDoc = new DOMParser().parseFromString(drawXml, 'text/xml');
              // Use localName matching to handle namespace prefixes (xdr:twoCellAnchor, etc.)
              var anchors = [].concat(xmlByLocal(drawDoc, 'twoCellAnchor'), xmlByLocal(drawDoc, 'oneCellAnchor'));
              console.log('[FFE] Anchors found in', df, ':', anchors.length);
              anchors.forEach(function(anchor) {
                var fromEls = xmlByLocal(anchor, 'from');
                if (!fromEls.length) return;
                var rowEls = xmlByLocal(fromEls[0], 'row');
                if (!rowEls.length) return;
                var row = parseInt(rowEls[0].textContent);
                var blips = xmlByLocal(anchor, 'blip');
                if (!blips.length) return;
                // Try all common attribute patterns for the embed reference
                var embed = blips[0].getAttribute('r:embed')
                  || blips[0].getAttributeNS('http://schemas.openxmlformats.org/officeDocument/2006/relationships', 'embed')
                  || blips[0].getAttribute('embed');
                if (embed && ridToFile[embed]) {
                  rowToRid[row] = ridToFile[embed];
                } else {
                  console.warn('[FFE] Blip found but no matching file. embed=' + embed, 'ridToFile keys:', Object.keys(ridToFile));
                }
              });
            } catch(e) { console.warn('[FFE] Error parsing drawing', df, e); }
          }
          console.log('[FFE] Row-to-image mapping:', JSON.stringify(rowToRid));

          // Fallback: if no drawings found, try to match media files to rows by index
          if (Object.keys(rowToRid).length === 0 && mediaKeys.length > 0) {
            console.log('[FFE] No drawing mappings found, using positional fallback for', mediaKeys.length, 'media files');
            // Sort media files by name (image1, image2, etc.)
            var sortedMedia = Object.keys(mediaFiles).sort(function(a, b) {
              var na = parseInt(a.match(/\d+/) || [0]) || 0;
              var nb = parseInt(b.match(/\d+/) || [0]) || 0;
              return na - nb;
            });
            // Map sequentially: image1 → row 1 (first data row), image2 → row 2, etc.
            for (var mi = 0; mi < sortedMedia.length; mi++) {
              rowToRid[mi + 1] = sortedMedia[mi]; // row 1 = first data row after header
            }
            console.log('[FFE] Positional fallback mapping:', JSON.stringify(rowToRid));
          }

          var totalImages = Object.keys(rowToRid).length;
          console.log('[FFE] Total images mapped:', totalImages);

          // Load existing clips for duplicate detection
          var existingClips = [];
          try {
            var clipSnap = await db.collection('boards').doc(projectId).collection('clips').get();
            clipSnap.forEach(function(d) { existingClips.push({ id: d.id, ...d.data() }); });
          } catch(e) {}

          // Build preview
          var items = [];
          for (var ri = 0; ri < rows.length; ri++) {
            var r = rows[ri];
            var title = r['Title'] || r['title'] || '';
            if (!title) continue;
            var vendor = r['Vendor'] || r['vendor'] || '';
            var room = r['Room'] || r['room'] || '';
            var category = r['Category'] || r['category'] || '';
            var sku = r['SKU'] || r['sku'] || '';
            var unitCost = parseFloat(r['Unit Purchase Cost'] || r['Unit Cost'] || 0) || 0;
            var unitSell = parseFloat(r['Unit Selling Price'] || r['Unit Price'] || 0) || 0;
            var totalCost = parseFloat(r['Total Purchase Cost'] || r['Total Cost'] || 0) || 0;
            var totalSell = parseFloat(r['Total Selling Price'] || r['Total Price'] || 0) || 0;
            var qty = parseInt(r['Quantity'] || r['Qty'] || 1) || 1;
            var markup = parseFloat(r['Markup %'] || 0) || 0;
            var website = r['Website Link'] || r['Website'] || '';
            var description = r['Description (client facing)'] || r['Description'] || '';
            var dimensions = r['Dimensions'] || '';
            var finish = r['Finish / Color'] || r['Finish'] || '';
            var materials = r['Materials'] || '';
            var poNum = r['Purchase Order Number'] || '';
            var invNum = r['Invoice Number'] || '';
            var status = r['Approval Status'] || '';
            var imageFile = rowToRid[ri + 1] || null; // Drawing rows are 1-indexed (row 0 = header)
            // Also check for image URL in a data column as fallback
            var imageUrlFromCol = r['Image URL'] || r['Image'] || r['Photo URL'] || r['Photo'] || r['Thumbnail'] || '';
            if (imageUrlFromCol && !imageUrlFromCol.startsWith('http')) imageUrlFromCol = ''; // must be a URL

            // Check for existing clip by title + vendor
            var titleLower = title.toLowerCase().trim();
            var existing = existingClips.find(function(c) {
              return (c.title || '').toLowerCase().trim() === titleLower &&
                     (c.vendor || '').toLowerCase().trim() === (vendor || '').toLowerCase().trim();
            });

            // Check if existing clip has a WORKING image (not just a non-empty URL)
            var existingImgUrl = existing ? (existing.imageUrl || '') : '';
            var existingHasValidImage = false;
            if (existingImgUrl) {
              // Consider image valid only if it's a Firebase Storage URL with a token
              existingHasValidImage = existingImgUrl.includes('firebasestorage.googleapis.com') && existingImgUrl.includes('token=');
            }

            items.push({
              title: title, vendor: vendor, room: room, category: category, sku: sku,
              unitCost: unitCost, unitSell: unitSell, totalCost: totalCost, totalSell: totalSell,
              qty: qty, markup: markup, website: website, description: description,
              dimensions: dimensions, finish: finish, materials: materials,
              poNum: poNum, invNum: invNum, status: status,
              imageFile: imageFile, imageUrlFromCol: imageUrlFromCol,
              existingId: existing ? existing.id : null,
              existingHasImage: existingHasValidImage,
              existingImageUrl: existingImgUrl
            });
          }

          // Show preview
          var newCount = items.filter(function(i) { return !i.existingId; }).length;
          var updateCount = items.filter(function(i) { return i.existingId; }).length;
          var withImages = items.filter(function(i) { return i.imageFile || i.imageUrlFromCol; }).length;
          var needsImage = items.filter(function(i) { return i.existingId && !i.existingHasImage && (i.imageFile || i.imageUrlFromCol); }).length;
          console.log('[FFE] Preview: ' + items.length + ' items, ' + withImages + ' with images, ' + newCount + ' new, ' + updateCount + ' existing, ' + needsImage + ' need images, ' + brokenImages + ' broken');
          var brokenImages = items.filter(function(i) { return i.existingId && i.existingImageUrl && !i.existingHasImage; }).length;

          document.getElementById('ffeImportProgress').innerHTML = `
            <div style="margin-bottom:16px;">
              <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px;">
                <div style="text-align:center;padding:12px;background:var(--gray-50);border-radius:0;">
                  <div style="font-size:22px;font-weight:700;">${items.length}</div>
                  <div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">Total Items</div>
                </div>
                <div style="text-align:center;padding:12px;background:rgba(0,184,212,0.06);border-radius:0;">
                  <div style="font-size:22px;font-weight:700;color:var(--teal);">${newCount}</div>
                  <div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">New Items</div>
                </div>
                <div style="text-align:center;padding:12px;background:rgba(196,164,100,0.06);border-radius:0;">
                  <div style="font-size:22px;font-weight:700;color:var(--gold);">${updateCount}</div>
                  <div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">Existing</div>
                </div>
                <div style="text-align:center;padding:12px;background:rgba(76,175,80,0.06);border-radius:0;">
                  <div style="font-size:22px;font-weight:700;color:var(--green);">${withImages}</div>
                  <div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">With Images</div>
                </div>
              </div>
              ${brokenImages > 0 ? '<div style="padding:8px 12px;background:rgba(231,76,60,0.08);border:1px solid rgba(231,76,60,0.2);border-radius:0;font-size:12px;color:#e74c3c;margin-bottom:8px;">⚠️ ' + brokenImages + ' existing clips have broken/expired image URLs — re-import will fix them!</div>' : ''}
              ${needsImage > 0 && needsImage !== brokenImages ? '<div style="padding:8px 12px;background:rgba(76,175,80,0.08);border:1px solid rgba(76,175,80,0.2);border-radius:0;font-size:12px;color:var(--green);margin-bottom:12px;">✨ ' + needsImage + ' existing clips need images — embedded thumbnails will be uploaded.</div>' : ''}
            </div>
            <div style="max-height:350px;overflow-y:auto;border:1px solid var(--gray-200);border-radius:0;">
