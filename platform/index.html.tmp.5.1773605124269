    // ==================== IMPORT NIICE BOARD ====================
    function ibImportNiice(projectId) {
      // Create hidden file input for zip
      var input = document.createElement('input');
      input.type = 'file';
      input.accept = '.zip';
      input.multiple = true;
      input.onchange = async function(e) {
        var files = Array.from(e.target.files);
        if (files.length === 0) return;

        // Show progress modal
        document.getElementById('modalContainer').innerHTML = `
          <div class="modal-overlay">
            <div class="modal" style="width:500px;">
              <div class="modal-header"><div class="modal-title">📦 Importing Niice Boards</div></div>
              <div class="modal-body" id="niiceImportProgress">
                <div style="text-align:center;padding:20px;color:var(--gray-400);">Processing ${files.length} board(s)...</div>
              </div>
            </div>
          </div>
        `;

        var progressEl = document.getElementById('niiceImportProgress');
        var results = [];

        for (var f = 0; f < files.length; f++) {
          var file = files[f];
          var boardName = file.name.replace(/\.zip$/i, '').replace(/_\d+$/, '').replace(/[-_]/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });

          progressEl.innerHTML += '<div style="padding:4px 0;font-size:13px;">📂 ' + esc(boardName) + '...</div>';

          try {
            var zip = await JSZip.loadAsync(file);

            // Detect subfolder structure (storyboards within the board)
            var subfolders = {};
            var rootFiles = [];
            zip.forEach(function(relativePath, zipEntry) {
              if (zipEntry.dir) return;
              var parts = relativePath.split('/');
              if (parts.length > 1 && parts[0] !== '__MACOSX') {
                var folder = parts[0];
                if (!subfolders[folder]) subfolders[folder] = { images: [], sources: null };
                if (parts[parts.length-1].toLowerCase() === 'sources.txt') subfolders[folder].sources = zipEntry;
                else rootFiles.push({ path: relativePath, entry: zipEntry, folder: folder });
              } else {
                rootFiles.push({ path: relativePath, entry: zipEntry, folder: null });
              }
            });

            // Find root-level sources.txt
            var sourcesTxt = null;
            zip.forEach(function(relativePath, zipEntry) {
              if (relativePath.toLowerCase() === 'sources.txt') sourcesTxt = zipEntry;
            });

            // Parse sources.txt for URL mapping
            var allSourceUrls = [];
            if (sourcesTxt) {
              var txt = await sourcesTxt.async('text');
              var lines = txt.split('\n');
              lines.forEach(function(line) {
                var match = line.match(/url:\s*(https?:\/\/[^\s)]+)/);
                if (match) allSourceUrls.push(match[1]);
              });
              allSourceUrls = [...new Set(allSourceUrls)];
            }

            // Also check subfolder sources.txt files
            for (var sfKey in subfolders) {
              if (subfolders[sfKey].sources) {
                var sfTxt = await subfolders[sfKey].sources.async('text');
                sfTxt.split('\n').forEach(function(line) {
                  var match = line.match(/url:\s*(https?:\/\/[^\s)]+)/);
                  if (match) {
                    subfolders[sfKey].images.push(match[1]);
                    allSourceUrls.push(match[1]);
                  }
                });
              }
            }

            // Determine if we should split into multiple sections
            var folderNames = Object.keys(subfolders).filter(function(k) { return subfolders[k].images.length > 0; });
            var hasMeaningfulSubfolders = folderNames.length > 1;

            // Get current max order
            var snap = await db.collection('boards').doc(projectId).collection('ideabooks').get();
            var maxOrder = 0;
            snap.forEach(function(d) { var o = d.data().order || 0; if (o > maxOrder) maxOrder = o; });

            if (hasMeaningfulSubfolders) {
              // Create a section per subfolder (storyboard)
              var sectionCount = 0;
              for (var si = 0; si < folderNames.length; si++) {
                var sfName = folderNames[si].replace(/[-_]/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
                var sfUrls = [...new Set(subfolders[folderNames[si]].images)];
                if (sfUrls.length === 0) continue;
                var sfImages = sfUrls.map(function(url, idx) {
                  var filename = url.split('/').pop().split('?')[0];
                  var isEtsy = filename.startsWith('il_');
                  return { imageUrl: url, caption: '', sourceUrl: '', vendor: isEtsy ? 'Etsy' : '', showPrice: true, showSource: true, stars: 0, comments: [], tags: [], addedAt: new Date().toISOString(), importedFrom: 'niice', originalFile: filename };
                });
                await db.collection('boards').doc(projectId).collection('ideabooks').add({
                  name: sfName, description: 'Imported from Niice — ' + sfImages.length + ' images', images: sfImages, order: maxOrder + f * 100 + si + 1, createdAt: new Date().toISOString(), source: 'niice-import', parentBoard: boardName
                });
                sectionCount++;
                progressEl.innerHTML += '<div style="padding:2px 0;font-size:12px;color:var(--green);">  ✓ ' + sfImages.length + ' images → "' + esc(sfName) + '"</div>';
              }
              results.push({ name: boardName, status: 'ok', count: allSourceUrls.length, sections: sectionCount });
            } else {
              // Single section (original behavior)
              var imageUrls = allSourceUrls.length > 0 ? allSourceUrls : [];

            // If no sources.txt URLs found, try image files directly
            if (imageUrls.length === 0) {
              var imgFiles = [];
              zip.forEach(function(relativePath, zipEntry) {
                if (/\.(png|jpg|jpeg|webp|gif)$/i.test(relativePath) && !zipEntry.dir) {
                  imgFiles.push(zipEntry);
                }
              });
              if (imgFiles.length > 0) {
                progressEl.innerHTML += '<div style="padding:2px 0;font-size:11px;color:var(--gray-400);">  ⚠️ ' + imgFiles.length + ' images found but no sources.txt — images need CDN URLs to display</div>';
              }
            }

            imageUrls = [...new Set(imageUrls)];

            if (imageUrls.length === 0) {
              progressEl.innerHTML += '<div style="padding:2px 0;font-size:11px;color:var(--red);">  ✕ No image URLs found in ' + esc(file.name) + '</div>';
              results.push({ name: boardName, status: 'empty', count: 0 });
              continue;
            }

            // Build images array
            var images = imageUrls.map(function(url, idx) {
              var filename = url.split('/').pop().split('?')[0];
              var ext = filename.split('.').pop();
              var isEtsy = filename.startsWith('il_');
              return {
                imageUrl: url,
                caption: '',
                sourceUrl: '',
                vendor: isEtsy ? 'Etsy' : '',
                showPrice: true,
                showSource: true,
                stars: 0,
                comments: [],
                tags: [],
                addedAt: new Date().toISOString(),
                importedFrom: 'niice',
                originalFile: filename
              };
            });

            // Create ideabook section
            var docRef = await db.collection('boards').doc(projectId).collection('ideabooks').add({
              name: boardName,
              description: 'Imported from Niice — ' + images.length + ' images',
              images: images,
              order: maxOrder + f + 1,
              createdAt: new Date().toISOString(),
              source: 'niice-import'
            });

            progressEl.innerHTML += '<div style="padding:2px 0;font-size:12px;color:var(--green);font-weight:600;">  ✓ ' + images.length + ' images imported as "' + esc(boardName) + '"</div>';
            results.push({ name: boardName, status: 'ok', count: images.length, id: docRef.id });
            }

          } catch(err) {
            progressEl.innerHTML += '<div style="padding:2px 0;font-size:11px;color:var(--red);">  ✕ Error: ' + esc(err.message) + '</div>';
            results.push({ name: boardName, status: 'error', error: err.message });
          }
        }

        // Summary
        var totalImported = results.filter(function(r) { return r.status === 'ok'; }).reduce(function(s, r) { return s + r.count; }, 0);
        var totalBoards = results.filter(function(r) { return r.status === 'ok'; }).length;

        progressEl.innerHTML += '<div style="margin-top:16px;padding:12px 16px;background:var(--gray-50);border-radius:0;">' +
          '<div style="font-size:16px;font-weight:700;color:var(--gold);">✅ Import Complete</div>' +
          '<div style="font-size:13px;margin-top:4px;">' + totalBoards + ' board(s) · ' + totalImported + ' total images</div>' +
          '</div>' +
          '<div style="text-align:right;margin-top:12px;">' +
            '<button class="btn btn-primary" onclick="closeModal();ibActiveSection=\'' + (results[0] && results[0].id ? results[0].id : '') + '\';renderProjectDetail();">View Boards</button>' +
          '</div>';
      };
      input.click();
    }

