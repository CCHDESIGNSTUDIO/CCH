    @media (max-width: 1200px) { .asset-masonry { columns: 4; } }
    @media (max-width: 900px) { .asset-masonry { columns: 3; } }
    @media (max-width: 600px) { .asset-masonry { columns: 2; } }
    .ideabook-card { cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; overflow: hidden; border-radius: 0; background: white; border: none; box-shadow: none; }
    .ideabook-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.12); }
    .ideabook-cover { position: relative; width: 100%; aspect-ratio: 4/3; overflow: hidden; border-radius: 0; background: var(--gray-100); display: grid; gap: 2px; }
    .ideabook-cover.imgs-1 { grid-template-columns: 1fr; }
    .ideabook-cover.imgs-2 { grid-template-columns: 1fr 1fr; }
    .ideabook-cover.imgs-3 { grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; }
    .ideabook-cover.imgs-3 img:first-child { grid-row: 1 / 3; }
    .ideabook-cover.imgs-4 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
    .ideabook-cover img { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
