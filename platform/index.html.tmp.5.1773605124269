                       proj.clientName || proj.client || proj.customerName || '';
      let clientEmail = invData.clientEmail || invData.email || proj.clientEmail || proj.email || '';
      let clientPhone = invData.clientPhone || invData.phone || proj.clientPhone || proj.phone || '';
