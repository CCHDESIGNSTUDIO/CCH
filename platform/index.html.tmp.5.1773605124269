                  <th style="padding:10px 8px;text-align:center;">Received</th>
                </tr>
              </thead>
              <tbody>
      `;

      Object.keys(vendorData).sort((a, b) => vendorData[b].sell - vendorData[a].sell).forEach(v => {
        const d = vendorData[v];
        const profit = d.sell - d.cost;
        const margin = d.sell > 0 ? (profit / d.sell * 100) : 0;

        html += `
          <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
