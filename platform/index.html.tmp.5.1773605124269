          if (c.projectName) projectNames[c.projectName] = true;
          // Track time range
          if (c.startTime && (!timeRangeStart || c.startTime < timeRangeStart)) timeRangeStart = c.startTime;
          if (c.endTime && (!timeRangeEnd || c.endTime > timeRangeEnd)) timeRangeEnd = c.endTime;
        });
        // Format time for display
        function fmtTime(ts) {
          if (!ts) return '';
          var m = String(ts).match(/T?(\d{1,2}):(\d{2})/);
          if (!m) return '';
          var h = parseInt(m[1]), mm = m[2];
          var ampm = h >= 12 ? 'pm' : 'am';
          if (h > 12) h -= 12; if (h === 0) h = 12;
          return h + ':' + mm + ampm;
        }
        var timeLabel = '';
        if (timeRangeStart) {
          timeLabel = fmtTime(timeRangeStart);
          if (timeRangeEnd && timeRangeEnd !== timeRangeStart) timeLabel += '–' + fmtTime(timeRangeEnd);
        }
        // Detect meetings and calls
        var aiSug = _tlCaptureSuggestions[g.indices[0]];
        var isMeeting = false;
        var meetingLabel = '';
        var appLow = (g.app || '').toLowerCase();
        if (appLow === 'ms-teams' || appLow === 'microsoft teams' || appLow === 'teams') {
