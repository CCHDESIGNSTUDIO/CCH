          { '': 'Invoices without QB ID', 'Count': unsyncedInv.length, 'Total $': unsyncedInv.reduce(function(s,i){return s+(parseFloat(i.total)||0)},0) },
          { '': 'Invoices WITH QB ID', 'Count': syncedInv.length, 'Total $': syncedInv.reduce(function(s,i){return s+(parseFloat(i.total)||0)},0) },
          { '': '' },
          { '': 'POs without QB ID', 'Count': unsyncedPO.length, 'Total $': unsyncedPO.reduce(function(s,p){return s+(parseFloat(p.total)||0)},0) },
          { '': 'POs WITH QB ID', 'Count': syncedPO.length, 'Total $': syncedPO.reduce(function(s,p){return s+(parseFloat(p.total)||0)},0) },
          { '': '' },
          { '': 'Retainers without QB ID', 'Count': unsyncedRR.length },
          { '': 'Retainers WITH QB ID', 'Count': syncedRR.length },
        ];
        XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(summaryRows), 'Summary');

        XLSX.writeFile(wb, 'CCH-QB-Sync-Report-' + new Date().toISOString().slice(0,10) + '.xlsx');
        console.log('[QB Report] Download triggered');

      } catch(err) {
