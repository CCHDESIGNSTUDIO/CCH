            var myMemberName = typeof currentMemberName === 'function' ? currentMemberName() : '';
            var myEmail = (currentUser && currentUser.email) ? currentUser.email.toLowerCase() : '';
            var myFirst = myMemberName ? myMemberName.toLowerCase().split(' ')[0] : '';
            var skipMemberFilter = window._captureShowAll || false;
            // Build all name variants for matching
