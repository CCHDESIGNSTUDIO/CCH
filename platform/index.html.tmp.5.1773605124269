        ` : ''}

        ${externalOk.length > 0 ? `
          <div style="margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;">
            <div style="font-size:15px;font-weight:600;color:#F57C00;">🌐 External Images — Still Working (${externalOk.length})</div>
