    let importData = null;

    async function handleImportFile(file) {
      if (!file) return;
      const status = document.getElementById('importStatus');
      status.innerHTML = '<div style="color:var(--gold);font-weight:600;">Reading file...</div>';

      // Wait for SheetJS
      let tries = 0;
      while (!window.XLSX && tries < 50) { await new Promise(r => setTimeout(r, 100)); tries++; }
      if (!window.XLSX) { status.innerHTML = '<div style="color:var(--red);">Error loading parser library.</div>'; return; }

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = new Uint8Array(e.target.result);
          const wb = XLSX.read(data, { type: 'array' });
          const sheet = wb.Sheets[wb.SheetNames[0]];

          // Find the Image column letter dynamically
          const range = XLSX.utils.decode_range(sheet['!ref'] || 'A1');
          let imageCol = null;
          for (let c = range.s.c; c <= range.e.c; c++) {
            const addr = XLSX.utils.encode_cell({r:0, c:c});
            const cell = sheet[addr];
            if (cell && String(cell.v).trim() === 'Image') {
              imageCol = XLSX.utils.encode_col(c);
              break;
            }
          }

          // Extract ALL hyperlinks - check .l property on every cell
          const hyperlinks = {};
          Object.keys(sheet).forEach(key => {
            if (key.startsWith('!')) return;
            if (sheet[key] && sheet[key].l && sheet[key].l.Target) {
              hyperlinks[key] = sheet[key].l.Target;
            }
          });

          // Map image hyperlinks to row numbers
          const imageUrlsByRow = {};
          if (imageCol) {
            Object.keys(hyperlinks).forEach(ref => {
              const col = ref.replace(/[0-9]/g, '');
              const row = parseInt(ref.replace(/[^0-9]/g, ''));
              if (col === imageCol) {
                imageUrlsByRow[row] = hyperlinks[ref];
              }
            });
          }

          const rows = XLSX.utils.sheet_to_json(sheet, { defval: '' });
          parseHouzzData(rows, imageUrlsByRow, file.name, imageCol);
        } catch(err) {
          status.innerHTML = '<div style="color:var(--red);">Error parsing file: ' + err.message + '</div>';
        }
      };
      reader.readAsArrayBuffer(file);
    }

    function parseHouzzData(rows, imageUrlsByRow, filename, imageCol) {
      const status = document.getElementById('importStatus');
      const preview = document.getElementById('importPreview');
      const footer = document.getElementById('importFooter');

      // Map columns
      const projectName = rows[0] ? (rows[0]['Project Name'] || '') : '';
      const items = [];
      const rooms = new Set();
      const vendors = new Set();
      let imageCount = 0;

      rows.forEach((row, i) => {
        const rowNum = i + 2; // 1-indexed, plus header
        const imageUrl = imageUrlsByRow[rowNum] || '';
        if (imageUrl) imageCount++;

        const item = {
          title: row['Title'] || '',
          room: row['Room'] || '',
          clientDescription: row['Client Description'] || '',
          vendorDescription: row['Vendor Description'] || '',
          vendor: row['Vendor'] || '',
          materials: row['Materials'] || '',
          finishColor: row['Finish/Color'] || '',
          status: row['Status'] || '',
          sku: row['SKU'] || '',
          imageUrl: imageUrl,
          imageName: row['Image'] || '',
          sellingQty: parseFloat(row['Selling Quantity']) || 0,
          unitSellingPrice: parseFloat(row['Unit Selling Price']) || 0,
          markupPct: parseFloat(row['Markup %']) || 0,
          markupValue: parseFloat(row['Markup Value']) || 0,
          totalSellingPrice: parseFloat(row['Total Selling Price']) || 0,
          unitPurchaseCost: parseFloat(row['Unit Purchase Cost']) || 0,
          totalPurchaseCost: parseFloat(row['Total Purchase Cost']) || 0,
          proposal: row['Proposal'] || '',
          proposalDate: row['Proposal Date'] || '',
          invoice: row['Invoice'] || '',
          invoiceDate: row['Invoice Date'] || '',
          purchaseOrder: row['Purchase Order'] || '',
          poDate: row['Purchase Order Date'] || '',
          shippingAddress: row['Shipping Address'] || '',
          notes: row['Notes'] || '',
          assignee: row['Assignee'] || '',
          category: row['Category'] || ''
        };

        if (item.room) rooms.add(item.room);
        if (item.vendor) vendors.add(item.vendor);
        items.push(item);
      });

      importData = { projectName, items, rooms: [...rooms], vendors: [...vendors], filename, imageCount };

      status.innerHTML = '<div style="color:var(--green);font-weight:600;">✓ File parsed successfully</div>';
      preview.style.display = 'block';
      preview.innerHTML = `
        <div class="card card-body">
          <div style="font-weight:700;margin-bottom:12px;font-size:16px;">${esc(projectName || filename)}</div>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px;">
            <div style="text-align:center;"><div style="font-size:24px;font-weight:700;">${items.length}</div><div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;">Products</div></div>
            <div style="text-align:center;"><div style="font-size:24px;font-weight:700;">${rooms.size}</div><div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;">Rooms</div></div>
            <div style="text-align:center;"><div style="font-size:24px;font-weight:700;">${vendors.size}</div><div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;">Vendors</div></div>
            <div style="text-align:center;"><div style="font-size:24px;font-weight:700;">${imageCount}</div><div style="font-size:11px;color:var(--gray-400);text-transform:uppercase;">Images</div></div>
          </div>
          <div style="font-size:12px;color:var(--gray-500);">
            <strong>Rooms:</strong> ${[...rooms].map(r => esc(r)).join(', ') || 'None'}<br>
            <strong>Top Vendors:</strong> ${[...vendors].slice(0,8).map(v => esc(v)).join(', ')}${vendors.size > 8 ? '...' : ''}
          </div>
          ${imageCount > 0 ? '<div style="margin-top:8px;padding:8px;background:var(--gold-light);border-radius:0;font-size:12px;color:var(--gold-dark);"><strong>⚠️ Image URLs expire in ~24 hours.</strong> Import now to capture them.</div>' : ''}
        </div>
      `;
      footer.style.display = 'flex';
    }

    async function confirmImport() {
      if (!importData) return;
      const btn = document.getElementById('importConfirmBtn');
      const status = document.getElementById('importStatus');
      btn.disabled = true;
      btn.textContent = 'Importing...';

      try {
        const projectId = importData.projectName
          ? importData.projectName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '')
          : 'import-' + Date.now();

        // Create/update the board document
        const boardRef = db.collection('boards').doc(projectId);
        const boardDoc = await boardRef.get();

        const boardData = {
          name: importData.projectName || projectId,
          clipCount: importData.items.length,
          categories: importData.rooms,
          updatedAt: new Date().toISOString(),
          source: 'houzz-import',
          owner: currentUser.email
        };

        if (boardDoc.exists) {
          await boardRef.update(boardData);
        } else {
          boardData.createdAt = new Date().toISOString();
          boardData.status = 'In Progress';
          await boardRef.set(boardData);
        }

        // === PASS 1: Import items as clips ===
        status.innerHTML = '<div style="color:var(--gold);font-weight:600;">Pass 1/4 — Importing products...</div>';
        let imported = 0;
        const batch_size = 400;
        let batch = db.batch();
        let batchCount = 0;
        const clipIdMap = {}; // title -> clipId for PO linking

        for (const item of importData.items) {
          if (!item.title && !item.imageUrl) continue;
          const clipRef = boardRef.collection('clips').doc();
          clipIdMap[item.title] = clipRef.id;
          batch.set(clipRef, {
            title: item.title || 'Untitled',
            imageUrl: item.imageUrl || null,
            room: item.room || null,
            category: item.category || null,
            vendor: item.vendor || null,
            description: item.clientDescription || item.vendorDescription || null,
            finish: item.finishColor || null,
            materials: item.materials || null,
            sku: item.sku || null,
            clientPrice: item.totalSellingPrice ? '$' + item.totalSellingPrice.toFixed(2) : (item.unitSellingPrice ? '$' + item.unitSellingPrice.toFixed(2) : null),
            cost: item.unitPurchaseCost ? '$' + item.unitPurchaseCost.toFixed(2) : null,
            qty: item.sellingQty || 1,
            status: item.status || null,
            houzzProposal: item.proposal || null,
            houzzInvoice: item.invoice || null,
            houzzPO: item.purchaseOrder || null,
            notes: item.notes || null,
            savedAt: new Date().toISOString(),
            source: 'houzz-import'
          });
          batchCount++; imported++;
          if (batchCount >= batch_size) {
            await batch.commit(); batch = db.batch(); batchCount = 0;
            status.innerHTML = `<div style="color:var(--gold);font-weight:600;">Pass 1/4 — ${imported}/${importData.items.length} products...</div>`;
          }
        }
        if (batchCount > 0) await batch.commit();

        // === PASS 2: Group items by proposal name and create proposal docs ===
        status.innerHTML = '<div style="color:var(--gold);font-weight:600;">Pass 2/4 — Building proposals...</div>';
        const proposalGroups = {};
        importData.items.forEach(item => {
          if (!item.proposal) return;
          if (!proposalGroups[item.proposal]) {
            proposalGroups[item.proposal] = { name: item.proposal, date: item.proposalDate, items: [] };
          }
          proposalGroups[item.proposal].items.push(item);
        });
        let propCount = 0;
        for (const [propName, propData] of Object.entries(proposalGroups)) {
          const items = propData.items.map(item => ({
            description: item.title || 'Item',
            qty: item.sellingQty || 1,
            unitPrice: item.unitSellingPrice || 0,
            lineTotal: item.totalSellingPrice || (item.sellingQty * item.unitSellingPrice) || 0,
            vendor: item.vendor || '',
            room: item.room || '',
            sku: item.sku || '',
            imageUrl: item.imageUrl || null
          }));
          const total = items.reduce((s, i) => s + (i.lineTotal || 0), 0);
          const propRef = boardRef.collection('proposals').doc();
          await propRef.set({
            name: propName,
            number: propName,
            items: items,
            total: total,
            status: 'Sent',
            source: 'houzz-import',
            createdAt: propData.date ? new Date(propData.date).toISOString() : new Date().toISOString(),
            owner: currentUser.email
          });
          propCount++;
        }

        // === PASS 3: Group items by invoice and create invoice docs ===
        status.innerHTML = '<div style="color:var(--gold);font-weight:600;">Pass 3/4 — Building invoices...</div>';
        const invoiceGroups = {};
        importData.items.forEach(item => {
          if (!item.invoice) return;
          if (!invoiceGroups[item.invoice]) {
            invoiceGroups[item.invoice] = { name: item.invoice, date: item.invoiceDate, items: [] };
          }
          invoiceGroups[item.invoice].items.push(item);
        });
        let invCount = 0;
        for (const [invName, invData] of Object.entries(invoiceGroups)) {
          const items = invData.items.map(item => ({
            description: item.title || 'Item',
            qty: item.sellingQty || 1,
            unitPrice: item.unitSellingPrice || 0,
            lineTotal: item.totalSellingPrice || 0,
            vendor: item.vendor || '',
            room: item.room || '',
            imageUrl: item.imageUrl || null,
            cost: item.unitPurchaseCost || 0,
            sku: item.sku || ''
          }));
          const total = items.reduce((s, i) => s + (i.lineTotal || 0), 0);
          const invRef = boardRef.collection('invoices').doc();
          await invRef.set({
            number: invName,
            name: invName,
            items: items,
            total: total,
            status: 'Sent',
            source: 'houzz-import',
            createdAt: invData.date ? new Date(invData.date).toISOString() : new Date().toISOString(),
            owner: currentUser.email
          });
          invCount++;
        }

        // === PASS 4: Group items by PO and create PO docs ===
        status.innerHTML = '<div style="color:var(--gold);font-weight:600;">Pass 4/4 — Building purchase orders...</div>';
        const poGroups = {};
        importData.items.forEach(item => {
          if (!item.purchaseOrder) return;
          // Group by PO name + vendor
          const key = item.purchaseOrder + '|||' + (item.vendor || '');
          if (!poGroups[key]) {
            poGroups[key] = { name: item.purchaseOrder, vendor: item.vendor || '', date: item.poDate, items: [] };
          }
          poGroups[key].items.push(item);
        });
        let poCount = 0;
        for (const [poKey, poData] of Object.entries(poGroups)) {
          const items = poData.items.map(item => ({
            description: item.title || 'Item',
            qty: item.sellingQty || 1,
            unitCost: item.unitPurchaseCost || 0,
            lineTotal: item.totalPurchaseCost || 0,
            sku: item.sku || '',
            room: item.room || '',
            imageUrl: item.imageUrl || null
          }));
          const total = items.reduce((s, i) => s + (i.lineTotal || 0), 0);
          const poRef = boardRef.collection('purchaseOrders').doc();
          await poRef.set({
            number: poData.name,
            vendor: poData.vendor,
            items: items,
            total: total,
            status: 'Ordered',
            source: 'houzz-import',
            description: items.map(i => i.description).join(', ').substring(0, 500),
            date: poData.date || '',
            orderDate: poData.date || '',
            createdAt: new Date().toISOString(),
            owner: currentUser.email
          });
          poCount++;
        }

        // Update board counts
        await boardRef.update({
          proposalCount: propCount,
          invoiceCount: invCount,
          poCount: poCount
        });

        status.innerHTML = `<div style="color:var(--green);font-weight:600;">✓ Import complete! ${imported} products · ${propCount} proposals · ${invCount} invoices · ${poCount} POs</div>`;
        btn.textContent = 'Done!';

        setTimeout(() => {
          closeModal();
          navigate('#/project/' + projectId + '/boards');
        }, 2000);

      } catch(err) {
        status.innerHTML = `<div style="color:var(--red);">Error: ${err.message}</div>`;
        btn.disabled = false;
        btn.textContent = 'Retry Import';
      }
    }

