    async function createInvoice(projectId) {
      const lines = document.querySelectorAll('.inv-line');
      const items = [];
      let total = 0;
      lines.forEach(line => {
        const inputs = line.querySelectorAll('input');
        const desc = inputs[0].value.trim();
        const qty = parseFloat(inputs[1].value) || 1;
        const amount = parseFloat(inputs[2].value) || 0;
        if (desc || amount) {
          const lineTotal = qty * amount;
          items.push({ description: desc, qty, amount, lineTotal });
          total += lineTotal;
        }
      });

      var _cUser = (currentUser && currentUser.displayName) || (currentUser && currentUser.email) || 'Unknown';
      await db.collection('boards').doc(projectId).collection('invoices').add({
        number: document.getElementById('invNum').value.trim(),
        dueDate: document.getElementById('invDue').value,
        notes: document.getElementById('invNotes').value.trim(),
        items, total,
        status: 'Draft',
        createdAt: new Date().toISOString(),
        createdBy: _cUser,
        createdByEmail: (currentUser && currentUser.email) || '',
        activityLog: [{ action: 'created', details: items.length + ' line items, total ' + formatMoney(total), userName: _cUser, userEmail: (currentUser && currentUser.email) || '', timestamp: new Date().toISOString() }]
      });

      // Update count
      try { await db.collection('boards').doc(projectId).update({ invoiceCount: firebase.firestore.FieldValue.increment(1) }); } catch(e){}

      closeModal();
      renderProjectDetail();
    }

