    async function saveCorrespondence(projectId) {
      var commType = document.getElementById('corrType').value;
      var subject = document.getElementById('corrSubject').value.trim();
      var body = document.getElementById('corrBody').value.trim();
      if (!subject && !body) { alert('Please add a subject or details.'); return; }

      var linkedVal = document.getElementById('corrLinkedDoc').value;
      var linkedDocType = '', linkedDocId = '', linkedDocNum = '';
      if (linkedVal) {
        var parts = linkedVal.split('|');
        linkedDocType = parts[0] || '';
        linkedDocId = parts[1] || '';
        linkedDocNum = parts[2] || '';
      }

      var attachUrls = [];
      document.querySelectorAll('.corr-attach-url').forEach(function(inp) {
        if (inp.value.trim()) attachUrls.push(inp.value.trim());
      });

      var _cUser = (currentUser && currentUser.displayName) || (currentUser && currentUser.email) || 'Unknown';

      var data = {
        commType: commType, subject: subject, body: body,
        from: document.getElementById('corrFrom').value.trim(),
        to: document.getElementById('corrTo').value.trim(),
        vendor: document.getElementById('corrVendor').value.trim(),
        contact: document.getElementById('corrContact').value.trim(),
        date: document.getElementById('corrDate').value || new Date().toISOString().split('T')[0],
        linkedDocType: linkedDocType, linkedDocId: linkedDocId, linkedDocNum: linkedDocNum,
        attachmentUrls: attachUrls,
        loggedBy: _cUser, loggedByEmail: (currentUser && currentUser.email) || '',
        createdAt: new Date().toISOString()
      };

      var statusEl = document.getElementById('corrStatus');
      if (statusEl && (commType === 'change_order' || commType === 'approval')) {
        data.status = statusEl.value;
      }

      try {
        await db.collection('boards').doc(projectId).collection('correspondence').add(data);
        closeModal();
        showToast('Correspondence logged');
        renderProjectDetail();
      } catch(e) { alert('Error saving: ' + e.message); }
    }

