    function renderReconciliationView(container, filtered, admin) {
      // Get last 14 days
      const days = [];
      const today = new Date();
      for (let i = 0; i < 14; i++) {
        const d = new Date(today);
        d.setDate(d.getDate() - i);
        days.push(d.toISOString().split('T')[0]);
      }

      // Build per-day data
      const dayData = days.map(dateStr => {
        const dayEntries = timeEntries.filter(t => t.date === dateStr);
        const loggedHours = dayEntries.reduce((s, t) => s + (parseFloat(t.hours) || 0), 0);
        const loggedValue = dayEntries.filter(t => t.billable).reduce((s, t) => s + (parseFloat(t.total) || 0), 0);
        const invoicedValue = dayEntries.filter(t => t.invoiceId).reduce((s, t) => s + (parseFloat(t.invoicedAmount) || parseFloat(t.total) || 0), 0);
        const entryCount = dayEntries.length;

        // Check for captured but unlogged time
        const captures = (window._dayBuckets && window._dayBuckets[dateStr]) || [];
        const capturedMinutes = captures.reduce((s, b) => {
          if (b.items) {
            return s + b.items.reduce((s2, item) => s2 + (parseFloat(item.duration) || 0), 0);
          }
          return s;
        }, 0);
        const unloggedBuckets = captures.filter(b => !b.logged && b.items && b.items.length > 0).length;

        // Group by member
        const byMember = {};
        dayEntries.forEach(t => {
          const m = t.member || 'Unknown';
          if (!byMember[m]) byMember[m] = { hours: 0, value: 0, entries: 0 };
          byMember[m].hours += parseFloat(t.hours) || 0;
          byMember[m].value += t.billable ? (parseFloat(t.total) || 0) : 0;
          byMember[m].entries++;
        });

        // Group by project
        const byProject = {};
        dayEntries.forEach(t => {
          const p = t.project || 'Unassigned';
          if (!byProject[p]) byProject[p] = { hours: 0, value: 0 };
          byProject[p].hours += parseFloat(t.hours) || 0;
          byProject[p].value += t.billable ? (parseFloat(t.total) || 0) : 0;
