    async function executeFFEImport(projectId) {
      var d = window._ffeImportData;
      if (!d) return;

      var btn = document.getElementById('ffeImportBtn');
      if (btn) { btn.disabled = true; btn.textContent = 'Importing...'; }

      var skipExisting = document.getElementById('ffeSkipExisting')?.checked;
      var checkboxes = document.querySelectorAll('.ffe-item-cb');
      var selectedIdxs = new Set();
      checkboxes.forEach(function(cb) { if (cb.checked) selectedIdxs.add(parseInt(cb.dataset.idx)); });

      var progress = document.getElementById('ffeImportProgress');
      var created = 0, updated = 0, skipped = 0, imgUploaded = 0, imgFailed = 0;

      for (var i = 0; i < d.items.length; i++) {
        var item = d.items[i];
        if (!selectedIdxs.has(i)) { skipped++; continue; }
        if (skipExisting && item.existingId && item.existingHasImage) { skipped++; continue; }

        // Upload embedded image to Firebase Storage if available
        var imageUrl = '';
        if (item.imageFile && d.mediaFiles[item.imageFile]) {
          try {
            var imgBlob = await d.mediaFiles[item.imageFile].async('blob');
            var ext = (item.imageFile.split('.').pop() || 'jpeg').toLowerCase();
            // Normalize EMF/WMF to png (not valid web formats)
            if (ext === 'emf' || ext === 'wmf') ext = 'png';
            var contentType = ext === 'jpg' ? 'image/jpeg' : 'image/' + ext;
            var storagePath = 'projects/' + projectId + '/clips/' + Date.now() + '_' + i + '.' + ext;
            console.log('[FFE] Uploading image for "' + item.title + '": ' + item.imageFile + ' → ' + storagePath);
            var ref = firebase.storage().ref(storagePath);
            await ref.put(imgBlob, { contentType: contentType });
            imageUrl = await ref.getDownloadURL();
            imgUploaded++;
            console.log('[FFE] ✓ Image uploaded:', item.title, imageUrl.substring(0, 80) + '...');
          } catch(e) {
            imgFailed++;
            console.error('[FFE] ✗ Image upload FAILED for "' + item.title + '":', e.code || e.message || e);
          }
        } else if (!item.imageFile) {
          // Fallback: use image URL from spreadsheet column if available
          if (item.imageUrlFromCol) {
            imageUrl = item.imageUrlFromCol;
            imgUploaded++;
            console.log('[FFE] Using column URL for "' + item.title + '":', imageUrl.substring(0, 80));
          } else {
            console.log('[FFE] No image file mapped for "' + item.title + '" (row ' + i + ')');
          }
        }

        // Build clip data
        var clipData = {
          title: item.title,
          vendor: item.vendor,
          room: item.room || '',
          category: item.category || '',
          sku: item.sku || '',
          cost: item.unitCost || 0,
          totalCost: item.totalCost || 0,
          clientPrice: item.unitSell || 0,
          totalSelling: item.totalSell || 0,
          qty: item.qty || 1,
          markup: item.markup || 0,
          website: item.website || '',
          description: item.description || '',
          dimensions: item.dimensions || '',
          finish: item.finish || '',
          materials: item.materials || '',
          poNum: item.poNum || '',
          invoiceNum: item.invNum || '',
          approvalStatus: item.status || '',
          source: 'ffe-import',
          importedAt: new Date().toISOString()
        };

        if (imageUrl) clipData.imageUrl = imageUrl;

        if (item.existingId) {
          // Update existing clip — always overwrite image if we uploaded a new one
          var updateFields = {};
          if (imageUrl) updateFields.imageUrl = imageUrl; // Always update image when we have a fresh upload
          if (item.room) updateFields.room = item.room;
          // Always update financial data if we have it
          if (item.totalCost > 0) { updateFields.cost = item.unitCost; updateFields.totalCost = item.totalCost; }
          if (item.totalSell > 0) { updateFields.clientPrice = item.unitSell; updateFields.totalSelling = item.totalSell; }
          if (item.qty > 1) updateFields.qty = item.qty;
          if (item.poNum) updateFields.poNum = item.poNum;
          if (item.invNum) updateFields.invoiceNum = item.invNum;
          if (item.website) updateFields.website = item.website;
          if (item.sku) updateFields.sku = item.sku;
          if (item.dimensions) updateFields.dimensions = item.dimensions;
          if (item.finish) updateFields.finish = item.finish;
          if (item.materials) updateFields.materials = item.materials;
          if (item.markup > 0) updateFields.markup = item.markup;
          updateFields.ffeUpdatedAt = new Date().toISOString();

          if (Object.keys(updateFields).length > 0) {
            await db.collection('boards').doc(projectId).collection('clips').doc(item.existingId).update(updateFields);
            updated++;
          } else { skipped++; }
        } else {
          // Create new clip
          clipData.savedAt = new Date().toISOString();
          await db.collection('boards').doc(projectId).collection('clips').add(clipData);
          created++;
        }

        // Sync to Product Library (products collection) — upsert by title+vendor
        try {
          // Use a deterministic doc ID based on title+vendor to avoid duplicates without needing a compound query
          var prodDocId = (item.title + '||' + (item.vendor || '')).toLowerCase().replace(/[^a-z0-9]/g, '_').substring(0, 120);

          var prodRef = db.collection('products').doc(prodDocId);
          var prodSnap = await prodRef.get();

          var prodData = {
            title: item.title,
            vendor: item.vendor || '',
            category: item.category || '',
            sku: item.sku || '',
            costPrice: item.unitCost || null,
            sellPrice: item.unitSell || null,
            dimensions: item.dimensions || '',
            finish: item.finish || '',
            materials: item.materials || '',
            description: item.description || '',
            vendorUrl: item.website || '',
            updatedAt: new Date().toISOString(),
            source: 'ffe-import',
            owner: currentUser.email
          };
          if (imageUrl) prodData.imageUrl = imageUrl;
          if (item.markup > 0) prodData.markupPct = item.markup;

          if (prodSnap.exists) {
            // Update existing product — only overwrite fields that have values
            var prodUpdate = { updatedAt: prodData.updatedAt, source: 'ffe-import' };
            if (imageUrl) prodUpdate.imageUrl = imageUrl;
            if (item.category) prodUpdate.category = item.category;
            if (item.unitCost > 0) prodUpdate.costPrice = item.unitCost;
            if (item.unitSell > 0) prodUpdate.sellPrice = item.unitSell;
            if (item.sku) prodUpdate.sku = item.sku;
            if (item.dimensions) prodUpdate.dimensions = item.dimensions;
            if (item.finish) prodUpdate.finish = item.finish;
            if (item.materials) prodUpdate.materials = item.materials;
            if (item.website) prodUpdate.vendorUrl = item.website;
            if (item.description) prodUpdate.description = item.description;
            await prodRef.update(prodUpdate);
          } else {
            // Create new product
            prodData.createdAt = new Date().toISOString();
            await prodRef.set(prodData);
          }
        } catch(e) { console.warn('[FFE] Product Library sync failed for', item.title, e); }

        // Update progress every 10 items
        if (i % 10 === 0 && progress) {
          progress.querySelector('div:first-child').innerHTML =
            '<div style="text-align:center;padding:16px;">' +
              '<div style="font-size:14px;font-weight:600;">Importing... ' + (i+1) + '/' + d.items.length + '</div>' +
