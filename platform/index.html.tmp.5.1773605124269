        try {
          var data = await file.arrayBuffer();
          var wb = XLSX.read(data, { type: 'array' });
          var ws = wb.Sheets[wb.SheetNames[0]];
          var rows = XLSX.utils.sheet_to_json(ws);

          // Build lookup: title -> { room, category } from global tracker
          var lookup = {};
          rows.forEach(function(row) {
            var title = (row['Title'] || row['Title (original)'] || '').trim();
            var room = (row['Room'] || '').trim();
            var category = (row['Category'] || '').trim();
            var project = (row['Project Name'] || '').trim();
            if (title && (room || category)) {
              var key = title.toLowerCase();
              // Store with project context for better matching
              if (!lookup[key]) lookup[key] = {};
              if (room) lookup[key].room = room;
              if (category) lookup[key].category = category;
              if (project) lookup[key].project = project;
            }
          });

          var totalLookup = Object.keys(lookup).length;
          prog.innerHTML = '<div style="padding:8px;font-size:12px;">Parsed ' + rows.length + ' rows → ' + totalLookup + ' unique product titles with category data</div>';

          // Show what categories exist
          var catCounts = {};
          Object.values(lookup).forEach(function(v) { if (v.category) catCounts[v.category] = (catCounts[v.category]||0) + 1; });
          prog.innerHTML += '<div style="padding:4px 8px;font-size:11px;color:var(--gray-400);">Categories: ' +
            Object.keys(catCounts).sort().map(function(c) { return c + ' (' + catCounts[c] + ')'; }).join(', ') + '</div>';

          // Load all clips from Firestore
          prog.innerHTML += '<div style="padding:4px 8px;font-size:12px;">Loading clips from Firestore...</div>';

          var projSnap = await db.collection('boards').get();
          var allClips = [];
          for (var pd of projSnap.docs) {
            try {
              var clipSnap = await db.collection('boards').doc(pd.id).collection('clips').get();
              clipSnap.forEach(function(d) {
                allClips.push({ id: d.id, projectId: pd.id, ...d.data() });
              });
            } catch(e) {}
          }

          prog.innerHTML += '<div style="padding:4px 8px;font-size:12px;">Found ' + allClips.length + ' clips in Firestore</div>';
          prog.innerHTML += '<div style="padding:4px 8px;font-size:12px;font-weight:600;">Matching and patching...</div>';

          var matched = 0, patched = 0, alreadyOk = 0;
          var patchLog = [];

          for (var clip of allClips) {
            var title = (clip.title || '').trim().toLowerCase();
            if (!title) continue;
            var match = lookup[title];
            if (!match) continue;
            matched++;

            var updates = {};
            var changes = [];

            // Patch category if it's currently a room name or missing
            var currentCat = clip.category || '';
            var isRoomName = ['Master Bedroom','Kitchen','Deck','Den','Master Bathroom','Bedroom 2','Entry',
              'Dining Room','Living Room','Powder Bath','Powder','Bedroom 3','Guest Bedroom','Guest Bath 2',
              'Outdoors','office','Bar','Master Closet','Master Bath','Laundry','Butler Pantry','Mudroom',
              'Exterior','Office','Suite 3','Suite 6','Suite 7','PR1','PR2','Lower Patio','Bathroom 2','Bath 5-6',
              'Fabrics','Fabric','Lighting','Mirrors & Accessories','Bedroom','Unassigned','General'].some(function(r) {
                return currentCat.toLowerCase() === r.toLowerCase();
              });

            if (match.category && (isRoomName || !currentCat || currentCat === match.room)) {
              updates.category = match.category;
              changes.push('category: ' + currentCat + ' → ' + match.category);
            }

            // Also ensure room is set correctly
            if (match.room && !clip.room) {
              updates.room = match.room;
              changes.push('room=' + match.room);
            }

            if (Object.keys(updates).length === 0) { alreadyOk++; continue; }

            try {
              await db.collection('boards').doc(clip.projectId).collection('clips').doc(clip.id).update(updates);
              patched++;
              patchLog.push({ title: clip.title.substring(0, 40), changes: changes.join(', '), status: 'ok' });
            } catch(err) {
              patchLog.push({ title: clip.title.substring(0, 40), changes: 'ERROR: ' + err.message, status: 'error' });
            }
          }

          prog.innerHTML += `
            <div style="margin-top:16px;padding:16px;background:var(--gray-50);border-radius:0;">
              <div style="font-size:18px;font-weight:700;color:var(--gold);margin-bottom:8px;">🏷️ Category Fix Complete</div>
              <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px;">
                <div style="text-align:center;"><div style="font-size:24px;font-weight:700;">${matched}</div><div style="font-size:10px;color:var(--gray-400);">Matched</div></div>
                <div style="text-align:center;"><div style="font-size:24px;font-weight:700;color:var(--green);">${patched}</div><div style="font-size:10px;color:var(--gray-400);">Fixed</div></div>
                <div style="text-align:center;"><div style="font-size:24px;font-weight:700;color:var(--gray-400);">${alreadyOk}</div><div style="font-size:10px;color:var(--gray-400);">Already OK</div></div>
              </div>
              <div style="font-size:12px;color:var(--gray-500);">
                Total clips: ${allClips.length} · Unmatched: ${allClips.length - matched}
              </div>
            </div>
            ${patchLog.length > 0 ? '<div style="margin-top:12px;max-height:200px;overflow-y:auto;font-size:11px;font-family:monospace;background:#1a1a1a;color:#fff;padding:12px;border-radius:0;">' +
              patchLog.slice(0, 100).map(function(l) {
                var color = l.status === 'error' ? '#ff6b6b' : '#4caf50';
                return '<div style="color:' + color + ';">' + esc(l.title) + ' → ' + l.changes + '</div>';
              }).join('') +
              (patchLog.length > 100 ? '<div style="color:var(--gold);">... and ' + (patchLog.length - 100) + ' more</div>' : '') +
            '</div>' : ''}
            <div style="text-align:right;margin-top:12px;">
              <button class="btn btn-primary" onclick="closeModal()">Done</button>
            </div>
          `;

        } catch(err) {
          prog.innerHTML = '<div style="color:var(--red);padding:20px;">Error: ' + esc(err.message) + '</div><div style="text-align:right;margin-top:12px;"><button class="btn btn-secondary" onclick="closeModal()">Close</button></div>';
        }
      };
      input.click();
    }

