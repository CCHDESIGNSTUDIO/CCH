    async function logBucket() {
      var sel = window._selectedCaptures;
      if (sel.size === 0) return;
      var project = document.getElementById('bucketProject').value;
      var actType = document.getElementById('bucketActivity').value;
      var hrs = parseFloat(document.getElementById('bucketHours').value) || 0;
      var mins = parseFloat(document.getElementById('bucketMins').value) || 0;
      var notes = document.getElementById('bucketNotes').value.trim();
      var totalHrs = hrs + mins / 60;
      // Round UP to nearest 15 minutes
      totalHrs = Math.ceil(totalHrs * 4) / 4;
      if (totalHrs < 0.25) totalHrs = 0.25;

      if (!project) { alert('Please select a project'); return; }
      if (!actType) { alert('Please select an activity type'); return; }
      if (totalHrs <= 0) { alert('Please enter time'); return; }

      var rate = ACTIVITY_TYPES[actType] ? ACTIVITY_TYPES[actType].rate : 75;
      var billable = rate > 0;
      var today = new Date().toISOString().slice(0, 10);

      // Gather source descriptions from selected captures
      var caps = window._pendingCaptures || [];
      var descriptions = [];
      sel.forEach(function(idx) {
        var s = caps[idx];
        if (s) descriptions.push(s.app + ': ' + (s.titles || s.category).substring(0, 60));
      });

      try {
        await db.collection('timeEntries').add({
          project: project,
          task: notes || descriptions.join('; '),
          activityType: actType,
          date: today,
          hours: Math.round(totalHrs * 100) / 100,
          rate: rate,
          total: Math.round(totalHrs * rate * 100) / 100,
          billable: billable,
          member: (currentUser && currentUser.displayName) || 'Cynthia',
          memberName: (currentUser && currentUser.displayName) || 'Cynthia',
          source: 'smart-time-bucket',
          sourceCaptures: descriptions.slice(0, 10),
          createdAt: new Date().toISOString()
        });

        // Fade out selected captures
        sel.forEach(function(idx) {
          var card = document.getElementById('capture-' + idx);
          if (card) { card.style.opacity = '0.3'; card.style.pointerEvents = 'none'; }
          if (window._pendingCaptures) window._pendingCaptures[idx] = null;
        });

        // Clear selection + refresh
        window._selectedCaptures = new Set();
        updateBucketBuilder();

        // Reload entries (build in local var, assign atomically to avoid race condition)
        var snap = await db.collection('timeEntries').orderBy('date', 'desc').get();
        var freshEntries = [];
        snap.forEach(function(d) { freshEntries.push({ id: d.id, ...d.data() }); });
        timeEntries = freshEntries;
        renderTimeView();
        // Re-render captures without full rescan
        var container = document.getElementById('capturesContainer');
        if (container) {
          var pendingLeft = (window._pendingCaptures || []).filter(Boolean);
          if (pendingLeft.length === 0) {
            container.innerHTML = '<div style="padding:20px;text-align:center;color:var(--gray-400);font-size:13px;">✅ All caught up — no pending captures.</div>';
          }
        }

      } catch(e) {
        alert('Error logging: ' + e.message);
      }
    }

