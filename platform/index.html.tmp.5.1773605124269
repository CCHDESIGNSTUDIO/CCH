    // Hamburger menu helpers
    function toggleActionMenu(btn) {
      var dropdown = btn.nextElementSibling;
      var wasOpen = dropdown.style.display === 'block';
      closeAllMenus();
      if (!wasOpen) dropdown.style.display = 'block';
    }
    function closeAllMenus() { document.querySelectorAll('.action-dropdown,.action-menu').forEach(function(d) { d.style.display = 'none'; }); }
    document.addEventListener('click', function(e) { if (!e.target.closest('.action-menu-wrap') && !e.target.closest('.action-menu') && !e.target.matches('[onclick*="nextElementSibling"]')) closeAllMenus(); });

    // Quick actions from hamburger menus
    async function deleteDoc(projectId, collection, docId) {
      if (!confirm('Delete this document? This cannot be undone.')) return;
      await db.collection('boards').doc(projectId).collection(collection).doc(docId).delete();
      _cacheTime = 0; invalidateSearchCache();
      navigate(window.location.hash);
    }
    async function markInvoicePaid(projectId, docId) {
      await db.collection('boards').doc(projectId).collection('invoices').doc(docId).update({ status: 'Paid', paidAt: new Date().toISOString() });
      logDocActivity(projectId, 'invoices', docId, 'paid', 'Marked as paid');
      _cacheTime = 0; invalidateSearchCache(); renderAllInvoices();
    }
    async function updatePOStatus(projectId, docId, status) {
      if (!status) return;
      await db.collection('boards').doc(projectId).collection('purchaseOrders').doc(docId).update({ status: status, updatedAt: new Date().toISOString() });
      logDocActivity(projectId, 'purchaseOrders', docId, 'status_changed', 'Status → ' + status);
      _cacheTime = 0; invalidateSearchCache();
      if (window.location.hash.includes('/project/')) { renderProjectDetail(); }
      else { renderAllPOs(); }
    }
    async function updatePOLocationPrompt(projectId, docId, statusType) {
      const label = statusType === 'At Receiver' ? 'receiver' : 'workroom';
      const name = prompt('Enter ' + label + ' name:');
      if (!name) return;
