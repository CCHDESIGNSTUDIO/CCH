              <div style="font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--gray-400);margin-bottom:8px;">Product Profit</div>
              <div style="font-size:24px;font-weight:700;color:${totalProfitAll >= 0 ? '#60A5FA' : 'var(--red)'};font-family:var(--font-mono);">${formatMoney(totalProfitAll)}</div>
            </div>
            <div style="padding:20px;background:linear-gradient(135deg,rgba(0,184,212,0.08),rgba(0,184,212,0.03));border:1px solid rgba(0,184,212,0.15);border-radius:0;text-align:center;">
              <div style="font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--gray-400);margin-bottom:8px;">Profit Margin</div>
              <div style="font-size:24px;font-weight:700;color:${profitMargin >= 30 ? 'var(--green)' : profitMargin >= 15 ? 'var(--cyan)' : 'var(--red)'};font-family:var(--font-mono);">${profitMargin.toFixed(1)}%</div>
            </div>
          </div>
        </div>
      `;

      return html;
    }
    // ==================== FINANCIALS TAB — Project Financial Intelligence ====================
    async function renderFinancialsTab(T, proj) {
      T.innerHTML = '<div style="text-align:center;padding:60px;color:var(--gray-400);">Loading financial data...</div>';

      // Admin check
      const _isAdmin = currentUser && ADMIN_EMAILS.includes((currentUser.email || '').toLowerCase());
      if (!_isAdmin) { T.innerHTML = '<div class="empty-state"><div class="empty-text">Financial data is admin-only.</div></div>'; return; }

      // Load all data in parallel
      let invoices = [], pos = [], timeEntries = [], clips = [];
      try {
        const [invSnap, poSnap, teSnap, te2Snap, clipSnap] = await Promise.all([
          db.collection('boards').doc(proj.id).collection('invoices').get(),
          db.collection('boards').doc(proj.id).collection('purchaseOrders').get(),
          db.collection('timeEntries').where('project', '==', (proj.name || proj.id)).limit(1000).get(),
          db.collection('timeEntries').where('projectId', '==', proj.id).limit(1000).get(),
          db.collection('boards').doc(proj.id).collection('clips').get()
        ]);
        invSnap.forEach(d => invoices.push({ id: d.id, ...d.data() }));
        poSnap.forEach(d => pos.push({ id: d.id, ...d.data() }));
        teSnap.forEach(d => timeEntries.push({ id: d.id, ...d.data() }));
        te2Snap.forEach(d => { if (!timeEntries.find(t => t.id === d.id)) timeEntries.push({ id: d.id, ...d.data() }); });
        clipSnap.forEach(d => clips.push({ id: d.id, ...d.data() }));
      } catch(e) { console.warn('Financial data load error:', e); }

      // Build clip-based POs
      var clipPoMap = {};
      clips.forEach(c => {
        if (c.poNum) {
          if (!clipPoMap[c.poNum]) {
            clipPoMap[c.poNum] = { id: 'clip-po-' + c.poNum, number: c.poNum, vendor: c.vendor || '', status: c.poStatus || 'Ordered', total: 0, items: [], _fromClips: true };
          }
          clipPoMap[c.poNum].total += (c.totalCost || c.cost || 0);
          clipPoMap[c.poNum].items.push(c);
        }
      });
      Object.values(clipPoMap).forEach(po => {
        if (!pos.find(ex => (ex.number || ex.num) === po.number)) pos.push(po);
      });

      // === CALCULATIONS ===
      var billingModel = proj.billingModel || (proj.contractFee || proj.flatFee || proj.budget ? 'flat_fee' : 'hourly');
      var contractFee = parseFloat(proj.contractFee || proj.flatFee || proj.budget) || 0;

      // Revenue
      var invoicedTotal = invoices.reduce(function(s, i) { return s + (parseFloat(i.total || i.amount) || 0); }, 0);
      var collectedTotal = invoices.filter(function(i) { return i.status === 'Paid'; }).reduce(function(s, i) { return s + (parseFloat(i.total || i.amount) || 0); }, 0);
      var payments = invoices.reduce(function(s, i) { return s + ((i.payments || []).reduce(function(s2, p) { return s2 + (parseFloat(p.amount) || 0); }, 0)); }, 0);
      if (payments > collectedTotal) collectedTotal = payments;
      var outstandingAR = invoicedTotal - collectedTotal;

      // Time
      var allTime = timeEntries;
      var totalHours = allTime.reduce(function(s, t) { return s + (parseFloat(t.hours) || 0); }, 0);
      var billableTime = allTime.filter(function(t) { return t.billable !== false; });
      var loggedValue = billableTime.reduce(function(s, t) {
        var rate = parseFloat(t.rate || t.hourlyRate || t.billableRate) || 150;
        return s + ((parseFloat(t.hours) || 0) * rate);
      }, 0);
      var leakage = loggedValue - invoicedTotal;

      // Owner time — uses TEAM_CONFIG
      var ownerTime = allTime.filter(function(t) { return _isOwnerMember(t.member || t.user || ''); });
      var ownerHours = ownerTime.reduce(function(s, t) { return s + (parseFloat(t.hours) || 0); }, 0);
      var ownerValue = ownerTime.filter(function(t) { return t.billable !== false; }).reduce(function(s, t) {
        return s + ((parseFloat(t.hours) || 0) * (parseFloat(t.rate || t.hourlyRate || t.billableRate) || TEAM_CONFIG.owner.rate));
      }, 0);

      // Contractor (non-owner) time — uses TEAM_CONFIG
      var contractorTime = allTime.filter(function(t) { return !_isOwnerMember(t.member || t.user || ''); });
      var contractorHours = contractorTime.reduce(function(s, t) { return s + (parseFloat(t.hours) || 0); }, 0);
      var contractorCost = contractorTime.reduce(function(s, t) {
        return s + ((parseFloat(t.hours) || 0) * (parseFloat(t.internalCostRate) || _getContractorRate(t.member || t.user || '')));
      }, 0);
      var contractorBilled = contractorTime.filter(function(t) { return t.billable !== false; }).reduce(function(s, t) {
        return s + ((parseFloat(t.hours) || 0) * (parseFloat(t.rate || t.hourlyRate || t.billableRate) || _getContractorRate(t.member || t.user || '')));
      }, 0);
      var contractorMargin = contractorBilled - contractorCost;

      // First contractor specifically (for detailed breakdown)
      var firstContractor = TEAM_CONFIG.contractors[0] || { names: [], rate: DEFAULT_CONTRACTOR_RATE, label: 'Contractor' };
      var vanessaTime = allTime.filter(function(t) { var m = (t.member || t.user || '').toLowerCase(); return firstContractor.names.some(function(n) { return m.indexOf(n) >= 0; }); });
      var vanessaHours = vanessaTime.reduce(function(s, t) { return s + (parseFloat(t.hours) || 0); }, 0);
      var vanessaCost = vanessaHours * firstContractor.rate;
      var vanessaBilled = vanessaTime.filter(function(t) { return t.billable !== false; }).reduce(function(s, t) {
        return s + ((parseFloat(t.hours) || 0) * (parseFloat(t.rate || t.hourlyRate || t.billableRate) || firstContractor.rate));
      }, 0);

      // PO costs
      var poCost = pos.reduce(function(s, po) {
        var t = parseFloat(po.total || po.amount) || 0;
        if (!t && po.items) t = po.items.reduce(function(s2, i) { return s2 + ((parseFloat(i.cost || i.totalCost || 0)) * (parseFloat(i.qty) || 1)); }, 0);
        return s + t;
      }, 0);
      var poPaid = pos.reduce(function(s, po) {
        var st = (po.status || '').toLowerCase();
        var paySt = (po.paymentStatus || '').toLowerCase();
        if (paySt === 'paid' || st === 'paid') return s + (parseFloat(po.total || po.amount) || 0);
        return s;
      }, 0);
      var poOutstanding = poCost - poPaid;

      // PO Expense Type Breakdown (for tax reporting)
      var poExpenseBreakdown = { product: 0, sales_tax: 0, shipping: 0, handling: 0, other_expense: 0 };
      pos.forEach(function(po) {
        if (po.items && po.items.length > 0) {
          po.items.forEach(function(item) {
            var et = item.expenseType || 'product';
            var qty = parseFloat(item.qty) || 1;
            var cost = parseFloat(item.cost || item.totalCost) || 0;
            var lt = cost * qty;
            if (poExpenseBreakdown.hasOwnProperty(et)) poExpenseBreakdown[et] += lt;
            else poExpenseBreakdown['product'] += lt;
          });
        } else {
          // PO without itemized expenses — count as product
          poExpenseBreakdown['product'] += parseFloat(po.total || po.amount) || 0;
        }
      });

      // Profit calculations
      var revenue = contractFee > 0 ? contractFee : invoicedTotal;
      var totalCost = poCost + contractorCost;
      var cashProfit = revenue - totalCost;
      var loadedProfit = cashProfit - ownerValue;
      var cashMargin = revenue > 0 ? (cashProfit / revenue * 100) : 0;

      // Flat fee burn
      var feeBurn = contractFee > 0 ? ownerValue + contractorCost : 0;
      var feeBurnPct = contractFee > 0 ? Math.round(feeBurn / contractFee * 100) : 0;
      var feeRemaining = contractFee > 0 ? contractFee - feeBurn : 0;

      // Realized rate
      var realizedRate = totalHours > 0 ? (invoicedTotal / totalHours) : 0;

      // Time by service/category
      var byService = {};
      allTime.forEach(function(t) {
        var svc = t.service || t.category || t.taskType || 'General Design';
        if (!byService[svc]) byService[svc] = { hours: 0, value: 0 };
        byService[svc].hours += parseFloat(t.hours) || 0;
        byService[svc].value += (parseFloat(t.hours) || 0) * (parseFloat(t.rate || t.hourlyRate || t.billableRate) || 150);
      });

      // Revenue timeline by month
      var monthlyRevenue = {};
      invoices.forEach(function(inv) {
        var d = inv.date || inv.createdAt || '';
        if (!d) return;
        var dt = new Date(d);
        var key = dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2, '0');
        if (!monthlyRevenue[key]) monthlyRevenue[key] = { invoiced: 0, collected: 0, logged: 0 };
        monthlyRevenue[key].invoiced += parseFloat(inv.total || inv.amount) || 0;
        if (inv.status === 'Paid') monthlyRevenue[key].collected += parseFloat(inv.total || inv.amount) || 0;
      });
      allTime.forEach(function(t) {
        var d = t.date || '';
        if (!d) return;
        var dt = new Date(d);
        var key = dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2, '0');
        if (!monthlyRevenue[key]) monthlyRevenue[key] = { invoiced: 0, collected: 0, logged: 0 };
        monthlyRevenue[key].logged += (parseFloat(t.hours) || 0) * (parseFloat(t.rate || t.hourlyRate || t.billableRate) || 150);
      });

      // Profit warnings
      var warnings = [];
      if (cashMargin < 10 && revenue > 0) warnings.push({ type: 'danger', text: 'Low Profitability: ' + cashMargin.toFixed(1) + '% margin' });
      if (feeBurnPct > 90 && contractFee > 0) warnings.push({ type: 'danger', text: 'Flat Fee Overrun Risk: ' + feeBurnPct + '% consumed' });
      if (feeBurnPct > 75 && feeBurnPct <= 90 && contractFee > 0) warnings.push({ type: 'warning', text: 'Fee Burn Alert: ' + feeBurnPct + '% of design fee consumed' });
      if (leakage > 5000) warnings.push({ type: 'warning', text: 'Revenue Leakage: ' + formatMoney(leakage) + ' logged but not invoiced' });
      if (outstandingAR > 10000) warnings.push({ type: 'info', text: 'Outstanding AR: ' + formatMoney(outstandingAR) + ' unpaid' });

      // Card helper
      function kpiCard(label, value, sub, color) {
        return '<div style="padding:16px 20px;background:rgba(30,30,40,0.5);border-radius:0;border:1px solid rgba(255,255,255,0.05);">' +
          '<div style="font-size:10px;text-transform:uppercase;letter-spacing:1.2px;color:var(--gray-400);margin-bottom:6px;">' + label + '</div>' +
          '<div style="font-size:22px;font-weight:700;color:' + (color || '#fff') + ';font-family:var(--font-mono);">' + value + '</div>' +
          (sub ? '<div style="font-size:11px;color:var(--gray-500);margin-top:4px;">' + sub + '</div>' : '') +
        '</div>';
      }

      // Build timeline chart bars
      var months = Object.keys(monthlyRevenue).sort();
      var maxVal = 1;
      months.forEach(function(m) { var v = Math.max(monthlyRevenue[m].invoiced, monthlyRevenue[m].logged, monthlyRevenue[m].collected); if (v > maxVal) maxVal = v; });

      var chartBars = months.map(function(m) {
        var d = monthlyRevenue[m];
        var logH = Math.round(d.logged / maxVal * 120);
        var invH = Math.round(d.invoiced / maxVal * 120);
        var colH = Math.round(d.collected / maxVal * 120);
        var label = new Date(m + '-01').toLocaleDateString('en-US', { month: 'short' });
        return '<div style="display:flex;flex-direction:column;align-items:center;gap:4px;min-width:50px;">' +
          '<div style="display:flex;align-items:flex-end;gap:3px;height:120px;">' +
            '<div style="width:14px;height:' + Math.max(2, logH) + 'px;background:var(--cyan);border-radius:3px 3px 0 0;opacity:0.6;" title="Logged: ' + formatMoney(d.logged) + '"></div>' +
            '<div style="width:14px;height:' + Math.max(2, invH) + 'px;background:var(--gold);border-radius:3px 3px 0 0;" title="Invoiced: ' + formatMoney(d.invoiced) + '"></div>' +
            '<div style="width:14px;height:' + Math.max(2, colH) + 'px;background:#5FA56B;border-radius:3px 3px 0 0;" title="Collected: ' + formatMoney(d.collected) + '"></div>' +
          '</div>' +
          '<div style="font-size:10px;color:var(--gray-500);">' + label + '</div>' +
        '</div>';
      }).join('');

      // Service breakdown bars
      var serviceEntries = Object.entries(byService).sort(function(a, b) { return b[1].value - a[1].value; });
      var maxSvcVal = serviceEntries.length > 0 ? serviceEntries[0][1].value : 1;
      var svcColors = ['var(--cyan)', 'var(--gold)', '#5FA56B', '#E16A5B', '#9B59B6', '#3498DB'];
      var svcBars = serviceEntries.slice(0, 8).map(function(entry, idx) {
        var name = entry[0], data = entry[1];
        var pct = Math.round(data.value / maxSvcVal * 100);
        var color = svcColors[idx % svcColors.length];
        return '<div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">' +
          '<div style="width:160px;font-size:12px;color:var(--gray-400);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' + esc(name) + '">' + esc(name) + '</div>' +
          '<div style="flex:1;height:20px;background:rgba(255,255,255,0.03);border-radius:4px;overflow:hidden;">' +
            '<div style="height:100%;width:' + pct + '%;background:' + color + ';border-radius:4px;opacity:0.7;"></div>' +
          '</div>' +
          '<div style="min-width:80px;text-align:right;font-size:12px;font-family:var(--font-mono);color:' + color + ';">' + formatMoney(data.value) + '</div>' +
          '<div style="min-width:50px;text-align:right;font-size:11px;color:var(--gray-500);">' + data.hours.toFixed(1) + 'h</div>' +
        '</div>';
      }).join('');

      T.innerHTML =
        '<div style="margin-bottom:20px;">' +
          '<h2 style="font-size:18px;font-weight:700;margin-bottom:4px;color:#fff;">Project Financial Overview</h2>' +
          '<div style="font-size:12px;color:var(--gray-400);">' + esc(proj.name || '') + (contractFee > 0 ? ' · Flat Fee ' + formatMoney(contractFee) : ' · Hourly') + '</div>' +
        '</div>' +

        // Warnings
        (warnings.length > 0 ?
          '<div style="margin-bottom:20px;display:flex;flex-direction:column;gap:8px;">' +
            warnings.map(function(w) {
              var bg = w.type === 'danger' ? 'rgba(225,106,91,0.12)' : w.type === 'warning' ? 'rgba(200,185,154,0.12)' : 'rgba(0,184,212,0.08)';
              var bc = w.type === 'danger' ? '#E16A5B' : w.type === 'warning' ? '#C8B99A' : 'var(--cyan)';
              var icon = w.type === 'danger' ? '🚨' : w.type === 'warning' ? '⚠️' : 'ℹ️';
              return '<div style="padding:10px 16px;background:' + bg + ';border-left:3px solid ' + bc + ';border-radius:0;font-size:13px;color:' + bc + ';font-weight:600;">' + icon + ' ' + w.text + '</div>';
            }).join('') +
          '</div>'
        : '') +

        // ROW 1: Revenue Snapshot
        '<div style="font-size:11px;text-transform:uppercase;letter-spacing:1.5px;color:var(--gray-400);font-weight:600;margin-bottom:10px;">Revenue Snapshot</div>' +
        '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px;">' +
          kpiCard('Design Fees Invoiced', formatMoney(invoicedTotal), invoices.length + ' invoices', '#5FA56B') +
          kpiCard('Fees Collected', formatMoney(collectedTotal), collectedTotal > 0 && invoicedTotal > 0 ? Math.round(collectedTotal/invoicedTotal*100) + '% collected' : '', '#5FA56B') +
          kpiCard('Outstanding AR', formatMoney(outstandingAR), outstandingAR > 0 ? invoices.filter(function(i){return i.status!=='Paid';}).length + ' unpaid invoices' : 'All paid!', outstandingAR > 0 ? '#E16A5B' : '#5FA56B') +
          kpiCard('Revenue Leakage', formatMoney(Math.max(0, leakage)), leakage > 0 ? 'Logged but not invoiced' : 'No leakage', leakage > 1000 ? '#E16A5B' : 'var(--gray-500)') +
        '</div>' +

        // ROW 2: Logged Design Value
        '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px;">' +
          kpiCard('Logged Design Value', formatMoney(loggedValue), totalHours.toFixed(1) + ' total hours', 'var(--cyan)') +
          kpiCard('Outsourced Labor Cost', formatMoney(contractorCost), contractorHours.toFixed(1) + ' contractor hours', '#E16A5B') +
          kpiCard('Purchases / PO Cost', formatMoney(poCost), pos.length + ' purchase orders', '#1abc9c') +
          kpiCard('Gross Project Revenue', formatMoney(invoicedTotal), '<span style="font-size:13px;font-weight:700;color:' + (cashProfit >= 0 ? '#5FA56B' : '#E16A5B') + ';">Profit: ' + formatMoney(cashProfit) + '</span>', 'var(--gold)') +
        '</div>' +

        // ROW 3: Flat Fee Burn Tracker (if applicable)
        (contractFee > 0 ?
          '<div style="font-size:11px;text-transform:uppercase;letter-spacing:1.5px;color:var(--gray-400);font-weight:600;margin-bottom:10px;">Flat Fee Burn Tracker</div>' +
          '<div style="background:rgba(30,30,40,0.5);border-radius:0;border:1px solid rgba(255,255,255,0.05);padding:20px;margin-bottom:24px;">' +
            '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:16px;">' +
              '<div><div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;letter-spacing:1px;">Design Fee Contract</div><div style="font-size:22px;font-weight:700;color:var(--gold);font-family:var(--font-mono);margin-top:4px;">' + formatMoney(contractFee) + '</div></div>' +
              '<div><div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;letter-spacing:1px;">Internal Time Used</div><div style="font-size:22px;font-weight:700;color:var(--cyan);font-family:var(--font-mono);margin-top:4px;">' + formatMoney(feeBurn) + '</div></div>' +
              '<div><div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;letter-spacing:1px;">Remaining Budget</div><div style="font-size:22px;font-weight:700;color:' + (feeRemaining > 0 ? '#5FA56B' : '#E16A5B') + ';font-family:var(--font-mono);margin-top:4px;">' + formatMoney(feeRemaining) + '</div></div>' +
            '</div>' +
            '<div style="height:8px;background:var(--gray-700);border-radius:4px;overflow:hidden;">' +
              '<div style="height:100%;width:' + Math.min(100, feeBurnPct) + '%;border-radius:4px;background:linear-gradient(90deg, ' + (feeBurnPct > 90 ? '#E16A5B, #c0392b' : feeBurnPct > 70 ? 'var(--gold), #E16A5B' : 'var(--cyan), var(--gold)') + ');transition:width 0.5s;"></div>' +
            '</div>' +
            '<div style="display:flex;justify-content:space-between;margin-top:6px;font-size:11px;color:var(--gray-500);">' +
              '<span>' + feeBurnPct + '% consumed</span>' +
              '<span>' + (100 - feeBurnPct) + '% remaining</span>' +
            '</div>' +
          '</div>'
        : '') +

        // ROW 4: Consultant Costs
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;">' +
          '<div>' +
            '<div style="font-size:11px;text-transform:uppercase;letter-spacing:1.5px;color:var(--gray-400);font-weight:600;margin-bottom:10px;">Consultant Costs</div>' +
            '<div style="background:rgba(30,30,40,0.5);border-radius:0;border:1px solid rgba(255,255,255,0.05);padding:20px;">' +
              '<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">' +
                '<div>' +
                  '<div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">Vanessa Hours</div>' +
                  '<div style="font-size:20px;font-weight:700;color:#fff;font-family:var(--font-mono);margin-top:4px;">' + vanessaHours.toFixed(1) + ' hrs</div>' +
                  '<div style="font-size:11px;color:var(--gray-500);">@ $75/hr</div>' +
                '</div>' +
                '<div>' +
                  '<div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">Vanessa Cost</div>' +
                  '<div style="font-size:20px;font-weight:700;color:#E16A5B;font-family:var(--font-mono);margin-top:4px;">' + formatMoney(vanessaCost) + '</div>' +
                '</div>' +
                '<div>' +
                  '<div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">Billed to Client</div>' +
                  '<div style="font-size:20px;font-weight:700;color:#5FA56B;font-family:var(--font-mono);margin-top:4px;">' + formatMoney(vanessaBilled) + '</div>' +
                '</div>' +
                '<div>' +
                  '<div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">Margin on Consultant</div>' +
                  '<div style="font-size:20px;font-weight:700;color:' + ((vanessaBilled - vanessaCost) >= 0 ? 'var(--gold)' : '#E16A5B') + ';font-family:var(--font-mono);margin-top:4px;">' + formatMoney(vanessaBilled - vanessaCost) + '</div>' +
                '</div>' +
              '</div>' +
            '</div>' +
          '</div>' +

        // ROW 5: Purchase Orders
          '<div>' +
            '<div style="font-size:11px;text-transform:uppercase;letter-spacing:1.5px;color:var(--gray-400);font-weight:600;margin-bottom:10px;">Purchase Orders & Expenses</div>' +
            '<div style="background:rgba(30,30,40,0.5);border-radius:0;border:1px solid rgba(255,255,255,0.05);padding:20px;">' +
              '<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">' +
                '<div>' +
                  '<div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">Total PO Cost</div>' +
                  '<div style="font-size:20px;font-weight:700;color:var(--cyan);font-family:var(--font-mono);margin-top:4px;">' + formatMoney(poCost) + '</div>' +
                  '<div style="font-size:11px;color:var(--gray-500);">' + pos.length + ' purchase orders</div>' +
                '</div>' +
                '<div>' +
                  '<div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">Paid to Vendors</div>' +
                  '<div style="font-size:20px;font-weight:700;color:#5FA56B;font-family:var(--font-mono);margin-top:4px;">' + formatMoney(poPaid) + '</div>' +
                '</div>' +
                '<div>' +
                  '<div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">Outstanding Vendor Bills</div>' +
                  '<div style="font-size:20px;font-weight:700;color:' + (poOutstanding > 0 ? '#C8B99A' : '#5FA56B') + ';font-family:var(--font-mono);margin-top:4px;">' + formatMoney(poOutstanding) + '</div>' +
                '</div>' +
                '<div>' +
                  '<div style="font-size:10px;color:var(--gray-400);text-transform:uppercase;">PO vs Revenue</div>' +
                  '<div style="font-size:20px;font-weight:700;color:var(--gray-300);font-family:var(--font-mono);margin-top:4px;">' + (invoicedTotal > 0 ? Math.round(poCost / invoicedTotal * 100) : 0) + '%</div>' +
                  '<div style="font-size:11px;color:var(--gray-500);">of revenue spent on products</div>' +
                '</div>' +
              '</div>' +
            '</div>' +
          '</div>' +
        '</div>' +

