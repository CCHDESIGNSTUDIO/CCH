      try {
        const teSnap = await db.collection('timeEntries').limit(2000).get();
        teSnap.forEach(d => allTimeEntries.push({ id: d.id, ...d.data() }));
      } catch(e) {}

      // Build per-project profit data
      const projectProfit = allProjects.map(p => {
        const pName = p.name || p.id;
        const billingModel = p.billingModel || (p.contractFee ? 'flat_fee' : 'hourly');
        const contractFee = parseFloat(p.contractFee || p.flatFee || p.budget) || 0;

        // Time entries for this project
        const pTime = allTimeEntries.filter(t => t.project === pName || t.projectId === p.id || t.project === p.id);
