                          <button class="btn btn-sm" style="padding:2px 6px;font-size:11px;" onclick="moveProposalItem('${projectId}','${proposalId}',${item._idx},1)" title="Move down"${item._idx === items.length - 1 ? ' disabled style="opacity:0.3;padding:2px 6px;font-size:11px;"' : ''}>▼</button>
                          <button class="btn btn-sm" style="padding:2px 6px;font-size:11px;" onclick="editProposalItem('${projectId}','${proposalId}',${item._idx})">✏️</button>
                          <button class="btn btn-sm" style="padding:2px 6px;font-size:11px;color:var(--red);" onclick="removeProposalItem('${projectId}','${proposalId}',${item._idx})">×</button>
                        </td>
                      </tr>`;
