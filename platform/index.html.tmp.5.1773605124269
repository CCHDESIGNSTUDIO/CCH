      setTopbarActions(`
        <button class="btn btn-secondary btn-sm" onclick="toggleDocTimeline('${projectId}','proposals','${proposalId}')">🕐 Timeline</button>
        <button class="btn btn-secondary btn-sm" onclick="previewDocument('proposal','${projectId}','${proposalId}')">👁️ Preview</button>
        <button class="btn btn-secondary btn-sm" onclick="editProposalMeta('${projectId}','${proposalId}')">✏️ Edit Details</button>
        <button class="btn btn-secondary btn-sm" onclick="addProposalLineItem('${projectId}','${proposalId}')">+ Add Item</button>
        <button class="btn btn-dark btn-sm" onclick="convertProposalToInvoice('${projectId}','${proposalId}')">🧾 Convert to Invoice</button>
        <button class="btn btn-dark btn-sm" onclick="generatePOsFromDoc('${projectId}','proposals','${proposalId}')">📦 Generate POs by Vendor</button>
        <button class="btn btn-primary btn-sm" onclick="printProposal('${projectId}','${proposalId}')">🖨️ Print / PDF</button>
        <button class="btn btn-sm" style="color:var(--red);border-color:var(--red);" onclick="deleteProposal('${projectId}','${proposalId}')">🗑️ Delete</button>
