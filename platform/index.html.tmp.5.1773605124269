      html += '<div style="display:flex;gap:10px;margin-top:16px;">' +
        '<button onclick="window._tlDeleteDupes()" style="flex:1;padding:10px;background:#E53935;color:white;border:none;border-radius:0;cursor:pointer;font-size:13px;font-weight:700;">🗑 Delete Unchecked Entries</button>' +
        '<button onclick="document.getElementById(\'tlDupeModal\').remove()" style="padding:10px 20px;background:#f5f5f5;color:var(--gold);border:1px solid #ddd;border-radius:0;cursor:pointer;font-size:13px;">Cancel</button>' +
