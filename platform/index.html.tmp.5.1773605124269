                  <td style="text-align:center;padding:12px;">${clips.length}</td>
                  <td style="text-align:right;padding:12px;font-family:var(--font-mono);color:var(--gray-400);">${totalBudget > 0 ? formatMoney(totalBudget) : '—'}</td>
                  <td style="text-align:right;padding:12px;font-family:var(--font-mono);">${formatMoney(totalRoomCost)}</td>
                  <td style="text-align:right;padding:12px;font-family:var(--font-mono);color:var(--green);">${formatMoney(totalRoomSell)}</td>
                  <td style="text-align:right;padding:12px;font-family:var(--font-mono);color:${totalRemaining >= 0 ? 'var(--green)' : 'var(--red)'};">${totalBudget > 0 ? formatMoney(totalRemaining) : '—'}</td>
                  <td style="text-align:right;padding:12px;font-family:var(--font-mono);color:var(--cyan);">${formatMoney(totalProfit)}</td>
                  <td></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      `;

      // ---- Report 2: Budget by Category ----
      const catData = {};
      clips.forEach(c => {
        const cat = c.category || 'Uncategorized';
        if (!catData[cat]) catData[cat] = { cost: 0, sell: 0, items: 0 };
        catData[cat].cost += (parseFloat(c.cost) || 0) * (parseFloat(c.qty) || 1);
        catData[cat].sell += parseFloat(c.totalSelling) || (parseFloat(c.clientPrice) || 0) * (parseFloat(c.qty) || 1);
        catData[cat].items++;
