                    ${TEAM_MEMBERS.map(m => `<option value="${escAttr(m)}" ${(t.member||currentMemberName()||TEAM_MEMBERS[0])===m?'selected':''}>${esc(m)}</option>`).join('')}
                  </select>` : `<input class="form-input" id="teMember" value="${escAttr(currentMemberName() || currentUser.email)}" readonly style="background:var(--gray-50);">`}
                </div>
                <div class="form-group">
                  <label class="form-label">Date</label>
                  <input type="date" class="form-input" id="teDate" value="${t.date || today}">
                </div>
                <div class="form-group">
                  <label class="form-label">Service Type</label>
                  <select class="form-input" id="teService" onchange="updateTimeRate()">
                    ${SERVICE_TYPES.map(s => `<option value="${escAttr(s.name)}" data-rate="${s.rate}" ${(t.service||'')===s.name?'selected':''}>${esc(s.name)} ($${s.rate}/hr)</option>`).join('')}
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label">Hours</label>
                  <input type="text" class="form-input" id="teHours" value="${t.hours || ''}" placeholder="e.g. 1.5 or 1:30" oninput="calcTimeTotal()">
                </div>
                <div class="form-group">
                  <label class="form-label">Rate ($/hr)</label>
                  <input type="number" class="form-input" id="teRate" value="${t.rate || SERVICE_TYPES[0].rate}" step="0.01" oninput="calcTimeTotal()" ${!isTimeAdmin()?'readonly style="background:var(--gray-50);"':''}>
                </div>
                <div class="form-group">
                  <label class="form-label">Total</label>
                  <input type="number" class="form-input" id="teTotal" value="${t.total || ''}" step="0.01" style="font-weight:700;font-size:16px;${!isTimeAdmin()?'background:var(--gray-50);':''}">
                </div>
                <div class="form-group" style="grid-column:span 2;">
                  <label class="form-label">Description</label>
                  <textarea class="form-input" id="teDesc" rows="2" placeholder="What was done...">${esc(t.description || '')}</textarea>
                </div>
                <div class="form-group">
                  <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                    <input type="checkbox" id="teBillable" ${t.billable !== false ? 'checked' : ''}>
                    <span class="form-label" style="margin:0;">Billable</span>
                  </label>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              ${t.id ? `<button class="btn" style="color:var(--red);margin-right:auto;" onclick="deleteTimeEntry('${t.id}')">Delete</button>` : ''}
              <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
              <button class="btn btn-primary" onclick="saveTimeEntry('${t.id || ''}')">${t.id ? 'Save Changes' : 'Save Entry'}</button>
            </div>
          </div>
        </div>
      `;
      updateTimeRate();
    }

    function updateTimeRate() {
      const sel = document.getElementById('teService');
      const opt = sel.options[sel.selectedIndex];
      const rate = opt ? opt.getAttribute('data-rate') : 0;
      document.getElementById('teRate').value = rate;
      calcTimeTotal();
    }

    function calcTimeTotal() {
      let hours = document.getElementById('teHours').value.trim();
      // Support both 1.5 and 1:30 formats
      if (hours.includes(':')) {
        const parts = hours.split(':');
        hours = parseInt(parts[0] || 0) + parseInt(parts[1] || 0) / 60;
      } else {
        hours = parseFloat(hours) || 0;
      }
      const rate = parseFloat(document.getElementById('teRate').value) || 0;
      document.getElementById('teTotal').value = (hours * rate).toFixed(2);
    }

    async function saveTimeEntry(existingId) {
      const project = document.getElementById('teProject').value.trim();
      if (!project) { alert('Project is required'); return; }

      let hours = document.getElementById('teHours').value.trim();
      if (hours.includes(':')) {
        const parts = hours.split(':');
        hours = (parseInt(parts[0] || 0) + parseInt(parts[1] || 0) / 60).toFixed(2);
      }

      const data = {
        project: project,
        member: document.getElementById('teMember').value,
        date: document.getElementById('teDate').value,
        service: document.getElementById('teService').value,
        hours: Math.ceil((parseFloat(hours) || 0) * 4) / 4 || 0.25,
        rate: parseFloat(document.getElementById('teRate').value) || 0,
        total: parseFloat(document.getElementById('teTotal').value) || 0,
        description: document.getElementById('teDesc').value.trim(),
        billable: document.getElementById('teBillable').checked,
        updatedAt: new Date().toISOString(),
        owner: currentUser.email
      };
      // Recalc total with rounded hours
      data.total = parseFloat((data.hours * data.rate).toFixed(2));

      try {
        if (existingId) {
          await db.collection('timeEntries').doc(existingId).update(data);
        } else {
          data.createdAt = new Date().toISOString();
          await db.collection('timeEntries').add(data);
        }
        closeModal();
        renderTimeTracker();
      } catch(e) { alert('Error: ' + e.message); }
    }

    function editTimeEntry(id) {
      const t = timeEntries.find(x => x.id === id);
      if (t) showNewTimeEntryModal(t);
    }

    async function deleteTimeEntry(id) {
      if (!confirm('Delete this time entry?')) return;
      try {
        await db.collection('timeEntries').doc(id).delete();
        closeModal();
        renderTimeTracker();
      } catch(e) { alert('Error: ' + e.message); }
    }

    async function bulkDeleteSelectedTime() {
      var checked = document.querySelectorAll('.time-cb:checked');
      var ids = [];
      checked.forEach(function(cb) { if (cb.dataset.id) ids.push(cb.dataset.id); });
      if (ids.length === 0) { alert('Select entries using the checkboxes first.'); return; }
      if (!confirm('Delete ' + ids.length + ' selected time entries? This cannot be undone.')) return;
      try {
        var batch = db.batch();
        ids.forEach(function(id) { batch.delete(db.collection('timeEntries').doc(id)); });
        await batch.commit();
        renderTimeTracker();
      } catch(e) {
        // Firestore batch limit is 500, fall back to sequential
        for (var i = 0; i < ids.length; i++) {
          try { await db.collection('timeEntries').doc(ids[i]).delete(); } catch(e2) {}
        }
        renderTimeTracker();
      }
    }

    // ==================== CONSOLIDATE SMALL ENTRIES ====================
