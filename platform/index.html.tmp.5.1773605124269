    async function previewInvoice(projectId, invId) {
      // Load invoice data
      let invData = null, items = [];
      try {
        const doc = await db.collection('boards').doc(projectId).collection('invoices').doc(invId).get();
        if (doc.exists) { invData = doc.data(); items = invData.items || []; }
      } catch(e) {}

      // If clip-based, build from clips
      if (!invData && invId.startsWith('clip-inv-')) {
        const invNum = invId.replace('clip-inv-', '');
        try {
          const clipSnap = await db.collection('boards').doc(projectId).collection('clips').get();
          items = []; let total = 0, vendor = '';
          clipSnap.forEach(d => {
            const c = d.data();
            if (c.invoiceNum === invNum || c.houzzInvoice === invNum) {
              items.push({ title: c.title || '', vendor: c.vendor || '', category: c.category || '', room: c.room || '',
                qty: c.qty || 1, cost: c.cost || 0, amount: c.totalSelling || c.clientPrice || 0, imageUrl: c.imageUrl || '' });
              total += (c.totalSelling || c.clientPrice || 0);
              if (c.vendor) vendor = c.vendor;
            }
          });
          invData = { invoiceNum: invNum, number: invNum, vendor, total, items, status: 'Invoiced' };
        } catch(e) {}
      }

      if (!invData) { alert('Invoice not found'); return; }

      // Load project for client info
      let proj = {};
      try { const pd = await db.collection('boards').doc(projectId).get(); if (pd.exists) proj = pd.data(); } catch(e) {}

      // Build client info from multiple sources: invoice > project > derive from project name
