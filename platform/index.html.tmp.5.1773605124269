    // ── Timeline: Init drag-drop on memory cards ──
    function _tlInitDragDrop() {
      document.querySelectorAll('.tl-memory-card').forEach(function(card) {
        card.addEventListener('dragstart', function(e) {
          // Check if multi-select: include all selected cards' indices
          var allIndices = [];
          var allMinutes = 0;
          var allApps = [];
          var selectedMems = window._tlSelectedMems || new Set();
          var memIdx = parseInt(card.dataset.memIdx);
          if (selectedMems.size > 0 && (selectedMems.has(memIdx) || selectedMems.size > 1)) {
            // Drag all selected + this card
            if (!selectedMems.has(memIdx)) selectedMems.add(memIdx);
            document.querySelectorAll('.tl-memory-card').forEach(function(c) {
              var cIdx = parseInt(c.dataset.memIdx);
              if (selectedMems.has(cIdx)) {
                var cIndices = JSON.parse(c.dataset.indices || '[]');
                cIndices.forEach(function(i) { if (allIndices.indexOf(i) < 0) allIndices.push(i); });
