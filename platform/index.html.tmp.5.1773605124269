    async function uploadProposalImage(projectId, proposalId, idx, inputEl) {
      const file = inputEl.files[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) { alert('Please select an image file'); return; }
      if (file.size > 5 * 1024 * 1024) { alert('Image must be under 5MB'); return; }
      try {
        const path = 'proposals/' + projectId + '/' + Date.now() + '_' + file.name.replace(/[^a-zA-Z0-9._-]/g, '');
        const ref = firebase.storage().ref(path);
        const snap = await ref.put(file);
        const url = await snap.ref.getDownloadURL();

        const doc = await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).get();
        const items = doc.data().items || [];
        if (items[idx]) {
          items[idx].imageUrl = url;
          await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).update({ items });
          // Update the preview image
          const imgPreview = document.getElementById('piImagePreview');
          if (imgPreview) imgPreview.innerHTML = '<img src="' + escAttr(url) + '" style="width:80px;height:80px;object-fit:cover;border-radius:0;">';
          const imgInput = document.getElementById('piImage');
          if (imgInput) imgInput.value = url;
        }
        showToast('Image uploaded');
      } catch(e) { alert('Upload failed: ' + e.message); }
    }

