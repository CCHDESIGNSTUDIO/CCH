      let totalBudget = 0, totalRoomCost = 0, totalRoomSell = 0;
      Object.keys(roomData).sort().forEach(rm => {
        const d = roomData[rm];
        const budget = roomBudgets[rm] || 0;
        const remaining = budget > 0 ? budget - d.sell : 0;
        const overBudget = budget > 0 && d.sell > budget;
        const pct = budget > 0 ? Math.min(Math.round(d.sell / budget * 100), 100) : 0;
        const profit = d.sell - d.cost;
        totalBudget += budget;
        totalRoomCost += d.cost;
        totalRoomSell += d.sell;

        const barColor = overBudget ? 'var(--red)' : pct > 80 ? '#C8B99A' : 'var(--green)';

        html += `
          <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
