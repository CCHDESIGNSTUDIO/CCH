            if (acMatch && acMatch[1].length > 2 && acMatch[1].length < 80) return acMatch[1].trim();
            return normalizedApp;
          }

          return normalizedApp;
        }

        // console.log('[Scan] Starting scan for dates:', scanDates.join(', '));

        for (var d = 0; d < scanDates.length; d++) {
          var scanDate = scanDates[d];
          var startOfDay = scanDate + 'T00:00:00';
