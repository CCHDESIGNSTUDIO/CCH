    async function generateProposalFromLibrary(projectId) {
      // Load product library
      let products = [];
      try {
        const snap = await db.collection('products').limit(500).get();
        snap.forEach(d => products.push({ id: d.id, ...d.data() }));
      } catch(e) {}
      if (products.length === 0) { alert('No products in the library yet.'); return; }

      // Show selection modal
      products.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
      window._libProposalProducts = products;
      window._libProposalSelected = new Set();
      window._libProposalProjectId = projectId;

      document.getElementById('modalContainer').innerHTML = `
        <div class="modal-overlay" onclick="if(event.target===this)closeModal()">
          <div class="modal" style="width:700px;max-height:80vh;">
            <div class="modal-header">
              <div class="modal-title">Select Products for Proposal</div>
              <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body" style="padding:16px;">
              <input class="form-input" id="libPropSearch" placeholder="Search products..." oninput="filterLibProposalProducts()" style="margin-bottom:12px;">
              <div id="libPropList" style="max-height:400px;overflow-y:auto;display:flex;flex-direction:column;gap:4px;"></div>
            </div>
            <div class="modal-footer">
              <div style="flex:1;font-size:12px;color:var(--gray-400);" id="libPropCount">0 selected</div>
              <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
              <button class="btn btn-primary" onclick="createProposalFromSelectedLibrary()">Create Proposal</button>
            </div>
          </div>
        </div>
      `;
      filterLibProposalProducts();
    }

    function filterLibProposalProducts() {
      var q = (document.getElementById('libPropSearch') || {}).value || '';
      q = q.toLowerCase().trim();
      var products = window._libProposalProducts || [];
      var filtered = q ? products.filter(function(p) {
        return ((p.title || '') + ' ' + (p.vendor || '') + ' ' + (p.category || '')).toLowerCase().indexOf(q) >= 0;
      }) : products;

      var list = document.getElementById('libPropList');
      if (!list) return;
      var sel = window._libProposalSelected || new Set();

      list.innerHTML = filtered.slice(0, 100).map(function(p) {
        var checked = sel.has(p.id) ? 'checked' : '';
        var price = p.sellPrice ? formatMoney(parseFloat(p.sellPrice) || 0) : (p.costPrice ? formatMoney(parseFloat(p.costPrice) || 0) : '—');
        var img = p.imageUrl || (p.images && p.images[0]) || '';
        return '<label style="display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:0;cursor:pointer;border:1px solid ' + (sel.has(p.id) ? 'rgba(0,184,212,0.3)' : 'rgba(255,255,255,0.06)') + ';background:' + (sel.has(p.id) ? 'rgba(0,184,212,0.06)' : 'transparent') + ';" onmouseover="this.style.background=\'rgba(255,255,255,0.04)\'" onmouseout="this.style.background=\'' + (sel.has(p.id) ? 'rgba(0,184,212,0.06)' : 'transparent') + '\'">' +
          '<input type="checkbox" ' + checked + ' onchange="toggleLibProposalProduct(\'' + p.id + '\',this.checked)" style="accent-color:var(--cyan);width:16px;height:16px;">' +
          (img ? '<img src="' + escAttr(img) + '" style="width:36px;height:36px;border-radius:4px;object-fit:cover;" onerror="this.style.display=\'none\'">' : '<div style="width:36px;height:36px;border-radius:4px;background:rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:center;font-size:14px;">📦</div>') +
          '<div style="flex:1;min-width:0;">' +
            '<div style="font-size:12px;font-weight:600;color:var(--white);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(p.title || 'Untitled') + '</div>' +
            '<div style="font-size:10px;color:var(--gray-500);">' + esc(p.vendor || '') + (p.category ? ' · ' + esc(p.category) : '') + '</div>' +
          '</div>' +
          '<div style="font-size:12px;font-weight:700;font-family:var(--font-mono);color:var(--cyan);">' + price + '</div>' +
        '</label>';
      }).join('');
    }

    function toggleLibProposalProduct(id, checked) {
      var sel = window._libProposalSelected || new Set();
      if (checked) sel.add(id); else sel.delete(id);
      window._libProposalSelected = sel;
      var ct = document.getElementById('libPropCount');
      if (ct) ct.textContent = sel.size + ' selected';
      filterLibProposalProducts();
    }

    async function createProposalFromSelectedLibrary() {
      var sel = window._libProposalSelected || new Set();
      if (sel.size === 0) { alert('Select at least one product.'); return; }
      var projectId = window._libProposalProjectId;
      var products = window._libProposalProducts || [];
