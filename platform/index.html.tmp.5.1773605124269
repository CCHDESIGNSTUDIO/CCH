              <thead>
                <tr style="background:var(--gray-50);">
                  <th style="padding:10px 12px;text-align:left;">Category</th>
                  <th style="padding:10px 8px;text-align:center;">Items</th>
                  <th style="padding:10px 8px;text-align:right;">Budget</th>
                  <th style="padding:10px 8px;text-align:right;">Cost</th>
                  <th style="padding:10px 8px;text-align:right;">Sell Price</th>
                  <th style="padding:10px 8px;text-align:right;">Profit</th>
                  <th style="padding:10px 8px;text-align:right;">Margin</th>
                  <th style="padding:10px 12px;min-width:160px;">Usage</th>
                </tr>
              </thead>
              <tbody>
      `;

      Object.keys(catData).sort().forEach(cat => {
        const d = catData[cat];
        const budget = categoryBudgets[cat] || 0;
        const profit = d.sell - d.cost;
        const margin = d.sell > 0 ? (profit / d.sell * 100) : 0;
        const pct = budget > 0 ? Math.min(Math.round(d.sell / budget * 100), 100) : 0;
        const overBudget = budget > 0 && d.sell > budget;
        const barColor = overBudget ? 'var(--red)' : pct > 80 ? '#C8B99A' : 'var(--cyan)';

        html += `
          <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
            <td style="padding:10px 12px;font-weight:500;">${esc(cat)}</td>
            <td style="padding:10px 8px;text-align:center;">${d.items}</td>
            <td style="padding:10px 8px;text-align:right;font-family:var(--font-mono);color:var(--gray-400);">${budget > 0 ? formatMoney(budget) : '—'}</td>
            <td style="padding:10px 8px;text-align:right;font-family:var(--font-mono);">${formatMoney(d.cost)}</td>
            <td style="padding:10px 8px;text-align:right;font-family:var(--font-mono);color:var(--green);font-weight:600;">${formatMoney(d.sell)}</td>
            <td style="padding:10px 8px;text-align:right;font-family:var(--font-mono);color:${profit >= 0 ? 'var(--cyan)' : 'var(--red)'};">${formatMoney(profit)}</td>
            <td style="padding:10px 8px;text-align:right;font-size:11px;color:${margin >= 30 ? 'var(--green)' : margin >= 15 ? 'var(--gold)' : 'var(--red)'};">${margin.toFixed(1)}%</td>
            <td style="padding:10px 12px;">
              ${budget > 0 ? `
                <div style="display:flex;align-items:center;gap:8px;">
                  <div style="flex:1;height:8px;background:rgba(255,255,255,0.06);border-radius:4px;overflow:hidden;">
