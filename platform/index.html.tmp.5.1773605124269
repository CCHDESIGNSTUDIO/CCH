    // ---- CUSTOMER PROFITABILITY ----
    function buildProfitabilityReport(wb, invoices, pos, clips, timeEntries, projectMap) {
      var projects = {};

      // Aggregate invoices (revenue)
      invoices.forEach(function(i) {
        var pn = i.projectName || i.project || 'Unknown';
        if (!projects[pn]) projects[pn] = { revenue: 0, cost: 0, productCost: 0, productSell: 0, invoiceCount: 0, poCount: 0, clipCount: 0, hours: 0, billableHours: 0, timeValue: 0, payments: 0, clientName: '', status: '' };
        projects[pn].revenue += parseFloat(i.total) || 0;
        projects[pn].invoiceCount++;
        var paid = (i.payments || []).reduce(function(s,p) { return s + (parseFloat(p.amount)||0); }, 0) || parseFloat(i.amountPaid||i.paidAmount||i.totalPaid||0) || (i.status === 'Paid' ? (parseFloat(i.total)||0) : 0);
        projects[pn].payments += paid;
        if (i.clientName || i.client) projects[pn].clientName = i.clientName || i.client;
        if (i.status) projects[pn].status = i.status;
        // Sum item-level costs if available
        (i.items || []).forEach(function(item) {
          var cost = (parseFloat(item.cost) || 0) * (parseFloat(item.qty) || 1);
          projects[pn].productCost += cost;
        });
      });

      // Aggregate POs (cost)
      pos.forEach(function(p) {
        var pn = p.projectName || p.project || 'Unknown';
        if (!projects[pn]) projects[pn] = { revenue: 0, cost: 0, productCost: 0, productSell: 0, invoiceCount: 0, poCount: 0, clipCount: 0, hours: 0, billableHours: 0, timeValue: 0, payments: 0, clientName: '', status: '' };
        projects[pn].cost += parseFloat(p.total) || 0;
        projects[pn].poCount++;
      });

      // Aggregate clips (product cost/sell)
      clips.forEach(function(c) {
        var pn = c.projectName || c.project || 'Unknown';
        if (!projects[pn]) projects[pn] = { revenue: 0, cost: 0, productCost: 0, productSell: 0, invoiceCount: 0, poCount: 0, clipCount: 0, hours: 0, billableHours: 0, timeValue: 0, payments: 0, clientName: '', status: '' };
        var qty = parseFloat(c.qty) || 1;
        projects[pn].productCost += (parseFloat(c.cost) || 0) * qty;
        projects[pn].productSell += parseFloat(c.totalSelling) || (parseFloat(c.clientPrice) || 0) * qty;
        projects[pn].clipCount++;
      });

      // Aggregate time
      timeEntries.forEach(function(t) {
        var pn = t.project || 'Unknown';
        if (!projects[pn]) projects[pn] = { revenue: 0, cost: 0, productCost: 0, productSell: 0, invoiceCount: 0, poCount: 0, clipCount: 0, hours: 0, billableHours: 0, timeValue: 0, payments: 0, clientName: '', status: '' };
        var hrs = parseFloat(t.hours) || 0;
        projects[pn].hours += hrs;
        if (t.billable) {
          projects[pn].billableHours += hrs;
          projects[pn].timeValue += parseFloat(t.total) || 0;
        }
      });

      // Build rows
      var rows = [];
      Object.keys(projects).sort().forEach(function(pn) {
        var p = projects[pn];
        var totalCost = p.cost !== undefined && p.cost !== null ? p.cost : p.productCost;
        var grossProfit = p.revenue - totalCost;
        var margin = p.revenue > 0 ? (grossProfit / p.revenue * 100) : 0;
        var productMargin = p.productSell > 0 && p.productCost > 0 ? ((p.productSell - p.productCost) / p.productCost * 100) : 0;
        var effectiveRate = p.billableHours > 0 ? (p.revenue / p.billableHours) : 0;
        rows.push({
          'Project': pn,
          'Client': p.clientName,
          'Revenue (Invoiced)': Math.round(p.revenue * 100) / 100,
          'Payments Received': Math.round(p.payments * 100) / 100,
          'Outstanding': Math.round((p.revenue - p.payments) * 100) / 100,
          'PO Cost': Math.round(p.cost * 100) / 100,
          'Product Cost': Math.round(p.productCost * 100) / 100,
          'Product Sell': Math.round(p.productSell * 100) / 100,
          'Product Markup %': Math.round(productMargin),
          'Gross Profit': Math.round(grossProfit * 100) / 100,
          'Margin %': Math.round(margin),
          'Total Hours': Math.round(p.hours * 10) / 10,
          'Billable Hours': Math.round(p.billableHours * 10) / 10,
          'Time Value': Math.round(p.timeValue * 100) / 100,
          'Effective $/hr': Math.round(effectiveRate),
          'Invoices': p.invoiceCount,
          'POs': p.poCount,
          'Products': p.clipCount
        });
      });
      rows.sort(function(a,b) { return b['Revenue (Invoiced)'] - a['Revenue (Invoiced)']; });

      // Totals row
      var totals = { 'Project': '=== TOTALS ===' };
      ['Revenue (Invoiced)','Payments Received','Outstanding','PO Cost','Product Cost','Product Sell','Gross Profit','Total Hours','Billable Hours','Time Value'].forEach(function(col) {
        totals[col] = rows.reduce(function(s,r) { return s + (r[col]||0); }, 0);
      });
      totals['Margin %'] = totals['Revenue (Invoiced)'] > 0 ? Math.round((totals['Gross Profit'] / totals['Revenue (Invoiced)']) * 100) : 0;
      totals['Effective $/hr'] = totals['Billable Hours'] > 0 ? Math.round(totals['Revenue (Invoiced)'] / totals['Billable Hours']) : 0;
      totals['Invoices'] = rows.reduce(function(s,r) { return s + (r['Invoices']||0); }, 0);
      totals['POs'] = rows.reduce(function(s,r) { return s + (r['POs']||0); }, 0);
      totals['Products'] = rows.reduce(function(s,r) { return s + (r['Products']||0); }, 0);
      rows.push(totals);

      var ws = XLSX.utils.json_to_sheet(rows);
      ws['!cols'] = [{wch:28},{wch:18},{wch:16},{wch:16},{wch:14},{wch:12},{wch:14},{wch:14},{wch:14},{wch:14},{wch:10},{wch:10},{wch:12},{wch:12},{wch:12},{wch:8},{wch:6},{wch:8}];
      XLSX.utils.book_append_sheet(wb, ws, 'Profitability');
    }

    // ---- VENDOR SPEND ----
    function buildVendorSpendReport(wb, invoices, pos, clips) {
