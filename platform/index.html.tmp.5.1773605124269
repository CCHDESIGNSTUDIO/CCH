    async function convertProposalTo(type, projectId, proposalId) {
      const doc = await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).get();
      const prop = doc.data();
      const items = prop.items || [];

      var _cUser = (currentUser && currentUser.displayName) || (currentUser && currentUser.email) || 'Unknown';
      if (type === 'invoice') {
        const invItems = items.map(i => ({ description: i.title + (i.vendor ? ' (' + i.vendor + ')' : ''), qty: 1, amount: i.amount || 0, lineTotal: i.amount || 0 }));
        const total = invItems.reduce((s, i) => s + i.lineTotal, 0);
        var _invNum = await getNextDocNumber('INV');
        var invRef = await db.collection('boards').doc(projectId).collection('invoices').add({
          number: _invNum, invoiceNum: _invNum,
          items: invItems, total,
          status: 'Draft',
          fromProposal: proposalId,
          notes: 'Generated from proposal: ' + (prop.name || ''),
          createdAt: new Date().toISOString(),
          createdBy: _cUser,
          createdByEmail: (currentUser && currentUser.email) || '',
          activityLog: [{ action: 'created_from_proposal', details: 'From: ' + (prop.name || 'Proposal'), userName: _cUser, userEmail: (currentUser && currentUser.email) || '', timestamp: new Date().toISOString() }]
        });
        logDocActivity(projectId, 'proposals', proposalId, 'converted', 'Converted to Invoice');
        alert('Invoice created from proposal!');
        navigate('#/project/' + projectId + '/invoices');
      } else if (type === 'po') {
        // Group by vendor
        const byVendor = {};
        items.forEach(i => {
          const v = i.vendor || 'No Vendor';
          if (!byVendor[v]) byVendor[v] = [];
          byVendor[v].push(i);
        });
        for (const [vendor, vItems] of Object.entries(byVendor)) {
          const poItems = vItems.map(i => ({ description: i.title, qty: 1, cost: i.amount || 0, lineTotal: i.amount || 0 }));
          const total = poItems.reduce((s, i) => s + i.lineTotal, 0);
          var _poNum = await getNextDocNumber('PO');
          await db.collection('boards').doc(projectId).collection('purchaseOrders').add({
            number: _poNum,
            vendor: vendor,
            items: poItems, total,
            status: 'Draft',
            fromProposal: proposalId,
            createdAt: new Date().toISOString(),
            createdBy: _cUser,
            createdByEmail: (currentUser && currentUser.email) || '',
            activityLog: [{ action: 'po_generated', details: 'From proposal, vendor: ' + vendor, userName: _cUser, userEmail: (currentUser && currentUser.email) || '', timestamp: new Date().toISOString() }]
          });
        }
        alert(Object.keys(byVendor).length + ' PO(s) created, grouped by vendor!');
        navigate('#/project/' + projectId + '/pos');
      }
    }

