    // ── Timeline: Log bucket as time entry ──
    window._tlLogBucket = function(bi) {
      var buckets = window._projectBuckets || [];
      var bucket = buckets[bi];
      if (!bucket) return;
      if (bucket.logged) {
        showToast('⚠️ Already logged! Use "Clear Logged" to remove, or drag more items to create a new bucket.');
        return;
      }
      var caps = window._pendingCaptures || [];
      var totalMins = bucket.items.reduce(function(s, idx) { return s + (caps[idx] ? caps[idx].minutes : 0); }, 0);
      var roundedMins = Math.ceil(totalMins / 15) * 15;
      if (roundedMins <= 0) { alert('No time to log.'); return; }
      var hrs = roundedMins / 60;
      var rate = (currentUser && currentUser.email === 'cindy@cchdesign.com') ? 150 : 75;

      // ── Duplicate check ──
      var existingDupes = timeEntries.filter(function(t) {
        return t.date === _tlDay &&
          t.project === (bucket.project || 'Unassigned') &&
          t.service === 'Smart Time' &&
          t.member === (currentMemberName() || '');
      });
      if (existingDupes.length > 0) {
        var existingHrs = existingDupes.reduce(function(s,t) { return s + (parseFloat(t.hours)||0); }, 0);
        if (!confirm('⚠️ You already have ' + existingDupes.length + ' Smart Time entr' + (existingDupes.length===1?'y':'ies') + 
          ' for "' + bucket.project + '" today (' + existingHrs.toFixed(1) + 'h).\n\n' +
          'Log another ' + hrs.toFixed(1) + 'h? Or Cancel to review existing entries first.')) {
          return;
        }
      }

      var apps = [];
      bucket.items.forEach(function(idx) {
        if (caps[idx] && caps[idx].app && apps.indexOf(caps[idx].app) < 0) apps.push(caps[idx].app);
      });
      var description = apps.join(', ');
      if (bucket.comment) description += (description ? ' — ' : '') + bucket.comment;

      var entry = {
        date: _tlDay,
        project: bucket.project || 'Unassigned',
        service: 'Smart Time',
        description: description,
        member: currentMemberName() || (currentUser ? currentUser.email : ''),
        hours: hrs,
        rate: rate,
        total: hrs * rate,
        billable: true,
        status: 'draft',
        team: currentUser ? currentUser.email : '',
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      };

      db.collection('timeEntries').add(entry).then(function(docRef) {
        entry.id = docRef.id;
        timeEntries.push(entry);
        // Mark bucket as logged (keep it in place)
        bucket.logged = true;
        bucket.loggedHrs = hrs;
        bucket.loggedTotal = hrs * rate;
        bucket.entryId = docRef.id;
        bucket.loggedId = docRef.id;
        _tlSaveBuckets();
        // Re-render buckets (preserving all)
        var bl = document.getElementById('tlBucketsList');
        if (bl) bl.innerHTML = _tlRenderBucketsPanel();
        _tlInitDragDrop();
        showToast('✓ Logged ' + hrs.toFixed(1) + 'h to ' + (bucket.project || 'Unassigned'));
      }).catch(function(err) {
        alert('Error logging: ' + err.message);
      });
    };

