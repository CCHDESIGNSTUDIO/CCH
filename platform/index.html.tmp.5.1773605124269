          sku: p.sku || '',
          imageUrl: p.imageUrl || (p.images && p.images[0]) || null,
          source: 'product-library',
          libraryProductId: p.id
        };
      });

      var total = items.reduce(function(s, i) { return s + i.amount; }, 0);
      var _cUser = (currentUser && currentUser.displayName) || (currentUser && currentUser.email) || 'Unknown';
