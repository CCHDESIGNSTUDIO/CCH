    // ── Execute duplicate deletion ──
    window._tlDeleteDupes = async function() {
      var modal = document.getElementById('tlDupeModal');
      if (!modal) return;
      var keepIds = new Set();
      modal.querySelectorAll('input[name="tlDupeKeep"]:checked').forEach(function(cb) {
        keepIds.add(cb.value);
      });
      var allDupeIds = [];
      (window._tlDupeEntries || []).forEach(function(group) {
        group.entries.forEach(function(t) { allDupeIds.push(t.id); });
      });
      var toDelete = allDupeIds.filter(function(id) { return !keepIds.has(id); });

      if (toDelete.length === 0) {
        showToast('Nothing to delete — all entries are marked to keep.');
        modal.remove();
        return;
      }

      if (!confirm('Delete ' + toDelete.length + ' duplicate entr' + (toDelete.length === 1 ? 'y' : 'ies') + '? This cannot be undone.')) return;

      var deleted = 0;
      for (var i = 0; i < toDelete.length; i++) {
        try {
          await db.collection('timeEntries').doc(toDelete[i]).delete();
          // Remove from local array
          timeEntries = timeEntries.filter(function(t) { return t.id !== toDelete[i]; });
          deleted++;
        } catch(e) {
          console.error('Delete error for', toDelete[i], e);
        }
      }

      modal.remove();
      showToast('🗑 Deleted ' + deleted + ' duplicate entr' + (deleted === 1 ? 'y' : 'ies'));
      renderTimeView();
    };

    // ── Safe bucket re-render: preserves textarea focus ──
    function _tlSafeRenderBuckets() {
      var bl = document.getElementById('tlBucketsList');
      if (!bl) return;
