    .asset-masonry { columns: 5; column-gap: 12px; }
    .asset-masonry .asset-item { break-inside: avoid; margin-bottom: 12px; border-radius: 0; overflow: hidden; cursor: pointer; position: relative; background: var(--gray-100); }
    .asset-masonry .asset-item img { width: 100%; display: block; }
    .asset-masonry .asset-item:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.15); }
    .asset-masonry .asset-item .asset-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 8px 10px; background: linear-gradient(transparent, rgba(0,0,0,0.7)); color: white; font-size: 11px; opacity: 0; transition: opacity 0.2s; }
