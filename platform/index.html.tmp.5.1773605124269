      // Time calcs
      const totalHours = myTimeEntries.reduce((s, t) => s + (parseFloat(t.hours) || 0), 0);
      const totalBillable = myTimeEntries.filter(t => t.billable !== false).reduce((s, t) => s + (parseFloat(t.hours) || 0), 0);
