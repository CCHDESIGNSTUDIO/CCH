          ' data-mem-idx="' + gi + '"' +
          ' onclick="window._tlMemoryClick(event,' + gi + ',' + escAttr(JSON.stringify(g.indices)) + ',\'' + escAttr(g.app) + '\')"' +
          ' style="' +
            'margin-bottom:6px;' +
            'background:' + (isMeeting ? 'rgba(123,31,162,0.12)' : 'rgba(255,255,255,0.06)') + ';' +
            'border-left:3px solid ' + (isMeeting ? '#7B1FA2' : color) + ';' +
            'border-radius:0 8px 8px 0;' +
            'padding:10px 12px 10px 14px;' +
            'cursor:grab;' +
            'opacity:' + (isInBucket?'0.35':'1') + ';' +
            'box-shadow:0 1px 4px rgba(0,0,0,0.15);' +
            'transition:opacity 0.15s,box-shadow 0.15s,background 0.15s;' +
            'user-select:none;' +
            'position:relative;' +
          '"' +
          ' onmouseenter="this.style.boxShadow=\'0 3px 12px rgba(0,0,0,0.25)\';this.querySelector(\'.tl-mem-select\').style.opacity=\'1\'"' +
          ' onmouseleave="var cb=this.querySelector(\'.tl-mem-select\');if(!cb.checked)cb.style.opacity=\'0.5\';this.style.boxShadow=\'0 1px 4px rgba(0,0,0,0.15)\'">';

        // Detect if app is a website for clickable link
        var isWebsite = g.app.match(/\.[a-z]{2,}$/i) || g.app.match(/^[a-z0-9][-a-z0-9]*\.[a-z]/i);
        var websiteUrl = isWebsite ? 'https://' + g.app.replace(/^https?:\/\//, '') : '';
