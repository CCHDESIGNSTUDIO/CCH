          '<div style="font-size:10px;color:var(--gold);margin-top:3px;">' +
            g.indices.length + ' memor' + (g.indices.length===1?'y':'ies') +
            (g.key && g.key.indexOf('web:') === 0 ? ' · <span style="color:#fff;">' + esc(g.key.substring(4)) + '</span>' : '') +
