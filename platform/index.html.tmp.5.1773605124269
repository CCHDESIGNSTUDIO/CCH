    // ==================== PATCH QB IDs & DATES FROM TRANSACTIONS EXPORT ====================
    function patchFromQBTransactions() {
      var input = document.createElement('input');
      input.type = 'file';
      input.accept = '.xlsx,.xls,.csv';
      input.onchange = async function(e) {
        var file = e.target.files[0];
        if (!file) return;

        // Show progress modal
        document.getElementById('modalContainer').innerHTML = `
          <div class="modal-overlay">
            <div class="modal" style="width:600px;max-height:80vh;">
              <div class="modal-header"><div class="modal-title">🔧 Patching QB IDs & Dates</div></div>
              <div class="modal-body" id="patchProgress" style="max-height:60vh;overflow-y:auto;">
                <div style="text-align:center;padding:20px;color:var(--gray-400);">Reading file...</div>
              </div>
            </div>
          </div>
        `;
        var prog = document.getElementById('patchProgress');

        try {
          // Read XLSX
          var data = await file.arrayBuffer();
          var wb = XLSX.read(data, { type: 'array' });
          var ws = wb.Sheets[wb.SheetNames[0]];
          var allRows = XLSX.utils.sheet_to_json(ws, { header: 1 });

          // Find header row (look for "Code" column)
          var headerIdx = -1;
          for (var i = 0; i < Math.min(10, allRows.length); i++) {
            if (allRows[i] && allRows[i].indexOf('Code') >= 0) { headerIdx = i; break; }
          }
          if (headerIdx < 0) { prog.innerHTML = '<div style="color:var(--red);padding:20px;">Could not find header row with "Code" column.</div>'; return; }

          var headers = allRows[headerIdx];
          var codeCol = headers.indexOf('Code');
          var dateCol = headers.indexOf('Doc Date');
          var createDateCol = headers.indexOf('Create Date');
          var typeCol = headers.indexOf('Transaction Type');
          var statusCol = headers.indexOf('Status');
          var amountCol = headers.indexOf('Amount');
          var qbIdCol = headers.indexOf('Quickbooks Doc id');
          var projectCol = 0; // First column is project name
          var tagsCol = headers.indexOf('Document Tags');

          prog.innerHTML = '<div style="padding:8px;font-size:12px;">Found ' + (allRows.length - headerIdx - 1) + ' transactions. Columns: Code=' + codeCol + ', DocDate=' + dateCol + ', QBId=' + qbIdCol + '</div>';

          // Build lookup maps by code
          var txByCode = {};
          for (var r = headerIdx + 1; r < allRows.length; r++) {
            var row = allRows[r];
            var code = row[codeCol];
            if (!code || typeof code !== 'string') continue;
            code = code.trim();
            txByCode[code] = {
              code: code,
              docDate: row[dateCol] || row[createDateCol] || '',
              type: (row[typeCol] || '').toLowerCase(),
              status: row[statusCol] || '',
              amount: parseFloat(row[amountCol]) || 0,
              qbDocId: row[qbIdCol] ? String(row[qbIdCol]).trim() : '',
              project: row[projectCol] || '',
              tags: row[tagsCol] || ''
            };
          }

          var totalTx = Object.keys(txByCode).length;
          prog.innerHTML += '<div style="padding:4px 8px;font-size:12px;">Unique transaction codes: ' + totalTx + '</div>';

          // Load all Firestore invoices and POs
          prog.innerHTML += '<div style="padding:4px 8px;font-size:12px;">Loading Firestore data...</div>';

          var projSnap = await db.collection('boards').get();
          var allInvoices = [], allPOs = [], allProposals = [];

          for (var pd of projSnap.docs) {
            var pid = pd.id;
            var pName = pd.data().name || pid;
            try {
              var invSnap = await db.collection('boards').doc(pid).collection('invoices').get();
              invSnap.forEach(function(d) { allInvoices.push({ id: d.id, projectId: pid, projectName: pName, ...d.data() }); });
            } catch(e) {}
            try {
              var poSnap = await db.collection('boards').doc(pid).collection('purchaseOrders').get();
              poSnap.forEach(function(d) { allPOs.push({ id: d.id, projectId: pid, projectName: pName, ...d.data() }); });
            } catch(e) {}
            try {
              var prSnap = await db.collection('boards').doc(pid).collection('proposals').get();
              prSnap.forEach(function(d) { allProposals.push({ id: d.id, projectId: pid, projectName: pName, ...d.data() }); });
            } catch(e) {}
          }

          prog.innerHTML += '<div style="padding:4px 8px;font-size:12px;">Found: ' + allInvoices.length + ' invoices, ' + allPOs.length + ' POs, ' + allProposals.length + ' proposals in Firestore</div>';

          // Match and patch
          var matched = 0, patched = 0, skipped = 0, errors = 0;
          var patchLog = [];

          // Helper to match
          async function patchDoc(collection, doc, tx) {
            var updates = {};
            var changes = [];
            if (tx.qbDocId && !doc.qbDocId) {
              updates.qbDocId = tx.qbDocId;
              changes.push('qbDocId=' + tx.qbDocId);
            }
            if (tx.docDate && tx.docDate !== '-') {
              var currentDate = doc.date || doc.issueDate || '';
              // For POs: always patch date from transactions file (source of truth)
              // For invoices: only patch if date looks like upload date or is missing
              var shouldPatchDate = (collection === 'purchaseOrders') ||
                !currentDate ||
                currentDate.includes('2026-02-27') || currentDate.includes('02/27/2026') ||
                currentDate.includes('2026-02-28') || currentDate.includes('02/28/2026') ||
                currentDate.includes('2026-03');
              if (shouldPatchDate) {
                updates.date = tx.docDate;
                updates.issueDate = tx.docDate;
                changes.push('date=' + tx.docDate);
              }
            }
            if (tx.status && !doc.status) {
              updates.status = tx.status;
              changes.push('status=' + tx.status);
            }
            if (Object.keys(updates).length === 0) return false;
            updates.qbSyncDate = new Date().toISOString();
            try {
              await db.collection('boards').doc(doc.projectId).collection(collection).doc(doc.id).update(updates);
              patchLog.push({ code: tx.code, project: doc.projectName, collection: collection, changes: changes.join(', ') });
              return true;
            } catch(err) {
              patchLog.push({ code: tx.code, project: doc.projectName, collection: collection, changes: 'ERROR: ' + err.message });
              return false;
            }
          }

          // Match invoices
          prog.innerHTML += '<div style="padding:4px 8px;font-size:12px;font-weight:600;">Matching invoices...</div>';
          for (var inv of allInvoices) {
            var invNum = inv.invoiceNum || inv.number || inv.name || '';
            if (!invNum) continue;
            var tx = txByCode[invNum];
            if (!tx) {
              // Try with different formats
              tx = txByCode['IN-' + invNum] || txByCode[invNum.replace('IN-', '')];
            }
            if (tx) {
              matched++;
              var didPatch = await patchDoc('invoices', inv, tx);
              if (didPatch) patched++;
              else skipped++;
            }
          }

          // Match POs
          prog.innerHTML += '<div style="padding:4px 8px;font-size:12px;font-weight:600;">Matching POs...</div>';
          for (var po of allPOs) {
            var poNum = po.number || po.poNum || po.name || '';
            if (!poNum) continue;
            var tx2 = txByCode[poNum];
            if (!tx2) {
              tx2 = txByCode['PO-' + poNum] || txByCode[poNum.replace('PO-', '')];
            }
            if (tx2) {
              matched++;
              var didPatch2 = await patchDoc('purchaseOrders', po, tx2);
              if (didPatch2) patched++;
              else skipped++;
            }
          }

          // Match proposals
          prog.innerHTML += '<div style="padding:4px 8px;font-size:12px;font-weight:600;">Matching proposals...</div>';
          for (var pr of allProposals) {
            var prNum = pr.proposalNum || pr.number || pr.name || '';
            if (!prNum) continue;
            var tx3 = txByCode[prNum];
            if (!tx3) {
              tx3 = txByCode['PR-' + prNum] || txByCode[prNum.replace('PR-', '')];
            }
            if (tx3) {
              matched++;
              var didPatch3 = await patchDoc('proposals', pr, tx3);
              if (didPatch3) patched++;
              else skipped++;
            }
          }

          // Results
          _cacheTime = 0; // Invalidate financial cache
          prog.innerHTML += `
            <div style="margin-top:16px;padding:16px;background:var(--gray-50);border-radius:0;">
              <div style="font-size:18px;font-weight:700;color:var(--gold);margin-bottom:8px;">✅ Patch Complete</div>
              <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px;">
                <div style="text-align:center;"><div style="font-size:24px;font-weight:700;">${matched}</div><div style="font-size:10px;color:var(--gray-400);">Matched</div></div>
                <div style="text-align:center;"><div style="font-size:24px;font-weight:700;color:var(--green);">${patched}</div><div style="font-size:10px;color:var(--gray-400);">Patched</div></div>
                <div style="text-align:center;"><div style="font-size:24px;font-weight:700;color:var(--gray-400);">${skipped}</div><div style="font-size:10px;color:var(--gray-400);">Already OK</div></div>
              </div>
              <div style="font-size:12px;color:var(--gray-500);">
                Unmatched in Firestore: ${allInvoices.length + allPOs.length + allProposals.length - matched}<br>
                Transaction codes in file: ${totalTx}
              </div>
            </div>
            ${patchLog.length > 0 ? '<div style="margin-top:12px;max-height:200px;overflow-y:auto;font-size:11px;font-family:monospace;background:#1a1a1a;color:#fff;padding:12px;border-radius:0;">' +
              patchLog.map(function(l) {
                var color = l.changes.includes('ERROR') ? '#ff6b6b' : '#4caf50';
                return '<div style="color:' + color + ';">' + l.code + ' → ' + l.project + ' [' + l.collection + '] ' + l.changes + '</div>';
              }).join('') + '</div>' : ''}
            <div style="text-align:right;margin-top:12px;">
              <button class="btn btn-primary" onclick="closeModal()">Done</button>
            </div>
          `;

        } catch(err) {
          prog.innerHTML = '<div style="color:var(--red);padding:20px;">Error: ' + esc(err.message) + '</div><div style="text-align:right;margin-top:12px;"><button class="btn btn-secondary" onclick="closeModal()">Close</button></div>';
        }
      };
      input.click();
    }

    // ==================== FIX PRODUCT CATEGORIES FROM GLOBAL TRACKER ====================
