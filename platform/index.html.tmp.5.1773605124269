        const cashProfit = revenue - directCosts - contractorCost;
        const loadedProfit = cashProfit - ownerLaborValue;
        const cashMargin = revenue > 0 ? (cashProfit / revenue * 100) : 0;
        const feeBurnPct = contractFee > 0 ? Math.round((directCosts + contractorCost) / contractFee * 100) : 0;
        const revenueEfficiency = loggedValue > 0 ? (invoicedValue / loggedValue * 100) : 0;

        return {
          id: p.id, name: pName, status: p.status || 'Active',
          billingModel, contractFee,
          loggedHours, loggedValue,
          directCosts, contractorCost, ownerLaborValue,
          cynthiaHours, vanessaHours,
          invoicedValue, collectedValue,
          cashProfit, loadedProfit, cashMargin,
          revenueEfficiency, feeBurnPct
        };
