      input.type = 'file';
      input.accept = '.xlsx,.xls,.csv';
      input.onchange = async function(e) {
        var file = e.target.files[0];
        if (!file) return;

        document.getElementById('modalContainer').innerHTML = `
          <div class="modal-overlay">
            <div class="modal" style="width:600px;max-height:80vh;">
              <div class="modal-header"><div class="modal-title">🏷️ Fixing Product Categories</div></div>
              <div class="modal-body" id="catPatchProgress" style="max-height:60vh;overflow-y:auto;">
                <div style="text-align:center;padding:20px;color:var(--gray-400);">Reading file...</div>
              </div>
            </div>
          </div>
        `;
