    // Preload asset cache in background — called on sign-in
    async function preloadAssetCache() {
      if (_cachedAssets && _cachedAssets.length > 0) return;
      _cachedAssets = [];
      var tags = new Set();
      try {
        var projSnap = await db.collection('boards').get();
        for (var pd of projSnap.docs) {
          var pName = pd.data().name || pd.id;
          var pid = pd.id;
          try {
            var ibSnap = await db.collection('boards').doc(pid).collection('ideabooks').get();
            ibSnap.forEach(function(d) {
              var data = d.data();
              (data.images || []).forEach(function(img) {
                var url = typeof img === 'string' ? img : (img.imageUrl || img.url || img.src || '');
                if (!url) return;
                var caption = typeof img === 'object' ? (img.caption || img.title || '') : '';
                var vendor = typeof img === 'object' ? (img.vendor || '') : '';
                var t = [];
                if (vendor) { t.push(vendor); tags.add(vendor); }
                if (data.name) { t.push(data.name); tags.add(data.name); }
                _cachedAssets.push({ url: url, caption: caption, vendor: vendor, board: data.name || '', project: pName, projectId: pid, tags: t, source: 'ideabook' });
              });
            });
          } catch(e) {}
          try {
            var clipSnap = await db.collection('boards').doc(pid).collection('clips').get();
            clipSnap.forEach(function(d) {
              var c = d.data();
              if (!c.imageUrl) return;
              var t = [];
              if (c.vendor) { t.push(c.vendor); tags.add(c.vendor); }
              if (c.category) { t.push(c.category); tags.add(c.category); }
              if (c.room) { t.push(c.room); tags.add(c.room); }
              var title = c.title || '';
              ['sofa','chair','table','lamp','sconce','pendant','chandelier','rug','mirror','pillow',
               'stool','barstool','bar stool','ottoman','bench','desk','dresser','nightstand','bed',
               'vanity','faucet','sink','tile','wallpaper','curtain','shade','fan','cabinet'].forEach(function(kw) {
                if (title.toLowerCase().includes(kw)) { t.push(kw.charAt(0).toUpperCase() + kw.slice(1)); tags.add(kw.charAt(0).toUpperCase() + kw.slice(1)); }
              });
              _cachedAssets.push({ url: c.imageUrl, caption: title, vendor: c.vendor || '', board: c.room || c.category || '', project: pName, projectId: pid, tags: t, source: 'clip', cost: c.cost, price: c.clientPrice, finish: c.finish || '', room: c.room || '', category: c.category || '' });
            });
          } catch(e) {}
        }
      } catch(e) { console.warn('Asset preload error:', e); }
      window._assetTags = [...tags].sort();
      console.log('[Assets] Preloaded ' + _cachedAssets.length + ' assets with ' + window._assetTags.length + ' tags');
    }

