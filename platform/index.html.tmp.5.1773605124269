      if (attachments.length === 0) {
        el.innerHTML = '<div style="font-size:12px;color:var(--gray-400);padding:8px 0;font-style:italic;">No attachments</div>';
        return;
      }
      el.innerHTML = attachments.map((a, i) => {
        var isLink = a.type === 'onedrive-link' || a.type === 'external-link';
        const icon = isLink ? '🔗' : a.type && a.type.includes('pdf') ? '📄' : a.type && a.type.startsWith('image') ? '🖼️' : '📎';
        const size = !isLink && a.size ? (a.size < 1024 ? a.size + ' B' : a.size < 1048576 ? (a.size/1024).toFixed(1) + ' KB' : (a.size/1048576).toFixed(1) + ' MB') : '';
        const sourceLabel = a.source ? '<span style="font-size:9px;background:rgba(0,184,212,0.1);color:var(--cyan);padding:2px 6px;border-radius:3px;">' + esc(a.source) + '</span>' : '';
        return '<div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--gray-100);">' +
          '<span>' + icon + '</span>' +
          '<a href="' + escAttr(a.url) + '" target="_blank" style="flex:1;font-size:12px;color:var(--cyan);text-decoration:none;">' + esc(a.name) + '</a>' +
          sourceLabel +
          '<span style="font-size:10px;color:var(--gray-400);">' + size + '</span>' +
          '<button onclick="removeDocEditAttachment(' + i + ')" style="background:none;border:none;color:var(--gray-400);cursor:pointer;font-size:14px;" title="Remove">×</button>' +
        '</div>';
      }).join('');
    }

