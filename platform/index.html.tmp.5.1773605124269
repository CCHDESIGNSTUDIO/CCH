        var detailId = 'tlMemDetail-' + gi;

        html += '<div class="tl-memory-card" draggable="true"' +
          ' data-app="' + escAttr(g.app) + '"' +
          ' data-indices="' + escAttr(JSON.stringify(g.indices)) + '"' +
