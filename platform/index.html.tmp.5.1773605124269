    async function ibMoveImage(projectId, sectionId, index, direction) {
      const doc = await db.collection('boards').doc(projectId).collection('ideabooks').doc(sectionId).get();
      const images = doc.data().images || [];
      const target = index + direction;
      if (target < 0 || target >= images.length) return;
