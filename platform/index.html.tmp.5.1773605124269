        const cynthiaHours = cynthiaTime.reduce((s, t) => s + (parseFloat(t.hours) || 0), 0);
        const cynthiaValue = cynthiaTime.filter(t => t.billable !== false).reduce((s, t) => {
          return s + ((parseFloat(t.hours) || 0) * (parseFloat(t.rate || t.hourlyRate || t.billableRate) || 150));
