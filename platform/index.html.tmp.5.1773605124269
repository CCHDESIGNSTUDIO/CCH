      var html = '<div style="background:white;border-radius:0;padding:24px;width:600px;max-width:90vw;max-height:80vh;overflow-y:auto;box-shadow:0 16px 48px rgba(0,0,0,0.3);">' +
        '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">' +
          '<div style="font-size:18px;font-weight:700;">⚠️ Duplicate Review — ' + _tlDay + '</div>' +
