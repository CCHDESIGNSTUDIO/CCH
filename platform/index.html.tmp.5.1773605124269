        for (var pi = 0; pi < projs.length; pi++) {
          var proj = projs[pi];
          var clipSnap = await db.collection('boards').doc(proj.id).collection('clips').get();
          var rooms = {};
          clipSnap.forEach(function(cd) {
            var c = cd.data();
            var rm = c.room || c.category || 'General';
            if (!rooms[rm]) rooms[rm] = 0;
            rooms[rm]++;
          });
          var roomNames = Object.keys(rooms);
          if (roomNames.length === 0) continue;
          html += '<div style="margin-bottom:8px;"><div style="color:var(--gold);font-weight:600;font-size:11px;margin-bottom:4px;">' + esc(proj.name) + '</div>';
          roomNames.forEach(function(rm) {
            var roomId = rm.replace(/[^a-zA-Z0-9]/g, '_').toLowerCase();
            html += '<div onclick="window._pdSetCover(\'' + proj.id + '\',\'' + roomId + '\',\'' + rm.replace(/'/g, "\\'") + '\',\'' + productId + '\')" ' +
              'style="padding:4px 8px;color:white;cursor:pointer;border-radius:4px;margin-bottom:2px;" ' +
              'onmouseenter="this.style.background=\'rgba(200,185,154,0.2)\'" onmouseleave="this.style.background=\'transparent\'">' +
              esc(rm) + ' <span style="color:var(--gray-500);">(' + rooms[rm] + ')</span></div>';
          });
          html += '</div>';
        }
        list.innerHTML = html || '<div style="color:var(--gray-400);">No rooms found.</div>';
      } catch(e) {
        list.innerHTML = '<div style="color:var(--red);">Error: ' + esc(e.message) + '</div>';
