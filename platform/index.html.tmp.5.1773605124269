    async function saveUpdateEdits(projectId, updateId) {
      var rooms = [];
      document.querySelectorAll('.update-room-row').forEach(function(row) {
        var name = row.querySelector('.ur-name').value.trim();
        if (name) rooms.push({ name: name, progress: parseInt(row.querySelector('.ur-pct').value) || 0, delivery: row.querySelector('.ur-delivery').value.trim() });
      });

      var approvals = [];
      document.querySelectorAll('.update-approval-row').forEach(function(row) {
        var title = row.querySelector('.ua-title').value.trim();
        if (title) approvals.push({ title: title, room: row.querySelector('.ua-room').value.trim(), daysWaiting: parseInt(row.querySelector('.ua-days').value) || 0 });
      });

      var completed = [];
      document.querySelectorAll('.uc-item').forEach(function(inp) {
        if (inp.value.trim()) completed.push(inp.value.trim());
      });

      var upcoming = [];
      document.querySelectorAll('#updateUpcoming > div').forEach(function(row) {
        var week = row.querySelector('.uu-week');
        var items = row.querySelector('.uu-items');
        if (week && week.value.trim()) {
          upcoming.push({ week: week.value.trim(), items: items ? items.value.split(',').map(function(s) { return s.trim(); }).filter(Boolean) : [] });
        }
      });

      await db.collection('boards').doc(projectId).collection('updates').doc(updateId).update({
        period: document.getElementById('ePeriod').value.trim(),
        greeting: document.getElementById('eGreeting').value.trim(),
        rooms: rooms,
        approvals: approvals,
        completed: completed,
        upcoming: upcoming,
        updatedAt: new Date().toISOString()
      });

      // Log activity
      var projDoc = await db.collection('boards').doc(projectId).get();
      var projName = projDoc.exists ? (projDoc.data().name || projectId) : projectId;
      await logActivity('note', 'updated', 'Bi-weekly update edited: ' + (document.getElementById('ePeriod').value || ''), projectId, projName, {});

      navigate('#/project/' + projectId + '/updates');
    }

