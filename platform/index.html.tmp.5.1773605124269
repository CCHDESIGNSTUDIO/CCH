    // ----- POs TAB -----
    async function renderPOsTab(T, proj) {
      let pos = [];
      try {
        const s = await db.collection('boards').doc(proj.id).collection('purchaseOrders').orderBy('createdAt','desc').get();
        s.forEach(d => pos.push({id:d.id,...d.data()}));
      } catch(e){}
      // Fallback: also do unordered query to catch docs missing createdAt
      try {
        const s2 = await db.collection('boards').doc(proj.id).collection('purchaseOrders').get();
        s2.forEach(d => {
          if (!pos.find(p => p.id === d.id)) {
            pos.push({id:d.id,...d.data()});
          }
        });
      } catch(e){}

      // Also build POs from clips that have poNum
      try {
        const clipSnap = await db.collection('boards').doc(proj.id).collection('clips').get();
        const poMap = {};
        clipSnap.forEach(d => {
          const c = d.data();
          if (c.poNum) {
            if (!poMap[c.poNum]) {
              poMap[c.poNum] = { id: 'clip-po-' + c.poNum, number: c.poNum, vendor: c.vendor || '',
                status: c.poStatus || 'Ordered', date: c.poDate || '', orderDate: c.poDate || '', createdAt: c.savedAt || '',
                total: 0, items: [], _fromClips: true };
            }
            poMap[c.poNum].total += (c.totalCost || c.cost || 0);
            poMap[c.poNum].items.push({
              title: c.title || '', vendor: c.vendor || '', category: c.category || '',
              room: c.room || '', cost: c.totalCost || c.cost || 0,
              clientPrice: c.totalSelling || c.clientPrice || 0, qty: c.qty || 1,
              imageUrl: c.imageUrl || null
            });
            if (c.vendor && !poMap[c.poNum].vendor) poMap[c.poNum].vendor = c.vendor;
          }
        });
        Object.values(poMap).forEach(po => {
          if (!pos.find(existing => (existing.number || existing.num) === po.number)) {
            pos.push(po);
          }
        });
      } catch(e) {}

      // Auto-link: match POs to invoices in this project by shared items/vendor
      try {
        let invoices = [];
        const invSnap = await db.collection('boards').doc(proj.id).collection('invoices').get();
        invSnap.forEach(d => invoices.push({ id: d.id, ...d.data() }));

        for (const po of pos) {
          if (po.linkedInvoiceId) continue; // already linked
          if (po.id.startsWith('clip-po-')) continue; // clip-derived, skip auto-link

          // Strategy 1: Match by linkedPOId on invoice side
          const invByLink = invoices.find(inv => inv.linkedPOId === po.id);
          if (invByLink) {
            po.linkedInvoiceId = invByLink.id;
            continue;
          }

          // Strategy 2: Match by shared vendor + overlapping items
          const poVendor = (po.vendor || '').toLowerCase().trim();
          const poItems = (po.items || []).map(i => (i.title || '').toLowerCase().trim()).filter(Boolean);
          if (poVendor && poItems.length > 0) {
            for (const inv of invoices) {
              if (inv.linkedPOId) continue;
              const invItems = (inv.items || []).map(i => (i.title || '').toLowerCase().trim()).filter(Boolean);
              const overlap = poItems.filter(t => invItems.includes(t));
              if (overlap.length >= Math.min(poItems.length, 2)) {
                // Auto-link bidirectionally in Firestore
                po.linkedInvoiceId = inv.id;
                inv.linkedPOId = po.id;
                try {
                  await db.collection('boards').doc(proj.id).collection('purchaseOrders').doc(po.id).update({ linkedInvoiceId: inv.id });
                  await db.collection('boards').doc(proj.id).collection('invoices').doc(inv.id).update({ linkedPOId: po.id });
                } catch(e2) { console.warn('Auto-link save failed:', e2); }
                break;
              }
            }
          }
        }
      } catch(e) { console.warn('Auto-link scan failed:', e); }

      // Calculate PO totals
      let _poTotalCost = 0, _poPaid = 0, _poBalance = 0;
      pos.forEach(po => {
        let t = parseFloat(po.total || po.amount) || 0;
        if (!t && po.items) t = (po.items || []).reduce((s, i) => {
          return s + (parseFloat(String(i.cost || i.unitCost || i.lineTotal || 0).replace(/[^0-9.-]/g,'')) || 0) * (parseFloat(i.qty) || 1);
        }, 0);
        _poTotalCost += t;
        // Check if PO is paid: explicit paidAmount, or status=Paid, or has QB sync + paid status
        const _paidAmt = parseFloat(po.paidAmount) || 0;
        if (_paidAmt > 0) {
          _poPaid += _paidAmt;
        } else {
          const st = (po.status || '').toLowerCase();
          // Houzz uses separate payment status - check for 'paid' or 'partially paid'
          const paySt = (po.paymentStatus || '').toLowerCase();
          const qbSt = (po.qbStatus || '').toLowerCase();
          if (paySt === 'paid' || st === 'paid' || qbSt === 'paid') {
            _poPaid += t;
          } else if (paySt === 'partially paid' || qbSt === 'partial') {
            _poPaid += t * 0.5; // estimate
          }
        }
      });
      _poBalance = _poTotalCost - _poPaid;

      T.innerHTML = `
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <div class="section-title" style="margin:0;">Purchase Orders</div>
          <button class="btn btn-primary btn-sm" onclick="showNewPOModal('${proj.id}')">+ New PO</button>
        </div>
