    async function saveClipDetail(projectId, clipId) {
      const updates = {
        title: document.getElementById('cdTitle').value.trim(),
        room: document.getElementById('cdRoom') ? document.getElementById('cdRoom').value.trim() || null : null,
        category: document.getElementById('cdCategory').value.trim() || null,
        cost: document.getElementById('cdCost').value.trim() || null,
        clientPrice: document.getElementById('cdClientPrice').value.trim() || null,
        vendor: document.getElementById('cdVendor').value.trim() || null,
        sku: document.getElementById('cdSku').value.trim() || null,
        finish: document.getElementById('cdFinish').value.trim() || null,
        dimensions: document.getElementById('cdDimensions').value.trim() || null,
        description: document.getElementById('cdDescription').value.trim() || null,
        status: document.getElementById('cdStatus').value || null,
        notes: document.getElementById('cdNotes').value.trim() || null,
        updatedAt: new Date().toISOString()
      };

      // Update image if changed — skip base64 data URLs (too large for Firestore)
      const newImageUrl = document.getElementById('cdImageUrl').value.trim();
      if (newImageUrl && !newImageUrl.startsWith('data:') && newImageUrl.length < 2000) updates.imageUrl = newImageUrl;

      // Materials field (only if it exists in the modal)
      const matEl = document.getElementById('cdMaterials');
      if (matEl) updates.materials = matEl.value.trim() || null;

      try {
        await db.collection('boards').doc(projectId).collection('clips').doc(clipId).update(updates);
        closeModal();
        renderProjectDetail(); // Refresh the board view
      } catch(e) {
        alert('Save failed: ' + e.message);
      }
    }

    async function deleteClip(projectId, clipId) {
      if (!confirm('Delete this product? This cannot be undone.')) return;
      try {
        await db.collection('boards').doc(projectId).collection('clips').doc(clipId).delete();
        closeModal();
        renderProjectDetail();
      } catch(e) {
        alert('Delete failed: ' + e.message);
      }
    }

    async function cdHandleImageUpload(input, projectId, clipId, mode) {
      const files = Array.from(input.files);
      if (!files.length) return;

      for (const file of files) {
        try {
          // Upload to Firebase Storage
          const path = 'projects/' + projectId + '/clips/' + clipId + '/' + Date.now() + '-' + file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
          const downloadUrl = await uploadImageToStorage(file, path);

          if (mode === 'replace') {
            await db.collection('boards').doc(projectId).collection('clips').doc(clipId).update({
              imageUrl: downloadUrl, updatedAt: new Date().toISOString()
            });
            const mainImg = document.getElementById('cdMainImage');
            if (mainImg) mainImg.src = downloadUrl;
            const urlInput = document.getElementById('cdImageUrl');
            if (urlInput) urlInput.value = downloadUrl;
          } else {
            const doc = await db.collection('boards').doc(projectId).collection('clips').doc(clipId).get();
            const clip = doc.data();
            const images = clip.images || (clip.imageUrl ? [clip.imageUrl] : []);
            images.push(downloadUrl);
            await db.collection('boards').doc(projectId).collection('clips').doc(clipId).update({
              images: images, updatedAt: new Date().toISOString()
            });
          }
        } catch(err) {
          alert('Upload failed: ' + err.message);
        }
      }
      // Re-open the modal to show updated images
      setTimeout(() => showClipDetail(projectId, clipId), 500);
    }

    // ==================== IMAGE MANAGER ====================
