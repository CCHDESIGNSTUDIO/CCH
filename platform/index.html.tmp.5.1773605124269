    function uploadRoomCover(projectId, roomName, btnEl) {
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.onchange = async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        try {
          const roomId = roomName.replace(/[^a-zA-Z0-9]/g, '_').toLowerCase();
          const path = 'projects/' + projectId + '/rooms/' + roomId + '/' + Date.now() + '-' + file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
          const downloadUrl = await uploadImageToStorage(file, path);
          try {
            await db.collection('boards').doc(projectId).collection('roomMeta').doc(roomId).set({
              name: roomName, coverImage: downloadUrl, updatedAt: new Date().toISOString()
            }, { merge: true });
            // Update the card image
            const card = btnEl.closest('.room-card');
            if (card) {
              const cover = card.querySelector('.room-card-cover');
              cover.innerHTML = '<img src="' + downloadUrl + '"><div class="room-card-upload" onclick="event.stopPropagation();uploadRoomCover(\'' + projectId + '\',\'' + roomName.replace(/'/g,"\\'") + '\',this)" title="Upload cover image">📷</div>';
            }
          } catch(err) { console.error('Upload failed:', err); alert('Upload failed: ' + err.message); }
        } catch(err) { console.error('Upload failed:', err); alert('Upload failed: ' + err.message); }
      };
      input.click();
    }

