    // PO Attachments
    function addPOAttachment(projectId, poId) {
      var input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*,.pdf,.doc,.docx,.xls,.xlsx';
      input.multiple = true;
      input.onchange = async function(e) {
        var files = Array.from(e.target.files);
        if (files.length === 0) return;
        try {
          var uploaded = [];
          for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var ext = (file.name.split('.').pop() || '').toLowerCase();
            var path = 'projects/' + projectId + '/po-attachments/' + poId + '/' + Date.now() + '_' + i + '.' + ext;
            var ref = firebase.storage().ref(path);
            await ref.put(file, { contentType: file.type });
            var url = await ref.getDownloadURL();
            uploaded.push({ name: file.name, url: url, type: file.type, uploadedAt: new Date().toISOString() });
          }
          // Merge with existing attachments
          var docRef = db.collection('boards').doc(projectId).collection('purchaseOrders').doc(poId);
          var snap = await docRef.get();
          var existing = (snap.exists && snap.data().attachments) ? snap.data().attachments : [];
          await docRef.update({ attachments: existing.concat(uploaded) });
          showToast('📎 ' + uploaded.length + ' file(s) attached');
          renderProjectDetail();
        } catch(err) { alert('Upload failed: ' + err.message); }
      };
      input.click();
    }

    function viewPOAttachments(projectId, poId) {
      db.collection('boards').doc(projectId).collection('purchaseOrders').doc(poId).get().then(function(snap) {
        if (!snap.exists) return;
        var attachments = snap.data().attachments || [];
        if (attachments.length === 0) { addPOAttachment(projectId, poId); return; }
        var html = '<div style="padding:16px;">' +
          attachments.map(function(a, idx) {
            var isImg = /\.(jpg|jpeg|png|gif|webp)$/i.test(a.name) || (a.type && a.type.startsWith('image/'));
            return '<div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--gray-100);">' +
              (isImg ? '<img src="' + escAttr(a.url) + '" style="width:48px;height:48px;object-fit:cover;border-radius:4px;">' : '<div style="width:48px;height:48px;background:var(--gray-100);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:20px;">📄</div>') +
              '<div style="flex:1;"><div style="font-size:13px;font-weight:600;">' + esc(a.name) + '</div><div style="font-size:11px;color:var(--gray-400);">' + formatDate(a.uploadedAt) + '</div></div>' +
              '<a href="' + escAttr(a.url) + '" target="_blank" style="color:var(--teal);font-size:12px;">Open ↗</a>' +
              '<span style="cursor:pointer;color:var(--red);font-size:12px;" onclick="removePOAttachment(\'' + projectId + '\',\'' + poId + '\',' + idx + ')">✕</span>' +
            '</div>';
          }).join('') +
          '<div style="margin-top:12px;"><button class="btn btn-secondary btn-sm" onclick="closeModal();addPOAttachment(\'' + projectId + '\',\'' + poId + '\')">+ Add More</button></div>' +
        '</div>';
        showModal('📎 Attachments — ' + (snap.data().number || poId.slice(0,8)), html);
      });
