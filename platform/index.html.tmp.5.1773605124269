    async function saveLinkDoc(projectId, sourceCollection, sourceDocId) {
      const sel = document.getElementById('linkDocSelect').value;
      if (!sel) { alert('Select a document to link'); return; }
      const [targetCollection, targetDocId] = sel.split('|');

      try {
        const sourceRef = db.collection('boards').doc(projectId).collection(sourceCollection).doc(sourceDocId);
        const targetRef = db.collection('boards').doc(projectId).collection(targetCollection).doc(targetDocId);

        // Determine link field names based on collection types
        const sourceType = sourceCollection === 'proposals' ? 'Proposal' : sourceCollection === 'invoices' ? 'Invoice' : 'PO';
        const targetType = targetCollection === 'proposals' ? 'Proposal' : targetCollection === 'invoices' ? 'Invoice' : 'PO';

        // Save bidirectional links
        const sourceUpdate = {};
        sourceUpdate['linked' + targetType + 'Id'] = targetDocId;
        await sourceRef.update(sourceUpdate);

        const targetUpdate = {};
        targetUpdate['linked' + sourceType + 'Id'] = sourceDocId;
        await targetRef.update(targetUpdate);

        document.getElementById('linkModal').remove();
        _cacheTime = 0;
        renderProjectDetail();
      } catch(e) { console.error('Link save failed:', e); alert('Failed to link documents'); }
    }

