    async function parseTearSheetPDF(file) {
      const status = document.getElementById('tearParseStatus');
      const preview = document.getElementById('tearParsePreview');
      if (!file) return;
      status.innerHTML = '<div style="color:var(--gold);font-weight:600;">📄 Reading PDF...</div>';
      preview.style.display = 'none';

      try {
        const arrayBuffer = await file.arrayBuffer();
        const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
        const numPages = pdf.numPages;

        status.innerHTML = `<div style="color:var(--gold);font-weight:600;">🔍 Parsing ${numPages} pages...</div>`;

        // Extract all text with position data
        const allItems = []; // {text, x, y, page, h}
        for (let p = 1; p <= numPages; p++) {
          const page = await pdf.getPage(p);
          const tc = await page.getTextContent();
          const vp = page.getViewport({ scale: 1 });
          tc.items.forEach(item => {
            if (item.str && item.str.trim()) {
              allItems.push({
                text: item.str.trim(),
                x: Math.round(item.transform[4]),
                y: Math.round(vp.height - item.transform[5]), // flip Y
                h: Math.round(item.height || 0),
                page: p
              });
            }
          });
        }

        // Parse products from text stream
        const products = parseTearSheetTextItems(allItems);
        _tearImportData = products;

        if (products.length === 0) {
          status.innerHTML = '<div style="color:var(--red);font-weight:600;">⚠️ Could not detect products. Please verify this is a Houzz tear sheet PDF.</div>';
          return;
        }

        // Group by room for preview
        const byRoom = {};
        products.forEach(p => { if (!byRoom[p.room]) byRoom[p.room] = []; byRoom[p.room].push(p); });

        const roomCount = Object.keys(byRoom).length;
        status.innerHTML = `<div style="color:var(--green);font-weight:600;">✅ Found ${products.length} products across ${roomCount} room${roomCount !== 1 ? 's' : ''}</div>`;

        preview.style.display = 'block';
        preview.innerHTML = Object.keys(byRoom).map(room => `
          <div style="margin-bottom:16px;">
            <div style="font-weight:700;font-size:13px;color:var(--gold);border-bottom:2px solid var(--gold);padding-bottom:4px;margin-bottom:8px;letter-spacing:0.5px;text-transform:uppercase;">${esc(room)} (${byRoom[room].length})</div>
            ${byRoom[room].map(p => `
              <div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--gray-100);">
                ${p.imageDataUrl
                  ? `<img src="${p.imageDataUrl}" style="width:52px;height:52px;object-fit:cover;border-radius:4px;flex-shrink:0;background:var(--gray-100);">`
                  : `<div style="width:52px;height:52px;background:var(--gray-100);border-radius:4px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--gray-400);font-size:18px;">📷</div>`}
                <div style="flex:1;min-width:0;">
                  <div style="font-weight:600;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(p.title || 'Untitled')}</div>
                  <div style="font-size:11px;color:var(--gray-400);">${esc(p.vendor || '')}${p.itemCode ? ' · ' + esc(p.itemCode) : ''}</div>
                </div>
                ${p.clientPrice ? `<div style="font-weight:700;color:var(--green);font-size:13px;white-space:nowrap;">$${parseFloat(p.clientPrice).toLocaleString()}</div>` : ''}
              </div>`).join('')}
          </div>`).join('');

        document.getElementById('tearImportFooter').style.display = '';
      } catch(err) {
        console.error('PDF parse error:', err);
        status.innerHTML = `<div style="color:var(--red);">Error reading PDF: ${esc(err.message)}</div>`;
      }
    }

    function parseTearSheetTextItems(items) {
      // ── Strategy: walk text items in reading order (page then Y then X)
      // Identify rooms by: short all-caps text or known room keywords with no price/code nearby
      // Products: item code pattern + title + price

      const ROOM_KEYWORDS = /^(entry|foyer|living|dining|kitchen|bedroom|bathroom|bath|office|hallway|powder|garage|laundry|library|family|game|media|master|guest|great|staircase|stair|landing|mudroom|closet|pantry|basement|loft|porch|patio|outdoor|terrace|study|bonus|wine|bar|gym|exercise|spa|breezeway|sunroom|den|nook)/i;
      const PRICE_RE = /^\$[\d,]+(\.\d{2})?$|^[\d,]+\.\d{2}$/;
      const ITEM_CODE_RE = /^[A-Z]{0,3}\d+[A-Z]?$|^#\d+$|^[A-Z]-\d+$/;

      // Sort by page, then Y, then X
      items.sort((a, b) => a.page !== b.page ? a.page - b.page : a.y !== b.y ? a.y - b.y : a.x - b.x);

      const lines = [];
      let curLine = null;
      const Y_TOLERANCE = 6;

      items.forEach(item => {
        if (!curLine || item.page !== curLine.page || Math.abs(item.y - curLine.y) > Y_TOLERANCE) {
          if (curLine) lines.push(curLine);
          curLine = { y: item.y, page: item.page, texts: [item.text], h: item.h };
        } else {
          curLine.texts.push(item.text);
        }
      });
      if (curLine) lines.push(curLine);

      const products = [];
      let currentRoom = 'Unassigned';
      let i = 0;

      const joinLine = (l) => l.texts.join(' ').trim();

      while (i < lines.length) {
        const lineText = joinLine(lines[i]);
        const lineUpper = lineText.toUpperCase();

        // Skip obvious header / logo lines (very short or CCH branding)
        if (/^(CCH|DESIGN INC|PRODUCT SELECTIONS|PAGE \d|PREPARED|CONFIDENTIAL)/i.test(lineText) && lineText.length < 60) {
          i++; continue;
        }

        // Detect room header: short line (< 40 chars), matches room keywords, no price pattern
        if (lineText.length < 50 && ROOM_KEYWORDS.test(lineText) && !PRICE_RE.test(lineText)) {
          currentRoom = lineText.replace(/^\d+[\.\)]\s*/, '').trim();
          i++; continue;
        }

        // Detect all-caps short room label (like "ENTRY", "LIVING ROOM")
        if (lineText === lineUpper && lineText.length > 3 && lineText.length < 40 && /^[A-Z\s\/]+$/.test(lineText) && !PRICE_RE.test(lineText) && !ITEM_CODE_RE.test(lineText)) {
          currentRoom = lineText.charAt(0) + lineText.slice(1).toLowerCase();
          i++; continue;
        }

        // Detect product: item code on a line, or line with price somewhere
        // Look for item code at start of line
        const firstToken = (lines[i].texts[0] || '').trim();
        const hasItemCode = ITEM_CODE_RE.test(firstToken) && lineText.length > firstToken.length;

        // Look for price in current line or next 2 lines
        const nearbyTexts = [lineText, joinLine(lines[i+1]||{texts:[]}), joinLine(lines[i+2]||{texts:[]})].join(' ');
        const priceMatch = nearbyTexts.match(/\$\s*([\d,]+(?:\.\d{2})?)/);

        if (hasItemCode || (priceMatch && lineText.length > 6 && !/^(date|total|subtotal|tax|shipping|note)/i.test(lineText))) {
          const product = {
            room: currentRoom,
            itemCode: hasItemCode ? firstToken : '',
            title: hasItemCode ? lineText.slice(firstToken.length).trim() : lineText,
            vendor: '',
            clientPrice: priceMatch ? priceMatch[1].replace(/,/g,'') : '',
            qty: 1,
            description: '',
            imageDataUrl: ''
          };

          // Harvest next few lines for vendor, description, qty
          let descLines = [];
          let j = i + 1;
          const PAGE_BREAK_DIST = 80;
          while (j < lines.length && j < i + 8) {
            if (lines[j].page !== lines[i].page && (lines[j].y < PAGE_BREAK_DIST)) break;
            const next = joinLine(lines[j]);
            if (!next) { j++; continue; }
            // Stop if next product or room
            if (ITEM_CODE_RE.test(lines[j].texts[0]) && next.length > lines[j].texts[0].length) break;
            if (ROOM_KEYWORDS.test(next) && next.length < 50) break;
            if (next === next.toUpperCase() && next.length < 40 && /^[A-Z\s\/]+$/.test(next)) break;

            const qtyMatch = next.match(/^qty[:\s]+(\d+)/i) || next.match(/^quantity[:\s]+(\d+)/i);
            if (qtyMatch) { product.qty = parseInt(qtyMatch[1]); j++; continue; }

            // If line looks like vendor (short, no numbers)
            if (!product.vendor && next.length < 60 && !/\d/.test(next) && j === i + 1) {
              product.vendor = next; j++; continue;
            }
            // Skip pure price lines
            if (PRICE_RE.test(next)) { j++; continue; }

            descLines.push(next);
            j++;
          }
          product.description = descLines.filter(l => !PRICE_RE.test(l)).join(' ').substring(0, 400);
          i = j;
          if (product.title && product.title.length > 2) products.push(product);
          continue;
        }

        i++;
      }

      return products;
    }

    async function confirmTearSheetImport() {
      if (!_tearImportData || !_tearImportData.length || !_tearImportProjectId) return;
      const btn = document.querySelector('#tearImportFooter .btn-primary');
      if (btn) { btn.disabled = true; btn.textContent = 'Importing...'; }

      const status = document.getElementById('tearParseStatus');
      let imported = 0, failed = 0;
      const batch_size = 10;

      try {
        for (let i = 0; i < _tearImportData.length; i += batch_size) {
          const chunk = _tearImportData.slice(i, i + batch_size);
          const writes = chunk.map(p => {
            const clipRef = db.collection('boards').doc(_tearImportProjectId).collection('clips').doc();
            const data = {
              title: p.title || 'Untitled',
              room: p.room || 'Unassigned',
              category: p.room || 'Unassigned',
              vendor: p.vendor || '',
              sku: p.itemCode || '',
              itemCode: p.itemCode || '',
              clientPrice: parseFloat(p.clientPrice) || 0,
              qty: parseFloat(p.qty) || 1,
              totalSelling: (parseFloat(p.clientPrice) || 0) * (parseFloat(p.qty) || 1),
              description: p.description || '',
              imageUrl: p.imageDataUrl || '',
              importedFrom: 'houzz-tearsheet',
              importedAt: firebase.firestore.FieldValue.serverTimestamp(),
              createdAt: firebase.firestore.FieldValue.serverTimestamp(),
            };
            return clipRef.set(data).then(() => imported++).catch(() => failed++);
          });
          await Promise.all(writes);
          if (status) status.innerHTML = `<div style="color:var(--gold);font-weight:600;">Importing... ${Math.min(i + batch_size, _tearImportData.length)} / ${_tearImportData.length}</div>`;
        }

        closeModal();
        // Refresh the room board
        await showPage('projects');
        alert(`✅ Imported ${imported} product${imported !== 1 ? 's' : ''} to Room Board.${failed > 0 ? ` (${failed} failed)` : ''}`);
      } catch(err) {
        console.error('Import error:', err);
        if (btn) { btn.disabled = false; btn.textContent = '✅ Import to Room Board'; }
        if (status) status.innerHTML = `<div style="color:var(--red);">Import error: ${esc(err.message)}</div>`;
      }
    }

