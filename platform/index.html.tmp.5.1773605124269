      T.innerHTML = '<div style="text-align:center;padding:60px;color:var(--gray-400);">Loading products...</div>';

      // Load from products collection - LIMIT to prevent browser crash
      try {
        const snap = await db.collection('products').orderBy('updatedAt', 'desc').limit(300).get();
        libraryProducts = [];
        snap.forEach(d => libraryProducts.push({ id: d.id, ...d.data() }));
      } catch(e) {
        try {
          const snap = await db.collection('products').limit(300).get();
          libraryProducts = [];
          snap.forEach(d => libraryProducts.push({ id: d.id, ...d.data() }));
          libraryProducts.sort((a, b) => (b.updatedAt || '').localeCompare(a.updatedAt || ''));
        } catch(e2) { libraryProducts = []; }
      }

      // Filter out junk
      libraryProducts = libraryProducts.filter(isRealProduct);

      // Get vendors/categories from products we already loaded (no extra queries)
      if (!window._globalVendors || !window._globalCategories) {
        window._globalVendors = new Set();
        window._globalCategories = new Set();
        libraryProducts.forEach(p => {
          if (p.vendor) window._globalVendors.add(p.vendor);
          if (p.category) window._globalCategories.add(p.category);
          if (p.manufacturer) window._globalVendors.add(p.manufacturer);
        });
      }

      renderLibraryView();
    }

    function renderLibraryView() {
      const T = document.getElementById('contentArea');
      const vendorSet = new Set([...libraryProducts.map(p => p.vendor).filter(Boolean), ...(window._globalVendors || [])]);
      const catSet = new Set([...libraryProducts.map(p => p.category).filter(Boolean), ...(window._globalCategories || [])]);
      const vendors = [...vendorSet].sort();
      const categories = [...catSet].sort();
      // Add proper interior design categories
      ['Lighting','Fabric','Furniture','Accessories','Plumbing','Hardware','Tile','Stone','Rugs','Art','Wallcovering','Window Treatments','Outdoor','Appliances'].forEach(function(c) { if (categories.indexOf(c) < 0) categories.push(c); });
      categories.sort();
      const filtered = libraryProducts.filter(p => {
        if (libraryFilter.search) {
          const s = libraryFilter.search.toLowerCase();
          const str = function(v) { return (v == null ? '' : String(v)).toLowerCase(); };
          const match = str(p.title).includes(s) ||
                        str(p.vendor).includes(s) ||
                        str(p.sku).includes(s) ||
                        str(p.description).includes(s) ||
                        str(p.manufacturer).includes(s) ||
                        str(p.materials).includes(s) ||
                        str(p.finish).includes(s) ||
                        str(p.dimensions).includes(s) ||
                        str(p.category).includes(s);
          if (!match) return false;
        }
        if (libraryFilter.vendor && (p.vendor || '') !== libraryFilter.vendor) return false;
        if (libraryFilter.category && (p.category || '') !== libraryFilter.category) return false;
        return true;
      });

      const viewToggle = `<div class="view-toggle">
        <button class="${libraryViewMode==='list'?'active':''}" onclick="libraryViewMode='list';renderLibraryView()">☰</button>
        <button class="${libraryViewMode==='grid'?'active':''}" onclick="libraryViewMode='grid';renderLibraryView()">▦</button>
      </div>`;

      const DISPLAY_LIMIT = 50;

      // Sort filtered results
      const sortArrow = function(field) {
        if (librarySortField !== field) return ' ▾';
        return librarySortDir === 'asc' ? ' ▲' : ' ▼';
      };
      filtered.sort(function(a, b) {
        var dir = librarySortDir === 'asc' ? 1 : -1;
        var va, vb;
        if (librarySortField === 'cost') { va = parseFloat(a.cost || a.costPrice) || 0; vb = parseFloat(b.cost || b.costPrice) || 0; }
        else if (librarySortField === 'sell') { va = parseFloat(a.clientPrice || a.sellPrice) || 0; vb = parseFloat(b.clientPrice || b.sellPrice) || 0; }
        else { va = (a[librarySortField] || '').toString().toLowerCase(); vb = (b[librarySortField] || '').toString().toLowerCase(); }
        if (va < vb) return -1 * dir;
        if (va > vb) return 1 * dir;
        return 0;
      });

      const displayItems = filtered.slice(0, DISPLAY_LIMIT);
      const hasMore = filtered.length > DISPLAY_LIMIT;

      let content = '';
      if (filtered.length === 0) {
        content = `<div class="empty-state"><div class="empty-icon">📦</div>
          <div class="empty-text">${libraryProducts.length === 0 ? 'No products yet. Add your first product to get started.' : 'No products match your filters.'}</div>
          ${libraryProducts.length === 0 ? '<button class="btn btn-primary" onclick="showNewProductModal()">+ New Product</button>' : ''}</div>`;
      } else if (libraryViewMode === 'list') {
