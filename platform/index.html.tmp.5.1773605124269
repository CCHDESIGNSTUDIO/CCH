      const statusColors = { Draft: 'draft', Sent: 'sent', Approved: 'paid', Declined: 'overdue' };

      T.innerHTML = `
        <div id="proposalPrintArea">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;">
            <div>
              <h1 class="page-title" style="margin-bottom:4px;">${esc(prop.name || 'Proposal')}</h1>
              <div style="color:var(--gray-400);font-size:13px;">
                ${projName}${proj.clientName ? ' · ' + esc(proj.clientName) : ''}
                ${prop.createdAt ? ' · ' + new Date(prop.createdAt).toLocaleDateString() : ''}
              </div>
            </div>
            <div style="text-align:right;">
              <div class="status-badges" style="justify-content:flex-end;margin-bottom:8px;">
                <span class="badge badge-${statusColors[prop.status] || 'draft'}" style="font-size:13px;padding:6px 14px;cursor:pointer;" onclick="cycleProposalStatus('${projectId}','${proposalId}','${prop.status || 'Draft'}')">${esc(prop.status || 'Draft')}</span>
                <span class="badge ${prop.published ? 'badge-published' : 'badge-draft'}" style="font-size:11px;padding:4px 12px;cursor:pointer;" onclick="togglePublished('${projectId}','${proposalId}',${!prop.published})" title="${prop.published ? 'Click to unpublish from client' : 'Click to publish to client dashboard'}">
                  ${prop.published ? '<span class="badge-icon">✓</span>Published' : '○ Publish'}
                </span>
                <span class="badge ${getQbId(prop) ? 'badge-qb-synced' : 'badge-qb-pending'}" style="font-size:11px;padding:4px 12px;${getQbId(prop) ? '' : 'cursor:pointer;'}" ${getQbId(prop) ? 'title="QB #'+esc(String(getQbId(prop)))+'"' : 'title="Not yet synced to QuickBooks"'}>
                  ${getQbId(prop) ? '<span class="badge-icon">✓</span> Synced' : '○ QB Sync'}
                </span>
              </div>
