    // ==================== IMPORT TEAR SHEET (HOUZZ PDF → CLIPS) ====================
    let _tearImportData = null;
    let _tearImportProjectId = null;

    async function showImportTearSheetModal(projectId, projectName) {
      _tearImportProjectId = projectId;
      _tearImportData = null;

      document.getElementById('modalContainer').innerHTML = `
        <div class="modal-overlay" onclick="if(event.target===this)closeModal()">
          <div class="modal" style="width:740px;max-height:90vh;overflow-y:auto;">
