            ${procStatuses.map(st => {
              const count = procCounts[st];
              const color = procColors[st];
              const pct = Math.round(count / totalItems * 100);
              return `
                <div style="padding:16px 12px;background:${color}11;border:1px solid ${color}33;border-radius:0;text-align:center;">
