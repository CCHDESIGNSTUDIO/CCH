    }
    // Load saved theme
    (function() {
      const saved = localStorage.getItem('cch-theme');
      if (saved === 'classic') {
        document.documentElement.setAttribute('data-theme', 'classic');
        setTimeout(function() { updateThemeToggle('classic'); }, 0);
      }
    })();

    // ── Security: HTML escaping (must be at top) ──
    function esc(t) { if (t == null) return ''; const d = document.createElement('div'); d.textContent = String(t); return d.innerHTML; }
    function escAttr(t) { if (t == null) return ''; t = String(t); return t.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    // ── Team Configuration ──
    const ADMIN_EMAILS = ['cindy@cchdesign.com', 'cynthia@cchdesign.com', 'cynthiacbh@gmail.com'];
    const TEAM_CONFIG = {
      owner: { names: ['cynthia', 'cindy', 'holloway'], rate: 150, label: 'Cynthia Holloway' },
      contractors: [
        { names: ['vanessa'], rate: 75, label: 'Vanessa Holliday' }
      ]
    };
    const DEFAULT_CONTRACTOR_RATE = 75;
    function _isOwnerMember(memberStr) {
      var m = (memberStr || '').toLowerCase();
      return TEAM_CONFIG.owner.names.some(function(n) { return m.indexOf(n) >= 0; });
    }
    function _isContractorMember(memberStr) {
      var m = (memberStr || '').toLowerCase();
      return !_isOwnerMember(memberStr) && m !== '' && m !== 'unknown';
    }
    function _getContractorRate(memberStr) {
      var m = (memberStr || '').toLowerCase();
      for (var i = 0; i < TEAM_CONFIG.contractors.length; i++) {
        var c = TEAM_CONFIG.contractors[i];
        if (c.names.some(function(n) { return m.indexOf(n) >= 0; })) return c.rate;
      }
      return DEFAULT_CONTRACTOR_RATE;
    }
    function _getMemberRate(memberStr) {
      if (_isOwnerMember(memberStr)) return TEAM_CONFIG.owner.rate;
      return _getContractorRate(memberStr);
    }

    // ── Toast notification utility ──
    function showToast(msg, duration) {
      duration = duration || 3000;
      var existing = document.getElementById('cchToast');
      if (existing) existing.remove();
      var toast = document.createElement('div');
      toast.id = 'cchToast';
      toast.textContent = msg;
      toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#1C1C1E;color:#fff;padding:12px 24px;border-radius:0;font-size:13px;font-weight:600;z-index:99999;box-shadow:0 8px 24px rgba(0,0,0,0.25);border:1px solid rgba(196,160,82,0.3);transition:opacity 0.3s;';
      document.body.appendChild(toast);
      setTimeout(function() { toast.style.opacity = '0'; setTimeout(function() { toast.remove(); }, 300); }, duration);
    }

    // Upload image file to Firebase Storage, return download URL
    async function uploadImageToStorage(file, path) {
      if (!path) path = 'images/' + Date.now() + '-' + file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
      const ref = storage.ref(path);
      await ref.put(file);
      return await ref.getDownloadURL();
    }

    // Upload base64 data URL to Firebase Storage, return download URL
    async function uploadBase64ToStorage(dataUrl, path) {
      if (!path) path = 'images/' + Date.now() + '.jpg';
      const ref = storage.ref(path);
      await ref.putString(dataUrl, 'data_url');
      return await ref.getDownloadURL();
    }

    // ==================== UTILITY: formatMoney ====================
    function formatMoney(n) {
      return '$' + (parseFloat(n) || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // ==================== AUTO-NUMBERING SYSTEM ====================
    // Uses a Firestore counter doc to generate sequential numbers
    // Starting offsets: PRO-3000, INV-6000, PO-9000 (to avoid overlap with any existing docs)
    var _docNumberStartOffsets = { 'PRO': 2999, 'INV': 5999, 'PO': 8999 };

    async function getNextDocNumber(prefix) {
      // prefix: 'PRO', 'INV', 'PO'
      var counterDocId = 'docCounters';
      var counterField = prefix.toLowerCase() + 'Counter';
      var counterRef = db.collection('settings').doc(counterDocId);
      var startOffset = _docNumberStartOffsets[prefix] || 0;
      try {
        var result = await db.runTransaction(async function(transaction) {
          var doc = await transaction.get(counterRef);
          var current = 0;
          if (doc.exists && doc.data()[counterField]) {
            current = doc.data()[counterField];
          }
          // If counter hasn't been initialized yet, start from offset
          if (current < startOffset) {
            current = startOffset;
          }
          var next = current + 1;
          var update = {};
          update[counterField] = next;
          if (doc.exists) {
            transaction.update(counterRef, update);
          } else {
            transaction.set(counterRef, update, { merge: true });
          }
          return next;
        });
        return prefix + '-' + String(result);
      } catch(e) {
        console.warn('Counter transaction failed, using timestamp fallback:', e);
        return prefix + '-' + Date.now().toString().slice(-5);
      }
    }

    function formatDate(d) {
      if (!d) return '—';
      try {
        var dt = new Date(d);
        if (isNaN(dt.getTime())) return String(d);
        return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      } catch(e) { return String(d); }
    }

    function statusBadge(status) {
      const s = (status || 'Draft').toLowerCase();
      const classMap = {
        'draft':'badge-draft', 'sent':'badge-sent', 'approved':'badge-approved', 'declined':'badge-overdue',
        'paid':'badge-paid', 'overdue':'badge-overdue', 'partial':'badge-partial', 'partially paid':'badge-partial',
        'invoiced':'badge-invoiced', 'partially invoiced':'badge-ordered', 'open':'badge-sent',
        'ordered':'badge-ordered', 'received':'badge-received', 'installed':'badge-installed',
        'waiting for confirmation':'badge-waiting', 'waiting':'badge-waiting',
        'at receiver':'badge-atreceiver', 'at workroom':'badge-atworkroom',
        'cancelled':'badge-draft', 'on hold':'badge-atworkroom', 'closed':'badge-draft'
      };
      const cls = classMap[s] || 'badge-draft';
      return '<span class="badge ' + cls + '">' + esc(status||'Draft') + '</span>';
    }

    function publishedBadge(isPublished) {
      if (!isPublished) return '';
      return ' <span class="badge badge-published" style="font-size:10px;padding:2px 8px;border-radius:0;"><span class="badge-icon">✓</span>Published</span>';
    }

    function qbBadge(qbDocId) {
      if (!qbDocId) return ' <span class="badge badge-qb-pending" style="font-size:10px;padding:2px 8px;border-radius:0;" title="Not synced to QuickBooks">○ QB</span>';
      return ' <span class="badge badge-qb-synced" style="font-size:10px;padding:2px 8px;border-radius:0;" title="QB #' + esc(String(qbDocId)) + '"><span class="badge-icon">✓</span>QB</span>';
    }

    function qbCellBadge(qbDocId) {
      if (qbDocId) return '<span class="badge badge-qb-synced" style="font-size:10px;padding:3px 10px;border-radius:0;display:inline-flex;align-items:center;gap:4px;"><span style="width:8px;height:8px;background:#2E7D32;border-radius:50%;display:inline-block;"></span> QB</span>';
      return '<span style="font-size:10px;color:var(--gray-300);cursor:pointer;" title="Click to mark as synced to QB">○ QB</span>';
    }

    // Derive QB ID from doc data — Houzz docs already synced to QB
    function getQbId(doc) {
      if (doc.qbDocId) return doc.qbDocId;
      // Houzz proposals (PR-XXXXX), invoices (IN-XXXXX), POs (PO-XXXXX) were already QB synced
      const num = doc.proposalNum || doc.invoiceNum || doc.poNum || doc.number || '';
      if (/^(PR|IN|PO)-\d+/.test(num)) return num;
      if (doc._fromClips || doc.source === 'clip-derived') return num || null;
      return null;
    }

    function allBadges(item) {
      return '<div class="status-badges">' + statusBadge(item.status) + publishedBadge(item.published) + qbBadge(getQbId(item)) + '</div>';
    }

    // ==================== STATE ====================
    let currentUser = null;
    let currentPage = 'projects';
    let currentProjectId = null;
    let currentProjectTab = 'overview';
    let projects = [];

    // ==================== AUTH ====================
    auth.onAuthStateChanged(user => {
      if (user) {
        currentUser = user;
        document.getElementById('authScreen').style.display = 'none';
        document.getElementById('appShell').style.display = 'flex';
        document.getElementById('sidebarUser').textContent = user.email;
        // Hide admin-only nav items for non-admins
        const _isAdmin = ADMIN_EMAILS.includes((user.email || '').toLowerCase());
        if (!_isAdmin) {
          const ptNav = document.getElementById('navProfitTracker');
          if (ptNav) ptNav.style.display = 'none';
          const finNav = document.querySelector('[data-page="financials"]');
          if (finNav) finNav.style.display = 'none';
        }
        navigate(window.location.hash || '#/projects');
        // Background preload asset cache for instant Assets view
        setTimeout(function() { preloadAssetCache(); }, 3000);
      } else {
        currentUser = null;
        document.getElementById('authScreen').style.display = 'flex';
        document.getElementById('appShell').style.display = 'none';
      }
    });

    document.getElementById('authSubmit').addEventListener('click', signIn);
    document.getElementById('authPassword').addEventListener('keydown', e => { if (e.key === 'Enter') signIn(); });
    document.getElementById('logoutBtn').addEventListener('click', () => auth.signOut());

    async function signIn() {
      const email = document.getElementById('authEmail').value.trim();
      const pass = document.getElementById('authPassword').value;
      const err = document.getElementById('authError');
      err.style.display = 'none';
      try {
        await auth.signInWithEmailAndPassword(email, pass);
      } catch (e) {
        err.textContent = e.message.includes('invalid') ? 'Invalid email or password.' : e.message;
        err.style.display = 'block';
      }
    }

    // ==================== ROUTING ====================
    window.addEventListener('hashchange', () => navigate(window.location.hash));

    document.querySelectorAll('.nav-item').forEach(btn => {
      btn.addEventListener('click', () => navigate('#/' + btn.dataset.page));
    });

    function navigate(hash) {
      if (!currentUser) return;
      const parts = (hash || '#/projects').replace('#/', '').split('/');
      const page = parts[0] || 'projects';

      // Restore sidebar/topbar when leaving client view
      if (page !== 'clientview' && page !== 'clientboard') {
        const sb = document.querySelector('.sidebar');
        const tb = document.querySelector('.topbar');
        const mn = document.querySelector('.main');
        if (sb) sb.style.display = '';
        if (tb) tb.style.display = '';
        if (mn) { mn.style.marginLeft = ''; mn.style.maxWidth = ''; mn.style.margin = ''; mn.style.padding = ''; mn.style.paddingBottom = ''; }
        document.body.style.background = '';
      }

      // Update sidebar active
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      const activeNav = document.querySelector(`.nav-item[data-page="${page}"]`) ||
                        document.querySelector(`.nav-item[data-page="projects"]`);
      if (activeNav) activeNav.classList.add('active');

      window.location.hash = hash;

      if (page === 'dashboard') renderDashboard();
      else if (page === 'projects') renderProjectsList();
      else if (page === 'project') {
        currentProjectId = parts[1];
        currentProjectTab = parts[2] || 'overview';
        // Redirect old tab names to Communications
        if (currentProjectTab === 'updates' || currentProjectTab === 'milestones') currentProjectTab = 'comms';
        if (currentProjectTab === 'proposal' && parts[3]) {
          renderProposalDetail(parts[1], parts[3]);
        } else if (currentProjectTab === 'invoice' && parts[3]) {
          renderInvoiceDetail(parts[1], parts[3]);
        } else if (currentProjectTab === 'po' && parts[3]) {
          renderPODetail(parts[1], parts[3]);
        } else if (currentProjectTab === 'designboard' && parts[3]) {
          openDesignBoard(parts[1], parts[3]);
        } else {
          renderProjectDetail();
        }
      }
      else if (page === 'ideabooks') renderIdeabooksList();
      else if (page === 'ideabook') renderIdeabookDetail(parts[1], parts[2]);
      else if (page === 'library') renderProductLibrary();
      else if (page === 'timetracker') renderTimeTracker();
      else if (page === 'timereconciliation') { smartTimeTab = 'reconciliation'; renderTimeTracker(); }
      else if (page === 'timeledger') { smartTimeTab = 'ledger'; renderTimeTracker(); }
      else if (page === 'activity') renderActivityFeed();
      else if (page === 'reports') renderReportsPage();
      else if (page === 'schedule') renderGlobalSchedule();
      else if (page === 'financials') renderFinancials();
      else if (page === 'bizreports') renderBizReports();
      else if (page === 'clientview') renderClientView(parts[1]);
      else if (page === 'clientboard') openClientBoard(parts[1], parts[2]);
      else if (page === 'allproposals') renderAllProposals();
      else if (page === 'allinvoices') renderAllInvoices();
      else if (page === 'allpos') renderAllPOs();
      else if (page === 'profittracker') renderProfitTracker();
      else if (page === 'clients') renderClients();
      else if (page === 'vendors') {
        if (parts[1]) showVendorDetail(decodeURIComponent(parts[1]));
        else renderVendors();
      }
      else if (page === 'workrooms') renderWorkrooms();
      else if (page === 'deliveryreceivers') renderDeliveryReceivers();
      else renderProjectsList();
    }

    // ==================== BREADCRUMB ====================
    function setBreadcrumb(crumbs) {
      const el = document.getElementById('breadcrumb');
      el.innerHTML = crumbs.map((c, i) => {
        if (i === crumbs.length - 1) return `<span class="breadcrumb-current">${esc(c.label)}</span>`;
        return `<button class="breadcrumb-link" onclick="navigate('${c.hash}')">${esc(c.label)}</button><span class="breadcrumb-sep">›</span>`;
      }).join('');
    }

    function setTopbarActions(html) {
      document.getElementById('topbarActions').innerHTML = html;
    }

    // ==================== GLOBAL SEARCH ====================
    let searchCache = null;
    let searchOpen = false;

    // Cmd+K / Ctrl+K shortcut
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openGlobalSearch(); }
      if (e.key === 'Escape' && searchOpen) closeGlobalSearch();
    });

    async function buildSearchCache() {
      if (searchCache) return searchCache;
      const projSnap = await db.collection('boards').get();
      const cache = { projects: [], invoices: [], proposals: [], pos: [], clips: [], loaded: false };
      const projNames = {};
      projSnap.forEach(d => {
        const data = d.data();
        const name = data.name || d.id;
        projNames[d.id] = name;
        cache.projects.push({ id: d.id, name, status: data.status || 'In Progress', clipCount: data.clipCount || 0, clientName: data.clientName || '' });
      });
      searchCache = cache;
      // Load subcollections in background (limit to projects with data)
      const projIds = Object.keys(projNames);
      const loadBatch = async (pids) => {
        await Promise.all(pids.map(async pid => {
          try {
            const invs = await db.collection('boards').doc(pid).collection('invoices').get();
            invs.forEach(d => { const data = d.data(); cache.invoices.push({ id: d.id, projectId: pid, projectName: projNames[pid], num: data.invoiceNum || data.number || d.id, status: data.status || 'Draft', total: parseFloat(data.total) || 0, date: data.date || data.createdAt || '' }); });
          } catch(e) {}
          try {
            const props = await db.collection('boards').doc(pid).collection('proposals').get();
            props.forEach(d => { const data = d.data(); cache.proposals.push({ id: d.id, projectId: pid, projectName: projNames[pid], name: data.name || data.proposalNum || data.number || d.id, status: data.status || 'Draft', total: parseFloat(data.total) || 0, date: data.date || data.createdAt || '', items: data.items || [] }); });
          } catch(e) {}
          try {
            const clps = await db.collection('boards').doc(pid).collection('clips').limit(50).get();
            clps.forEach(d => { const data = d.data(); cache.clips.push({ id: d.id, projectId: pid, projectName: projNames[pid], title: data.title || '', vendor: data.vendor || '', manufacturer: data.manufacturer || '', category: data.category || '', room: data.room || '', sku: data.sku || '', description: data.description || '', cost: parseFloat(data.cost) || 0, clientPrice: parseFloat(data.clientPrice) || 0, imageUrl: data.imageUrl || '' }); });
          } catch(e) {}
        }));
      };
      // Load in batches of 8 projects at a time to avoid rate limits
      for (let i = 0; i < projIds.length; i += 8) {
        loadBatch(projIds.slice(i, i + 8));
      }
      cache.loaded = true;
      return cache;
    }

    function invalidateSearchCache() { searchCache = null; }

    function openGlobalSearch() {
      searchOpen = true;
      const overlay = document.createElement('div');
      overlay.className = 'search-overlay';
      overlay.id = 'globalSearchOverlay';
      overlay.onclick = (e) => { if (e.target === overlay) closeGlobalSearch(); };
      overlay.innerHTML = `
        <div class="search-modal">
          <div class="search-input-wrap">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input class="search-input" id="globalSearchInput" placeholder="Search projects, invoices, POs, items, vendors, amounts..." autofocus>
            <button class="search-close" onclick="closeGlobalSearch()">&times;</button>
          </div>
          <div class="search-results" id="globalSearchResults">
            <div class="search-empty">Start typing to search across all projects...</div>
          </div>
          <div class="search-hint">
            <span><kbd>↑↓</kbd> Navigate</span>
            <span><kbd>Enter</kbd> Open</span>
            <span><kbd>Esc</kbd> Close</span>
          </div>
        </div>
      `;
      document.body.appendChild(overlay);
      const input = document.getElementById('globalSearchInput');
      input.focus();
      let debounce = null;
      input.addEventListener('input', () => {
        clearTimeout(debounce);
        debounce = setTimeout(() => runGlobalSearch(input.value.trim()), 200);
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          const items = document.querySelectorAll('.search-item');
          const active = document.querySelector('.search-item.active');
          let idx = active ? [...items].indexOf(active) : -1;
          if (active) active.classList.remove('active');
          idx = e.key === 'ArrowDown' ? Math.min(idx + 1, items.length - 1) : Math.max(idx - 1, 0);
          if (items[idx]) { items[idx].classList.add('active'); items[idx].scrollIntoView({ block: 'nearest' }); }
        }
        if (e.key === 'Enter') {
          const active = document.querySelector('.search-item.active') || document.querySelector('.search-item');
          if (active) active.click();
        }
      });
      // Pre-build cache in background
      buildSearchCache();
    }

    function closeGlobalSearch() {
      searchOpen = false;
      const el = document.getElementById('globalSearchOverlay');
      if (el) el.remove();
    }

    async function runGlobalSearch(query) {
      const R = document.getElementById('globalSearchResults');
      if (!query || query.length < 1) { R.innerHTML = '<div class="search-empty">Start typing to search across all projects...</div>'; return; }
      R.innerHTML = '<div class="search-empty" style="color:var(--gold);">Searching...</div>';
      const cache = await buildSearchCache();
      const q = query.toLowerCase();
      const qNum = parseFloat(query.replace(/[$,]/g, ''));
      let html = '';

      // Search projects
      const projMatches = cache.projects.filter(p => p.name.toLowerCase().includes(q) || p.id.includes(q));
      if (projMatches.length > 0) {
        html += '<div class="search-section"><div class="search-section-title">Projects (' + projMatches.length + ')</div>';
        projMatches.slice(0, 5).forEach(p => {
          html += '<div class="search-item" onclick="closeGlobalSearch();navigate(\'#/project/' + p.id + '\')">' +
            '<div class="search-item-icon clip">📁</div>' +
            '<div class="search-item-body"><div class="search-item-title">' + esc(p.name) + '</div><div class="search-item-sub">' + p.clipCount + ' items • ' + p.status + '</div></div></div>';
        });
        html += '</div>';
      }

      // Search invoices
      const invMatches = cache.invoices.filter(i =>
        i.num.toLowerCase().includes(q) || i.projectName.toLowerCase().includes(q) || i.status.toLowerCase().includes(q) ||
        (!isNaN(qNum) && Math.abs(i.total - qNum) < 1)
      );
      if (invMatches.length > 0) {
        html += '<div class="search-section"><div class="search-section-title">Invoices (' + invMatches.length + ')</div>';
        invMatches.slice(0, 8).forEach(i => {
          const sColor = i.status === 'Paid' ? 'var(--green)' : i.status === 'Sent' ? 'var(--gold)' : 'var(--gray-400)';
          html += '<div class="search-item" onclick="closeGlobalSearch();navigate(\'#/project/' + i.projectId + '/invoices\')">' +
            '<div class="search-item-icon inv">💰</div>' +
            '<div class="search-item-body"><div class="search-item-title">' + esc(i.num) + '</div><div class="search-item-sub">' + esc(i.projectName) + ' • ' + esc(i.date) + '</div></div>' +
            '<div class="search-item-right"><div class="search-item-amount">$' + i.total.toLocaleString('en-US',{minimumFractionDigits:2}) + '</div><div class="search-item-badge" style="color:' + sColor + '">' + esc(i.status) + '</div></div></div>';
        });
        html += '</div>';
      }

      // Search proposals
      const propMatches = cache.proposals.filter(p =>
        p.name.toLowerCase().includes(q) || p.projectName.toLowerCase().includes(q) || p.status.toLowerCase().includes(q) ||
        (!isNaN(qNum) && Math.abs(p.total - qNum) < 1) ||
        p.items.some(it => (it.title||'').toLowerCase().includes(q) || (it.vendor||'').toLowerCase().includes(q))
      );
      if (propMatches.length > 0) {
        html += '<div class="search-section"><div class="search-section-title">Proposals (' + propMatches.length + ')</div>';
        propMatches.slice(0, 8).forEach(p => {
          html += '<div class="search-item" onclick="closeGlobalSearch();navigate(\'#/project/' + p.projectId + '/proposal/' + p.id + '\')">' +
            '<div class="search-item-icon prop">📋</div>' +
            '<div class="search-item-body"><div class="search-item-title">' + esc(p.name) + '</div><div class="search-item-sub">' + esc(p.projectName) + ' • ' + (p.items||[]).length + ' items</div></div>' +
            '<div class="search-item-right"><div class="search-item-amount">$' + p.total.toLocaleString('en-US',{minimumFractionDigits:2}) + '</div><div class="search-item-badge">' + esc(p.status) + '</div></div></div>';
        });
        html += '</div>';
      }

      // Search POs
      const poMatches = cache.pos.filter(p =>
        p.num.toLowerCase().includes(q) || p.vendor.toLowerCase().includes(q) || p.projectName.toLowerCase().includes(q) ||
        p.status.toLowerCase().includes(q) || (!isNaN(qNum) && Math.abs(p.total - qNum) < 1)
      );
      if (poMatches.length > 0) {
        html += '<div class="search-section"><div class="search-section-title">Purchase Orders (' + poMatches.length + ')</div>';
        poMatches.slice(0, 8).forEach(p => {
          html += '<div class="search-item" onclick="closeGlobalSearch();navigate(\'#/project/' + p.projectId + '/pos\')">' +
            '<div class="search-item-icon po">📦</div>' +
            '<div class="search-item-body"><div class="search-item-title">' + esc(p.num) + '</div><div class="search-item-sub">' + esc(p.vendor || p.projectName) + ' • ' + esc(p.projectName) + '</div></div>' +
            '<div class="search-item-right"><div class="search-item-amount">$' + p.total.toLocaleString('en-US',{minimumFractionDigits:2}) + '</div><div class="search-item-badge">' + esc(p.status) + '</div></div></div>';
        });
        html += '</div>';
      }

      // Search products/clips
      const clipMatches = cache.clips.filter(c =>
        c.title.toLowerCase().includes(q) || c.vendor.toLowerCase().includes(q) || c.manufacturer.toLowerCase().includes(q) ||
        c.category.toLowerCase().includes(q) || c.room.toLowerCase().includes(q) || c.sku.toLowerCase().includes(q) ||
        c.description.toLowerCase().includes(q) || c.projectName.toLowerCase().includes(q) ||
        (!isNaN(qNum) && (Math.abs(c.clientPrice - qNum) < 1 || Math.abs(c.cost - qNum) < 1))
      );
      if (clipMatches.length > 0) {
        html += '<div class="search-section"><div class="search-section-title">Products (' + clipMatches.length + ')</div>';
        clipMatches.slice(0, 10).forEach(c => {
          const imgTag = c.imageUrl ? '<img src="' + escAttr(c.imageUrl) + '" style="width:32px;height:32px;border-radius:4px;object-fit:cover;" onerror="this.style.display=\'none\'">' : '';
          html += '<div class="search-item" onclick="closeGlobalSearch();navigate(\'#/project/' + c.projectId + '/boards\')">' +
            '<div class="search-item-icon" style="padding:0;">' + (imgTag || '🛋️') + '</div>' +
            '<div class="search-item-body"><div class="search-item-title">' + esc(c.title) + '</div><div class="search-item-sub">' + esc(c.projectName) + (c.vendor ? ' • ' + esc(c.vendor) : '') + (c.room ? ' • ' + esc(c.room) : '') + '</div></div>' +
            (c.clientPrice ? '<div class="search-item-right"><div class="search-item-amount">$' + c.clientPrice.toLocaleString('en-US',{minimumFractionDigits:2}) + '</div><div class="search-item-badge">' + esc(c.category) + '</div></div>' : '') + '</div>';
        });
        html += '</div>';
      }

      if (!html) html = '<div class="search-empty">No results for "' + esc(query) + '"</div>';
      R.innerHTML = html;
    }

    // ==================== SORT/FILTER HELPERS ====================
    function sortFilterToolbar(pageType, state) {
      const projectOpts = (state.projects || []).map(p => '<option value="' + esc(p.id) + '"' + (state.filterProject === p.id ? ' selected' : '') + '>' + esc(p.name) + '</option>').join('');
      const vendorOpts = pageType === 'pos' ? (state.vendors || []).map(v => '<option value="' + esc(v) + '"' + (state.filterVendor === v ? ' selected' : '') + '>' + esc(v) + '</option>').join('') : '';
      const statusOpts = (state.statuses || []).map(s => '<option value="' + esc(s) + '"' + (state.filterStatus === s ? ' selected' : '') + '>' + esc(s) + '</option>').join('');
      const renderFn = pageType==='pos'?'AllPOs':pageType==='invoices'?'AllInvoices':'AllProposals';
      const resetPage = pageType + 'Page=1;';

      return '<div class="sort-toolbar">' +
        '<div class="filter-group"><label>Project</label><select onchange="' + pageType + 'FilterProject=this.value;' + resetPage + 'render' + renderFn + '()"><option value="">All Projects</option>' + projectOpts + '</select></div>' +
        (pageType === 'pos' ? '<div class="filter-group"><label>Vendor</label><select onchange="' + pageType + 'FilterVendor=this.value;' + resetPage + 'renderAllPOs()"><option value="">All Vendors</option>' + vendorOpts + '</select></div>' : '') +
        '<div class="filter-group"><label>Status</label><select onchange="' + pageType + 'FilterStatus=this.value;' + resetPage + 'render' + renderFn + '()"><option value="">All Statuses</option>' + statusOpts + '</select></div>' +
        '<div class="filter-group" style="margin-left:auto;"><label>Sort</label>' +
        '<button class="sort-btn' + (state.sortBy==='date'?' active':'') + '" onclick="' + pageType + 'SortBy=\'date\';' + resetPage + 'render' + renderFn + '()">Date</button>' +
        '<button class="sort-btn' + (state.sortBy==='number'?' active':'') + '" onclick="' + pageType + 'SortBy=\'number\';' + resetPage + 'render' + renderFn + '()">Number</button>' +
        '<button class="sort-btn' + (state.sortBy==='amount'?' active':'') + '" onclick="' + pageType + 'SortBy=\'amount\';' + resetPage + 'render' + renderFn + '()">Amount</button>' +
        '<button class="sort-btn' + (state.sortBy==='project'?' active':'') + '" onclick="' + pageType + 'SortBy=\'project\';' + resetPage + 'render' + renderFn + '()">Project</button>' +
        '</div>' +
        '<div class="filter-group"><input type="text" placeholder="Filter by keyword..." value="' + esc(state.keyword||'') + '" oninput="' + pageType + 'Keyword=this.value;clearTimeout(' + pageType + 'Debounce);' + pageType + 'Debounce=setTimeout(()=>{' + resetPage + 'render' + renderFn + '()},300)"></div>' +
      '</div>';
    }

    // Filter/sort state for each page
    let proposalsFilterProject='', proposalsFilterStatus='', proposalsSortBy='date', proposalsSortDir='desc', proposalsKeyword='', proposalsDebounce=null;
    let invoicesFilterProject='', invoicesFilterStatus='', invoicesSortBy='date', invoicesSortDir='desc', invoicesKeyword='', invoicesDebounce=null;
    let posFilterProject='', posFilterVendor='', posFilterStatus='', posSortBy='date', posSortDir='desc', posKeyword='', posDebounce=null;
    let proposalsPage=1, invoicesPage=1, posPage=1;
    const PAGE_SIZE = 50;

    function paginationBar(totalItems, currentPage, pageType) {
      var totalPages = Math.ceil(totalItems / PAGE_SIZE);
      if (totalPages <= 1) return '';
      var start = (currentPage - 1) * PAGE_SIZE + 1;
      var end = Math.min(currentPage * PAGE_SIZE, totalItems);
      var html = '<div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-top:1px solid var(--gray-200);font-size:12px;color:var(--gray-500);">';
      html += '<div>Showing ' + start + '–' + end + ' of ' + totalItems + '</div>';
      html += '<div style="display:flex;gap:4px;align-items:center;">';
      if (currentPage > 1) {
        html += '<button class="btn btn-sm" style="padding:4px 10px;" onclick="' + pageType + 'Page=1;render' + (pageType === 'pos' ? 'AllPOs' : pageType === 'invoices' ? 'AllInvoices' : 'AllProposals') + '()">«</button>';
        html += '<button class="btn btn-sm" style="padding:4px 10px;" onclick="' + pageType + 'Page--;render' + (pageType === 'pos' ? 'AllPOs' : pageType === 'invoices' ? 'AllInvoices' : 'AllProposals') + '()">‹ Prev</button>';
      }
      // Page numbers
      var startPage = Math.max(1, currentPage - 2);
      var endPage = Math.min(totalPages, currentPage + 2);
      for (var p = startPage; p <= endPage; p++) {
        html += '<button class="btn btn-sm" style="padding:4px 10px;' + (p === currentPage ? 'background:var(--gold);color:white;font-weight:700;' : '') + '" onclick="' + pageType + 'Page=' + p + ';render' + (pageType === 'pos' ? 'AllPOs' : pageType === 'invoices' ? 'AllInvoices' : 'AllProposals') + '()">' + p + '</button>';
      }
      if (currentPage < totalPages) {
        html += '<button class="btn btn-sm" style="padding:4px 10px;" onclick="' + pageType + 'Page++;render' + (pageType === 'pos' ? 'AllPOs' : pageType === 'invoices' ? 'AllInvoices' : 'AllProposals') + '()">Next ›</button>';
        html += '<button class="btn btn-sm" style="padding:4px 10px;" onclick="' + pageType + 'Page=' + totalPages + ';render' + (pageType === 'pos' ? 'AllPOs' : pageType === 'invoices' ? 'AllInvoices' : 'AllProposals') + '()">»</button>';
      }
      html += '</div></div>';
      return html;
    }

    // Project-level tab sorting
    let projTabSort = { field: 'date', dir: 'desc' };
    function projTabSortBy(field) {
      if (projTabSort.field === field) projTabSort.dir = projTabSort.dir === 'desc' ? 'asc' : 'desc';
      else { projTabSort.field = field; projTabSort.dir = field === 'total' ? 'desc' : 'asc'; }
      renderProjectDetail();
    }
    function projSortArrow(field) {
      if (projTabSort.field !== field) return '';
      return projTabSort.dir === 'asc' ? ' ▲' : ' ▼';
    }
    function projSortItems(arr, type) {
      const f = projTabSort.field, d = projTabSort.dir === 'asc' ? 1 : -1;
      return [...arr].sort((a,b) => {
        if (f === 'number') return d * (a.invoiceNum||a.number||a.proposalNum||a.name||a.num||'').localeCompare(b.invoiceNum||b.number||b.proposalNum||b.name||b.num||'');
        if (f === 'date') return d * (a.dueDate||a.date||a.createdAt||'').localeCompare(b.dueDate||b.date||b.createdAt||'');
        if (f === 'total') return d * ((parseFloat(a.total)||0) - (parseFloat(b.total)||0));
        if (f === 'status') return d * (a.status||'').localeCompare(b.status||'');
        if (f === 'vendor') return d * (a.vendor||'').localeCompare(b.vendor||'');
        if (f === 'items') return d * ((a.items||[]).length - (b.items||[]).length);
        if (f === 'balance') {
          const ab = (parseFloat(a.total)||0) - (a.payments||[]).reduce((s,p)=>s+(parseFloat(p.amount)||0),0);
          const bb = (parseFloat(b.total)||0) - (b.payments||[]).reduce((s,p)=>s+(parseFloat(p.amount)||0),0);
          return d * (ab - bb);
        }
        if (f === 'published') return d * ((a.published?1:0)-(b.published?1:0));
        if (f === 'shipTo') return d * (a.shipTo||a.deliverTo||a.receiver||'').localeCompare(b.shipTo||b.deliverTo||b.receiver||'');
        if (f === 'qb') return d * ((getQbId(a)?1:0)-(getQbId(b)?1:0));
        if (f === 'client') return d * (a.client||a.clientName||'').localeCompare(b.client||b.clientName||'');
        return 0;
      });
    }

    function sortByField(field, pageType) {
      if (pageType === 'proposals') {
        if (proposalsSortBy === field) proposalsSortDir = proposalsSortDir === 'desc' ? 'asc' : 'desc';
        else { proposalsSortBy = field; proposalsSortDir = field === 'amount' ? 'desc' : 'asc'; }
        proposalsPage = 1;
        renderAllProposals();
      } else if (pageType === 'invoices') {
        if (invoicesSortBy === field) invoicesSortDir = invoicesSortDir === 'desc' ? 'asc' : 'desc';
        else { invoicesSortBy = field; invoicesSortDir = field === 'amount' ? 'desc' : 'asc'; }
        invoicesPage = 1;
        renderAllInvoices();
      } else {
        if (posSortBy === field) posSortDir = posSortDir === 'desc' ? 'asc' : 'desc';
        else { posSortBy = field; posSortDir = field === 'amount' ? 'desc' : 'asc'; }
        posPage = 1;
        renderAllPOs();
      }
    }

    function sortArrow(field, pageType) {
      let cur, dir;
      if (pageType === 'proposals') { cur = proposalsSortBy; dir = proposalsSortDir; }
      else if (pageType === 'invoices') { cur = invoicesSortBy; dir = invoicesSortDir; }
      else { cur = posSortBy; dir = posSortDir; }
      if (cur !== field) return '';
      return dir === 'asc' ? ' ▲' : ' ▼';
    }

    function applySortFilter(items, pageType) {
      let filterProject, filterStatus, filterVendor, sortBy, keyword, sortDir;
      if (pageType === 'proposals') { filterProject=proposalsFilterProject; filterStatus=proposalsFilterStatus; sortBy=proposalsSortBy; keyword=proposalsKeyword; sortDir=proposalsSortDir; }
      else if (pageType === 'invoices') { filterProject=invoicesFilterProject; filterStatus=invoicesFilterStatus; sortBy=invoicesSortBy; keyword=invoicesKeyword; sortDir=invoicesSortDir; }
      else { filterProject=posFilterProject; filterStatus=posFilterStatus; filterVendor=posFilterVendor; sortBy=posSortBy; keyword=posKeyword; sortDir=posSortDir; }

      let filtered = [...items];
      if (filterProject) filtered = filtered.filter(i => i.projectId === filterProject);
      if (filterStatus) filtered = filtered.filter(i => (i.status||'Draft') === filterStatus);
      if (filterVendor) filtered = filtered.filter(i => (i.vendor||'') === filterVendor);
      if (keyword) {
        const kw = keyword.toLowerCase();
        filtered = filtered.filter(i => {
          const searchable = [i.name, i.number, i.num, i.invoiceNum, i.vendor, i.projectName, i.status, String(i.total)].filter(Boolean).join(' ').toLowerCase();
          return searchable.includes(kw);
        });
      }

      const dir = sortDir === 'asc' ? 1 : -1;
      filtered.sort((a, b) => {
        if (sortBy === 'date') return dir * (a.createdAt||a.date||'').localeCompare(b.createdAt||b.date||'');
        if (sortBy === 'number') return dir * (a.number||a.num||a.name||a.invoiceNum||a.proposalNum||'').localeCompare(b.number||b.num||b.name||b.invoiceNum||b.proposalNum||'');
        if (sortBy === 'amount') return dir * ((parseFloat(a.total)||0) - (parseFloat(b.total)||0));
        if (sortBy === 'project') return dir * (a.projectName||'').localeCompare(b.projectName||'');
        if (sortBy === 'status') return dir * (a.status||'').localeCompare(b.status||'');
        if (sortBy === 'vendor') return dir * (a.vendor||'').localeCompare(b.vendor||'');
        if (sortBy === 'published') return dir * ((a.published?1:0) - (b.published?1:0));
        if (sortBy === 'datePaid') { const ap = a.datePaid||a.paidAt||''; const bp = b.datePaid||b.paidAt||''; return dir * ap.localeCompare(bp); }
        if (sortBy === 'balance') { const ab = a._balance != null ? a._balance : (parseFloat(a.total)||0); const bb = b._balance != null ? b._balance : (parseFloat(b.total)||0); return dir * (ab - bb); }
        if (sortBy === 'qb') { const aq = a.qbDocId||''; const bq = b.qbDocId||''; return dir * (aq?1:0) - (bq?1:0); }
        if (sortBy === 'eta') return dir * (a.eta||'').localeCompare(b.eta||'');
        if (sortBy === 'workroom') return dir * (a.workroom||'').localeCompare(b.workroom||'');
        if (sortBy === 'receiver') return dir * (a.receiver||'').localeCompare(b.receiver||'');
        return 0;
      });
      return filtered;
    }

    // ==================== DASHBOARD ====================
    // Dashboard view toggle — lets owner see contractor dashboard
    window._dashboardView = window._dashboardView || 'owner';
    window.toggleDashboardView = function(view) {
      window._dashboardView = view;
      renderDashboard();
    };

    async function renderDashboard() {
      setBreadcrumb([{ label: 'Dashboard' }]);
      setTopbarActions('');
      const C = document.getElementById('contentArea');
      C.innerHTML = '<div style="text-align:center;padding:60px;color:var(--gray-400);">Loading dashboard...</div>';

      const isOwner = currentUser && ADMIN_EMAILS.includes((currentUser.email || '').toLowerCase());
      const showOwnerView = isOwner && window._dashboardView === 'owner';

      // Load all projects
      const snap = await db.collection('boards').get();
      const allProjects = [];
      snap.forEach(d => allProjects.push({ id: d.id, ...d.data() }));
      allProjects.sort((a, b) => (b.updatedAt || '') > (a.updatedAt || '') ? 1 : -1);
      const active = allProjects.filter(p => p.status !== 'Completed');

      // Load invoices, POs, and proposals across projects
      let allInvoices = [], allPOs = [], allProposals = [];
      await Promise.all(allProjects.slice(0, 20).map(async p => {
        try {
          const invSnap = await db.collection('boards').doc(p.id).collection('invoices').get();
          invSnap.forEach(d => allInvoices.push({ id: d.id, projectId: p.id, projectName: p.name, ...d.data() }));
        } catch(e) {}
        try {
          const poSnap = await db.collection('boards').doc(p.id).collection('purchaseOrders').get();
          poSnap.forEach(d => allPOs.push({ id: d.id, projectId: p.id, projectName: p.name, ...d.data() }));
        } catch(e) {}
        try {
          const prSnap = await db.collection('boards').doc(p.id).collection('proposals').get();
          prSnap.forEach(d => allProposals.push({ id: d.id, projectId: p.id, projectName: p.name, ...d.data() }));
        } catch(e) {}
      }));

      // Load time entries
      let _allTimeEntries = [];
      try {
        const teSnap = await db.collection('timeEntries').limit(500).get();
        teSnap.forEach(d => _allTimeEntries.push({ id: d.id, ...d.data() }));
      } catch(e) {}
      const memberName = currentMemberName();

      // When owner views contractor dashboard, show Vanessa's data
      let myTimeEntries = _allTimeEntries;
      if (isOwner && window._dashboardView === 'contractor') {
        myTimeEntries = _allTimeEntries.filter(t => _isContractorMember(t.member || t.user || ''));
      } else if (memberName) {
        myTimeEntries = _allTimeEntries.filter(t => (t.member || '') === memberName);
      }

      // Load room covers for project thumbnails
      let roomCovers = {};
      for (const p of active.slice(0, 12)) {
        try {
          const rmSnap = await db.collection('boards').doc(p.id).collection('roomMeta').limit(1).get();
          rmSnap.forEach(d => { const rm = d.data(); if (rm.coverImage) roomCovers[p.id] = rm.coverImage; });
        } catch(e) {}
        if (!roomCovers[p.id]) {
          try {
            const clSnap = await db.collection('boards').doc(p.id).collection('clips').limit(5).get();
            clSnap.forEach(d => { if (!roomCovers[p.id]) { const c = d.data(); if (c.imageUrl && !c.imageUrl.startsWith('data:')) roomCovers[p.id] = c.imageUrl; } });
          } catch(e) {}
        }
      }

      // ── Calculate last activity date per project ──
      const projectActivity = {};
      function trackDate(projId, dateVal) {
        if (!dateVal) return;
        let d = '';
        if (typeof dateVal === 'string') d = dateVal.slice(0, 10);
        else if (dateVal.toDate) d = dateVal.toDate().toISOString().slice(0, 10);
        else if (dateVal instanceof Date) d = dateVal.toISOString().slice(0, 10);
        if (d && (!projectActivity[projId] || d > projectActivity[projId])) projectActivity[projId] = d;
      }
      allInvoices.forEach(i => { trackDate(i.projectId, i.date || i.createdAt || i.invoiceDate); });
      allPOs.forEach(po => { trackDate(po.projectId, po.date || po.createdAt || po.orderDate); });
      allProposals.forEach(pr => { trackDate(pr.projectId, pr.date || pr.createdAt); });
      myTimeEntries.forEach(t => {
        // Map time entry project name back to project ID
        const matched = allProjects.find(p => (p.name || p.id) === (t.project || t.projectName));
        if (matched) trackDate(matched.id, t.date);
      });

      // Split into current (activity in last 90 days) vs older
      const today = new Date();
      const cutoffDate = new Date(today); cutoffDate.setDate(cutoffDate.getDate() - 90);
      const cutoffStr = cutoffDate.toISOString().slice(0, 10);
      const currentProjects = active.filter(p => projectActivity[p.id] && projectActivity[p.id] >= cutoffStr);
      currentProjects.sort((a, b) => (projectActivity[b.id] || '') > (projectActivity[a.id] || '') ? 1 : -1);
      const olderProjects = active.filter(p => !projectActivity[p.id] || projectActivity[p.id] < cutoffStr);

      // Financial calcs
      const totalInvoiced = allInvoices.reduce((s, i) => s + (parseFloat(i.total || i.amount) || 0), 0);
      const totalCollected = allInvoices.filter(i => i.status === 'Paid').reduce((s, i) => s + (parseFloat(i.total || i.amount) || 0), 0);
      const totalOutstanding = totalInvoiced - totalCollected;
      const totalPOCost = allPOs.reduce((s, po) => {
        let t = parseFloat(po.total || po.amount) || 0;
        if (!t && po.items) t = po.items.reduce((s2,i) => s2 + (parseFloat(i.total || i.amount) || 0), 0);
