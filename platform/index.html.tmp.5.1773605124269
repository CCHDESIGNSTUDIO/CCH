    async function convertProposalToInvoice(projectId, proposalId) {
      if (!confirm('Create a new Invoice from this Proposal? Items will be copied.')) return;
      try {
        const propDoc = await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).get();
        if (!propDoc.exists) { alert('Proposal not found'); return; }
        const prop = propDoc.data();
        const items = (prop.items || []).map(item => ({
          ...item,
          amount: item.amount || item.totalSelling || item.lineTotal || 0
        }));
        const total = items.reduce((s,i) => s + (parseFloat(i.amount)||0), 0);
        const invNum = await getNextDocNumber('INV');

        var _cUser = (currentUser && currentUser.displayName) || (currentUser && currentUser.email) || 'Unknown';
        const invRef = await db.collection('boards').doc(projectId).collection('invoices').add({
          invoiceNum: invNum, number: invNum,
          status: 'Draft', total, items,
          vendor: prop.vendor || '', documentTags: prop.documentTags || prop.tags || prop.vendor || '',
          clientName: prop.clientName || '', clientEmail: prop.clientEmail || '',
          taxRate: prop.taxRate || 0,
          linkedProposalId: proposalId,
          createdAt: new Date().toISOString(), date: new Date().toISOString().split('T')[0],
          payments: [],
          createdBy: _cUser,
          createdByEmail: (currentUser && currentUser.email) || '',
          activityLog: [{ action: 'created_from_proposal', details: 'From: ' + (prop.name || 'Proposal'), userName: _cUser, userEmail: (currentUser && currentUser.email) || '', timestamp: new Date().toISOString() }]
        });

        // Update proposal with link back
        await db.collection('boards').doc(projectId).collection('proposals').doc(proposalId).update({
          status: 'Invoiced', linkedInvoiceId: invRef.id
        });
        logDocActivity(projectId, 'proposals', proposalId, 'converted', 'Converted to Invoice ' + invNum);

        alert('Invoice ' + invNum + ' created with ' + items.length + ' items!');
        _cacheTime = 0;
        navigate('#/project/' + projectId + '/invoice/' + invRef.id);
      } catch(e) { console.error('Convert failed:', e); alert('Error: ' + e.message); }
    }

    async function generatePOsFromDoc(projectId, collection, docId) {
      // Load the source document
      let items = [];
      try {
        if (_docEdit && _docEdit.docId === docId) {
          items = JSON.parse(JSON.stringify(_docEdit.items));
        } else {
          const doc = await db.collection('boards').doc(projectId).collection(collection).doc(docId).get();
          if (doc.exists) items = doc.data().items || [];
        }
      } catch(e) { alert('Failed to load document'); return; }

      if (items.length === 0) { alert('No items to generate POs from'); return; }

      // Group items by vendor
      const vendorGroups = {};
      items.forEach(item => {
        const vendor = (item.vendor || 'No Vendor').trim();
        if (!vendorGroups[vendor]) vendorGroups[vendor] = [];
        vendorGroups[vendor].push(item);
      });

      const vendors = Object.keys(vendorGroups);
      if (vendors.length === 0) { alert('No vendors found on items'); return; }

      // Show confirmation with vendor breakdown
      let msg = 'Generate POs for ' + vendors.length + ' vendor' + (vendors.length > 1 ? 's' : '') + ':\n\n';
      vendors.forEach(v => {
        const vitems = vendorGroups[v];
        const vtotal = vitems.reduce((s,i) => s + (parseFloat(i.cost || i.totalCost || 0) * (parseFloat(i.qty) || 1)), 0);
        msg += '• ' + v + ' — ' + vitems.length + ' items ($' + vtotal.toFixed(2) + ' cost)\n';
      });
      msg += '\nCreate these Purchase Orders?';

      if (!confirm(msg)) return;

      try {
        const created = [];
        for (const vendor of vendors) {
          const vitems = vendorGroups[vendor];
          const poNum = await getNextDocNumber('PO');
          const totalCost = vitems.reduce((s,i) => s + ((parseFloat(i.cost || i.totalCost || 0)) * (parseFloat(i.qty) || 1)), 0);
          const totalSell = vitems.reduce((s,i) => s + (parseFloat(i.amount || i.totalSelling || i.clientPrice || 0)), 0);

          const poItems = vitems.map(item => ({
            title: item.title || item.name || '',
            description: item.description || '',
            vendor: vendor,
            room: item.room || item.category || '',
            qty: item.qty || 1,
            cost: parseFloat(item.cost || item.totalCost || 0),
            unitCost: parseFloat(item.cost || item.totalCost || 0) / (parseFloat(item.qty) || 1),
            clientPrice: parseFloat(item.amount || item.totalSelling || item.clientPrice || 0),
            imageUrl: item.imageUrl || null,
            markupPct: item.markupPct || 0,
            shipping: item.shipping || 0
          }));

          var _cUser = (currentUser && currentUser.displayName) || (currentUser && currentUser.email) || 'Unknown';
          await db.collection('boards').doc(projectId).collection('purchaseOrders').add({
            number: poNum, poNum: poNum, vendor: vendor,
            status: 'Draft', total: totalCost, totalSelling: totalSell,
            items: poItems,
            linkedInvoiceId: collection === 'invoices' ? docId : null,
            linkedProposalId: collection === 'proposals' ? docId : null,
            shipTo: 'client',
            createdAt: new Date().toISOString(), date: new Date().toISOString().split('T')[0],
            createdBy: _cUser,
            createdByEmail: (currentUser && currentUser.email) || '',
            activityLog: [{ action: 'po_generated', details: 'Vendor: ' + vendor + ', ' + vitems.length + ' items', userName: _cUser, userEmail: (currentUser && currentUser.email) || '', timestamp: new Date().toISOString() }]
          });
          created.push(vendor + ' (' + vitems.length + ' items)');
        }

        alert('Created ' + created.length + ' Purchase Orders:\n\n' + created.join('\n'));
        _cacheTime = 0;
        navigate('#/project/' + projectId + '/pos');
      } catch(e) { console.error('PO generation failed:', e); alert('Error: ' + e.message); }
    }
