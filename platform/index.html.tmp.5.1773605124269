    // Image handling for product modal
    async function handleImageFile(file) {
      if (!file || !file.type.startsWith('image/')) return;
      try {
        const path = 'images/products/' + Date.now() + '-' + file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
        const downloadUrl = await uploadImageToStorage(file, path);
        document.getElementById('prodImage').value = downloadUrl;
        const zone = document.getElementById('prodImageZone');
        zone.innerHTML = '<img src="'+downloadUrl+'" style="max-width:100%;max-height:120px;border-radius:4px;" id="prodImagePreview"><div style="font-size:11px;color:var(--gray-400);">Click to change</div><input type="file" id="prodImageFile" accept="image/*" style="display:none;" onchange="handleImageFile(this.files[0])">';
      } catch(err) {
        alert('Image upload failed: ' + err.message);
      }
    }

    function handleImageDrop(e) {
      e.preventDefault();
      e.currentTarget.style.borderColor = 'var(--gray-200)';
      const file = e.dataTransfer.files[0];
      if (file) handleImageFile(file);
    }

    function updateImagePreview(url) {
      if (!url) return;
      const zone = document.getElementById('prodImageZone');
      if (url.startsWith('http') || url.startsWith('data:')) {
        zone.innerHTML = '<img src="'+url+'" style="max-width:100%;max-height:120px;border-radius:4px;" id="prodImagePreview" onerror="this.style.display=\'none\'"><div style="font-size:11px;color:var(--gray-400);">Click to change</div><input type="file" id="prodImageFile" accept="image/*" style="display:none;" onchange="handleImageFile(this.files[0])">';
      }
    }

    // Listen for paste events when modal is open
    document.addEventListener('paste', function(e) {
      const modal = document.querySelector('.modal-overlay');
      if (!modal) return;
      const items = e.clipboardData.items;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.startsWith('image/')) {
          e.preventDefault();
          handleImageFile(items[i].getAsFile());
          break;
        }
      }
    });

    async function saveProduct(existingId) {
      const title = document.getElementById('prodTitle').value.trim();
      if (!title) { alert('Product name is required'); return; }

      const data = {
        title: title,
        vendor: document.getElementById('prodVendor').value.trim(),
        category: document.getElementById('prodCategory').value.trim(),
        sku: document.getElementById('prodSku').value.trim(),
        imageUrl: (function() { var v = document.getElementById('prodImage').value.trim(); if (v.startsWith('data:') || v.length > 2000) return ''; return v; })(),
        costPrice: document.getElementById('prodCost').value ? parseFloat(document.getElementById('prodCost').value) : null,
        sellPrice: document.getElementById('prodSell').value ? parseFloat(document.getElementById('prodSell').value) : null,
        materials: document.getElementById('prodMaterials').value.trim(),
        finish: document.getElementById('prodFinish').value.trim(),
        dimensions: document.getElementById('prodDimensions').value.trim(),
        vendorUrl: document.getElementById('prodUrl').value.trim(),
        description: document.getElementById('prodDesc').value.trim(),
        updatedAt: new Date().toISOString(),
        owner: currentUser.email
      };

      if (data.costPrice && data.sellPrice) {
        data.markupPct = ((data.sellPrice - data.costPrice) / data.costPrice * 100).toFixed(1);
      }

      try {
        if (existingId) {
          await db.collection('products').doc(existingId).update(data);
        } else {
          data.createdAt = new Date().toISOString();
          await db.collection('products').add(data);
        }
        closeModal();
        renderProductLibrary();
      } catch(e) {
        alert('Error saving product: ' + e.message);
      }
    }

