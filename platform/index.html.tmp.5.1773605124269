    async function ibMoveSection(projectId, sectionId, direction) {
      // Load all sections
      const snap = await db.collection('boards').doc(projectId).collection('ideabooks').get();
      let sections = [];
      snap.forEach(d => sections.push({id:d.id,...d.data()}));
      sections.sort((a,b) => (a.order||0)-(b.order||0));

      const idx = sections.findIndex(s => s.id === sectionId);
      if (idx < 0) return;
      const targetIdx = idx + direction;
      if (targetIdx < 0 || targetIdx >= sections.length) return;

      // Swap orders
      const batch = db.batch();
      const refA = db.collection('boards').doc(projectId).collection('ideabooks').doc(sections[idx].id);
      const refB = db.collection('boards').doc(projectId).collection('ideabooks').doc(sections[targetIdx].id);
      batch.update(refA, { order: sections[targetIdx].order || targetIdx });
      batch.update(refB, { order: sections[idx].order || idx });
      await batch.commit();
      renderProjectDetail();
    }

    // Remove images with broken/relative URLs from a section
    async function ibCleanBrokenImages(projectId, sectionId) {
      try {
        var doc = await db.collection('boards').doc(projectId).collection('ideabooks').doc(sectionId).get();
        if (!doc.exists) return;
        var data = doc.data();
        var images = data.images || [];
        var valid = [];
        var removed = 0;
        images.forEach(function(item) {
          var url = (typeof item === 'string') ? item : (item.imageUrl || item.url || item.src || '');
          // Keep only images with valid full URLs
          if (url && (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('data:'))) {
            valid.push(item);
          } else {
            removed++;
          }
        });
        if (removed === 0) {
          showToast('All images have valid URLs — nothing to clean.');
          return;
        }
        if (!confirm('Remove ' + removed + ' image(s) with broken/missing URLs?\n\n' + (valid.length) + ' valid images will be kept.')) return;
        await db.collection('boards').doc(projectId).collection('ideabooks').doc(sectionId).update({
          images: valid,
          description: (data.description || '').replace(/\d+ images/, valid.length + ' images')
        });
        showToast('🧹 Removed ' + removed + ' broken image(s). ' + valid.length + ' remaining.');
        renderProjectDetail();
      } catch(e) {
        console.error('Clean broken images error:', e);
        showToast('Error: ' + e.message);
      }
    }

