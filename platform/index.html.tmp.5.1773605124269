    // ----- ROOM BOARDS TAB -----
    async function createNewBoard(projectId) {
      const name = prompt('Board name (e.g. "Master Bedroom", "Living Room"):');
      if (!name || !name.trim()) return;
      try {
        const boardId = projectId + '-' + name.trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'') + '-' + Date.now().toString().slice(-4);
        await db.collection('boards').doc(boardId).set({
          name: name.trim(), projectId: projectId, clipCount: 0,
          createdAt: new Date().toISOString(), updatedAt: new Date().toISOString(),
          owner: currentUser.email, status: 'In Progress'
        });
        navigate('#/project/' + projectId + '/boards');
      } catch(e) { alert('Error creating board: ' + e.message); }
    }

    async function createNewRoom(projectId) {
      const name = prompt('Room name (e.g. "Master Bedroom", "Living Room", "Kitchen"):');
      if (!name || !name.trim()) return;
      try {
        const roomId = name.trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
        await db.collection('boards').doc(projectId).collection('roomMeta').doc(roomId).set({
          name: name.trim(),
          coverImage: '',
          createdAt: new Date().toISOString()
        }, { merge: true });
        showToast('Room "' + name.trim() + '" created');
        renderBoardsTab(document.getElementById('tabContent'), { id: projectId, name: '' });
      } catch(e) { alert('Error creating room: ' + e.message); }
    }

    async function moveClipToRoom(projectId, clipId, newRoom) {
      if (!newRoom) return;
      try {
        await db.collection('boards').doc(projectId).collection('clips').doc(clipId).update({ room: newRoom });
        showToast('Item moved to ' + newRoom);
        renderBoardsTab(document.getElementById('tabContent'), { id: projectId, name: '' });
      } catch(e) { alert('Error moving item: ' + e.message); }
    }

    async function bulkMoveClipsToRoom(projectId, room) {
      const checkboxes = document.querySelectorAll('.unassigned-check:checked');
      if (checkboxes.length === 0) { showToast('Select items to move first', 'warning'); return; }
      if (!room) return;
      try {
        const batch = db.batch();
        checkboxes.forEach(cb => {
          const ref = db.collection('boards').doc(projectId).collection('clips').doc(cb.dataset.clipId);
          batch.update(ref, { room: room });
        });
        await batch.commit();
        showToast(checkboxes.length + ' item(s) moved to ' + room);
        renderBoardsTab(document.getElementById('tabContent'), { id: projectId, name: '' });
      } catch(e) { alert('Error moving items: ' + e.message); }
    }

    let boardSortField = 'title';
    let boardSortDir = 'asc';

    async function renderBoardsTab(T, proj) {
      // Load clips from boards subcollection (published) or show instruction
      let clips = [];
      try {
        const s = await db.collection('boards').doc(proj.id).collection('clips').get();
        s.forEach(d => clips.push({id:d.id,...d.data()}));
      } catch(e){}

      // Load room cover images
      let roomMeta = {};
      try {
        const rm = await db.collection('boards').doc(proj.id).collection('roomMeta').get();
        rm.forEach(d => { const data = d.data(); if (data.name) roomMeta[data.name] = data; });
      } catch(e){}

      // Sort clips
      clips.sort((a, b) => {
        let va = a[boardSortField] || '', vb = b[boardSortField] || '';
        if (typeof va === 'number' || boardSortField === 'clientPrice' || boardSortField === 'cost' || boardSortField === 'qty' || boardSortField === 'totalSelling') {
          va = parseFloat(va) || 0; vb = parseFloat(vb) || 0;
        } else { va = String(va).toLowerCase(); vb = String(vb).toLowerCase(); }
        if (va < vb) return boardSortDir === 'asc' ? -1 : 1;
        if (va > vb) return boardSortDir === 'asc' ? 1 : -1;
        return 0;
      });

      // Group by room
      const grouped = {};
      clips.forEach(c => { const rm = c.room || 'Unassigned'; if(!grouped[rm]) grouped[rm]=[]; grouped[rm].push(c); });

      const sortHdr = (field, label) => {
        const arrow = boardSortField === field ? (boardSortDir === 'asc' ? ' ▲' : ' ▼') : '';
        return '<th class="sortable-header" onclick="boardSortField=\'' + field + '\';boardSortDir=boardSortDir===\'asc\'?\'desc\':\'asc\';renderBoardsTab(document.getElementById(\'tabContent\'),{id:\'' + escAttr(proj.id) + '\',name:\'' + escAttr(proj.name) + '\'});" style="cursor:pointer;user-select:none;">' + label + arrow + '</th>';
      };

      // Build room summary cards with cover images
      const roomNames = Object.keys(grouped).sort();
      const roomCards = roomNames.map(rm => {
        const items = grouped[rm];
        const count = items.length;
        const totalCost = items.reduce((s,c) => s + ((parseFloat(c.cost)||0) * (parseFloat(c.qty)||1)), 0);
        const totalSell = items.reduce((s,c) => s + (parseFloat(c.totalSelling) || ((parseFloat(c.clientPrice)||0) * (parseFloat(c.qty)||1))), 0);
        // Use first item image as fallback cover
        const firstWithImg = items.find(c => c.imageUrl || (c.images && c.images[0]) || c.image || c.img || c.thumbnail);
        const coverImg = (roomMeta[rm] && roomMeta[rm].coverImage) || (firstWithImg ? (firstWithImg.imageUrl || (firstWithImg.images && firstWithImg.images[0]) || firstWithImg.image || firstWithImg.img || firstWithImg.thumbnail) : '') || '';
        return { name: rm, count, totalCost, totalSell, coverImg, items };
      });

      T.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
          <div class="section-title" style="margin:0;">${roomNames.length} Rooms · ${clips.length} Items</div>
          <div style="display: flex; gap: 8px;">
            <button class="btn btn-secondary btn-sm" onclick="showImageManager('${proj.id}','${escAttr(proj.name)}')">🖼️ Image Manager</button>
            <button class="btn btn-secondary btn-sm" onclick="previewRoomBoard('${proj.id}')">👁️ Preview</button>
            <button class="btn btn-secondary btn-sm" onclick="toggleRoomView()">Toggle View</button>
            <button class="btn btn-secondary btn-sm" onclick="generateProposalFromClips('${proj.id}')">📋 Generate Proposal</button>
            <button class="btn btn-secondary btn-sm" onclick="generateTearSheets('${proj.id}','${escAttr(proj.name)}')">📄 Tear Sheets</button>
            <button class="btn btn-primary btn-sm" onclick="showImportTearSheetModal('${proj.id}','${escAttr(proj.name)}')">📦 Import Tear Sheet</button>
            <button class="btn btn-secondary btn-sm" onclick="importFFEReport('${proj.id}','${escAttr(proj.name)}')" style="background:rgba(196,164,100,0.1);color:var(--gold);border-color:var(--gold);">📊 Import FFE</button>
            <button class="btn btn-primary btn-sm" onclick="createNewRoom('${escAttr(proj.id)}')" style="background:var(--cyan);border-color:var(--cyan);color:#fff;">+ New Room</button>
          </div>
        </div>
        <div class="room-cards-grid" id="roomCardsGrid">
          ${roomCards.map(rc => `
            <div class="room-card" onclick="scrollToRoom('${escAttr(rc.name)}')">
              <div class="room-card-cover">
                ${rc.coverImg ? '<img src="' + escAttr(rc.coverImg) + '" referrerpolicy="no-referrer" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'">' : ''}<div class="room-card-placeholder" style="${rc.coverImg ? 'display:none;' : 'display:flex;'}background:linear-gradient(135deg,#2a2a2a,#3a3a3a);align-items:center;justify-content:center;width:100%;height:100%;color:var(--gold);font-size:28px;flex-direction:column;gap:4px;">🏠<span style="font-size:9px;color:var(--gold);">Upload cover</span></div>
                <div class="room-card-upload" onclick="event.stopPropagation();uploadRoomCover('${escAttr(proj.id)}','${escAttr(rc.name)}',this)" title="Upload cover image">📷</div>
