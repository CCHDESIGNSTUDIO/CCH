        async function tlAcceptSuggestion(entryId, suggestedProject) {
      _tlAISuggestions[entryId] = { ..._tlAISuggestions[entryId], accepted: true };
      try {
        await db.collection('timeEntries').doc(entryId).update({ project: suggestedProject });
        // Update local array
        const entry = timeEntries.find(t => t.id === entryId);
        if (entry) entry.project = suggestedProject;
        delete _tlAISuggestions[entryId];
      } catch(e) { alert('Save error: ' + e.message); return; }
      renderTimeView();
    }

    function _tlRenderBlocks(gridInner, dayEntries, allProjects) {
      var HOUR_START = 6, HOUR_END = 23, PX_PER_HOUR = 84, LABEL_W = 56;

      // ── LOGGED ENTRIES ──
      var blocks = [];
      var fallbackOffset = 9 * 60;
      dayEntries.forEach(function(entry) {
        var durationHrs = parseFloat(entry.hours) || 0;
        if (durationHrs <= 0) return;
        var startMin;
        var rawTs = entry.createdAt;
        if (rawTs && rawTs.toDate) {
          var d = rawTs.toDate();
          startMin = d.getHours() * 60 + d.getMinutes() - Math.round(durationHrs * 60);
          if (startMin < 0) startMin = d.getHours() * 60 + d.getMinutes();
        } else if (entry.startTime) {
          var parts = String(entry.startTime).split(':');
          startMin = parseInt(parts[0]) * 60 + parseInt(parts[1] || 0);
        } else {
          startMin = fallbackOffset;
          fallbackOffset += Math.max(Math.round(durationHrs * 60), 15);
        }
        blocks.push({ entry: entry, startMin: startMin, endMin: startMin + Math.round(durationHrs * 60), durationHrs: durationHrs });
      });

      blocks.sort(function(a,b) { return a.startMin - b.startMin; });
      var lanes = [];
      blocks.forEach(function(b) {
        var lane = -1;
        for (var i=0; i<lanes.length; i++) { if (lanes[i] <= b.startMin) { lane = i; break; } }
        if (lane === -1) { lane = lanes.length; lanes.push(0); }
        lanes[lane] = b.endMin;
        b.lane = lane;
      });
      var numLanes = Math.max(lanes.length, 1);

      var html = '';

      // ── Draw logged entry blocks ──
      blocks.forEach(function(b) {
        var top = Math.max(0, (b.startMin / 60 - HOUR_START) * PX_PER_HOUR);
        var height = Math.max(20, b.durationHrs * PX_PER_HOUR);
        // center grid: full width from LABEL_W
        var laneW = 100 / numLanes;
        var leftPct = b.lane * laneW;

        var suggest = _tlAISuggestions[b.entry.id];
        var effectiveProject = (suggest && !suggest.accepted) ? suggest.project : (b.entry.project || '');
        var isSuggested = !!suggest && !suggest.accepted && effectiveProject !== 'Unassigned';
        var isUnassigned = !effectiveProject || effectiveProject === 'Unassigned';
        var col = isSuggested ? TL_SUGGESTED : tlProjectColor(b.entry.project || '', allProjects);

        var m = Math.round(b.durationHrs * 60);
        var dur = m >= 60 ? Math.floor(m/60)+'h'+(m%60?' '+m%60+'m':'') : m+'m';
        var isShort = height < 36;
        var isTiny = height < 22;

        var acceptBtn = isSuggested
          ? '<button onclick="event.stopPropagation();tlAcceptSuggestion(\'' + escAttr(b.entry.id) + '\',\'' + escAttr(suggest.project) + '\')" style="margin-top:3px;font-size:9px;padding:1px 6px;background:' + col.border + ';color:white;border:none;border-radius:3px;cursor:pointer;display:block;">✓ Accept</button>'
          : '';

        html += '<div id="tlblock-' + b.entry.id + '"' +
          ' onclick="editTimeEntry(\'' + escAttr(b.entry.id) + '\')"' +
          ' title="' + escAttr((b.entry.project||'Unassigned') + ' · ' + (b.entry.service||b.entry.description||'') + ' · ' + dur) + '"' +
          ' style="' +
            'position:absolute;' +
            'top:' + top + 'px;height:' + height + 'px;' +
            'left:calc(' + LABEL_W + 'px + ' + leftPct + '%);' +
            'width:calc(' + laneW + '% - 5px);' +
            'background:' + col.bg + ';' +
            'border-left:3px solid ' + col.border + ';' +
            'border-radius:0 5px 5px 0;' +
            (isSuggested ? 'border:2px dashed ' + col.border + ';border-left:4px solid ' + col.border + ';' : '') +
            (isUnassigned && !isSuggested ? 'border:1px dashed #bbb;border-left:3px solid #bbb;' : '') +
            'padding:' + (isTiny?'1px 5px':isShort?'3px 6px':'5px 8px') + ';' +
            'cursor:pointer;overflow:hidden;' +
            'box-shadow:0 1px 4px rgba(0,0,0,0.08);' +
            'transition:box-shadow 0.15s,filter 0.1s;' +
            'box-sizing:border-box;z-index:3;' +
          '"' +
          ' onmouseover="this.style.boxShadow=\'0 3px 12px rgba(0,0,0,0.18)\';this.style.filter=\'brightness(0.97)\'"' +
          ' onmouseout="this.style.boxShadow=\'0 1px 4px rgba(0,0,0,0.08)\';this.style.filter=\'\'">' +
          (!isTiny ? (
            '<div style="font-size:' + (isShort?10:12) + 'px;font-weight:700;color:' + col.text + ';white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' +
              (isSuggested ? '<span style="font-size:9px;opacity:0.7;">🤖 </span>' : '') +
              esc(isSuggested ? suggest.project : (b.entry.project || 'Unassigned')) +
            '</div>' +
            (!isShort ? '<div style="font-size:10px;color:' + col.border + ';opacity:0.9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(b.entry.service||b.entry.description||'') + '</div>' : '') +
            '<div style="font-size:10px;color:' + col.text + ';opacity:0.65;">' + dur + (b.entry.total>0?' · $'+Math.round(b.entry.total):'') + '</div>' +
            acceptBtn
          ) : '<div style="font-size:9px;font-weight:700;color:' + col.text + ';overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">' + esc(isSuggested?suggest.project:(b.entry.project||'·')) + '</div>') +
        '</div>';
      });

      // ── Now indicator ──
      var todayStr = dateStr(new Date());
      if (_tlDay === todayStr) {
        var now = new Date();
        var nowMin = now.getHours() * 60 + now.getMinutes();
        if (nowMin >= HOUR_START*60 && nowMin <= HOUR_END*60) {
          var nowTop = (nowMin/60 - HOUR_START) * PX_PER_HOUR;
          var nowH = now.getHours(), nowM = now.getMinutes();
          var nowAmPm = nowH >= 12 ? 'pm' : 'am';
          var nowHour = nowH > 12 ? nowH - 12 : (nowH === 0 ? 12 : nowH);
          var nowLabel = nowHour + ':' + (nowM < 10 ? '0' : '') + nowM + nowAmPm;
          html += '<div style="position:absolute;left:0;right:0;top:' + nowTop + 'px;z-index:10;pointer-events:none;display:flex;align-items:center;">' +
            '<div style="font-size:9px;font-weight:700;color:#E53935;padding-right:4px;text-align:right;width:' + LABEL_W + 'px;transform:translateY(-1px);">' + nowLabel + '</div>' +
            '<div style="width:8px;height:8px;background:#E53935;border-radius:50%;flex-shrink:0;box-shadow:0 0 0 3px rgba(229,57,53,0.2);"></div>' +
            '<div style="flex:1;height:2px;background:linear-gradient(to right,#E53935,rgba(229,57,53,0.1));"></div>' +
          '</div>';
        }
      }

      // ── Capture blocks in center grid — Timely-style multi-lane layout ──
      var APP_COLORS_TL = ['#1976D2','#E53935','#F57C00','#388E3C','#7B1FA2','#00838F','#5D4037','#455A64','#C62828','#2E7D32','#F06292','#81C784','#4DD0E1','#FF8A65','#BA68C8','#0097A7','#8D6E63','#D81B60','#00BFA5','#6D4C41','#1E88E5','#43A047','#FB8C00','#8E24AA','#00897B','#EF5350','#5C6BC0','#FFB300','#26A69A','#EC407A'];
      function _tlAppColor(app) {
        // Better hash: use FNV-1a for more even distribution across 30 colors
        var h = 2166136261;
        for (var i = 0; i < app.length; i++) { h ^= app.charCodeAt(i); h = (h * 16777619) & 0xFFFFFFFF; }
        return APP_COLORS_TL[Math.abs(h) % APP_COLORS_TL.length];
      }

      // Get captures ONLY for the displayed day
      var allCaps = window._pendingCaptures || [];
      var dayCaps = [];
      for (var ci = 0; ci < allCaps.length; ci++) {
        if (allCaps[ci].date === _tlDay && !allCaps[ci]._dismissed) {
          dayCaps.push({ cap: allCaps[ci], globalIdx: ci });
        }
      }
      // console.log('[Timeline Caps] _tlDay:', _tlDay, 'total caps:', allCaps.length, 'day caps:', dayCaps.length, 'dates:', [...new Set(allCaps.map(function(c){return c.date;}))].join(', '));

      var bucketed = {};
      var bucketProjectMap = {}; // maps capture index → bucket project name
      (window._projectBuckets || []).forEach(function(b){ 
        (b.items||[]).forEach(function(i){ 
          bucketed[i]=true; 
          bucketProjectMap[i] = b.project || 'Unassigned';
        }); 
      });

      // Show ALL captures (bucketed ones rendered grayed out, dismissed already filtered)
      var visibleCaps = dayCaps; // dismissed already excluded above

      if (visibleCaps.length > 0) {
        var gridLeft = LABEL_W + 4;

        // Helper: parse timestamp to minutes from midnight
        function parseTimeToMin(ts) {
          if (!ts) return -1;
          ts = String(ts);
          // Try ISO: "2026-03-09T09:04:00"
          var isoMatch = ts.match(/T(\d{1,2}):(\d{2})/);
          if (isoMatch) return parseInt(isoMatch[1]) * 60 + parseInt(isoMatch[2]);
          // Try "HH:MM" or "H:MM"
          var hmMatch = ts.match(/^(\d{1,2}):(\d{2})/);
          if (hmMatch) return parseInt(hmMatch[1]) * 60 + parseInt(hmMatch[2]);
          // Try epoch (seconds or ms)
          var num = parseInt(ts);
          if (num > 1000000000) {
            var d = new Date(num > 9999999999 ? num : num * 1000);
            return d.getHours() * 60 + d.getMinutes();
          }
          return -1;
        }

        // Separate timestamped vs non-timestamped captures
        var withTimestamps = [];
        var withoutTimestamps = [];
        visibleCaps.forEach(function(dc) {
          if (parseTimeToMin(dc.cap.startTime) >= 0) {
            withTimestamps.push(dc);
          } else {
            withoutTimestamps.push(dc);
          }
        });
        // console.log('[Timeline Caps] with timestamps:', withTimestamps.length, 'without:', withoutTimestamps.length);

        // Fewer lanes = wider, more readable blocks
        // Count only UN-BUCKETED captures for lane calculation (bucketed ones are nearly invisible)
        var unbucketedCount = visibleCaps.filter(function(dc) { return !bucketed[dc.globalIdx]; }).length;
        var NUM_LANES = unbucketedCount <= 4 ? 1 : unbucketedCount <= 12 ? 2 : unbucketedCount <= 25 ? 3 : unbucketedCount <= 50 ? 4 : Math.min(6, Math.ceil(unbucketedCount / 10));
        var capBlocks = [];

        // ── TIMESTAMPED entries: position at actual time ──
        if (withTimestamps.length > 0) {
          withTimestamps.sort(function(a,b) {
            return parseTimeToMin(a.cap.startTime) - parseTimeToMin(b.cap.startTime);
          });

          var laneEnds = [];
          for (var li = 0; li < NUM_LANES; li++) laneEnds.push(0);

          withTimestamps.forEach(function(dc) {
            var startMin = parseTimeToMin(dc.cap.startTime);
            var durMins = Math.max(15, dc.cap.minutes);

            // Find best lane — prefer lanes that are truly free, dynamically add lanes to prevent overlap
            var bestLane = -1;
            var bestEnd = Infinity;
            for (var li = 0; li < laneEnds.length; li++) {
              if (laneEnds[li] <= startMin) { bestLane = li; break; }
              if (laneEnds[li] < bestEnd) { bestEnd = laneEnds[li]; bestLane = li; }
            }
            // If no free lane found and best lane would cause overlap, add a new lane
            if (bestLane === -1 || laneEnds[bestLane] > startMin) {
              // Only add new lane if best lane truly overlaps; cap at reasonable max
              if (laneEnds[bestLane] > startMin && laneEnds.length < 8) {
                bestLane = laneEnds.length;
                laneEnds.push(0);
                NUM_LANES = laneEnds.length;
              }
            }
            laneEnds[bestLane] = startMin + durMins + 3;
            capBlocks.push({ dc: dc, lane: bestLane, startMin: startMin, durMins: durMins });
          });
        }

        // ── NON-TIMESTAMPED entries: spread evenly across time window ──
        if (withoutTimestamps.length > 0) {
          // ── NO TIMESTAMPS: spread evenly across time window ──
          var capStartHour = 8;
          var capEndHour;
          var todayCheck = dateStr(new Date());
          if (_tlDay === todayCheck) {
            var nowH = new Date().getHours() + new Date().getMinutes() / 60;
            capEndHour = Math.max(nowH, capStartHour + 2);
          } else {
            capEndHour = 18;
          }
          var totalAvailMin = (capEndHour - capStartHour) * 60;

          withoutTimestamps.sort(function(a,b) { return b.cap.minutes - a.cap.minutes; });

          var laneBuckets = [];
          for (var li = 0; li < NUM_LANES; li++) laneBuckets.push([]);
          withoutTimestamps.forEach(function(dc, idx) {
            laneBuckets[idx % NUM_LANES].push(dc);
          });

          laneBuckets.forEach(function(laneItems, laneIdx) {
            if (laneItems.length === 0) return;
            var adjustedItems = laneItems.map(function(dc) {
              return { dc: dc, displayMins: Math.max(12, dc.cap.minutes) };
            });
            var totalDisplayMins = adjustedItems.reduce(function(s,it) { return s + it.displayMins; }, 0);
            var remainingSpace = Math.max(0, totalAvailMin - totalDisplayMins);
            var gapSize = remainingSpace / (adjustedItems.length + 1);

            var currentMin = capStartHour * 60 + gapSize;
            adjustedItems.forEach(function(item) {
              if (currentMin + item.displayMins > capEndHour * 60) {
                item.displayMins = Math.max(3, capEndHour * 60 - currentMin);
              }
              capBlocks.push({ dc: item.dc, lane: laneIdx, startMin: currentMin, durMins: item.displayMins });
              currentMin += item.displayMins + gapSize;
            });
          });
        }

        // Render each capture block
        var laneW = (100 - 2) / NUM_LANES; // 2% total margin
        capBlocks.forEach(function(cb) {
          var dc = cb.dc;
          var cap = dc.cap;
          var appCol = _tlAppColor(cap.app || 'Unknown');
          var top = Math.max(0, (cb.startMin / 60 - HOUR_START) * PX_PER_HOUR);
          var height = Math.max(28, (cb.durMins / 60) * PX_PER_HOUR);
          var leftPct = cb.lane * laneW + 0.5;
          var widthPct = laneW - 1;

          // App icon mapping
          var appIcons = {
            'chrome':'🌐','Chrome':'🌐','firefox':'🦊','Firefox':'🦊','safari':'🧭','Safari':'🧭',
            'edge':'🌐','Edge':'🌐','claude.ai':'🤖','claude':'🤖','Claude':'🤖',
