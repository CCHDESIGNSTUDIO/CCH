rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'cindy@cchdesign.com' ||
        request.auth.token.email == 'cynthia@cchdesign.com' ||
        request.auth.token.email == 'cynthiacbh@gmail.com'
      );
    }

    function isFeedbackTeam() {
      return request.auth != null && (
        request.auth.token.email == 'cindy@cchdesign.com' ||
        request.auth.token.email == 'cynthia@cchdesign.com' ||
        request.auth.token.email == 'cynthiacbh@gmail.com' ||
        request.auth.token.email == 'vanessa@cchdesign.com' ||
        request.auth.token.email == 'vanessaholliday@cchdesign.com' ||
        request.auth.token.email == 'vholliday@cchdesign.com'
      );
    }

    // --- Client portal (no Firebase Auth): narrow helpers ---
    // Published proposals: clients may run multi-field updates from the portal UI
    // (line approvals, totals, activityLog arrayUnion). Full field-level parity with
    // the app is not expressible here; tighten further with Callable + auth when ready.
    function portalPublishedProposalUpdate() {
      return !isAuth()
        && resource.data.published == true
        && request.resource.data.published == true;
    }

    function portalProposalSeenUpdate() {
      return !isAuth()
        && resource.data.published == true
        && request.resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'clientPortalSeenAt', 'updatedAt']);
    }

    function portalClientMessageCreate() {
      return !isAuth()
        && request.resource.data.keys().hasAll(['text', 'author', 'from', 'createdAt', 'type'])
        && request.resource.data.keys().hasOnly(['text', 'author', 'from', 'createdAt', 'type'])
        && request.resource.data.author == 'Client'
        && request.resource.data.from == 'client'
        && request.resource.data.type == 'client';
    }

    function portalClientDocumentReviewUpdate() {
      return !isAuth()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedAt', 'updatedAt']);
    }

    /** Client portal decision responses (Approve / Request Changes / I've Reviewed). */
    function portalClientDecisionReviewUpdate() {
      return !isAuth()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'clientResponse', 'responseHistory', 'updatedAt']);
    }

    /** Client portal task input responses (needs_input flag). */
    function portalClientTaskResponseUpdate() {
      return !isAuth()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['clientResponse', 'responseHistory', 'updatedAt']);
    }

    function portalActivityCreate() {
      return !isAuth()
        && request.resource.data.user == 'Client'
        && request.resource.data.type == 'proposal'
        && request.resource.data.keys().hasAll(['type', 'action', 'description', 'projectId', 'user', 'timestamp'])
        && request.resource.data.meta is map;
    }

    /** Client portal timeline (views, inspiration feedback, messages) — unauthenticated. */
    function portalClientActivityCreate() {
      return !isAuth()
        && request.resource.data.meta is map
        && request.resource.data.meta.source == 'client_portal'
        && request.resource.data.keys().hasAll(['type', 'action', 'description', 'projectId', 'projectName', 'user', 'timestamp', 'createdAt', 'meta'])
        && request.resource.data.description is string
        && request.resource.data.projectId is string
        && (
          request.resource.data.type == 'client_portal'
          || request.resource.data.type == 'client_first_visit'
          || request.resource.data.type == 'inspiration'
          || request.resource.data.type == 'proposal'
          || request.resource.data.type == 'message'
          || request.resource.data.type == 'invoice'
        )
        && (
          request.resource.data.user == 'Client'
          || (request.resource.data.meta.clientEmail is string
              && request.resource.data.user == request.resource.data.meta.clientEmail)
        );
    }

    function portalClientSessionWrite() {
      return !isAuth()
        && request.resource.data.keys().hasAll(['clientName', 'clientEmail', 'lastVisit', 'projectId'])
        && request.resource.data.clientName is string
        && request.resource.data.clientEmail is string
        && request.resource.data.lastVisit is string
        && request.resource.data.projectId is string
        && request.resource.data.clientName.size() > 0
        && request.resource.data.clientEmail.size() > 3;
    }

    /** Inspiration board stars/comments/notes — clients update images[] only. */
    function portalIdeabookClientFeedbackUpdate() {
      return !isAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['images', 'updatedAt']);
    }

    // Room-board clips = furnishing products only (Studio + Clipper). Admin SDK / imports bypass rules.
    function clipStr(d, k) {
      return (k in d && d[k] is string) ? d[k] : '';
    }
    function clipLower(d, k) {
      return clipStr(d, k).lower().trim();
    }
    function clipBoardForbiddenKinds(d) {
      let lk = clipLower(d, 'libraryItemKind').replace(' ', '_');
      let ik = clipLower(d, 'itemKind').replace(' ', '_');
      return lk == 'expense' || lk == 'labor' || lk == 'design_service' || lk == 'designservice' || lk == 'service'
        || ik == 'expense' || ik == 'labor' || ik == 'design_service' || ik == 'designservice' || ik == 'service';
    }
    function clipBoardForbiddenExpenseType(d) {
      let et = clipLower(d, 'expenseType');
      return et == 'expense' || et == 'other_expense' || et == 'labor' || et == 'service'
        || et == 'shipping' || et == 'handling' || et == 'sales_tax' || et == 'discount';
    }
    function clipBoardForbiddenLineMeta(d) {
      let lt = clipLower(d, 'lineType').replace(' ', '_');
      let ity = clipLower(d, 'itemType').replace(' ', '_');
      let cc = clipLower(d, 'cchLineCategory').replace(' ', '_');
      return lt == 'design_service' || lt == 'designservice' || lt == 'labor' || lt == 'expense'
        || ity == 'labor' || ity == 'expense' || ity == 'service'
        || cc == 'design_service' || cc == 'designservice' || cc == 'labor' || cc == 'expense';
    }
    function clipBoardForbiddenTitle(d) {
      let t = clipLower(d, 'title');
      return t == 'expense' || t == 'expenses' || t == 'labor' || t == 'labour' || t == 'services' || t == 'service'
        || t == 'design service' || t == 'design services' || t == 'time billing' || t == 'design fee' || t == 'design fees';
    }
    function clipBoardForbiddenCatOrRoom(d) {
      let c = clipLower(d, 'category');
      let r = clipLower(d, 'room');
      return c == 'expense' || c == 'expenses' || c == 'labor' || c == 'time billing' || c == 'time track' || c == 'time tracking'
        || c == 'design fees' || c == 'design services' || c == 'blended design fees' || c == 'blended design services'
        || c == 'consultation' || c == 'project management' || c == 'pass-through' || c == 'passthrough'
        || c == 'freight' || c == 'shipping' || c == 'client admin' || c == 'client project services'
        || c == 'professional services' || c == 'design service' || c == 'service' || c == 'services' || c == 'fees' || c == 'fee'
        || r == 'expense' || r == 'expenses' || r == 'labor' || r == 'time billing' || r == 'time track' || r == 'time tracking'
        || r == 'design fees' || r == 'design services' || r == 'blended design fees' || r == 'blended design services'
        || r == 'consultation' || r == 'project management' || r == 'pass-through' || r == 'passthrough'
        || r == 'freight' || r == 'shipping' || r == 'client admin' || r == 'client project services'
        || r == 'professional services' || r == 'design service' || r == 'service' || r == 'services' || r == 'fees' || r == 'fee';
    }
    function clipBoardWriteOk(d) {
      return d is map
        && !clipBoardForbiddenKinds(d)
        && !clipBoardForbiddenExpenseType(d)
        && !clipBoardForbiddenLineMeta(d)
        && !clipBoardForbiddenTitle(d)
        && !clipBoardForbiddenCatOrRoom(d);
    }

    // Admin config (QB tokens, etc.) — admin only
    match /admin/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // boards/{projectId} — project document (not subcollections)
    match /boards/{projectId} {
      // Client portal loads the board doc without auth (index.html renderClientPortal / renderClientView).
      allow read: if true;
      // All board-document field writes in Studio are signed-in (invoiceCount, clipCount, etc.).
      allow write: if isAuth();

      // Financial subcollections — Studio must be signed in. No catch-all OR that bypasses this.
      match /purchaseOrders/{docId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
      match /invoices/{docId} {
        allow read: if true;
        allow write: if isAuth();
      }
      match /proposals/{docId} {
        allow read: if true;
        allow create, delete: if isAuth();
        allow update: if isAuth()
          || portalProposalSeenUpdate()
          || portalPublishedProposalUpdate();
      }

      // Portal-visible / Studio subcollections (explicit list — no public wildcard)
      match /clips/{docId} {
        allow read: if true;
        allow create: if isAuth() && clipBoardWriteOk(request.resource.data);
        allow update: if isAuth() && clipBoardWriteOk(request.resource.data);
        allow delete: if isAuth();
      }
      match /ideabooks/{docId} {
        allow read: if true;
        allow create, delete: if isAuth();
        allow update: if isAuth() || portalIdeabookClientFeedbackUpdate();
      }
      match /clientSessions/{docId} {
        allow read: if isAuth();
        allow create, update: if isAuth() || portalClientSessionWrite();
      }
      match /notes/{docId} {
        allow read: if true;
        allow write: if isAuth();
      }
      match /tasks/{docId} {
        allow read: if true;
        allow create, delete: if isAuth();
        allow update: if isAuth() || portalClientTaskResponseUpdate();
      }
      match /messages/{docId} {
        allow read: if true;
        allow create: if isAuth() || portalClientMessageCreate();
        allow update, delete: if isAuth();
      }
      match /roomMeta/{docId} {
        allow read: if true;
        allow write: if isAuth();
      }
      match /files/{docId} {
        allow read: if true;
        allow write: if isAuth();
      }
      // External contractor invites (capability URL + token). Not TEAM_CONFIG.contractors.
      match /contractorAccess/{token} {
        allow get: if true;
        allow list: if isAuth();
        allow create, delete: if isAuth();
        allow update: if isAuth()
          || (
            resource.data.revoked != true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
          );
      }
      match /workOrders/{docId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
      match /designBoards/{docId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
      match /projectNotes/{docId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
      match /clientDocuments/{docId} {
        allow read: if true;
        allow create: if isAuth();
        allow update: if isAuth() || portalClientDocumentReviewUpdate();
        allow delete: if isAuth();
      }
      match /clientDecisions/{docId} {
        allow read: if true;
        allow create: if isAuth();
        allow update: if isAuth() || portalClientDecisionReviewUpdate();
        allow delete: if isAuth();
      }
      match /whatsNew/{docId} {
        allow read: if true;
        allow write: if isAuth();
      }
      match /heroImages/{docId} {
        allow read: if true;
        allow write: if isAuth();
      }
      match /progressUpdates/{docId} {
        allow read: if resource.data.status == 'published' || isAuth();
        allow write: if isAuth();
      }
      match /notifications/{docId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isAuth();
      }
      // Project correspondence + PO vendor email thread (index.html + cch-po-vendor-comms.js)
      match /correspondence/{docId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
      // WO-058 — user cleared room from board; doc-line ensure must not re-room / re-create
      match /clipSuppressions/{docId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }
    }

    // settings/* — was public read/write; counters + rates + integrations are sensitive.
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isAuth() && (
        docId == 'docCounters' ||
        docId == 'serviceRates' ||
        docId == 'integrations'
      );
    }

    // Legacy top-level ideabooks (renderClientView reads index.html ~49405). Studio uses boards/.../ideabooks.
    match /ideabooks/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // Desktop time logs — Smart Time / import push from signed-in Studio only.
    match /desktopTimeLogs/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /timeBuckets/{docId} {
      allow read: if isAuth() && resource.data.email == request.auth.token.email;
      allow write: if isAuth() && request.resource.data.email == request.auth.token.email;
    }

    // Activity: global read still wide (portal + dashboard). Writes: Studio or narrow client rows.
    match /activity/{docId} {
      allow read: if true;
      allow create: if isAuth() || portalActivityCreate() || portalClientActivityCreate();
      allow update, delete: if isAuth();
    }

    match /timeEntries/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /invoices/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
    match /proposals/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /purchaseOrders/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /products/{docId} {
      allow read: if true;
      // Was if true — any client could pollute catalog; signed-in Studio/Clipper only.
      allow create, update: if isAuth();
      allow delete: if isAdmin();
    }

    match /clients/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /vendors/{docId} {
      allow read: if true;
      // Clipper "New vendor" from extension may have no Firebase user — keep open create.
      allow create: if true;
      // Studio users maintain vendor contact + QuickBooks mapping (qbVendorId).
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    match /workrooms/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /reports/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /deliveries/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /notes/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /_searchIndex/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /feedbackRequests/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();

      match /messages/{messageId} {
        allow read, write: if isFeedbackTeam();
      }
    }

    // Studio writes productLibrary heavily; align rule with app (was admin-only write).
    match /productLibrary/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Junk Library quarantine (productLibrary_archive / products_archive).
    match /productLibrary_archive/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /products_archive/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Counters live in settings/docCounters in app; deny stray top-level docCounters client access.
    match /docCounters/{docId} {
      allow read, write: if false;
    }

    match /tasks/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /team/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /timelyEntries/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Used by Studio sync UIs (index.html) — was missing from rules (default deny).
    match /projects/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Internal briefings (index.html ~5938+) — was missing from rules.
    match /briefings/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    /** WO-089: unauthenticated client Pepper → Team Chat (Cindy + Vanessa both unread). */
    function portalClientPepperStaffChatCreate() {
      return !isAuth()
        && request.resource.data.fromClient == true
        && request.resource.data.source == 'client_pepper'
        && request.resource.data.authorRole == 'client'
        && request.resource.data.keys().hasAll([
          'text', 'authorRole', 'authorName', 'createdAt', 'fromClient', 'source', 'projectId', 'projectName'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 4000
        && request.resource.data.projectId is string
        && request.resource.data.projectName is string
        && request.resource.data.authorName is string;
    }
    function portalClientPepperStaffChatRoomTouch() {
      return !isAuth()
        && request.resource.data.keys().hasAll(['lastMessage', 'unreadBy', 'updatedAt'])
        && request.resource.data.unreadBy is map
        && request.resource.data.unreadBy.owner == true
        && request.resource.data.unreadBy.vanessa == true
        && request.resource.data.lastMessage is map
        && request.resource.data.lastMessage.fromClient == true;
    }

    // WO-063 / FT-018 — Studio staff chat (Cindy ↔ Vanessa). Append-only messages.
    // WO-089 — narrow create path for client Pepper relay (no read for clients).
    match /internal/{docId} {
      allow read: if isFeedbackTeam() && docId == 'staffChat';
      allow create, update: if (isFeedbackTeam() && docId == 'staffChat')
        || (docId == 'staffChat' && portalClientPepperStaffChatRoomTouch());
      match /messages/{messageId} {
        allow read: if isFeedbackTeam();
        allow create: if isFeedbackTeam() || portalClientPepperStaffChatCreate();
        allow update, delete: if false;
      }
    }
  }
}
